{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@udixio/ui-angular": ["../../packages/ui-angular/src/index.ts"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "references": [
    {
      "path": "../../packages/ui-react"
    },
    {
      "path": "../../packages/tailwind"
    },
    {
      "path": "../../packages/icons/icons-rounded-400"
    },
    {
      "path": "../../packages/core"
    },
    {
      "path": "../../packages/theme"
    }
  ]
}
