        "size": {
          "name": "size",
          "description": "Visual size; every option retains at least a 48px touch target.",
          "required": false,
          "type": {
            "name": "IconButtonSize | undefined"
          },
          "defaultValue": {
            "value": "'medium'"
          }
        },
        "width": {
          "name": "width",
          "description": "Horizontal container width.",
          "required": false,
          "type": {
            "name": "IconButtonWidth | undefined"
          },
          "defaultValue": {
            "value": "'default'"
          }
        },
        "disabled": {
          "name": "disabled",
          "description": "Disables interaction.",
          "required": false,
          "type": {
            "name": "boolean | undefined"
          },
          "defaultValue": {
