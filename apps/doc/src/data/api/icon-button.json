          "type": {
            "name": "string"
          },
          "defaultValue": null
        },
        "icon": {
          "name": "icon",
          "description": "Icon shown in the resting state.",
          "required": true,
          "type": {
            "name": "Icon"
          },
          "defaultValue": null
        },
        "pressedIcon": {
          "name": "pressedIcon",
          "description": "Optional icon shown while a toggle icon button is pressed.",
