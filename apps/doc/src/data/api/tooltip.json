{
  "schemaVersion": 2,
  "displayName": "Tooltip",
  "defaultFramework": "react",
  "frameworks": {
    "react": {
      "filePath": "packages/ui-react/src/lib/components/Tooltip.tsx",
      "description": "Tooltips display brief labels or messages",
      "tags": {
        "status": "beta",
        "category": "Communication",
        "devx": "- `content` overrides `title`/`text`/`buttons` for fully custom content.\n- Supports controlled `isOpen` plus `openDelay`/`closeDelay`.",
        "a11y": "- Provides `role=\"tooltip\"` and `aria-describedby` when open."
      },
      "methods": [],
      "props": {
        "className": {
          "name": "className",
          "description": "Classes or state-aware element classes applied through the shared style contract.",
          "required": false,
          "type": {
            "name": "string | ClassNameComponent<TooltipInterface> | undefined"
          },
          "defaultValue": null
        },
        "variant": {
          "name": "variant",
          "description": "",
          "required": false,
          "type": {
            "name": "TooltipVariant | undefined"
          },
          "defaultValue": {
            "value": "'plain'"
          }
        },
        "title": {
          "name": "title",
          "description": "Headline of a rich tooltip.",
          "required": false,
          "type": {
            "name": "string | undefined"
          },
          "defaultValue": null
        },
        "text": {
          "name": "text",
          "description": "Supporting text for the tooltip.",
          "required": false,
          "type": {
            "name": "string | undefined"
          },
          "defaultValue": null
        },
        "trigger": {
          "name": "trigger",
          "description": "",
          "required": false,
          "type": {
            "name": "TooltipTrigger | TooltipTrigger[] | undefined"
          },
          "defaultValue": {
            "value": "['hover', 'focus']"
          }
        },
        "openDelay": {
          "name": "openDelay",
          "description": "Delay in milliseconds before showing the tooltip. Default: 400ms",
          "required": false,
          "type": {
            "name": "number | undefined"
          },
          "defaultValue": {
            "value": "400"
          }
        },
        "closeDelay": {
          "name": "closeDelay",
          "description": "Delay in milliseconds before hiding the tooltip. Default: 150ms",
          "required": false,
          "type": {
            "name": "number | undefined"
          },
          "defaultValue": {
            "value": "150"
          }
        },
        "isOpen": {
          "name": "isOpen",
          "description": "Controlled mode: explicitly control whether the tooltip is open",
          "required": false,
          "type": {
            "name": "boolean | undefined"
          },
          "defaultValue": null
        },
        "defaultOpen": {
          "name": "defaultOpen",
          "description": "Uncontrolled mode: default open state",
          "required": false,
          "type": {
            "name": "boolean | undefined"
          },
          "defaultValue": {
            "value": "false"
          }
        },
        "onOpenChange": {
          "name": "onOpenChange",
          "description": "Callback when the open state changes",
          "required": false,
          "type": {
            "name": "((open: boolean) => void) | undefined"
          },
          "defaultValue": null
        },
        "id": {
          "name": "id",
          "description": "Custom ID for accessibility linking. Auto-generated if not provided.",
          "required": false,
          "type": {
            "name": "string | undefined"
          },
          "defaultValue": null
        },
        "anchorRef": {
          "name": "anchorRef",
          "description": "Custom anchor for positioning. Defaults to the trigger element.",
          "required": false,
          "type": {
            "name": "RefObject<HTMLElement> | undefined"
          },
          "defaultValue": null
        }
      }
    }
  }
}
