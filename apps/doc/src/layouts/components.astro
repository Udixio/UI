---
import '@/styles/global.css';
import { getCollection } from 'astro:content';
import { ComponentNavigation } from '@/components/ComponentNavigation';
import Layout from '@/layouts/layout.astro';
import { Card } from '@udixio/ui-react';
import { renderMarkdown } from '@/lib/markdown';
import { EXAMPLE_FRAMEWORKS } from '@/stores/exampleFrameworkStore';
import { ComponentDocumentationNotes } from '@/components/api/ComponentDocumentationNotes';
import type { DocumentationNoteHtml } from '@/components/api/ComponentDocumentationNotes';

const apis = await getCollection('api');

const isApiPage = Astro.url.pathname.split('/').filter(Boolean).at(-1) === 'api';
const documentationTags = isApiPage
  ? (['devx', 'a11y', 'limitations'] as const)
  : (['limitations'] as const);

const { component } = Astro.params;

const componentApi = apis.find((api) => api.id === component);

if (!componentApi) {
  return Astro.redirect('/404', 404);
}

const componentApiData = componentApi.data;

const documentationHtml = Object.fromEntries(
  EXAMPLE_FRAMEWORKS.flatMap((framework) => {
    const tags = componentApiData.frameworks[framework]?.tags;
    if (!tags) return [];

    return [
      [
        framework,
        Object.fromEntries(
          documentationTags.flatMap((tag) => {
            const value = tags[tag];
            return typeof value === 'string' && value.trim()
              ? [[tag, renderMarkdown(value)]]
              : [];
          }),
        ),
      ],
    ];
  }),
) as DocumentationNoteHtml;

---
<Layout docSidebar>
  <div class="max-w-screen-xl mx-auto px-8 pb-10">
    <Card variant="filled" className="mt-8 bg-surface-container">
      <div class="p-8">
        <slot name="header" />
      </div>
      <div data-pagefind-ignore>
        <ComponentNavigation
          client:load
          transition:name="component-navigation"
          transition:persist
          componentApi={componentApi}
        />
      </div>
    </Card>
    <ComponentDocumentationNotes
      client:load
      api={componentApiData}
      html={documentationHtml}
    />

    <slot />
  </div>
</Layout>
