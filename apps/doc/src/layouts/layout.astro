---
import '@/styles/global.css';
import { getCollection } from 'astro:content';
import { Navigation } from '@/components/Navigation';
import { buildComponentSections } from '@/lib/component-nav';
import { ClientRouter } from 'astro:transitions';
import { Sidebar } from '@/components/Sidebar';
import { Button } from '@udixio/ui-react';
import { ThemeProvider } from '@/components/theme/ThemeProvider';
import { Font } from 'astro:assets';
import { SEO } from 'astro-seo';
import { canonicalUrl, hasFrameworkVariants, readingFramework, splitFramework } from '@/lib/framework-url';
import { EXAMPLE_FRAMEWORKS } from '@/stores/exampleFrameworkStore';

const componentSections = buildComponentSections(
  await getCollection('api'),
  await getCollection('overviews'),
);

interface Props {
  docSidebar?: boolean;
  title?: string;
  description?: string;
  noindex?: boolean;
}

const site = Astro.site;
if (site === undefined) throw new Error('layout: the site URL is not set');
// A reading declares its framework alone, and every other page declares the four: Pagefind's search filters on the
// stored framework (framework-urls spec §2.8).
const { framework: prefix, path } = splitFramework(Astro.url.pathname);
const reading = readingFramework(prefix);
const searchFrameworks = reading !== undefined && hasFrameworkVariants(path) ? [reading] : EXAMPLE_FRAMEWORKS;

// On a compact screen the top app bar stays at the top of the window: `scroll-pt-16` on <html> stops a jump to an anchor
// below it.
const {
  docSidebar = false,
  title,
  description = 'Udixio UI is a framework-agnostic Material Design 3 component library with first-class React, Angular and Svelte support.',
  noindex,
} = Astro.props;
---

<html lang="en" class="max-[600px]:scroll-pt-16">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width" />
  <SEO
    title={title}
    titleTemplate="%s — Udixio UI"
    titleDefault="Udixio UI — Material Design 3 components for React, Angular & Svelte"
    description={description}
    noindex={noindex}
    twitter={{ card: 'summary' }}
    canonical={canonicalUrl(Astro.url.pathname, site)}
  />
  {searchFrameworks.map((framework) => <meta data-pagefind-filter="framework[content]" content={framework} />)}
  <Font cssVariable="--font-roboto" preload />
  <Font cssVariable="--font-montserrat" preload />
  <script is:inline>
    // The visitor's "Reduce motion" choice (motionPolicy.ts) applies to the whole site from the first paint. The
    // client router replaces the attributes of <html> with the incoming page's, so the choice is written there too.
    (() => {
      const apply = (root) => {
        let reduce = false;
        try {
          reduce = localStorage.getItem('udixio:docs:motion-policy') === 'reduce';
        } catch {
          // Storage may be unavailable in privacy-restricted contexts: the system preference still applies.
        }
        if (reduce) root.setAttribute('data-motion-policy', 'reduce');
      };
      apply(document.documentElement);
      if (window.__udxDocsMotionPolicy) return;
      window.__udxDocsMotionPolicy = true;
      document.addEventListener('astro:before-swap', (event) => apply(event.newDocument.documentElement));
    })();
  </script>
  <script is:inline>
    // The visitor's framework (lib/framework-choice.ts tells the contract, and keeps it in step once the page has loaded)
    // applies before the first paint: it is set on <html>, and each framework variant, framework tab and code block panel
    // is shown, hidden or selected as the parser inserts it, and each static framework link is sent to it. A
    // client-side navigation applies it to the incoming page.
    (() => {
      const FRAMEWORKS = ['html', 'react', 'angular', 'svelte'];
      const SELECTOR =
        '[data-framework-variant], [data-framework-choice], [data-code-tab], ' +
        '[data-example-panel], a[data-framework-link]';
      const list = (value) => (value || '').split(/\s+/).filter(Boolean);
      const stored = () => {
        try {
          const value = localStorage.getItem('udixio:docs:preferred-example-framework');
          return FRAMEWORKS.includes(value) ? value : 'react';
        } catch {
          return 'react';
        }
      };
      const select = (tab, selected) => {
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
      };
      const apply = (element, framework) => {
        // A static link of a neutral page names React: it goes to the chosen framework. A link inside an island is the
        // island's own, as its render: it is left as rendered.
        if (element.hasAttribute('data-framework-link')) {
          const href = element.getAttribute('href');
          if (href !== null && !element.closest('astro-island')) {
            element.setAttribute('href', href.replace(/^\/(html|react|angular|svelte)(?=\/)/, '/' + framework));
          }
          return;
        }
        if (element.hasAttribute('data-framework-variant')) {
          element.hidden = !list(element.dataset.frameworkVariant).includes(framework);
          return;
        }
        // A choice of the switch is a radio: it is checked, where a tab is selected.
        if (element.hasAttribute('data-framework-choice')) {
          const checked = element.dataset.frameworkChoice === framework;
          element.setAttribute('aria-checked', String(checked));
          element.tabIndex = checked ? 0 : -1;
          return;
        }
        // A code block shows the chosen framework when it has it, else its first one: its preview, else its code. A split
        // block (`data-code-layout="split"`) shows its code and its preview together.
        const block = element.closest('[data-code-frameworks]');
        if (!block) return;
        const frameworks = list(block.dataset.codeFrameworks);
        const shown = frameworks.includes(framework) ? framework : frameworks[0];
        if (element.hasAttribute('data-code-tab')) {
          select(element, element.dataset.framework === shown);
          return;
        }
        const view = list(block.dataset.codePreviews).includes(shown) ? 'preview' : 'code';
        const split = block.dataset.codeLayout === 'split';
        element.hidden = element.dataset.framework !== shown || (!split && element.dataset.view !== view);
      };
      const framework = stored();
      document.documentElement.dataset.docsFramework = framework;
      if (document.readyState === 'loading') {
        const observer = new MutationObserver((records) => {
          for (const record of records) {
            for (const node of record.addedNodes) {
              if (node.nodeType === 1 && node.matches(SELECTOR)) apply(node, framework);
            }
          }
        });
        observer.observe(document.documentElement, { childList: true, subtree: true });
        document.addEventListener('DOMContentLoaded', () => observer.disconnect(), { once: true });
      }
      if (window.__udxDocsFramework) return;
      window.__udxDocsFramework = true;
      document.addEventListener('astro:before-swap', (event) => {
        const next = stored();
        event.newDocument.documentElement.dataset.docsFramework = next;
        for (const element of event.newDocument.querySelectorAll(SELECTOR)) apply(element, next);
      });
    })();
  </script>
  <ClientRouter />
</head>
<body class="dark dynamic bg-surface text-on-surface" data-udx-color-keys="surface surface-dim surface-bright surface-container-lowest surface-container-low surface-container surface-container-high surface-container-highest on-surface on-surface-variant outline outline-variant inverse-surface inverse-on-surface primary primary-dim on-primary primary-container on-primary-container primary-fixed primary-fixed-dim on-primary-fixed on-primary-fixed-variant inverse-primary secondary secondary-dim on-secondary secondary-container on-secondary-container secondary-fixed secondary-fixed-dim on-secondary-fixed on-secondary-fixed-variant tertiary tertiary-dim on-tertiary tertiary-container on-tertiary-container tertiary-fixed tertiary-fixed-dim on-tertiary-fixed on-tertiary-fixed-variant error error-dim on-error error-container on-error-container surface-variant surface-tint background on-background success success-dim on-success success-container on-success-container success-fixed success-fixed-dim on-success-fixed on-success-fixed-variant">
{/*
  The first stop of the keyboard: a link to the page's content, past the navigation. A Udixio Button rendered as a link
  (no island: a link needs no script), out of view until it has the focus.
*/}
<Button
  href="#doc-content"
  variant="filled"
  label="Skip to content"
  className="fixed! top-3 left-3 z-50 not-focus-visible:sr-only"
/>
{/*
  The navigation, then the page. On a compact screen (below 600 px) the navigation is a top app bar above the page,
  sticky; from 600 px it is the rail, a column beside it. Without JavaScript the rail stays on every screen.
*/}
<div class="mx-auto flex justify-between max-[600px]:[@media(scripting:enabled)]:flex-col">
  <div class="flex sticky top-0 z-20 h-screen max-[600px]:[@media(scripting:enabled)]:h-auto" data-pagefind-ignore>
    <Navigation
      client:load
      transition:name="navigation"
      transition:persist
      componentSections={componentSections}
      pathname={Astro.url.pathname}
    />
  </div>
  <main
    id="doc-content"
    tabindex="-1"
    class="relative flex min-h-screen min-w-0 flex-1 gap-8 bg-surface-container [contain:layout] focus:outline-none"
  >

    <div class="flex-1 min-w-0">

      <slot />

    </div>

  </main>
  <div class="bg-surface-container max-lg:hidden" data-pagefind-ignore>
    {docSidebar && <Sidebar client:load mode="toc" />}
  </div>
</div>
<script >
  import { connectMotion } from '@udixio/motion';
  import '@udixio/motion/presets';
  import { runHtmlExamples } from '@/lib/html-example-runner';
  import { connectFrameworkChoice } from '@/lib/framework-choice';

  // The variants and the static links follow the stored choice on every page (framework-choice.ts).
  connectFrameworkChoice();

  // The client router swaps the body: reconnect on every page so that content
  // delivered with the page is treated as already in place.
  let disconnectMotion: (() => void) | undefined;
  /** Bumped on each swap: a page left while its HTML examples load is not connected. */
  let swaps = 0;
  document.addEventListener('astro:before-swap', () => {
    swaps++;
    disconnectMotion?.();
    disconnectMotion = undefined;
  });
  document.addEventListener('astro:page-load', async () => {
    const page = swaps;
    // The HTML examples of the page define their motions first, as their code does before its connectMotion().
    await runHtmlExamples();
    if (page !== swaps) return;
    disconnectMotion ??= connectMotion({ development: import.meta.env.DEV });
  });
</script>
<ThemeProvider client:idle transition:name="theme-provider" transition:persist />
</body>
</html>
