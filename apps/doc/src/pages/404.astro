---
import Layout from '@/layouts/layout.astro';
import { Button } from '@udixio/ui-react';
---
<Layout
  title="Page not found"
  description="The page you're looking for doesn't exist or has been moved."
  noindex
>
  <div class="flex items-center justify-center min-h-[70vh] px-8">
    <div class="text-center space-y-6">
      <h1 class="text-4xl font-extrabold tracking-tight">404 — Page not found</h1>
      <p class="text-base text-muted-foreground max-w-prose mx-auto">
        The page you are looking for does not exist or has been moved.
      </p>
      <div class="flex items-center justify-center gap-3">
        <Button href="/">Back to home</Button>
      </div>
      <p class="text-sm text-on-surface-variant">
        Search is available through the Search button in the navigation.
      </p>
    </div>
  </div>
</Layout>
