---
import Layout from '@/layouts/layout.astro';
import { getCollection } from 'astro:content';
import ComponentPreview from '@/components/ComponentPreview.astro';

export const prerender = false;

const overviews = await getCollection('overviews');
const apis = await getCollection('api');

const overviewIds = new Set(
  overviews.map((overview) => overview.id.replaceAll('overview', '')),
);

const components = apis
  .map((api) => ({
    entry: api,
    data: api.data,
  }))
  .filter(({ data }) => !data.frameworks.react.tags.parent)
  .filter(({ entry }) => overviewIds.has(entry.id))
  .map(({ entry, data }) => {
    const frameworkApi = data.frameworks.react;
    const tags = frameworkApi.tags ?? {};

    return {
      id: entry.id,
      displayName: data.displayName,
      category: tags.category ?? 'Other',
    };
  })
  .sort((a, b) => a.displayName.localeCompare(b.displayName));

const componentsByCategory = components.reduce(
  (acc, component) => {
    const group = acc[component.category] ?? [];
    group.push(component);
    acc[component.category] = group;
    return acc;
  },
  {} as Record<string, typeof components>,
);

const categories = Object.keys(componentsByCategory).sort((a, b) =>
  a.localeCompare(b),
);
---

<Layout

  title="Components"
  description="Browse all Udixio UI components — buttons, inputs, navigation, feedback and more — available for React and Angular."
>
  <div class="max-w-screen-xl mx-auto px-6 py-10">
    <div class="mb-10">
      <h1 class="text-display-large">Components</h1>
      <p class="text-headline-small mt-4 text-on-surface-variant">
        Browse all documented components and their essential dev notes.
      </p>
    </div>

    {
      categories.map((category) => (
        <section class="mb-12">
          <div class="flex items-center justify-between mb-5">
            <h2 class="text-title-large">{category}</h2>
            <span class="text-label-large text-on-surface-variant">
              {componentsByCategory[category].length} components
            </span>
          </div>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-3">
            {componentsByCategory[category].map((component) => (
              <a
                href={`/components/${component.id}/overview`}
                class="group block no-underline"
              >
                <div class="light @container relative aspect-[4/3] w-full overflow-hidden rounded-[28px] bg-surface-container-low text-on-surface transition-colors duration-200 group-hover:bg-surface-container group-focus-visible:bg-surface-container transform-gpu">
                  <div
                    class="absolute inset-0 flex items-center justify-center p-6"
                    inert
                  >
                    <ComponentPreview id={component.id} />
                  </div>
                </div>
                <h3 class="text-title-medium mt-3 px-1 text-on-surface">
                  {component.displayName}
                </h3>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Layout>
