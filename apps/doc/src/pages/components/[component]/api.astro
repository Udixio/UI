---
import { getCollection } from 'astro:content';
import Components from '@/layouts/components.astro';
import { ComponentApiHeader } from '@/components/api/ComponentApiHeader';
import { ComponentApiReference } from '@/components/api/ComponentApiReference';

export async function getStaticPaths() {
  const apis = await getCollection('api');
  return apis.map((api) => ({
    params: { component: api.id },
  }));
}

const { component } = Astro.params;
const apis = await getCollection('api');
const componentEntry = apis.find((api) => api.id === component);

if (!componentEntry) {
  return Astro.redirect('/404', 404);
}

const componentApi = componentEntry.data;
---

<Components>
  <Fragment slot="header">
    <ComponentApiHeader client:load api={componentApi} />
  </Fragment>
  <ComponentApiReference client:load api={componentApi} />
</Components>
