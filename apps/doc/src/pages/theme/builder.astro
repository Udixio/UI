---
import { ThemePicker } from '@/components/theme/ThemePicker';
import { ThemeBuilderContent } from '@/components/theme/ThemeBuilderContent';
import Layout from '@/layouts/layout.astro';
import { Sidebar, THEME_SECTIONS } from '@/components/Sidebar';
import { Card, Divider } from '@udixio/ui-react';
---
<Layout
  title="Theme Builder"
  description="Customize your Material Design 3 theme colors and preview Udixio UI components live."
>
  <Fragment slot="sidebar">
    <Sidebar
      client:load
      transition:name="theme-sidebar"
      transition:persist
      mode="nav"
      title="Theme"
      sections={THEME_SECTIONS}
      basePath="/theme"
      current="builder"
    />
  </Fragment>
  <section class="flex items-start bg-surface-container">
    <Card variant='filled' className="sticky top-0 p-8 h-screen max-w-lg flex-1 bg-surface-container overflow-auto">
      <h2 class="text-sm font-semibold text-on-surface-variant mb-3">Theme</h2>
      <ThemePicker client:load />
    </Card>
    <Divider orientation="vertical" />
    <div id="builder-scroll" class="flex-[2] overflow-y-auto h-screen">
      <ThemeBuilderContent client:only="react" />
    </div>
  </section>
</Layout>
