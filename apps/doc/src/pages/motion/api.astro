---
import DocLink from '@/components/DocLink.astro';
// The API reference of the Animation section. Its data, src/data/motion-api.json, is generated from the sources by
// scripts/motion-api.mjs (run it after changing an export or its TSDoc; `--check` fails when it is stale). The grouping by
// task, the need links, the HTML attributes and the tier of each export (ESSENTIALS, with its rule) are curated in
// scripts/motion-api.groups.mjs.
//
// Review 6, M4: the page was a wall (309 entries open, 1.4 MB of HTML). Every export stays on the page and exported;
// the presentation makes it progressive: a filter, two tiers (Essentials, then Advanced), entries folded until opened
// (an anchor opens its entry), the reader's framework first ("Written for"). The entries carry no classes of their own:
// apiStyles.ts styles them from the element around them, which keeps the page light.
import MotionPage from '@/components/MotionPage.astro';
import ApiTier from '@/components/motion/api/ApiTier.astro';
import ApiOrder from '@/components/motion/api/ApiOrder.astro';
import { ApiFilter } from '@/components/motion/api/ApiFilter';
import { apiEntriesClass, apiLinkClass } from '@/components/motion/api/apiStyles';
import { api, apiEntryCount, htmlAnchor, tierBlocks, type ApiTierBlock } from '@/lib/motionApi';

const essentials = tierBlocks('essential');
const advanced = tierBlocks('advanced');
const countOf = (blocks: ApiTierBlock[]) =>
  blocks.reduce((count, block) => count + (block.key === 'html' ? block.group.items.length : block.groups.reduce((sum, group) => sum + group.count, 0)), 0);
const frameworkLabel: Record<string, string> = { react: 'React', angular: 'Angular', svelte: 'Svelte' };
const motionEntries = api.entries.filter((entry) => !entry.adapter);

/** The index rows of a tier: one per framework, one per task of the core. */
const indexRows = (blocks: ApiTierBlock[]) =>
  blocks.flatMap((block) =>
    block.key === 'html'
      ? [{ key: 'html', id: block.group.id, title: block.group.title, links: block.group.items.map((item) => ({ href: `#${htmlAnchor(item.name)}`, name: item.name })), count: block.group.items.length }]
      : block.groups.map((group) => ({
          key: block.key,
          id: group.id,
          title: block.key === 'core' ? group.title : frameworkLabel[block.key]!,
          links: group.sections.flatMap((section) => section.symbols).map((symbol) => ({ href: `#${symbol.id}`, name: symbol.name })),
          count: group.count,
        })),
  );

const h2Class = 'mt-24 mb-4 scroll-mt-24 text-headline-small text-on-surface lg:text-headline-medium';
const leadClass = 'max-w-[65ch] text-body-large text-on-surface-variant';
const indexLabelClass = 'text-label-large text-on-surface-variant';
/** On each list of the index, for its links (set once per list, not on each of its fifty-odd links). */
const indexListClass = [
  'flex flex-wrap gap-1 [&_a]:inline-flex [&_a]:rounded-lg [&_a]:px-2 [&_a]:py-1 [&_a]:font-mono [&_a]:text-label-large',
  '[&_a]:text-on-surface-variant! [&_a]:no-underline! [&_a]:transition-colors [&_a:hover]:bg-surface-container-high [&_a:hover]:text-on-surface!',
].join(' ');
---
<MotionPage
  slug="api"
  title="Motion: API reference"
  description="Every export of @udixio/motion and of its React, Angular and Svelte adapters, in two tiers (the essentials, then the rest) and grouped by task: signature, parameters, options with their types and defaults, and the import path of each."
  frameworkSwitch
>
  <p>
    The essentials come first: what the pages of this section tell you to write. The advanced tier holds the rest, what
    they are built on. Each entry opens on its name to show its signature, its options and the page that shows it in use;
    the filter finds any of them by its name or by what it does.
  </p>
  <p>
    For agents and tools, the contract of the package is also served as JSON: <DocLink href="/motion-manifest.json">motion-manifest.json</DocLink>
    lists the verbs, their options, the presets, the tokens and the exports of each import path.
  </p>

  {/* The filter works on the page with JavaScript only: without it, it is not shown (as the framework switch). */}
  <div class="not-prose mt-10 hidden [[data-docs-framework]_&]:block" data-pagefind-ignore>
    <ApiFilter client:load total={apiEntryCount} />
  </div>

  <nav aria-label="API index" data-api-index class={`not-prose mt-6 flex flex-col gap-8 rounded-3xl bg-surface-container-low p-5 lg:p-6 ${apiLinkClass}`}>
    <div data-api-index-group>
      <p class="text-title-medium text-on-surface"><a href="#essentials" class="text-on-surface! no-underline! hover:underline!">Essentials</a></p>
      <div data-api-order class="mt-3 flex flex-col gap-3">
        {indexRows(essentials).map((row) => (
          <div data-api-framework={row.key} data-api-index-group class="grid gap-x-4 gap-y-1 sm:grid-cols-[8.5rem_1fr]">
            <p class={`${indexLabelClass} pt-1`}>{row.title}</p>
            <ul class={indexListClass}>
              {row.links.map((link) => <li><DocLink href={link.href}>{link.name}</DocLink></li>)}
            </ul>
          </div>
        ))}
      </div>
      <ApiOrder />
    </div>
    <div data-api-index-group>
      <p class="text-title-medium text-on-surface"><a href="#advanced" class="text-on-surface! no-underline! hover:underline!">Advanced</a></p>
      <p class="mt-1 text-body-medium text-on-surface-variant">What the essentials are built on, by task. The filter finds any of them by name.</p>
      <ul data-api-order class="mt-3 flex flex-wrap gap-2">
        {indexRows(advanced).map((row) => (
          <li data-api-framework={row.key}>
            <a href={`#${row.id}`} class="inline-flex items-baseline gap-2 rounded-lg bg-surface-container-high px-3 py-1.5 text-label-large text-on-surface! no-underline! transition-colors hover:bg-surface-container-highest">
              {row.title}<span data-count class="text-on-surface-variant">{row.count}</span>
            </a>
          </li>
        ))}
      </ul>
      <ApiOrder />
    </div>
  </nav>

  <div id="api-entries" class={apiEntriesClass}>
    <section data-api-filter-group aria-labelledby="essentials">
      <h2 id="essentials" class={h2Class}>Essentials</h2>
      <p class={leadClass}>
        The {countOf(essentials)} exports and attributes the pages of this section tell you to write: your framework's, then
        those of <code>@udixio/motion</code> by task, then the other frameworks'.
      </p>
      <ApiTier tier="essential" />
    </section>
    <section data-api-filter-group aria-labelledby="advanced">
      <h2 id="advanced" class={h2Class}>Advanced</h2>
      <p class={leadClass}>
        The {countOf(advanced)} others: the types of the options, the registries and resolvers, the handles, the frames and
        the providers the essentials are built on, the geometry of layout, and the tooling for engines and tests.
      </p>
      <ApiTier tier="advanced" />
    </section>
  </div>

  <h2 id="entries">Import paths</h2>
  <p>
    <code>@udixio/motion</code> holds what a page needs to attach motions; the other import paths are loaded on demand, so a
    page that does not use them does not download them. Each entry above names the import path it comes from.
  </p>
  <div class={`not-prose overflow-x-auto rounded-2xl bg-surface-container-low ${apiLinkClass}`}>
    <table class="w-full min-w-[40rem] border-collapse text-left">
      <caption class="sr-only">The import paths of @udixio/motion and their exports</caption>
      <thead>
        <tr class="text-label-large text-on-surface-variant">
          <th scope="col" class="px-4 py-3 font-normal">Import path</th>
          <th scope="col" class="px-4 py-3 font-normal">Exports</th>
        </tr>
      </thead>
      <tbody class="text-body-small text-on-surface-variant [&_code]:font-mono [&_td_a]:font-mono [&_th>code]:text-body-medium [&_th>code]:text-on-surface [&>tr]:border-t [&>tr]:border-outline-variant [&>tr]:align-top [&_td]:px-4 [&_td]:py-3 [&_th]:px-4 [&_th]:py-3 [&_th]:whitespace-nowrap [&_th]:text-left [&_th]:font-normal">
        {motionEntries.map((entry) => (
          <tr>
            <th scope="row"><code>{entry.entry}</code></th>
            <td>{entry.exports.map((name, index) => <>{index > 0 && ', '}<a href={`#api-${name}`}>{name}</a></>)}</td>
          </tr>
        ))}
        {api.files.map((file) => (
          <tr>
            <th scope="row"><code>{file.entry}</code></th>
            <td>
              {file.entry.endsWith('.css')
                ? 'The stylesheet: the tokens as CSS variables, --udx-motion-scale and the reduced-motion policy. Import it once per document.'
                : file.entry.endsWith('package.json') ? 'The package manifest.' : 'The contract of the package as JSON: verbs, options, presets, tokens and exports.'}
              {file.entry.endsWith('motion-manifest.json') && <> Also served as <DocLink href="/motion-manifest.json">/motion-manifest.json</DocLink>.</>}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</MotionPage>
<script>
  import { connectApiPage } from '@/components/motion/api/apiPage';

  document.addEventListener('astro:page-load', connectApiPage);
</script>
