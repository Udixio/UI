---
import Layout from '@/layouts/layout.astro';
import Header from '@/components/motion/root/Header.astro';
import SectionBar from '@/components/motion/root/SectionBar.astro';
import Section from '@/components/motion/root/Section.astro';
import NeedTile from '@/components/motion/NeedTile.astro';
import Inbox from '@/components/motion/scenes/Inbox.astro';
import Presence from '@/components/motion/scenes/Presence.astro';
import { MOTION_NEEDS, MOTION_ROOT_SECTIONS } from '@/lib/motion-nav';
import { chipClass, segmentedClass } from '@/components/motionDemo';

/** The needs of each section, its feature tile first. */
const sections = MOTION_ROOT_SECTIONS.map((section) => ({
  ...section,
  needs: MOTION_NEEDS.filter((need) => need.section === section.section).sort(
    (a, b) => Number(b.feature ?? false) - Number(a.feature ?? false),
  ),
}));

const origins = [
  ['first', 'First'],
  ['center', 'Center'],
  ['last', 'Last'],
] as const;
const presets = ['fade', 'slide', 'scale'] as const;

/** The controls of a stage: compact, so that a tile's row of controls holds on one line. */
const focusRing = 'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-surface';
const filledButton = `h-10 rounded-full bg-primary px-5 text-label-large text-on-primary transition-shadow hover:shadow-md ${focusRing}`;
const tonalButton = `h-10 rounded-full bg-secondary-container px-5 text-label-large text-on-secondary-container transition-shadow hover:shadow-md ${focusRing}`;
const segmentButton =
  'h-10 px-3 text-label-large text-on-surface transition-colors hover:bg-surface-container-highest aria-pressed:bg-secondary-container aria-pressed:text-on-secondary-container focus-visible:-outline-offset-2 focus-visible:outline-2 focus-visible:outline-on-surface [&+&]:border-l [&+&]:border-outline';
---
<Layout
  title="Animation"
  description="What @udixio/motion does, need by need: a live example of each, its code in HTML, React, Angular and Svelte, and a link to its page."
>
  <div class="motion-root">
    <div class="motion-page">
      <Header />
      <SectionBar />

      {sections.map((section) => (
        <Section id={section.id}>
          {section.needs.map((need) => {
            if (need.slug === 'lists') {
              return (
                <NeedTile slug="lists" hint="Swipe a message away, or focus it and press Delete.">
                  <Fragment slot="controls">
                    <div class="flex flex-wrap gap-2">
                      <button type="button" class={filledButton} data-inbox-add="1">Add one</button>
                      <button type="button" class={tonalButton} data-inbox-add="3">Add three</button>
                    </div>
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                      <div class={segmentedClass} role="group" aria-label="Cascade origin">
                        {origins.map(([origin, label]) => (
                          <button
                            type="button"
                            class={segmentButton}
                            aria-pressed={String(origin === 'first')}
                            data-inbox-origin={origin}
                          >{label}</button>
                        ))}
                      </div>
                      <code class={`${chipClass} tracking-normal`} data-inbox-readout>origin: 'first'</code>
                    </div>
                  </Fragment>
                  <Inbox />
                </NeedTile>
              );
            }
            if (need.slug === 'presence') {
              return (
                <NeedTile slug="presence" hint="Pick a preset, then Hide and Show.">
                  <Fragment slot="controls">
                    <button
                      type="button"
                      id="presence-tile-toggle"
                      class={`${filledButton} min-w-[5.5rem]`}
                      aria-expanded="true"
                      aria-controls="presence-tile-card"
                      data-presence-toggle
                    >Hide</button>
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                      <div class={segmentedClass} role="group" aria-label="Preset">
                        {presets.map((preset) => (
                          <button
                            type="button"
                            class={segmentButton}
                            aria-pressed={String(preset === 'slide')}
                            data-presence-preset={preset}
                          >{preset}</button>
                        ))}
                      </div>
                      <code class={`${chipClass} tracking-normal`} data-presence-readout>data-motion="slide"</code>
                    </div>
                  </Fragment>
                  <Presence id="presence-tile-card" toggleId="presence-tile-toggle" />
                </NeedTile>
              );
            }
            return <NeedTile slug={need.slug} />;
          })}
        </Section>
      ))}
    </div>
    <p class="sr-only" role="status" aria-live="polite" data-code-status></p>
    <script is:inline>
      // The visitor's framework, chosen once for the site, is shown in every tile before the first paint (root/tabs.ts
      // keeps it in step afterwards).
      (() => {
        let framework;
        try {
          framework = localStorage.getItem('udixio:docs:preferred-example-framework');
        } catch {
          return;
        }
        if (!['html', 'angular', 'svelte'].includes(framework)) return;
        for (const group of document.querySelectorAll('[data-code-tabs]')) {
          if (!group.querySelector(`[role="tab"][data-framework="${framework}"]`)) continue;
          for (const tab of group.querySelectorAll('[role="tab"]')) {
            const selected = tab.dataset.framework === framework;
            tab.setAttribute('aria-selected', String(selected));
            tab.tabIndex = selected ? 0 : -1;
            tab.querySelector('[data-motion-shared]').hidden = !selected;
          }
          for (const panel of group.querySelectorAll('[role="tabpanel"]')) panel.hidden = panel.dataset.framework !== framework;
          const label = { html: 'HTML', angular: 'Angular', svelte: 'Svelte' }[framework];
          group.querySelector('[data-code-copy]')?.setAttribute('aria-label', `Copy ${label} code`);
        }
      })();
    </script>
  </div>
</Layout>


<script>
  import '@/components/motion/scenes/loader';
  import '@/components/motion/root/tabs';
</script>

<style>
  /* Every breakpoint of the page is a container query on this root: the page sits beside the rail and the side panel. */
  .motion-root {
    container: motion-root / inline-size;
  }

  .motion-page {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 32px 120px;
  }

  @container motion-root (max-width: 559px) {
    .motion-page {
      padding: 0 16px 96px;
    }
  }
</style>
