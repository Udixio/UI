---
import Layout from '@/layouts/layout.astro';
import Hero from '@/components/motion/root/Hero.astro';
import Principle from '@/components/motion/root/Principle.astro';
import Gallery from '@/components/motion/root/Gallery.astro';
import Facts from '@/components/motion/root/Facts.astro';
---
<Layout
  title="Animation"
  description="@udixio/motion: define a motion once, attach it by name in HTML, React, Angular or Svelte. A live example, the principle in four frameworks, every need with its page, the browsers and the weight."
>
  {/*
    The page shows @udixio/motion on itself, with restraint: the hero's player opens and closes by itself (scenes/player.ts),
    the sections below rise into view with the `rise` preset (data-motion), and the gallery's previews play as their cards
    enter. Every breakpoint of the page is a container query on its root (`@container/motion-root`): the page sits beside
    the rail and the side panel. One section per line.
  */}
  <div class="motion-root @container/motion-root">
    <div class="motion-page mx-auto grid max-w-270 gap-24 px-8 pb-30 @max-[560px]/motion-root:gap-18 @max-[560px]/motion-root:px-4 @max-[560px]/motion-root:pb-24">
      <Hero />
      <Principle />
      <Gallery />
      <Facts />
    </div>
    <p class="sr-only" role="status" aria-live="polite" data-code-status></p>
    <script is:inline>
      // The visitor's framework, chosen once for the site, is shown before the first paint (root/framework.ts keeps it in
      // step afterwards): the install command, the principle's tabs and its result.
      (() => {
        let framework;
        try {
          framework = localStorage.getItem('udixio:docs:preferred-example-framework');
        } catch {
          return;
        }
        if (!['html', 'angular', 'svelte'].includes(framework)) return;
        for (const variant of document.querySelectorAll('[data-framework-variant]')) {
          variant.hidden = variant.dataset.frameworkVariant !== framework;
        }
        for (const group of document.querySelectorAll('[data-code-tabs]')) {
          for (const tab of group.querySelectorAll('[role="tab"]')) {
            const selected = tab.dataset.framework === framework;
            tab.setAttribute('aria-selected', String(selected));
            tab.tabIndex = selected ? 0 : -1;
            tab.querySelector('[data-motion-shared]').hidden = !selected;
          }
          for (const panel of group.querySelectorAll('[role="tabpanel"]')) panel.hidden = panel.dataset.framework !== framework;
          const select = group.querySelector('[data-code-select]');
          if (select) select.value = framework;
          const label = { html: 'HTML', angular: 'Angular', svelte: 'Svelte' }[framework];
          group.querySelector('[data-code-copy]')?.setAttribute('aria-label', `Copy the ${label} code`);
        }
      })();
    </script>
  </div>
</Layout>

<script>
  import '@/components/motion/scenes/loader';
  import '@/components/motion/root/framework';
</script>
