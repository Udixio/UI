---
import Layout from '@/layouts/layout.astro';
import Header from '@/components/motion/root/Header.astro';
import SectionBar from '@/components/motion/root/SectionBar.astro';
import Section from '@/components/motion/root/Section.astro';
import NeedTile from '@/components/motion/NeedTile.astro';
import Inbox from '@/components/motion/scenes/Inbox.astro';
import InboxControls from '@/components/motion/scenes/InboxControls.astro';
import Presence from '@/components/motion/scenes/Presence.astro';
import PresenceControls from '@/components/motion/scenes/PresenceControls.astro';
import Emphasis from '@/components/motion/scenes/Emphasis.astro';
import Resize from '@/components/motion/scenes/Resize.astro';
import ResizeControls from '@/components/motion/scenes/ResizeControls.astro';
import Gallery from '@/components/motion/scenes/Gallery.astro';
import GalleryControls from '@/components/motion/scenes/GalleryControls.astro';
import { MOTION_NEEDS, MOTION_ROOT_SECTIONS } from '@/lib/motion-nav';

/** The needs of each section, its feature tile first. */
const sections = MOTION_ROOT_SECTIONS.map((section) => ({
  ...section,
  needs: MOTION_NEEDS.filter((need) => need.section === section.section).sort(
    (a, b) => Number(b.feature ?? false) - Number(a.feature ?? false),
  ),
}));
---
<Layout
  title="Animation"
  description="What @udixio/motion does, need by need: a live example of each, its code in HTML, React, Angular and Svelte, and a link to its page."
>
  <div class="motion-root">
    <div class="motion-page">
      <Header />
      <SectionBar />

      {sections.map((section) => (
        <Section id={section.id}>
          {section.needs.map((need) => {
            if (need.slug === 'lists') {
              return (
                <NeedTile slug="lists" hint="Swipe a message away, or focus it and press Delete.">
                  <Fragment slot="controls"><InboxControls /></Fragment>
                  <Inbox />
                </NeedTile>
              );
            }
            if (need.slug === 'presence') {
              return (
                <NeedTile slug="presence" hint="Pick a preset, then Hide and Show.">
                  <Fragment slot="controls"><PresenceControls toggleId="presence-tile-toggle" cardId="presence-tile-card" /></Fragment>
                  <Presence id="presence-tile-card" toggleId="presence-tile-toggle" />
                </NeedTile>
              );
            }
            if (need.slug === 'emphasis') {
              return (
                <NeedTile slug="emphasis" hint="Try 0000, then press Check or Enter.">
                  <Emphasis />
                </NeedTile>
              );
            }
            if (need.slug === 'layout') {
              return (
                <NeedTile slug="layout" hint="Widen the card, or shuffle the list.">
                  <Fragment slot="controls"><ResizeControls /></Fragment>
                  <Resize />
                </NeedTile>
              );
            }
            if (need.slug === 'shared-elements') {
              return (
                <NeedTile slug="shared-elements" hint="Open a thumbnail; Escape closes it.">
                  <Fragment slot="controls"><GalleryControls /></Fragment>
                  <Gallery />
                </NeedTile>
              );
            }
            return <NeedTile slug={need.slug} />;
          })}
        </Section>
      ))}
    </div>
    <p class="sr-only" role="status" aria-live="polite" data-code-status></p>
    <script is:inline>
      // The visitor's framework, chosen once for the site, is shown in every tile before the first paint (root/tabs.ts
      // keeps it in step afterwards).
      (() => {
        let framework;
        try {
          framework = localStorage.getItem('udixio:docs:preferred-example-framework');
        } catch {
          return;
        }
        if (!['html', 'angular', 'svelte'].includes(framework)) return;
        for (const group of document.querySelectorAll('[data-code-tabs]')) {
          if (!group.querySelector(`[role="tab"][data-framework="${framework}"]`)) continue;
          for (const tab of group.querySelectorAll('[role="tab"]')) {
            const selected = tab.dataset.framework === framework;
            tab.setAttribute('aria-selected', String(selected));
            tab.tabIndex = selected ? 0 : -1;
            tab.querySelector('[data-motion-shared]').hidden = !selected;
          }
          for (const panel of group.querySelectorAll('[role="tabpanel"]')) panel.hidden = panel.dataset.framework !== framework;
          const label = { html: 'HTML', angular: 'Angular', svelte: 'Svelte' }[framework];
          group.querySelector('[data-code-copy]')?.setAttribute('aria-label', `Copy ${label} code`);
        }
      })();
    </script>
  </div>
</Layout>


<script>
  import '@/components/motion/scenes/loader';
  import '@/components/motion/root/tabs';
</script>

<style>
  /* Every breakpoint of the page is a container query on this root: the page sits beside the rail and the side panel. */
  .motion-root {
    container: motion-root / inline-size;
  }

  .motion-page {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 32px 120px;
  }

  @container motion-root (max-width: 559px) {
    .motion-page {
      padding: 0 16px 96px;
    }
  }
</style>
