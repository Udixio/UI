---
import Layout from '@/layouts/layout.astro';
import Hero from '@/components/motion/root/Hero.astro';
import Principle from '@/components/motion/root/Principle.astro';
import Gallery from '@/components/motion/root/Gallery.astro';
import Facts from '@/components/motion/root/Facts.astro';
import Components from '@/components/motion/root/Components.astro';
---
<Layout
  title="Animation"
  description="@udixio/motion: Material 3 motion, the same in HTML, React, Angular and Svelte. Define a motion once and attach it by name; the runtime takes care of reduced motion and focus. A live example, the principle in four frameworks, every need with its page."
>
  {/*
    The page shows @udixio/motion on itself, with restraint: the hero's player opens and closes by itself (scenes/player.ts),
    the sections below rise into view with the `rise` preset (data-motion), real Udixio components play their own motion
    (root/Components.astro), and the gallery's previews play as their cards enter. Every breakpoint of the page is a container query on its root (`@container/motion-root`): the page sits beside
    the rail and the side panel. One section per line.
  */}
  <div class="motion-root @container/motion-root">
    <div class="motion-page mx-auto grid max-w-270 gap-24 px-8 pb-30 @max-[560px]/motion-root:gap-18 @max-[560px]/motion-root:px-4 @max-[560px]/motion-root:pb-24">
      <Hero />
      <Principle />
      <Components />
      <Gallery />
      <Facts />
    </div>
    <script is:inline>
      // The copy button of the principle is named after the visitor's framework before its island hydrates. The layout's head
      // script shows the principle's tabs, panels and results before the first paint; the copy button is the one thing it
      // does not reach.
      (() => {
        let framework;
        try {
          framework = localStorage.getItem('udixio:docs:preferred-example-framework');
        } catch {
          return;
        }
        if (!['html', 'angular', 'svelte'].includes(framework)) return;
        const label = { html: 'HTML', angular: 'Angular', svelte: 'Svelte' }[framework];
        document.querySelector('[data-code-tabs] [data-code-copy]')?.setAttribute('aria-label', `Copy the ${label} code`);
      })();
    </script>
  </div>
</Layout>

<script>
  import '@/components/motion/scenes/loader';
  import '@/components/motion/root/framework';
</script>
