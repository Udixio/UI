                <td class={componentTd}>{parts(row.box).map((part) => (part.code ? <code class={componentCode}>{part.value}</code> : part.value))}</td>
                <td class={componentTd}>{parts(row.ref).map((part) => (part.code ? <code class={componentCode}>{part.value}</code> : part.value))}</td>
                <td class={componentTd}>{row.holds ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Fragment>
    <Fragment>
      <p>
        A motion on a Udixio component moves the box in the second column. A kind in the last column is the component's own:
        a motion of that kind on that element is ignored.
      </p>
      <div class="not-prose overflow-x-auto">
        <table class="w-full min-w-[32rem] border-collapse text-body-medium">
          <caption class="sr-only">Each Udixio component: the element a motion moves, and the kinds it holds</caption>
          <thead>
            <tr>
              <th scope="col" class={componentTh}>Component</th>
              <th scope="col" class={componentTh}>What a motion moves</th>
              <th scope="col" class={componentTh}>Kinds it holds</th>
