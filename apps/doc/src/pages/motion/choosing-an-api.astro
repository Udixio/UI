---
import MotionPage from '@/components/MotionPage.astro';
import ForFramework from '@/components/ForFramework.astro';
import ApiName from '@/components/ApiName.astro';
import Code from '@/components/Code.astro';
import MotionUsage from '@/components/motion/MotionUsage.astro';
import { glossaryHref } from '@/lib/motion-glossary';

// A decision is a list of choices: each card names the API, when to take it, and why.
const choices = 'not-prose my-6 grid grid-cols-[repeat(auto-fit,minmax(min(100%,15rem),1fr))] gap-4';
const card =
  'flex flex-col gap-3 rounded-3xl bg-surface-container-low p-5 text-body-medium text-on-surface-variant [&_code]:rounded [&_code]:bg-surface-container-highest [&_code]:px-1 [&_code]:font-mono [&_code]:text-on-surface [&_p_a]:text-primary [&_p_a]:underline [&_p_a]:underline-offset-4';
const cardTitle = 'font-mono text-title-medium text-on-surface';
const cardLabel = 'text-label-large text-on-surface';
// The header cells of a table: the theme's text colour, in light and dark.
const th = 'text-label-large text-on-surface';
const cardLink =
  'mt-auto self-start text-label-large text-primary underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-surface';

const fieldOrStyle = `import { defineMotion } from '@udixio/motion';
import { animateStyle } from '@udixio/motion/animate';

const card = document.getElementById('card') as HTMLElement;

// A motion field: name the motion once, and attach it by its name wherever the card enters.
defineMotion('card-enter', {
  verb: 'appear',
  keyframes: [{ opacity: 0, y: 24 }, { opacity: 1, y: 0 }],
});

// Any CSS property: call animateStyle on the element you hold, when you want it to play.
animateStyle(card, { backgroundColor: 'var(--color-tertiary-container)' }, {
  timing: 'spring.default.effects',
});`;

const ownDefinition = `import { defineMotion } from '@udixio/motion';

// Named after what it is for: the keyframes can change, the name stays.
export const toastEnter = defineMotion('toast-enter', {
  verb: 'appear',
  keyframes: [{ opacity: 0, y: 64 }, { opacity: 1, y: 0 }],
  timing: 'spring.fast.spatial',
  exit: 'out-of-flow',
});`;

const pauseByHand = `import { animateStyle, type MotionHandle } from '@udixio/motion/animate';
import { watchActive } from '@udixio/motion/active';

const badge = document.getElementById('badge') as HTMLElement;
// Play the loop only while the badge is in view, in a shown tab, with motion not reduced.
let glow: MotionHandle | undefined;
const stop = watchActive(badge, (active) => {
  glow?.cancel();
  glow = active
    ? animateStyle(badge, [{ opacity: 1 }, { opacity: 0.6 }, { opacity: 1 }], {
        timing: { duration: 3000, easing: 'ease-in-out' },
        iterations: Infinity,
      })
    : undefined;
});
// When the badge leaves the page: stop(); glow?.cancel();`;

const cascades = `import { defineMotion } from '@udixio/motion';
import { animateStyle, staggerCap, staggerDelay, staggerStep } from '@udixio/motion/animate';

// The option: the items of one definition that enter together cascade, in visual order.
defineMotion('row-enter', {
  verb: 'appear',
  keyframes: [{ opacity: 0, y: 16 }, { opacity: 1, y: 0 }],
  stagger: 'tight',
  origin: 'first',
});

// The functions: your own animation, your own order. The tokens come from the computed style.
const list = document.getElementById('list') as HTMLElement;
const style = getComputedStyle(list);
([...list.children] as HTMLElement[]).forEach((item, rank) => {
  animateStyle(item, { backgroundColor: 'var(--color-surface-container-high)' }, {
    delay: staggerDelay(rank, staggerStep(style, 'normal'), staggerCap(style)),
    timing: 'spring.default.effects',
  });
});`;

// What each Udixio component gives a motion: its box (the element the motion moves, React and Angular alike; a different
// element in Svelte is said), where React's `ref` lands, and the kinds the component holds itself (reserveMotion). Checked
// against packages/ui-react/src/lib/components, the Angular hosts (data-motion-box) and the Svelte rest-props spread.
type ComponentBox = { name: string; box: string; ref: string; holds?: string };
const ROOT = 'Its root';
const componentBoxes: readonly ComponentBox[] = [
  { name: 'Badge', box: 'Its root, around the anchor and the badge', ref: ROOT },
  { name: 'Button', box: 'Its `<button>`, or its `<a>` with `href`', ref: ROOT },
  { name: 'Card', box: 'Its root, a `<div>`, or an `<a>` with `href`', ref: ROOT },
  { name: 'Carousel', box: 'Its root', ref: ROOT },
  { name: 'CarouselItem', box: 'Its root', ref: ROOT },
  { name: 'Checkbox', box: 'Its root, around the input. Svelte: its `<input>`', ref: 'Its `<input>`' },
  { name: 'Chip', box: 'Its `<button>`, or its `<a>` with `href`', ref: ROOT },
  { name: 'Chips', box: 'Its root, the list', ref: 'Not forwarded' },
  { name: 'ContextMenu', box: 'None: it has no box to give', ref: 'Not forwarded', holds: 'Presence of its menu, in the top layer' },
  { name: 'DatePicker', box: 'Its root', ref: ROOT, holds: 'Emphasis of its month grid, inside' },
  { name: 'Divider', box: 'Its `<hr>`', ref: ROOT },
  { name: 'Fab', box: 'Its `<button>`, or its `<a>` with `href`', ref: ROOT },
  { name: 'FabMenu', box: 'Its root', ref: ROOT, holds: 'Presence of its panel and actions, layout of its trigger, inside' },
  { name: 'IconButton', box: 'Its `<button>`, or its `<a>` with `href`', ref: ROOT },
  { name: 'Menu', box: 'Its root, the list of items', ref: ROOT },
  { name: 'MenuItem', box: 'Its `<button>`, or its `<a>` with `href`', ref: ROOT },
  { name: 'MenuSubmenu', box: 'Its trigger item', ref: 'Not forwarded', holds: 'Presence of its submenu, in the top layer' },
  { name: 'NavigationRail', box: 'Its root', ref: 'Not forwarded', holds: 'Layout' },
  { name: 'NavigationRailItem', box: 'Its `<button>`, or its `<a>` with `href`', ref: ROOT },
  { name: 'ProgressIndicator', box: 'Its root, a `<div>` or an `<svg>`', ref: ROOT },
  { name: 'Search', box: 'Its root', ref: 'Its `<input>`', holds: 'Presence and layout of its results, inside' },
  { name: 'SideSheet', box: 'Its panel. Modal, in React and Angular: none, it has no box to give', ref: 'Not forwarded', holds: 'Presence and layout' },
  { name: 'Slider', box: 'Its root', ref: ROOT },
  { name: 'Snackbar', box: 'Its root, the panel', ref: 'Not forwarded', holds: 'Presence' },
  { name: 'SplitButton', box: 'Its root, the group', ref: ROOT },
  { name: 'Switch', box: 'Its root, the switch itself', ref: ROOT },
  { name: 'Tab', box: 'Its `<button>`, or its `<a>` with `href`', ref: ROOT },
  { name: 'TabPanel', box: 'Its root, the panel', ref: 'Set by TabPanels', holds: 'Presence' },
  { name: 'Tabs', box: 'Its root, the tab list', ref: 'Not forwarded' },
  { name: 'TextField', box: 'Its root, around the outline', ref: 'Its `<input>` or `<textarea>`' },
  { name: 'Toolbar', box: 'Its root', ref: ROOT },
  { name: 'Tooltip', box: 'React: none, it has no box to give. Angular and Svelte: a directive or an attachment on your own element, which stays its box', ref: 'Not forwarded', holds: 'Presence and layout of its surface' },
];
// The cells of the components table, as the tables of How it works draw them.
const componentTh = 'border-b border-outline-variant px-3 py-3 text-left align-bottom text-label-large text-on-surface';
const componentTd = 'border-b border-outline-variant px-3 py-3 align-top text-body-medium text-on-surface-variant';
const componentCode = 'rounded bg-surface-container-highest px-1 py-0.5 font-mono text-body-small text-on-surface';
/** Text with inline code between backticks, as parts to render. */
const parts = (text: string) => text.split('`').map((value, index) => ({ value, code: index % 2 === 1 }));
---
<MotionPage
  slug="choosing-an-api"
  title="Motion: choosing an API"
  description="When two parts of @udixio/motion answer the same need, which one to take: a named motion or animateStyle, the element or a component, removing or keeping, a preset or a definition, a loop, a scroll effect, a cascade, a replay."
  frameworkSwitch
>
  <ForFramework as="span" slot="summary">
    <Fragment slot="html">Some needs have two or more answers in the library. For each one, this page tells you which to take, and what you gain or lose: a named motion or <code>animateStyle()</code>, a loop, a scroll effect, a cascade, a replay.</Fragment>
    <Fragment slot="react">Some needs have two or more answers in the library. For each one, this page tells you which to take, and what you gain or lose: a named motion or <code>animateStyle()</code>, <code>&lt;Motion&gt;</code> or <code>useMotion</code>, <code>&lt;Presence&gt;</code> or <code>present</code>, a loop, a scroll effect, a replay.</Fragment>
    <Fragment slot="angular">Some needs have two or more answers in the library. For each one, this page tells you which to take, and what you gain or lose: a named motion or <code>animateStyle()</code>, <code>&#64;if</code> or <code>[udxMotionPresent]</code>, a loop, a scroll effect, a cascade, a replay.</Fragment>
    <Fragment slot="svelte">Some needs have two or more answers in the library. For each one, this page tells you which to take, and what you gain or lose: a named motion or <code>animateStyle()</code>, <code>transition:presence</code> or <code>present</code>, a loop, a scroll effect, a cascade, a replay.</Fragment>
  </ForFramework>

  <p>
    Find what you want in the table, and take the API it names. Each row leads to its section, which says why, and what you
    gain or lose. If a word is new to you, its definition is in the <a href="/motion/glossary">Glossary</a>.
  </p>
  <div>
    <!-- Below md, each row stacks: what you want, then what to take, full width. -->
    <table class="max-md:block max-md:[&_tbody]:block max-md:[&_tr]:block max-md:[&_tr]:py-3 max-md:[&_td]:block max-md:[&_td]:p-0! max-md:[&_td+td]:mt-1 max-md:[&_thead]:sr-only">
      <caption class="sr-only">What you want, and the API to take</caption>
      <thead><tr><th scope="col" class={th}>I want…</th><th scope="col" class={th}>Take…</th></tr></thead>
      <tbody>
        <tr>
          <td><a href="#motion-or-animate-style">To fade, move, scale or turn an element, or to animate another CSS property</a></td>
          <td>A named motion, <code>defineMotion()</code>, for opacity, position, scale and rotation. <code>animateStyle()</code> for any other property, such as a colour.</td>
        </tr>
        <tr>
          <td><a href="#element-or-component">To put a motion on an element, or on a Udixio component</a></td>
          <td>
            <ForFramework as="span">
              <Fragment slot="html"><code>data-motion</code> on the element itself. On a wrapper you cannot remove, <code>data-motion-box="child"</code> as well.</Fragment>
              <Fragment slot="react"><code>&lt;Motion&gt;</code> for an element or a component you can render through it, such as <code>&lt;Motion as=&#123;Button&#125;&gt;</code>. <code>useMotion()</code> for an element you already render.</Fragment>
              <Fragment slot="angular"><code>udxMotion</code> on the element, or on the component's own tag, such as <code>&lt;udx-button udxMotion&gt;</code>.</Fragment>
              <Fragment slot="svelte"><code>motion()</code> on the element, or on the component itself, such as <code>&lt;Button &#123;&#64;attach motion()&#125;&gt;</code>.</Fragment>
            </ForFramework>
          </td>
        </tr>
        <tr>
          <td><a href="#remove-or-keep">An element to leave the DOM after its exit, or to stay in it</a></td>
          <td>
            <ForFramework as="span">
              <Fragment slot="html">Remove it after <code>setPresent(false)</code> for a toast or a dialog. <code>hidden</code> for a menu or a panel that must stay indexed.</Fragment>
              <Fragment slot="react"><code>&lt;Presence&gt;</code> for a toast or a dialog. <code>present</code> for a menu or a panel that must stay indexed.</Fragment>
              <Fragment slot="angular"><code>&#64;if</code> for a toast or a dialog. <code>[udxMotionPresent]</code> for a menu or a panel that must stay indexed.</Fragment>
              <Fragment slot="svelte"><code>&#123;#if&#125;</code> with <code>transition:presence</code> for a toast or a dialog. <code>present</code> for a menu or a panel that must stay indexed.</Fragment>
            </ForFramework>
          </td>
        </tr>
        <tr>
          <td><a href="#preset-or-definition">A ready-made motion, or my own</a></td>
          <td>A preset when one of the thirteen does what you need. <code>defineMotion()</code> for other keyframes, timing or options.</td>
        </tr>
        <tr>
          <td><a href="#loops">Something to repeat forever</a></td>
          <td>The verb <code>loop</code> for the motion fields. <code>animateStyle()</code> with <code>iterations: Infinity</code> for another property. A time value for a number your CSS uses.</td>
        </tr>
        <tr>
          <td><a href="#scroll">Something to happen with the scroll</a></td>
          <td>The verb <code>reveal</code> to enter as it comes into view, <code>scrub</code> to follow the scroll position, <code>scrollTo()</code> to move the scroll, a scroll value for a number your CSS uses.</td>
        </tr>
        <tr>
          <td><a href="#cascade">Items to start one after another</a></td>
          <td>The <code>stagger</code> option of the motion. <code>staggerDelay()</code> for your own code.</td>
        </tr>
        <tr>
          <td><a href="#replay">To replay a motion on demand</a></td>
          <td>
            <ForFramework as="span">
              <Fragment slot="html">A new <code>data-motion-state</code>, or <code>getMotion(element, kind)?.play()</code> from a control.</Fragment>
              <Fragment slot="react">A new <code>state</code>, or <code>play(kind?)</code> from <code>motionRef</code> (or <code>useMotion()</code>) for a control.</Fragment>
              <Fragment slot="angular">A new <code>[udxMotionState]</code>, or <code>play(kind?)</code> on the directive (<code>#m="udxMotion"</code>) for a control.</Fragment>
              <Fragment slot="svelte">A new <code>state</code> option, or <code>getMotion(element, kind)?.play()</code> from a control.</Fragment>
            </ForFramework>
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2 id="motion-or-animate-style">Animate a motion field, or any CSS property</h2>
  <p>
    A named <a href={glossaryHref('motion')}>motion</a> animates nine fields: <code>opacity</code>, <code>x</code>,
    <code>y</code>, <code>scale</code>, <code>scaleX</code>, <code>scaleY</code>, <code>rotate</code>, and
    <code>draw</code> and <code>along</code> for SVG. That is its limit. <code>animateStyle()</code> animates any CSS
    property: it is the way out when you need a colour, a radius, a size or a custom property.
  </p>
  <ul class={choices}>
    <li class={card}>
      <h3 class={cardTitle}>defineMotion()</h3>
      <p><span class={cardLabel}>Take it when</span> the element fades, moves, scales or turns, and it enters, leaves, replays, reveals, loops or follows the scroll.</p>
      <p><span class={cardLabel}>Because</span> the motion gets a name that you attach in markup, and the runtime starts it, cascades it and reduces it for you.</p>
      <a class={cardLink} href="/motion/presets">Define a motion</a>
    </li>
    <li class={card}>
      <h3 class={cardTitle}>animateStyle()</h3>
      <p><span class={cardLabel}>Take it when</span> you animate another property, such as <code>backgroundColor</code>, <code>borderRadius</code>, <code>width</code> or <code>--x</code>, from your own code.</p>
      <p><span class={cardLabel}>Because</span> it takes any CSS, and the same timing tokens. You call it, and you get a <a href={glossaryHref('handle')}>handle</a> back.</p>
      <a class={cardLink} href="/motion/animate">Animate any CSS</a>
    </li>
  </ul>
  <p>Here is what each side gives you:</p>
  <div class="overflow-x-auto">
    <table class="min-w-[36rem]">
      <thead><tr><th class={th}><span class="sr-only">Aspect</span></th><th class={th}>A named motion</th><th class={th}><code>animateStyle()</code></th></tr></thead>
      <tbody>
        <tr><td>Properties</td><td>The nine motion fields</td><td>Any CSS property. A custom property needs <code>@property</code></td></tr>
        <tr><td>How you attach it</td><td>By its name, in the markup of every framework</td><td>You call it on an element you hold</td></tr>
        <tr><td>What starts it</td><td>Its verb: a presence, a new state, the view, the scroll, the layout</td><td>Your call</td></tr>
        <tr><td>Enter and leave</td><td>The exit plays before the element goes, and the element is <code>inert</code> meanwhile</td><td>No presence: it does not know if the element is shown</td></tr>
        <tr><td>Several on one element</td><td>One of each <a href={glossaryHref('kind')}>kind</a></td><td>A new call on the same properties cancels the one before</td></tr>
        <tr><td>Cascade</td><td>The <code>stagger</code> option</td><td><code>staggerDelay()</code> in the <code>delay</code> option</td></tr>
        <tr><td>Reduced motion</td><td>Each verb has its reduced form: a fade, the end frame, a still loop</td><td>The <code>reduced</code> frame, chosen when you call it</td></tr>
        <tr><td><code>--udx-motion-scale</code></td><td>Scales the duration and the distances</td><td>Scales the duration only</td></tr>
        <tr><td>Timing</td><td>A spring token or a curve, <code>&#123; duration, easing &#125;</code>, as the verb allows; each verb has a default</td><td>A spring token or a curve</td></tr>
      </tbody>
    </table>
  </div>
  <p>
    If an element must enter with a colour change, give it a named motion for its entry, and call
    <code>animateStyle()</code> for the colour: they do not compete, since a motion writes only its fields.
  </p>
  <Code data-code={fieldOrStyle} data-language="ts" />
  <p>
    In a component, take <code>card</code> from <ApiName html="document.getElementById()" react="ref" angular="viewChild()" svelte="bind:this" /> instead.
  </p>

  <h2 id="element-or-component">Put the motion on an element, or on a component</h2>
  <ForFramework>
    <Fragment slot="react">
      <p>React gives you two ways to attach a motion. Both bind the same core <a href={glossaryHref('binding')}>binding</a>.</p>
      <ul class={choices}>
        <li class={card}>
          <h3 class={cardTitle}>&lt;Motion&gt;</h3>
          <p><span class={cardLabel}>Take it when</span> you can render the element through it: an HTML element with <code>&lt;Motion as="li"&gt;</code>, a Udixio component with <code>&lt;Motion as=&#123;Button&#125;&gt;</code>, and above all inside a <code>&lt;Presence&gt;</code>.</p>
          <p><span class={cardLabel}>Because</span> it renders the element itself: no ref to pass, a <code>gesture</code> on the same element, and <code>&lt;Presence&gt;</code> plays its exit. <code>&lt;Presence&gt;</code> only sees <code>&lt;Motion&gt;</code> children. Its <code>motionRef</code> gives <code>play()</code> and <code>getBinding()</code>; its <code>ref</code> stays the element's, or the component's.</p>
          <a class={cardLink} href="/motion/presence">Show and hide</a>
        </li>
        <li class={card}>
          <h3 class={cardTitle}>useMotion()</h3>
          <p><span class={cardLabel}>Take it when</span> you already render an HTML element, or you need <code>mounted</code> in your code.</p>
          <p><span class={cardLabel}>Because</span> it returns a <code>ref</code> to put on any element, and the same controls as <code>motionRef</code>: <code>play()</code> and <code>getBinding()</code>. Without <code>&lt;Presence&gt;</code>, render the element while <code>mounted</code> is true.</p>
          <a class={cardLink} href="/motion/emphasis">Draw attention</a>
        </li>
      </ul>
      <p>
        On a Udixio component, render the component through <code>&lt;Motion&gt;</code>:
        <code>&lt;Motion as=&#123;Button&#125; name="press" label="Save" /&gt;</code>. Every prop that is not the motion's
        goes to the Button, and the motion moves the component's <a href={glossaryHref('box')}>box</a>, its root element:
        the <code>&lt;button&gt;</code> of a Button, the outlined box of a TextField and not its <code>&lt;input&gt;</code>.
        Put <code>useMotion()</code>'s <code>ref</code> on a component only when that <code>ref</code> reaches its root: the
        <code>ref</code> of a TextField is its <code>&lt;input&gt;</code>, so a shake through it would move the input alone.
      </p>
    </Fragment>
    <Fragment slot="angular">
      <p>
        Angular has one way: put <code>udxMotion</code> on an element. To call its <code>play()</code>, take the directive
        in a template reference: <code>#press="udxMotion"</code>.
      </p>
      <p>
        On a Udixio component, put <code>udxMotion</code> on the component's own tag:
        <code>&lt;udx-button udxMotion="press"&gt;</code>. The host of a Udixio component has no box: it carries
        <code>data-motion-box="child"</code> and is <code>display: contents</code>. So it gives the motion to its
        <a href={glossaryHref('box')}>box</a>, the component's root element: the <code>&lt;button&gt;</code> of a Button,
        the outlined box of a text field. The host keeps the state: <code>hidden</code>, <code>data-motion-presence</code>
        and <code>inert</code> stay on <code>&lt;udx-button&gt;</code>, so <code>[udxMotionPresent]</code> hides it.
      </p>
    </Fragment>
    <Fragment slot="svelte">
      <p>
        Svelte has one way: attach <code>motion()</code> to an element. An attachment returns no controls: play with the
        <code>state</code> option, or with <code>getMotion(element, kind)?.play()</code> on the element.
      </p>
      <p>
        On a Udixio component, attach <code>motion()</code> to the component:
        <code>&lt;Button &#123;&#64;attach motion('press')&#125; /&gt;</code>. The component passes the attachment on, with
        its other props, to its root element, which the motion moves: the <code>&lt;button&gt;</code> of a Button, the
        outlined box of a TextField. <code>bind:this</code> on a component gives the component, not its element: to call
        <code>getMotion()</code>, take the element with an attachment of your own, as the example does.
      </p>
    </Fragment>
    <Fragment slot="html">
      <p>
        In HTML, put <code>data-motion</code> on the element itself: a native element has its own box. Call
        <code>motion()</code> from script only when you need the binding before <code>connectMotion()</code> binds it, or
        on a page without <code>connectMotion()</code>.
      </p>
      <p>
        When a wrapper that you cannot remove stands around the element, such as the host of a third-party widget, give the
        wrapper <code>data-motion-box="child"</code>. It then has no box of its own: its motion moves its child marked
        <code>data-motion-box</code>, or else its first element child, which is its <a href={glossaryHref('box')}>box</a>.
        The wrapper keeps the state: its <code>hidden</code>, its <code>data-motion-state</code> and the
        <code>data-motion-presence</code> that the runtime writes.
      </p>
    </Fragment>
  </ForFramework>
  <MotionUsage name="motion-choosing-component" live={false} />

  <h3>Space a component with gap</h3>
  <ForFramework>
    <p slot="react">
      <code>&lt;Motion as=&#123;Component&#125;&gt;</code> creates no box, but it does put an element of its own between your
      parent and the component. A selector that needs the component to be a direct child of your parent, or a sibling of its
      neighbours, no longer sees it: the parent's <code>space-x-*</code>, <code>space-y-*</code>, <code>divide-*</code> and
      <code>[&amp;&gt;*]</code> variants, and <code>first:</code>, <code>last:</code> and <code>peer-*</code> on the
      component. Space the components with <code>gap</code> on a flex or grid parent: an element with no box takes no place
      in the layout, so the component's root is the flex or grid item.
    </p>
    <p slot="angular">
      The host of a Udixio component, motion or not, is an element between your parent and the component's root, with no box.
      A selector that needs the root to be a direct child of your parent, or a sibling of its neighbours, does not see it:
      the parent's <code>space-x-*</code>, <code>space-y-*</code>, <code>divide-*</code> and <code>[&amp;&gt;*]</code>
      variants, and <code>peer-*</code>. Space the components with <code>gap</code> on a flex or grid parent: the host takes
      no place in the layout, so the component's root is the flex or grid item.
    </p>
    <p slot="svelte">
      An attachment adds no element: the component's root stays the direct child of your parent, so <code>space-x-*</code>,
      <code>divide-*</code> and the other structural selectors reach it. <code>gap</code> on a flex or grid parent works as
      well.
    </p>
    <p slot="html">
      A wrapper with <code>data-motion-box="child"</code> stays an element between your parent and its child. A selector that
      needs the child to be a direct child of your parent, such as <code>space-x-*</code>, <code>divide-*</code> or
      <code>[&amp;&gt;*]</code>, reaches the wrapper and not the child. Give the wrapper <code>display: contents</code>, as
      the example does, and space the children with <code>gap</code> on a flex or grid parent.
    </p>
  </ForFramework>

  <h3>When a component refuses the motion</h3>
  <p>
    A component can refuse a motion in two cases. Each time, nothing moves, and in development the console says why, once
    per element.
  </p>
  <ul>
    <li>
      <strong>The component already holds that <a href={glossaryHref('reserved kind')}>kind</a>.</strong> A component
      that animates its own element holds the kind of that animation there: a Snackbar holds the presence of its panel. A
      motion of that kind on it is ignored; a motion of another kind still plays, so a <code>press</code> on a Snackbar
      works. Time the component's own animation with its <code>motion</code> prop, where it has one: a Snackbar, a
      SideSheet, a Tooltip, a NavigationRail.
    </li>
    <li>
      <strong>The component has no box to give.</strong> Its surface is in a portal or the top layer, away from where you
      write it: <ForFramework as="span">
        <Fragment slot="react">a Tooltip, an AnchorPositioner, a ContextMenu, a modal SideSheet.</Fragment>
        <Fragment slot="angular"><code>udx-anchor-positioner</code>, <code>udx-context-menu</code>, a modal <code>udx-side-sheet</code>.</Fragment>
        <Fragment slot="svelte">a ContextMenu.</Fragment>
        <Fragment slot="html">a popup's host, whose surface is elsewhere in the page.</Fragment>
      </ForFramework>
      It carries <code>data-motion-box="none"</code>, and the motion binds nothing, rather than moving the anchor. Time it
      with its own <code>motion</code> prop where it has one (a Tooltip, a SideSheet); otherwise put the motion on the
      element you give it, such as the trigger, or on the content inside it.
    </li>
  </ul>
  <p>
    The messages and their fixes are in <a href="/motion/troubleshooting#ignored-on-component">Troubleshooting</a>, and each
    component's page says which kinds it holds.
  </p>

  <h3>What each Udixio component gives a motion</h3>
  <ForFramework>
    <p slot="html">
      The Udixio components exist in React, Angular and Svelte. Choose one of them at the top of the page to see, for each
      component, the element a motion moves and the kinds the component holds itself.
    </p>
    <Fragment slot="react">
      <p>
        <code>&lt;Motion as=&#123;Component&#125;&gt;</code> moves the box in the second column. The third column is where the
        component's own <code>ref</code> lands, which is what <code>useMotion()</code>'s <code>ref</code> would move. A kind in
        the last column is the component's own: a motion of that kind on that element is ignored.
      </p>
      <div class="not-prose overflow-x-auto">
        <table class="w-full min-w-[40rem] border-collapse text-body-medium">
          <caption class="sr-only">Each Udixio React component: the element a motion moves, where its ref lands, and the kinds it holds</caption>
