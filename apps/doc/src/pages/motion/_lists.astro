---
import DocLink from '@/components/DocLink.astro';
import MotionPage from '@/components/MotionPage.astro';
import ForFramework from '@/components/ForFramework.astro';
import ApiName from '@/components/ApiName.astro';
import Code from '@/components/Code.astro';
import Choices from '@/components/motion/Choices.astro';
import Choice from '@/components/motion/Choice.astro';
import Steps from '@/components/motion/Steps.astro';
import Step from '@/components/motion/Step.astro';
import GoodToKnow from '@/components/motion/GoodToKnow.astro';
import Fact from '@/components/motion/Fact.astro';
import HtmlExample from '@/components/motion/HtmlExample.astro';
import MotionUsage from '@/components/motion/MotionUsage.astro';
import MotionOptions from '@/components/motion/MotionOptions.astro';
import MotionTokens from '@/components/motion/MotionTokens.astro';
import { MotionListsReact } from '@/examples/react/motion-lists.tsx';
import { MotionListsAngular } from '@/examples/angular/motion-lists.ts';
import MotionListsSvelte from '@/examples/svelte/motion-lists.svelte';
import { glossaryHref } from '@/lib/motion-glossary';

const defineListItem = `import { defineMotion } from '@udixio/motion';

// Items that enter together start one step apart, from the first one. A leaving item is taken out of the flow,
// so the items around it close the gap while it fades.
defineMotion('list-item', {
  verb: 'appear',
  keyframes: [{ opacity: 0, y: 16 }, { opacity: 1, y: 0 }],
  stagger: 'normal',
  origin: 'first',
  exit: 'out-of-flow',
});`;
---
<MotionPage
  slug="lists"
  title="Motion: make a list appear"
  description="Items added together cascade in visual order; a leaving item lets its neighbours close the gap. In HTML, React, Angular and Svelte."
  frameworkSwitch
>
  <Fragment slot="summary">
    Items added together cascade in visual order; a leaving item lets its neighbours close the gap.
  </Fragment>

  <h2 id="when-to-use-it">When to use it</h2>
  <Choices size="compact">
    <Choice lead href="/motion/choosing-an-api#cascade" link="Compare in Choosing an API">
      <Fragment slot="title"><ApiName html={'data-motion="cascade reflow"'} react={'<Motion name="cascade reflow">'} angular={'udxMotion="cascade reflow"'} svelte="motion('cascade reflow')" /></Fragment>
      <Fragment slot="when">the items of a list enter and leave together: a queue, search results.</Fragment>
      <Fragment slot="because">they enter one after another, in visual order, and a leaving item lets the others close the gap.</Fragment>
    </Choice>
    <Choice code={false} title="Presence" when="Prefer it when" href="/motion/presence" link="Presence">
      <Fragment slot="when">one element enters the page or leaves it: a toast, a dialog.</Fragment>
      <Fragment slot="because">its entry and its exit play on that element alone.</Fragment>
    </Choice>
    <Choice code={false} title="Layout" when="Prefer it when" href="/motion/layout" link="Layout">
      <Fragment slot="when">an element changes its place or its size and stays: a mini-player that grows.</Fragment>
      <Fragment slot="because">a layout motion carries it from its old box to its new one.</Fragment>
    </Choice>
    <Choice code={false} title="Reveal" when="Prefer it when" href="/motion/reveal" link="Reveal">
      <Fragment slot="when">the items sit below the fold, and each must play as the reader reaches it: a feed.</Fragment>
      <Fragment slot="because">each one waits in its first frame until it enters the view.</Fragment>
    </Choice>
  </Choices>

  <h2 id="add-three-tracks-to-the-queue">Add three tracks to the queue</h2>
  <p>
    The queue keeps five tracks. Adding three makes them cascade in at the bottom, and the three oldest leave from the top:
    the tracks below them close the gap. The <DocLink href={glossaryHref('stagger')}>stagger</DocLink> sets the step between the three
    that enter together.
  </p>
  <ForFramework>
    <p slot="html">Set <code>data-motion="cascade reflow"</code> on each track, and insert several in one task: they cascade in. Set <code>hidden</code> on a track to remove it: its exit plays first.</p>
    <p slot="react">Render each track as a <code>&lt;Motion as="li" name="cascade reflow"&gt;</code> inside one <code>&lt;Presence&gt;</code>, and add several in one render: they cascade in.</p>
    <p slot="angular">Put <code>udxMotion="cascade reflow"</code> on each track of an <code>&#64;for</code>, and add several in one change: they cascade in.</p>
    <p slot="svelte">Attach <code>motion('cascade reflow')</code> and <code>transition:presence</code> to each track of an <code>&#123;#each&#125;</code>, and add several in one update: they cascade in.</p>
  </ForFramework>
  <MotionUsage name="motion-lists" layout="split" previewHeight={[640, 584]}>
    <HtmlExample slot="html" name="motion-lists" />
    <MotionListsReact slot="react" client:visible />
    <MotionListsAngular slot="angular" client:visible />
    <MotionListsSvelte slot="svelte" client:visible />
  </MotionUsage>

  <h2 id="how-it-behaves">How it behaves</h2>
  <h3 id="what-starts-it">What starts it</h3>
  <ForFramework>
    <p slot="html">The <DocLink href={glossaryHref('trigger')}>trigger</DocLink> is the insertion: an element with <code>data-motion</code> inserted in the list plays its entry. Setting <code>hidden</code> plays its exit.</p>
    <p slot="react">The <DocLink href={glossaryHref('trigger')}>trigger</DocLink> is the render: a track rendered in the <code>&lt;Presence&gt;</code> plays its entry, and a track you remove from your state plays its exit.</p>
    <p slot="angular">The <DocLink href={glossaryHref('trigger')}>trigger</DocLink> is the <code>&#64;for</code>: a track added to the list plays its entry, and a track removed from it plays its exit.</p>
    <p slot="svelte">The <DocLink href={glossaryHref('trigger')}>trigger</DocLink> is the <code>&#123;#each&#125;</code>: a track added to the array plays its entry, and a track removed from it plays its exit.</p>
  </ForFramework>

  <h3 id="from-entry-to-gone">From entry to gone</h3>
  <Steps label="The life of a list item">
    <Step title="Entry" state="entering">The entry plays, one step after the item before it in the cascade.</Step>
    <Step title="At rest" state="present">The item lets go of its inline styles: your classes apply again (<DocLink href={glossaryHref('at rest')}>at rest</DocLink>).</Step>
    <Step title="Exit" state="exiting">The exit plays, and the item is <code>inert</code>: it can no longer be clicked or focused.</Step>
    <Step title="Gone">
      <ForFramework as="span" slot="state">
        <Fragment slot="html">hidden</Fragment>
        <Fragment slot="react">removed</Fragment>
        <Fragment slot="angular">removed</Fragment>
        <Fragment slot="svelte">removed</Fragment>
      </ForFramework>
      <ForFramework as="span">
        <Fragment slot="html">The item stays in the DOM, <code>hidden</code>, and the items below it close the gap.</Fragment>
        <Fragment slot="react">React removes the item, and the items below it close the gap.</Fragment>
        <Fragment slot="angular">Angular removes the item, and the items below it close the gap.</Fragment>
        <Fragment slot="svelte">Svelte removes the item, and the items below it close the gap.</Fragment>
      </ForFramework>
    </Step>
  </Steps>

  <h3 id="rules">Rules</h3>
  <ul>
    <li>
      The items that enter in the same change cascade in visual order; an item that enters alone plays at once.
    </li>
    <li>
      Put the <DocLink href={glossaryHref('presence')}>presence</DocLink> and the layout on the item itself, not on a wrapper inside it:
      the list then follows each item as it enters and leaves.
    </li>
    <li>
      To dismiss a track with a swipe, or to reorder the queue with a drag, see <DocLink href="/motion/gestures">Gestures</DocLink>.
    </li>
  </ul>

  <h2 id="variants">Variants</h2>
  <h3 id="set-the-stagger-and-the-exit">Set the stagger and the exit</h3>
  <p>
    Define your own list item with <code>defineMotion()</code> when the cascade or the exit must differ from the preset. Its
    <code>stagger</code> sets the step between the items that enter together: <code>tight</code> (20 ms),
    <code>normal</code> (50 ms) or <code>loose</code> (100 ms). The steps are capped at 400 ms in all.
  </p>
  <p>
    <code>origin</code> sets where the cascade starts: <code>first</code>, the default, <code>last</code>, or
    <code>center</code>, which starts in the middle and spreads both ways.
  </p>
  <p>
    <code>exit</code> sets how a leaving item moves its neighbours. <code>in-place</code>, the default, keeps the item where
    it is until its exit has played. <code>out-of-flow</code> takes it out of the flow when the exit starts, so the items
    around it close the gap while it fades.
  </p>
  <Code data-code={defineListItem} data-language="ts" />
  <p>
    Then give each item the name of your motion, in place of <code>cascade</code>:
    <ApiName html={'data-motion="list-item reflow"'} react={'name="list-item reflow"'} angular={'udxMotion="list-item reflow"'} svelte="motion('list-item reflow')" />.
  </p>

  <h2 id="options">Options</h2>
  <p>These options apply to a list item defined with the verb <code>appear</code>. <code>split</code> cuts text, so it is left out here.</p>
  <MotionOptions verb="appear" omit={['split']} />

  <h2 id="good-to-know">Good to know</h2>
  <GoodToKnow>
    <Fact label="Reduced motion">
      <ul>
        <li>A new item is a short fade, and the items that enter together fade in together: the cascade has no delays.</li>
        <li>A leaving item fades in place, whatever <code>exit</code> says: it does not leave the flow.</li>
        <li>Set <code>--udx-motion: none</code> on the list to show the end state at once.</li>
      </ul>
    </Fact>
    <Fact label="Timing">
      <p>
        A new item moves in on the <DocLink href={glossaryHref('spatial and effects springs')}>default spatial spring</DocLink>, and fades
        in on the default effects spring. A leaving item plays its exit on the default effects spring, and its neighbours
        follow it on the default spatial spring. The steps of the cascade come from the stagger token.
      </p>
      <MotionTokens tokens={['spring.default.spatial', 'spring.default.effects', 'stagger.normal']} />
    </Fact>
    <Fact label="Limits">
      <ul>
        <ForFramework as="li">
          <Fragment slot="html">If you remove an item from the DOM, it goes at once, with no exit: set <code>hidden</code> instead.</Fragment>
          <Fragment slot="react">If you stop rendering the <code>&lt;Presence&gt;</code> itself, its items go at once, with no exit: keep it rendered, and put the condition inside it.</Fragment>
          <Fragment slot="angular">If an item is a child component, Angular does not wait for its exit when it removes the child: put <code>udxMotion</code> on the child's host element, in the parent's template.</Fragment>
          <Fragment slot="svelte">If a parent block removes the item, Svelte plays no transition: put <code>transition:presence</code> on the element that its own <code>&#123;#each&#125;</code> block adds and removes.</Fragment>
        </ForFramework>
        <li>If more than eight items enter together at <code>normal</code>, the ninth and the later ones start together, 400 ms after the first: the cascade is capped at 400 ms.</li>
        <li>If you use <code>exit: 'out-of-flow'</code> on a list that is not positioned, the leaving item is placed against an ancestor that is: add <code>relative</code> to the list.</li>
        <li>Something else? See <DocLink href="/motion/troubleshooting">Troubleshooting</DocLink> and <DocLink href="/motion/limits">Limits</DocLink>.</li>
      </ul>
    </Fact>
  </GoodToKnow>
</MotionPage>
