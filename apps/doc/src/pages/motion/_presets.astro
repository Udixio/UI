---
import DocLink from '@/components/DocLink.astro';
import MotionPage from '@/components/MotionPage.astro';
import ForFramework from '@/components/ForFramework.astro';
import ApiName from '@/components/ApiName.astro';
import Code from '@/components/Code.astro';
import Choices from '@/components/motion/Choices.astro';
import Choice from '@/components/motion/Choice.astro';
import GoodToKnow from '@/components/motion/GoodToKnow.astro';
import Fact from '@/components/motion/Fact.astro';
import MotionStage from '@/components/motion/MotionStage.astro';
import MotionUsage from '@/components/motion/MotionUsage.astro';
import MotionTokens from '@/components/motion/MotionTokens.astro';
import Presets from '@/components/motion/scenes/Presets.astro';
import { PresetsControls } from '@/components/motion/scenes/PresetsControls';
import { chipClass } from '@/components/motionDemo';
import { glossaryHref } from '@/lib/motion-glossary';

const presets = [
  ['fade', 'appear', 'Fades in.'],
  ['slide', 'appear', 'Fades in while rising 24 px.'],
  ['cascade', 'appear', 'A list entering together: each item fades in while rising 24 px, one step after the previous one (stagger normal).'],
  ['scale', 'appear', 'Fades in while growing from 80 %.'],
  ['draw', 'appear', 'Draws a path or a basic shape from nothing to its whole stroke (see SVG).'],
  ['press', 'emphasize', 'Dips to 96 % and returns.'],
  ['shake', 'emphasize', 'Shakes sideways by 6 px, then settles, to signal a refused action.'],
  ['reflow', 'layout', 'Moves to the new place and size of the element when the layout changes.'],
  ['rise', 'reveal', 'Fades in while rising 24 px, when it enters the view (stagger normal).'],
  ['parallax', 'scrub', 'Drifts from 48 px below its place to 48 px above it, across the viewport.'],
  ['rotate', 'loop', 'Turns a full turn in one second. The user can pause it.'],
  ['breathe', 'loop', 'Swells to 104 % and back in one second. The user can pause it.'],
  ['blink', 'loop', 'One dim flash each second. The user can pause it.'],
];

const defineCardEnter = `import { defineMotion } from '@udixio/motion';

// A name, a verb and keyframes are enough: the timing is optional.
defineMotion('card-enter', {
  verb: 'appear',
  keyframes: [
    { opacity: 0, y: 24 },
    { opacity: 1, y: 0 },
  ],
  timing: 'spring.default.spatial',
});`;

const presetImports = `// Defines every preset: each one is then known by its name.
import '@udixio/motion/presets';

// Or import only the presets you use, by name, as references.
import { fade, slide, reflow } from '@udixio/motion/presets';`;
---
<MotionPage
  slug="presets"
  title="Motion: presets"
  description="The thirteen presets of @udixio/motion, defined by importing @udixio/motion/presets, and how to define a motion of your own with defineMotion."
  frameworkSwitch
>
  <ForFramework as="span" slot="summary">
    <Fragment slot="html">A <DocLink href={glossaryHref('preset')}>preset</DocLink> is a motion that is already defined: put its name in <code>data-motion</code> and it plays. Define your own with <code>defineMotion()</code>.</Fragment>
    <Fragment slot="react">A <DocLink href={glossaryHref('preset')}>preset</DocLink> is a motion that is already defined: render an element as a <code>&lt;Motion&gt;</code> with its name. Define your own with <code>defineMotion()</code>.</Fragment>
    <Fragment slot="angular">A <DocLink href={glossaryHref('preset')}>preset</DocLink> is a motion that is already defined: put its name in <code>udxMotion</code>. Define your own with <code>defineMotion()</code>.</Fragment>
    <Fragment slot="svelte">A <DocLink href={glossaryHref('preset')}>preset</DocLink> is a motion that is already defined: attach <code>motion()</code> with its name. Define your own with <code>defineMotion()</code>.</Fragment>
  </ForFramework>

  <h2 id="when-to-use-it">When to use it</h2>
  <Choices size="compact">
    <Choice lead href="#name-a-preset" link="Name a preset">
      <Fragment slot="title"><ApiName html={'data-motion="fade"'} react={'<Motion name="fade">'} angular={'udxMotion="fade"'} svelte={"motion('fade')"} /></Fragment>
      <Fragment slot="when">the motion you need is one of the thirteen presets below, and its timing suits you.</Fragment>
      <Fragment slot="because">it needs no definition: importing <code>@udixio/motion/presets</code> defines it, and its name is the same in every framework.</Fragment>
    </Choice>
    <Choice when="Prefer it when" title="defineMotion()" href="#define-a-motion-of-your-own" link="Define a motion of your own">
      <Fragment slot="when">none of the thirteen fits: you need other <DocLink href={glossaryHref('keyframes')}>keyframes</DocLink>, another timing, or a <DocLink href={glossaryHref('verb')}>verb</DocLink> of your own.</Fragment>
      <Fragment slot="because">you name the motion yourself, and development checks its spec when you define it.</Fragment>
    </Choice>
    <Choice when="Prefer it when" code={false} title="Presence" href="/motion/presence" link="Presence">
      <Fragment slot="when">an element enters the page and leaves it: a toast, a dialog, a panel, a message.</Fragment>
      <Fragment slot="because">the exit plays before the element is gone, and the page says where focus goes when it leaves.</Fragment>
    </Choice>
  </Choices>

  <h2 id="play-the-presets">Play the presets</h2>
  <p>
    Press a tile to replay its preset. <code>parallax</code> follows the scroll, so its tile opens Scrub instead. Pause loops holds the
    three loop presets: <code>rotate</code>, <code>breathe</code> and <code>blink</code>.
  </p>
  <MotionStage scene="presets" label="Live example: the thirteen presets, one tile each" height={[856, 2096]}>
    <Fragment slot="controls"><PresetsControls client:visible /></Fragment>
    <Presets />
    <Fragment slot="readout"><span class={`${chipClass} tracking-normal`} data-presets-readout>Press a preset to replay it.</span></Fragment>
  </MotionStage>

  <h2 id="name-a-preset">Name a preset in your framework</h2>
  <p>The example shows a card that fades in and out, and a Save button that presses.</p>
  <ForFramework>
    <Fragment slot="html">
      <p>Put <code>data-motion</code> on the element, with the name of the preset: <code>data-motion="fade"</code> fades it in, and out when you hide it.</p>
      <p>For an emphasis, change <code>data-motion-state</code> each time the element must replay: <code>data-motion="press"</code> plays on each change.</p>
    </Fragment>
    <Fragment slot="react">
      <p>Render the element as a <code>&lt;Motion name="fade"&gt;</code> inside a <code>&lt;Presence&gt;</code>: the element fades out before it leaves.</p>
      <p>For an emphasis, pass a value that changes as <code>state</code>: <code>&lt;Motion as=&#123;Button&#125; name="press" state=&#123;saves&#125;&gt;</code> replays the press on each change, on the Button itself.</p>
    </Fragment>
    <Fragment slot="angular">
      <p>Put <code>udxMotion="fade"</code> on the element, and show it with <code>&#64;if</code>.</p>
      <p>For an emphasis, bind <code>[udxMotionState]</code> to a value: each change of the value replays the emphasis. Put it on the component's own tag, <code>&lt;udx-button udxMotion="press"&gt;</code>.</p>
    </Fragment>
    <Fragment slot="svelte">
      <p>Attach <code>&#123;&#64;attach motion('fade')&#125;</code>, and add <code>transition:presence</code> to the element inside an <code>&#123;#if&#125;</code> block.</p>
      <p>For an emphasis, pass <code>state</code> in the options of <code>motion()</code>: each change of the value replays the emphasis. Attach it to the component itself, <code>&lt;Button &#123;&#64;attach motion('press', () =&gt; (&#123; state: saves &#125;))&#125; /&gt;</code>.</p>
    </Fragment>
  </ForFramework>
  <MotionUsage name="motion-presets" live={false} />
  <p>Import the presets once, and each one below is defined. Or import only the ones you use, by name:</p>
  <Code data-code={presetImports} data-language="ts" />

  <h2 id="the-thirteen-presets">The thirteen presets</h2>
  <p>Each preset is a motion with one verb. The table gives what each one does.</p>
  <div class="overflow-x-auto">
    <table>
      <thead><tr><th>Preset</th><th>Verb</th><th>Effect</th></tr></thead>
      <tbody>
        {presets.map(([name, verb, effect]) => <tr><td><code>{name}</code></td><td><code>{verb}</code></td><td>{effect}</td></tr>)}
      </tbody>
    </table>
  </div>
  <p>
    The values of the presets are not calibrated yet. Use <code>cascade</code> for a list that enters together, and <code>rise</code> for
    elements that enter as they scroll into view: see <DocLink href="/motion/lists">Lists</DocLink> and <DocLink href="/motion/reveal">Reveal</DocLink>.
    <code>parallax</code> is the subject of <DocLink href="/motion/scrub">Scrub</DocLink>, and the loops are on <DocLink href="/motion/loop">Loop</DocLink>.
  </p>

  <h2 id="define-a-motion-of-your-own">Define a motion of your own</h2>
  <p>
    Define a motion with <code>defineMotion(name, spec)</code>, once, before an element uses it. The name is kebab-case, such as
    <code>card-enter</code>. Reserved names, such as <code>enter</code> or <code>exit</code>, are refused.
  </p>
  <Code data-code={defineCardEnter} data-language="ts" />
  <p>The spec has three fields:</p>
  <ul>
    <li>
      <code>verb</code> is one of the seven verbs: <DocLink href="/motion/how-it-works#verbs">How it works</DocLink> lists them, with what triggers
      each one and how it ends.
    </li>
    <li>
      <code>keyframes</code> are the visual states, from the first to the last. Their fields are <code>opacity</code>, <code>x</code>,
      <code>y</code>, <code>scale</code>, <code>scaleX</code>, <code>scaleY</code> and <code>rotate</code>. <code>scale</code> scales
      both axes. A frame sets either <code>scale</code>, or <code>scaleX</code> and <code>scaleY</code>: development refuses a frame
      that sets both. <code>draw</code> and <code>along</code> are for shapes and paths, see <DocLink href="/motion/svg">SVG</DocLink>.
      A layout motion takes no keyframes.
    </li>
    <li>
      <code>timing</code> is optional: a spring token, such as <code>spring.fast.spatial</code>, or a duration and an easing, as in
      <code>&#123; duration: 'duration.medium2', easing: 'easing.standard' &#125;</code>. It applies to every field of the motion.
    </li>
  </ul>
  <p>Defining a name again with the same spec returns the existing motion. Defining it with a different spec throws.</p>

  <h2 id="good-to-know">Good to know</h2>
  <GoodToKnow>
    <Fact label="Timing">
      <p>
        The fade and slide presets use the default springs: spatial for the movement, and effects for the fade. The rotate preset turns over
        the extra long linear curve.
      </p>
      <MotionTokens tokens={['spring.default.spatial', 'spring.default.effects', 'duration.extraLong4', 'easing.linear']} />
    </Fact>
    <Fact label="Reduced motion">
      <p>
        A preset follows the reduced-motion policy of its verb: an entry or an exit becomes a short fade, an emphasis applies its end frame, a
        reveal shows at once, a scrub stays still and a loop does not play. See <DocLink href="/motion/accessibility">Accessibility</DocLink>.
      </p>
    </Fact>
    <Fact label="Limits">
      <ul>
        <li>If you name a preset without importing <code>@udixio/motion/presets</code>, nothing plays: import it, or define the name yourself.</li>
        <li>If you need a variant of a preset, define a new name for it: a name that is already defined with a different spec throws.</li>
        <li>If a definition is invalid, development reports it when you define it. A production build trusts the definition, so check the page in development first.</li>
      </ul>
    </Fact>
  </GoodToKnow>
</MotionPage>
