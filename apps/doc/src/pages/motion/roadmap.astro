---
import MotionPage from '@/components/MotionPage.astro';
import { MINIMUM_BROWSERS, VERIFIED_ENGINES, verifiedWith } from '@/lib/motion-facts';

const families = [
  ['Presence', 'Delivered', 'appear and disappear, the hidden attribute, data-presence, focus restoration, and the adapters.', '/motion/presence'],
  ['Emphasis', 'Delivered', 'emphasize, replayed on each change of data-state or by play().', '/motion/emphasis'],
  ['Layout, lists and shared elements', 'Delivered', 'The layout verb, the reflow preset, cascades with stagger and exit, and shared keys.', '/motion/layout'],
  ['Reveal', 'Delivered', 'reveal, with its repeat and its stagger.', '/motion/reveal'],
  ['Link to the scroll', 'Delivered', 'scrub on a view timeline where the browser has one; a stylesheet state where it has none.', '/motion/scrub'],
  ['Loop', 'Delivered', 'loop, with its pause rules.', '/motion/loop'],
  ['Values and counters', 'Delivered', 'defineValue with pointer, scroll, state and time sources; counters with a format.', '/motion/values'],
  ['Sequences', 'Delivered', 'defineSequence with named steps, at and stagger, and one handle.', '/motion/sequences'],
  ['Gestures', 'Delivered', 'drag, swipe and reorder, each with its keyboard alternative.', '/motion/gestures'],
  ['Page transitions', 'Delivered', 'navigate() inside a View Transition where the browser has one; the Astro client router.', '/motion/page-transitions'],
  ['Text', 'Delivered', 'split by words, characters or lines.', '/motion/text'],
  ['SVG', 'Delivered', 'draw, along, and morph.', '/motion/svg'],
  ['Scroll', 'Delivered', 'scrollTo and scrollDestination.', '/motion/scroll'],
  ['Animate', 'Delivered', 'animateStyle, createSpring, cssTiming, composeHandles and the stagger helpers.', '/motion/animate'],
  ['Scopes and breakpoints', 'Delivered', 'Motion per breakpoint, revert and inspect.', '/motion/scopes'],
  ['Accessibility and reduced motion', 'Delivered', 'The reduced-motion policy, focus, pause and reading rules.', '/motion/accessibility'],
  ['Tokens', 'Delivered, provisional', 'Springs, durations and easings; distance and stagger are provisional and await calibration.', '/motion/tokens'],
];

const minimum = MINIMUM_BROWSERS.map((browser) => `${browser.name} ${browser.version}${browser.note ? ` (${browser.note})` : ''}`).join(', ');
const engines = VERIFIED_ENGINES.map(({ name, version }) => `${name} ${version}`).join(', ');
---
<MotionPage slug="roadmap" title="Motion roadmap" description="Current status of the motion families and of the browsers they run on.">
  <p>This page is the public status source for the motion families. Each family is described on its own page, and the limits of the package are on the <a href="/motion/limits">Limits</a> page. The status "Delivered" means that the family's API is in the package, and that its limits are stated; the package as a whole is under construction.</p>
  <div class="overflow-x-auto">
    <table>
      <thead><tr><th>Family</th><th>Status</th><th>What it covers</th><th>Page</th></tr></thead>
      <tbody>
        {families.map(([family, status, covers, href]) => <tr><td>{family}</td><td>{status}</td><td>{covers}</td><td><a href={href}>Read</a></td></tr>)}
      </tbody>
    </table>
  </div>
  <h2>Browsers</h2>
  <p>The oldest browsers the package supports are {minimum}: the oldest releases of browserslist's <code>defaults</code> query. Which features each one lacks, and what the package does instead, is on the <a href="/motion/">motion home page</a>.</p>
  <p>The browser suites ran on {engines}, through {verifiedWith}. Older releases are not run: the fallbacks suite removes one feature at a time, as an older engine lacks it, and checks what the package does.</p>
</MotionPage>
