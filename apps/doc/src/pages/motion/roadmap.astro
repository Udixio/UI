---
import MotionPage from '@/components/MotionPage.astro';
const families = [
  ['Presence', 'Delivered', 'appear and disappear, the hidden attribute, data-presence, focus restoration, and the adapters.', '/motion/presence'],
  ['Emphasis', 'Delivered', 'emphasize, replayed on each change of data-state or by play().', '/motion/emphasis'],
  ['Layout, lists and shared elements', 'Delivered', 'The layout verb, the reflow preset, cascades with stagger and exit, and shared keys.', '/motion/layout'],
  ['Reveal', 'Delivered', 'reveal, with its repeat and its stagger.', '/motion/reveal'],
  ['Link to the scroll', 'Delivered', 'scrub on a view timeline where the browser has one; a stylesheet state where it has none.', '/motion/scrub'],
  ['Loop', 'Delivered', 'loop, with its pause rules.', '/motion/loop'],
  ['Values and counters', 'Delivered', 'defineValue with pointer, scroll, state and time sources; counters with a format.', '/motion/values'],
  ['Sequences', 'Delivered', 'defineSequence with named steps, at and stagger, and one handle.', '/motion/sequences'],
  ['Gestures', 'Delivered', 'drag, swipe and reorder, each with its keyboard alternative.', '/motion/gestures'],
  ['Page transitions', 'Delivered', 'navigate() inside a View Transition where the browser has one; the Astro client router.', '/motion/page-transitions'],
  ['Text', 'Delivered', 'split by words, characters or lines.', '/motion/text'],
  ['SVG', 'Delivered', 'draw, along, and morph.', '/motion/svg'],
  ['Scroll', 'Delivered', 'scrollTo and scrollDestination.', '/motion/scroll'],
  ['Animate', 'Delivered', 'animateStyle, createSpring, cssTiming, composeHandles and the stagger helpers.', '/motion/animate'],
  ['Scopes and breakpoints', 'Delivered', 'Motion per breakpoint, revert and inspect.', '/motion/scopes'],
  ['Accessibility and reduced motion', 'Delivered', 'The reduced-motion policy, focus, pause and reading rules.', '/motion/accessibility'],
  ['Tokens', 'Delivered, provisional', 'Springs, durations and easings; distance and stagger are provisional and await calibration.', '/motion/tokens'],
];

// Browser verification, from the run of the browser suites of @udixio/motion (vitest, one engine per run).
const verifiedOn = '2026-11-17';
const verifiedCommit = '04f44667';
const engines = ['Chromium 156.0.8078.4', 'Firefox 157.0', 'WebKit 27.2'];
// Each row: the family or provider, the browser suites that cover it, and the tests that passed on each engine.
const familyVerification = [
  ['Presence', 'connect, bind, play', '121', '121', '121'],
  ['Emphasis', 'play, bind', '79', '79', '79'],
  ['Layout, lists and shared elements', 'layout, layout-loader (and cold), shared, shared-registry, stagger, pin', '105', '105', '105'],
  ['Reveal, scrub and loop', 'reveal, scrub, loop, continuous (cold)', '31 (1 skipped)', '26 (6 skipped)', '31 (1 skipped)'],
  ['Values and counters', 'value-binding, value-counter', '33', '33', '33'],
  ['Sequences', 'sequence', '16', '16', '16'],
  ['Gestures', 'gesture-binding', '29', '29', '29'],
  ['Page transitions', 'navigate, astro', '16', '16', '16'],
  ['Text', 'text, split (cold, play, load failure)', '41', '41', '41'],
  ['SVG', 'svg, morph', '25', '25', '25'],
  ['Scroll', 'scroll-to', '20', '20', '20'],
  ['Animate', 'animate', '19', '19', '19'],
  ['Scopes and breakpoints', 'scope, named-motion', '18', '18', '18'],
  ['Accessibility and reduced motion', 'runtime-policy, fallbacks (older browsers simulated)', '14', '14', '14'],
  ['Tokens', 'curve-tokens, motion-css, timing-integration', '7', '7', '7'],
];
const providerVerification = [
  ['CSS', 'providers/css, css-diagnostic, leaks', '77', '77', '77'],
  ['WAAPI', 'providers/providers, waapi-probe', '49', '49', '49'],
  ['anime.js', 'providers/animejs', '29', '29', '29'],
  ['Providers compared', 'testing/conformance', '5', '5', '5'],
];
---
<MotionPage slug="roadmap" title="Motion roadmap" description="Current status of the motion families and of the verification.">
  <p>This page is the public status source for the motion families. Each family is described on its own page, and the limits of the package are on the <a href="/motion/limits">Limits</a> page. The status "Delivered" means that the family's API is in the package, and that its limits are stated; the package as a whole is under construction.</p>
  <div class="overflow-x-auto">
    <table>
      <thead><tr><th>Family</th><th>Status</th><th>What it covers</th><th>Page</th></tr></thead>
      <tbody>
        {families.map(([family, status, covers, href]) => <tr><td>{family}</td><td>{status}</td><td>{covers}</td><td><a href={href}>Read</a></td></tr>)}
      </tbody>
    </table>
  </div>
  <h2>Browser verification</h2>
  <p>Verified on {verifiedOn}, at commit <code>{verifiedCommit}</code>, with Playwright 1.64.0 and the browser builds it installs. The browser suites of <code>@udixio/motion</code> (47 files) ran on each engine, one engine per run, and every file passed on every engine: 678 tests passed and 1 skipped on Chromium, 673 passed and 6 skipped on Firefox, 678 passed and 1 skipped on WebKit. The skips are scroll-timeline branches of the scrub suite: the stylesheet branch is skipped where the engine has a native view timeline (Chromium, WebKit), and the six native branches are skipped where it has none (Firefox).</p>
  <p>A family is verified on an engine when every suite listed for it passes there. The cells count the tests that passed. The matrix records these runs; it makes no claim for other versions or other engines.</p>
  <div class="overflow-x-auto">
    <table>
      <thead><tr><th>Family</th><th>Suites</th>{engines.map((engine) => <th>{engine}</th>)}</tr></thead>
      <tbody>
        {familyVerification.map(([family, suites, ...counts]) => <tr><td>{family}</td><td>{suites}</td>{counts.map((count) => <td>Pass: {count}</td>)}</tr>)}
      </tbody>
    </table>
  </div>
  <h2>Provider verification</h2>
  <p>Provider presence or <code>CSS.supports</code> alone does not establish family compatibility. The same runs cover each provider on the same engines.</p>
  <div class="overflow-x-auto">
    <table>
      <thead><tr><th>Provider</th><th>Suites</th>{engines.map((engine) => <th>{engine}</th>)}</tr></thead>
      <tbody>
        {providerVerification.map(([provider, suites, ...counts]) => <tr><td>{provider}</td><td>{suites}</td>{counts.map((count) => <td>Pass: {count}</td>)}</tr>)}
      </tbody>
    </table>
  </div>
  <p>Older browsers are simulated, not run. The fallbacks suite removes <code>linear()</code> and the view timeline from the page and checks the fallbacks on each engine; no older browser release is part of this matrix.</p>
</MotionPage>
