---
import DocLink from '@/components/DocLink.astro';
import MotionPage from '@/components/MotionPage.astro';
import ForFramework from '@/components/ForFramework.astro';
import Code from '@/components/Code.astro';
import Choices from '@/components/motion/Choices.astro';
import Choice from '@/components/motion/Choice.astro';
import GoodToKnow from '@/components/motion/GoodToKnow.astro';
import Fact from '@/components/motion/Fact.astro';
import MotionUsage from '@/components/motion/MotionUsage.astro';
import HtmlExample from '@/components/motion/HtmlExample.astro';
import MotionOptions from '@/components/motion/MotionOptions.astro';
import MotionTokens from '@/components/motion/MotionTokens.astro';
import { MotionSequencesIntroReact } from '@/examples/react/motion-sequences-intro.tsx';
import { MotionSequencesIntroAngular } from '@/examples/angular/motion-sequences-intro.ts';
import MotionSequencesIntroSvelte from '@/examples/svelte/motion-sequences-intro.svelte';
import { MotionSequencesTimelineReact } from '@/examples/react/motion-sequences-timeline.tsx';
import { MotionSequencesTimelineAngular } from '@/examples/angular/motion-sequences-timeline.ts';
import MotionSequencesTimelineSvelte from '@/examples/svelte/motion-sequences-timeline.svelte';
import { glossaryHref } from '@/lib/motion-glossary';

const playIntro = `import { getSequence, sequence } from '@udixio/motion/sequence';

const panel = document.getElementById('intro-panel') as HTMLElement;
// Settled: the panel is already in place, so binding it plays no entry.
const binding = sequence(panel, 'intro-steps', { settled: true });
const handle = binding.play(); // plays the steps from the start
handle.pause(); // holds them where they are
handle.seek(400); // moves to 400 ms, forwards or backwards
await handle.finished; // 'finished', or 'cancelled' when a later play takes over
getSequence(panel)?.play(); // replays the sequence bound to the panel`;
---
<MotionPage
  slug="sequences"
  title="Motion: choreograph steps"
  description="Steps that play in order from one root, with one handle to play, pause and seek them. In HTML, React, Angular and Svelte."
>
  <Fragment slot="summary">
    Steps that play in order on the parts of one block, under one handle that plays, pauses and seeks the whole
    choreography.
  </Fragment>

  <h2 id="when-to-use-it">When to use it</h2>
  <Choices size="compact">
    <Choice lead title="defineSequence" href="/motion/how-it-works#families" link="See the families in How it works">
      <Fragment slot="when">several parts of one block enter in order, each with its own timing: a title, then a body, then a chart.</Fragment>
      <Fragment slot="because">one <DocLink href={glossaryHref('handle')}>handle</DocLink> plays, pauses, seeks and awaits the whole choreography, and a step can start with an earlier one.</Fragment>
    </Choice>
    <Choice code={false} title="Lists" when="Prefer it when" href="/motion/lists" link="Lists">
      <Fragment slot="when">the items of one list enter together, in visual order.</Fragment>
      <Fragment slot="because">one <DocLink href={glossaryHref('stagger')}>stagger</DocLink> spaces them, and the items need no steps of their own.</Fragment>
    </Choice>
    <Choice code={false} title="Text" when="Prefer it when" href="/motion/text" link="Text">
      <Fragment slot="when">one sentence is split into words or lines, and each piece plays in turn.</Fragment>
      <Fragment slot="because">the runtime makes the pieces, and you name the text once.</Fragment>
    </Choice>
  </Choices>

  <h2 id="play-a-now-playing-intro">Play a now-playing intro</h2>
  <p>
    A <DocLink href={glossaryHref('sequence')}>sequence</DocLink> plays the parts of the card in steps: the kicker, then the title, then
    the artist. One button replays it.
  </p>
  <ForFramework>
    <p slot="html">Put <code>data-motion</code> with the name of the sequence on the card, and <code>data-motion-step</code> on each part that plays a step.</p>
    <p slot="react">Call <code>useMotionSequence()</code> with the name of the sequence, put its <code>ref</code> on the card, and render each part as a <code>&lt;Motion step&gt;</code>.</p>
    <p slot="angular">Put <code>udxMotionSequence</code> on the card, and <code>data-motion-step</code> on each part: the directive binds the steps.</p>
    <p slot="svelte">Attach <code>motionSequence()</code> to the card, and put <code>data-motion-step</code> on each part.</p>
  </ForFramework>
  <MotionUsage name="motion-sequences-intro" layout="split" previewHeight={248}>
    <HtmlExample slot="html" name="motion-sequences-intro" />
    <MotionSequencesIntroReact slot="react" client:visible />
    <MotionSequencesIntroAngular slot="angular" client:visible />
    <MotionSequencesIntroSvelte slot="svelte" client:visible />
  </MotionUsage>

  <h2 id="how-it-behaves">How it behaves</h2>
  <h3 id="what-starts-it">What starts it</h3>
  <ForFramework>
    <p slot="html">The root plays its steps when <code>connectMotion()</code> binds it while it is inserted. A root that is on the page when <code>connectMotion()</code> runs is <DocLink href={glossaryHref('settled')}>settled</DocLink>: it plays no entry, and <code>getSequence(root)?.play()</code> plays it.</p>
    <p slot="react">The root plays its steps when React mounts it. Content the server rendered is <DocLink href={glossaryHref('settled')}>settled</DocLink> when React hydrates it, and <code>play()</code> replays the sequence from its start.</p>
    <p slot="angular">The directive binds the root when Angular inserts it, and the steps play then, unless the root was server-rendered: that content is settled. <code>play()</code> replays the sequence.</p>
    <p slot="svelte">The attachment binds the root when Svelte inserts it, and the steps play then. Pass <code>settled: true</code> in the options of <code>motionSequence()</code> for content that is already in place.</p>
  </ForFramework>

  <h3 id="rules">Rules</h3>
  <ul>
    <li>Each child plays the step of the name it carries: a child with no name plays nothing.</li>
    <li>A step without <code>at</code> starts when everything before it has ended. With <code>at</code>, it starts when that step or that token says.</li>
    <li>A finished handle is frozen, so <code>seek()</code> does nothing on it. To seek again, play the sequence, pause it, then seek.</li>
    <li>The definition is checked in development only: a production build trusts it.</li>
  </ul>

  <h2 id="variants">Variants</h2>
  <h3 id="pause-and-seek-the-timeline">Pause and seek the timeline</h3>
  <p>
    The play method returns the <DocLink href={glossaryHref('handle')}>handle</DocLink> of the whole choreography. <code>pause()</code>
    holds it, <code>seek()</code> moves it to a time in milliseconds, and <code>currentTime</code> reads where it is. The
    slider seeks the sequence in thousandths of its length, and the readout shows the time that it has reached.
  </p>
  <ForFramework>
    <p slot="react">The handle of the latest play is <code>intro.getHandle()</code>, from <code>useMotionSequence()</code>.</p>
    <p slot="angular">The handle of the latest play is <code>intro.handle</code>, on the directive's template reference.</p>
    <p slot="svelte">The handle of the latest play is <code>getSequence(root)?.handle</code>, on the root you bind with <code>bind:this</code>.</p>
  </ForFramework>
  <MotionUsage name="motion-sequences-timeline" layout="split" previewHeight={320}>
    <HtmlExample slot="html" name="motion-sequences-timeline" />
    <MotionSequencesTimelineReact slot="react" client:visible />
    <MotionSequencesTimelineAngular slot="angular" client:visible />
    <MotionSequencesTimelineSvelte slot="svelte" client:visible />
  </MotionUsage>

  <h3 id="play-it-without-a-framework">Play it without a framework</h3>
  <p>
    <code>sequence()</code> from <code>@udixio/motion/sequence</code> binds a root without a framework, and the framework
    bindings call it too. Its <code>play()</code> returns the handle, and in a module you can await the handle's
    <code>finished</code>.
  </p>
  <Code data-code={playIntro} data-language="ts" />

  <h2 id="options">Options</h2>
  <p>
    A sequence takes a <DocLink href={glossaryHref('verb')}>verb</DocLink>, its steps, and the options that each step takes, in the table
    below. Each step takes its <DocLink href={glossaryHref('keyframes')}>keyframes</DocLink> and its timing.
  </p>
  <MotionOptions
    rows={[
      { name: 'verb', values: 'appear · reveal', default: 'appear', description: 'appear plays when the root is bound while it is inserted, or on play(). reveal plays when the root enters the view, and holds its steps in their first frames until then.' },
      { name: 'steps', values: 'name: { keyframes, … }', description: 'The steps, by name, in the order they play. Each one plays on the children that carry its name.' },
      { name: 'keyframes', values: 'a list of frames, not empty', description: 'The frames of a step, as in an appear motion.' },
      { name: 'timing', values: 'spring.* token, or { duration, easing }', default: 'spring.default.spatial · spring.default.effects', description: 'The motion of the step. Without it, the spatial fields use spring.default.spatial, and opacity uses spring.default.effects, as in an appear.' },
      { name: 'reduced', values: 'fade · instant', default: 'fade', description: 'What the step shows under reduced motion: a short fade of the opacity, or the end state at once.' },
      { name: 'stagger', values: 'tight · normal · loose', default: 'none', description: 'The delay between the elements of one step, in visual order.' },
      { name: 'origin', values: 'first · last · center', default: 'first', description: 'Where the cascade of a step starts.' },
      { name: 'at', values: 'an earlier step, or +=tight · +=normal · +=loose', description: 'When the step starts. Without it, the step starts when everything before it has ended.' },
    ]}
  />

  <h2 id="good-to-know">Good to know</h2>
  <GoodToKnow>
    <Fact label="Reduced motion">
      <p>
        Under the reduced-motion <DocLink href={glossaryHref('policy')}>policy</DocLink>, every delay is 0: the steps start together, each
        with its reduced render. A sequence that is running when reduced motion turns on jumps to its end.
      </p>
    </Fact>
    <Fact label="Timing">
      <p>
        The title plays over an extra long duration, with the standard easing. The kicker and the artist have no timing, so
        they play on the default springs.
      </p>
      <MotionTokens tokens={['duration.extraLong2', 'easing.standard', 'spring.default.effects']} />
    </Fact>
    <Fact label="Limits">
      <ul>
        <li>If a cascade has many elements, its delays stop at <code>--udx-motion-stagger-max</code>, so the elements past the cap start together. A step started with <code>at</code> is not capped.</li>
        <li>If you nest a sequence in another, the outer one does not play the children of the inner one: give those children the steps of the inner sequence.</li>
        <ForFramework as="li">
          <Fragment slot="html">If the root is on the page when <code>connectMotion()</code> runs, it plays no entry: call <code>play()</code> on its binding to play the sequence.</Fragment>
          <Fragment slot="react">If the root is server-rendered, its sequence plays no entry when React hydrates it: call <code>play()</code> to play it.</Fragment>
          <Fragment slot="angular">If the root is server-rendered, its sequence plays its entry once the directive binds in the browser: set <code>udxMotionSequenceSettled</code> to keep the content in place.</Fragment>
          <Fragment slot="svelte">If the root is already in place when Svelte binds it, its entry plays again: pass <code>settled: true</code> in the options of <code>motionSequence()</code>.</Fragment>
        </ForFramework>
        <li>Something else? See <DocLink href="/motion/troubleshooting">Troubleshooting</DocLink> and <DocLink href="/motion/limits">Limits</DocLink>.</li>
      </ul>
    </Fact>
  </GoodToKnow>
</MotionPage>
