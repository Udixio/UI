---
import MotionPage from '@/components/MotionPage.astro';
import ForFramework from '@/components/ForFramework.astro';
import Code from '@/components/Code.astro';
import Choices from '@/components/motion/Choices.astro';
import Choice from '@/components/motion/Choice.astro';
import GoodToKnow from '@/components/motion/GoodToKnow.astro';
import Fact from '@/components/motion/Fact.astro';
import MotionUsage from '@/components/motion/MotionUsage.astro';
import HtmlExample from '@/components/motion/HtmlExample.astro';
import MotionOptions from '@/components/motion/MotionOptions.astro';
import MotionTokens from '@/components/motion/MotionTokens.astro';
import { MotionPageTransitionsPlayerReact } from '@/examples/react/motion-page-transitions-player.tsx';
import { MotionPageTransitionsPlayerAngular } from '@/examples/angular/motion-page-transitions-player.ts';
import MotionPageTransitionsPlayerSvelte from '@/examples/svelte/motion-page-transitions-player.svelte';
import { glossaryHref } from '@/lib/motion-glossary';

const stylesheetCss = `/* In the document stylesheet, once: the route rules that slide the two views. */
@import '@udixio/motion/motion.css';`;

const astroLayout = `// In the script of the layout, once: the router's navigations get the direction of travel.
import { connectAstroTransitions } from '@udixio/motion/astro';

connectAstroTransitions();`;
---
<MotionPage
  slug="page-transitions"
  title="Motion: change pages"
  description="The page slides forward or back with the direction of navigation: through navigate() inside a View Transition, or through Astro's client router."
  frameworkSwitch
>
  <Fragment slot="summary">
    The page slides forward or back with the direction of navigation, inside a View Transition.
  </Fragment>

  <h2 id="when-to-use-it">When to use it</h2>
  <Choices size="compact">
    <Choice lead title="navigate" href="/motion/how-it-works#families" link="See the families in How it works">
      <Fragment slot="when">the whole page changes and the reader should see the direction of travel: from the library to the player, and back.</Fragment>
      <Fragment slot="because">the new page enters from the side the navigation comes from, inside the browser's View Transition; without View Transitions, the update runs alone.</Fragment>
    </Choice>
    <Choice code={false} title="Shared elements" when="Prefer it when" href="/motion/shared-elements" link="Shared elements">
      <Fragment slot="when">one element must morph into its counterpart on the next page, such as a cover that grows into the player.</Fragment>
      <Fragment slot="because">the two elements share a key, and the layout engine carries the one into the other.</Fragment>
    </Choice>
    <Choice code={false} title="Presence" when="Prefer it when" href="/motion/presence" link="Presence">
      <Fragment slot="when">a part of the page appears or leaves in place: a toast, a panel.</Fragment>
      <Fragment slot="because">the page stays where it is, and only that part plays its entry and its exit.</Fragment>
    </Choice>
  </Choices>

  <h2 id="import-the-stylesheet">Import the stylesheet</h2>
  <p>
    The slide is written in the route rules of <code>@udixio/motion/motion.css</code>. Import it once in the document, outside
    shadow roots, as this site does in its global stylesheet. You need it when the page changes with <code>navigate()</code>
    or with the client router: without it, <code>navigate()</code> still runs the View Transition, and the browser plays its
    default cross-fade.
  </p>
  <Code data-code={stylesheetCss} data-language="css" />

  <h2 id="go-from-the-library-to-the-player">Go from the library to the player</h2>
  <p>
    The page holds two views: the library and the player. One button goes to the other view, and the new view comes in from
    the side the navigation comes from.
  </p>
  <ForFramework>
    <p slot="html">Move the <code>hidden</code> attribute from one view to the other inside the update of <code>navigate()</code>.</p>
    <p slot="react">Call <code>navigate()</code> around the state change, and apply the change with <code>flushSync</code>, so that React has drawn the new view in time.</p>
    <p slot="angular">Call <code>navigate()</code> around the change of a signal, and detect the changes inside the update, so that the new view is drawn in time.</p>
    <p slot="svelte">Call <code>navigate()</code> around the change of state, and apply it with <code>flushSync</code>, so that Svelte has drawn the new view in time.</p>
  </ForFramework>
  {/* The demo keeps its transition to its own views (the script below, and global.css): the page around it stays. */}
  <div data-page-transitions-demo>
    <MotionUsage name="motion-page-transitions-player" layout="split" previewHeight={260}>
      <HtmlExample slot="html" name="motion-page-transitions-player" />
      <MotionPageTransitionsPlayerReact slot="react" client:visible />
      <MotionPageTransitionsPlayerAngular slot="angular" client:visible />
      <MotionPageTransitionsPlayerSvelte slot="svelte" client:visible />
    </MotionUsage>
  </div>
  <p>
    In your app, the whole document slides: the navigation, the side panels and the text move with the new view. On this
    page, the demo keeps the transition to its own two views, so that the page around it stays still.
  </p>

  <h2 id="how-it-behaves">How it behaves</h2>
  <h3 id="what-starts-it">What starts it</h3>
  <p>
    A call to <code>navigate(update, &#123; direction &#125;)</code> starts it, from a click handler. The update runs inside the
    transition, and <code>navigate()</code> resolves once the update is applied. While the transition runs, the
    <code>html</code> element carries <code>data-motion-direction</code>, with the value <code>forward</code> or
    <code>back</code>.
  </p>

  <h3 id="rules">Rules</h3>
  <ul>
    <li>Without View Transitions, under reduced motion, or with <code>--udx-motion: none</code>, the update runs alone: the page changes without sliding.</li>
    <li>An update that throws rejects <code>navigate()</code> with its error: catch the rejection where you call it.</li>
    <li>A later <code>navigate()</code> takes over the transition: the attribute of the direction belongs to the latest one.</li>
    <li>The View Transition captures the whole document, so the navigation and the rest of the page move with the view: the route rules target the root view.</li>
  </ul>

  <h2 id="variants">Variants</h2>
  <h3 id="use-it-with-your-router">Use it with your router</h3>
  <ForFramework>
    <p slot="html">Your update shows the other page. The example below moves the <code>hidden</code> attribute from one section to the other, and each button gives the direction.</p>
    <p slot="react">Your update is the navigation of your router, such as <code>useNavigate()</code> from <code>react-router</code>. Each button gives the direction of its link.</p>
    <p slot="angular">Your update awaits the navigation of <code>Router</code>. Each button gives the direction of its link.</p>
    <p slot="svelte">Your update awaits <code>goto()</code>, from <code>$app/navigation</code>. Each button gives the direction of its link.</p>
  </ForFramework>
  <MotionUsage name="motion-page-transitions-router" live={false} />

  <h3 id="use-astros-client-router">Use Astro's client router</h3>
  <p>
    On a site that Astro's <code>ClientRouter</code> navigates, call <code>connectAstroTransitions()</code>, from
    <code>@udixio/motion/astro</code>, once in the layout. It gives each navigation of the router the direction that Astro
    reports. It starts no transition of its own: the router's transition runs, with the route rules. It returns a function
    that disconnects it. This documentation site calls it in its layout.
  </p>
  <Code data-code={astroLayout} data-language="ts" />

  <h3 id="keep-an-element-across-pages">Keep an element across pages</h3>
  <p>
    An element that must morph into its counterpart on the next page is a shared element: give both the same key, as in
    <a href="/motion/shared-elements">Shared elements</a>.
  </p>

  <h2 id="options">Options</h2>
  <p><code>navigate(update, options)</code> takes these options.</p>
  <MotionOptions
    rows={[
      { name: 'update', values: 'a function, or an async one', description: 'The change of page. It runs inside the transition, and navigate() resolves once it is applied.' },
      { name: 'direction', values: 'forward · back · none', default: 'forward', description: 'Where the page goes: the new page comes from the right for forward, from the left for back. none keeps the browser cross-fade.' },
    ]}
  />

  <h2 id="good-to-know">Good to know</h2>
  <GoodToKnow>
    <Fact label="Reduced motion">
      <p>
        Under the reduced-motion <a href={glossaryHref('policy')}>policy</a>, or with <code>--udx-motion: none</code>,
        <code>navigate()</code> runs the update alone, and <code>connectAstroTransitions()</code> does nothing: the page changes
        without sliding.
      </p>
    </Fact>
    <Fact label="Timing">
      <p>
        The old view leaves, and the new one enters, on the slow <a href={glossaryHref('spatial and effects springs')}>spatial</a>
        spring, and both views fade over the same time, as the route rules of the stylesheet say.
      </p>
      <MotionTokens tokens={['spring.slow.spatial']} />
    </Fact>
    <Fact label="Limits">
      <ul>
        <ForFramework as="li">
          <Fragment slot="react">If the update only schedules the change, the browser takes the new picture before React draws the new view: apply it with <code>flushSync</code>.</Fragment>
          <Fragment slot="angular">If the update only schedules the change, the browser takes the new picture before Angular draws the new view: call <code>detectChanges()</code> inside the update.</Fragment>
          <Fragment slot="svelte">If the update only schedules the change, the browser takes the new picture before Svelte draws the new view: apply it with <code>flushSync</code>.</Fragment>
        </ForFramework>
        <li>If an element must morph into one on the next page, give both the same shared key: that morph is the layout engine's, and it does not use the View Transitions API. See <a href="/motion/shared-elements">Shared elements</a>.</li>
        <li>If the update can fail, catch the rejection of <code>navigate()</code> where you call it: it rejects with the error of the update.</li>
        <li>Something else? See <a href="/motion/troubleshooting">Troubleshooting</a> and <a href="/motion/limits">Limits</a>.</li>
      </ul>
    </Fact>
  </GoodToKnow>
</MotionPage>

<script>
  // A navigation started in the demo transitions the demo's views only (the page-transitions-demo utility, global.css).
  // navigate() sets data-motion-direction on <html> before the browser takes its first picture; this observer runs
  // first, and marks the document when a press in the demo's preview has just started it. The mark goes with the
  // attribute. Any other navigation (a link, the browser's Back) transitions the whole document.
  const DEMO_PREVIEW = '[data-page-transitions-demo] [data-view="preview"]';
  /** When the last press in the demo's preview happened: a navigation within a second of it is the demo's. */
  let pressedInDemoAt = -Infinity;
  for (const type of ['pointerdown', 'keydown'] as const) {
    document.addEventListener(
      type,
      (event) => {
        const inDemo = event.target instanceof Element && event.target.closest(DEMO_PREVIEW) !== null;
        pressedInDemoAt = inDemo ? performance.now() : -Infinity;
      },
      true,
    );
  }
  const root = document.documentElement;
  new MutationObserver(() => {
    if (!root.hasAttribute('data-motion-direction')) root.classList.remove('page-transitions-demo');
    else if (performance.now() - pressedInDemoAt < 1000) root.classList.add('page-transitions-demo');
  }).observe(root, { attributes: true, attributeFilter: ['data-motion-direction'] });
</script>
