---
import DocLink from '@/components/DocLink.astro';
import MotionPage from '@/components/MotionPage.astro';
import ForFramework from '@/components/ForFramework.astro';
import Code from '@/components/Code.astro';
import Choices from '@/components/motion/Choices.astro';
import Choice from '@/components/motion/Choice.astro';
import Steps from '@/components/motion/Steps.astro';
import Step from '@/components/motion/Step.astro';
import GoodToKnow from '@/components/motion/GoodToKnow.astro';
import Fact from '@/components/motion/Fact.astro';
import MotionUsage from '@/components/motion/MotionUsage.astro';
import HtmlExample from '@/components/motion/HtmlExample.astro';
import MotionOptions from '@/components/motion/MotionOptions.astro';
import MotionTokens from '@/components/motion/MotionTokens.astro';
import { MotionLoopReact } from '@/examples/react/motion-loop.tsx';
import { MotionLoopAngular } from '@/examples/angular/motion-loop.ts';
import MotionLoopSvelte from '@/examples/svelte/motion-loop.svelte';
import { glossaryHref } from '@/lib/motion-glossary';

const defineSpin = `import { defineMotion } from '@udixio/motion';

// A spinner that turns once a second. pause: 'control' says the page offers a button that holds it.
defineMotion('spin', {
  verb: 'loop',
  keyframes: [{ rotate: 0 }, { rotate: 360 }],
  pause: 'control',
});`;

const defineIndeterminate = `import { defineMotion } from '@udixio/motion';

// The bar is the progress itself, so the loop is essential: a paused bar would look finished.
defineMotion('indeterminate', {
  verb: 'loop',
  keyframes: [{ x: -140 }, { x: 340 }],
  pause: 'essential',
  reason: 'The bar shows that work is running; a paused bar would look finished.',
});`;

const pauseFromScript = `import { getMotion } from '@udixio/motion';

const beat = document.querySelector<HTMLElement>('#beat')!;

// pause() holds the loop on its current frame, and play() resumes it, clearing the pause.
getMotion(beat, 'loop')?.pause();
getMotion(beat, 'loop')?.play();`;
---
<MotionPage
  slug="loop"
  title="Motion: loop, and pause it"
  description="Loop a motion while its element is in view, and pause it from the page: a loop states how it is paused. In HTML, React, Angular and Svelte."
  frameworkSwitch
>
  <Fragment slot="summary">
    An element repeats while it is in view, rests out of view, and always states how a visitor can pause it.
  </Fragment>

  <h2 id="when-to-use-it">When to use it</h2>
  <Choices size="compact">
    <Choice lead href="/motion/choosing-an-api#loops" link="Compare in Choosing an API">
      <Fragment slot="title">verb: 'loop'</Fragment>
      <Fragment slot="when">an element repeats a motion with its own fields: a beat, a spinner, or a bar that is the content.</Fragment>
      <Fragment slot="because">
        it pauses out of view and in a hidden tab, stays still under reduced motion, and states how a visitor can pause it
        (WCAG 2.2.2).
      </Fragment>
    </Choice>
    <Choice when="Prefer it when" href="/motion/animate" link="animateStyle and springs">
      <Fragment slot="title">iterations: Infinity</Fragment>
      <Fragment slot="when">one element loops a CSS property that a motion cannot, such as a <code>box-shadow</code>.</Fragment>
      <Fragment slot="because">
        <code>animateStyle()</code> takes any property, and you hold the <DocLink href={glossaryHref('handle')}>handle</DocLink>: you pause it
        and cancel it.
      </Fragment>
    </Choice>
  </Choices>

  <h2 id="show-an-equalizer-and-pause-it">Show an equalizer, and pause it</h2>
  <p>
    Three bars of the player's equalizer, each on its own beat. Each beat is a <DocLink href={glossaryHref('loop')}>loop</DocLink> of its own,
    because a loop has one curve: one definition, called for each beat with its duration. The button holds all three.
  </p>
  <ForFramework>
    <p slot="html">
      Put <code>data-motion</code> on each bar, and call <code>connectMotion()</code> once for the page: the button sets
      <code>data-motion-paused</code> on the bars.
    </p>
    <p slot="react">Render each bar as a <code>&lt;Motion&gt;</code>, and pass <code>paused</code> from the state of the button.</p>
    <p slot="angular">Put <code>udxMotion</code> on each bar, and bind <code>[udxMotionPaused]</code> to the state of the button.</p>
    <p slot="svelte">Attach <code>motion()</code> to each bar, and return <code>paused</code> from its options.</p>
  </ForFramework>
  <MotionUsage name="motion-loop" layout="split" previewHeight={160}>
    <HtmlExample slot="html" name="motion-loop" />
    <MotionLoopReact slot="react" client:visible />
    <MotionLoopAngular slot="angular" client:visible />
    <MotionLoopSvelte slot="svelte" client:visible />
  </MotionUsage>

  <h2 id="how-it-behaves">How it behaves</h2>
  <h3 id="what-starts-it">What starts it</h3>
  <p>
    A loop starts as soon as it is bound, and runs forever: its <DocLink href={glossaryHref('trigger')}>trigger</DocLink> is the binding
    itself. It pauses by itself while its element is out of view or its tab is hidden, and plays again when both hold.
  </p>
  <p>
    When its element sits in a box that clips it, with <code>overflow: hidden</code> or <code>clip</code>, the loop watches that
    box instead. A marquee that slides out of its clipping box keeps playing while the box is in view.
  </p>

  <h3 id="from-bound-to-paused">From bound to paused</h3>
  <Steps label="The life of a loop">
    <Step title="Bound">The loop starts at once, from its first keyframe.</Step>
    <Step title="Running">It repeats while its element is in view and its tab is shown.</Step>
    <Step title="Out of view">It pauses by itself, and plays again when the element is back in view.</Step>
    <Step title="Paused">The page holds it on its frame, until it plays again.</Step>
  </Steps>
  <p>
    Each round starts again from the first keyframe: a loop does not play back and forth. For a motion that goes and comes
    back, as the bars of the equalizer do, end on the first keyframe again.
  </p>

  <h3 id="rules">Rules</h3>
  <ul>
    <li>
      Every loop states how it is paused: <code>pause: 'control'</code> for decoration, or <code>pause: 'essential'</code> with a
      <code>reason</code> when the loop is the content.
    </li>
    <li>A loop has a curve, not a spring: its timing is a curve, and its duration is a token or milliseconds.</li>
    <li><code>play()</code> resumes a loop that you paused, and clears the pause.</li>
  </ul>

  <h2 id="variants">Variants</h2>
  <h3 id="define-your-own-loop">Define your own loop</h3>
  <p>
    Define a motion with the verb <code>loop</code>, and give it keyframes. Its timing is a curve, and its <code>pause</code> says
    how a visitor can stop it. WCAG 2.2.2 asks that moving content which starts by itself, lasts more than five seconds and runs
    beside other content can be paused, stopped or hidden, unless it is essential.
  </p>
  <Code data-code={defineSpin} data-language="ts" />
  <ul>
    <li>
      <code>pause: 'control'</code>: the page offers a visible control that pauses the loop. Use it for decoration, as the presets do.
    </li>
    <li>
      <code>pause: 'essential'</code> with a <code>reason</code>: the loop is the content itself, such as an indeterminate progress
      bar. The validator requires the reason, and refuses it on a <code>control</code> loop.
    </li>
  </ul>
  <Code data-code={defineIndeterminate} data-language="ts" />

  <h3 id="pause-the-loop-from-script">Pause the loop from script</h3>
  <p>
    From script, in any framework, <code>getMotion(element, 'loop')</code>, from <code>@udixio/motion</code>, returns the binding
    of the loop. Its <code>pause()</code> holds the loop, and its <code>play()</code> resumes it and clears the pause.
  </p>
  <Code data-code={pauseFromScript} data-language="ts" />

  <h2 id="options">Options</h2>
  <p>A loop takes a curve as its timing, and states how it is paused with <code>pause</code>. A <code>reason</code> is needed with an essential loop.</p>
  <MotionOptions verb="loop" />

  <h2 id="good-to-know">Good to know</h2>
  <GoodToKnow>
    <Fact label="Reduced motion">
      <p>
        Under reduced motion (the <DocLink href={glossaryHref('policy')}>policy</DocLink>), or with <code>--udx-motion: none</code>, a loop does
        not play: the element keeps its stylesheet state. When reduced motion is turned off, the loop starts again, paused if the
        page has paused it. See <DocLink href="/motion/accessibility">Accessibility</DocLink>.
      </p>
    </Fact>
    <Fact label="Timing">
      <p>
        Without a <code>timing</code>, a loop runs for one second, linearly. A duration is a
        <DocLink href={glossaryHref('token')}>token</DocLink> or milliseconds. The beats of the equalizer take 800, 1100 and 1400&nbsp;ms on
        the standard curve. The duration tokens end at 1000&nbsp;ms, so the two slower beats can only be written in milliseconds, and
        the three are written alike.
        <code>--udx-motion-scale</code> scales a duration: <code>0</code> stops it.
      </p>
      <MotionTokens tokens={['easing.standard']} />
    </Fact>
    <Fact label="Limits">
      <ul>
        <ForFramework as="li">
          <Fragment slot="html">
            If you define a loop with <code>pause: 'control'</code>, add a visible control that sets <code>data-motion-paused</code>
            on it, or calls <code>pause()</code> on its binding. Without one, the visitor cannot stop the loop.
          </Fragment>
          <Fragment slot="react">
            If you define a loop with <code>pause: 'control'</code>, add a visible control that sets <code>paused</code> on its
            <code>&lt;Motion&gt;</code>. Without one, the visitor cannot stop the loop.
          </Fragment>
          <Fragment slot="angular">
            If you define a loop with <code>pause: 'control'</code>, add a visible control bound to <code>[udxMotionPaused]</code>.
            Without one, the visitor cannot stop the loop.
          </Fragment>
          <Fragment slot="svelte">
            If you define a loop with <code>pause: 'control'</code>, add a visible control that sets <code>paused</code> in the
            options of <code>motion()</code>. Without one, the visitor cannot stop the loop.
          </Fragment>
        </ForFramework>
        <li>
          If a loop varies its opacity, keep it at three cycles a second or fewer (a duration of 333 ms or more, after the motion
          scale): WCAG 2.3.1 forbids content that flashes more often. In development, the console reports a loop that does.
        </li>
        <li>
          If something else moves by itself, such as a carousel that advances, check it with <code>watchActive</code>, from
          <code>@udixio/motion/active</code>. It reports when the element is in view, in a shown tab, and with motion not reduced.
        </li>
        <li>
          Something else? See <DocLink href="/motion/troubleshooting#loop-off-screen">Troubleshooting</DocLink> and
          <DocLink href="/motion/limits">Limits</DocLink>.
        </li>
      </ul>
    </Fact>
  </GoodToKnow>
</MotionPage>
