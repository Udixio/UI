---
import DocLink from '@/components/DocLink.astro';
import MotionPage from '@/components/MotionPage.astro';
import ForFramework from '@/components/ForFramework.astro';
import ApiName from '@/components/ApiName.astro';
import Code from '@/components/Code.astro';
import MotionUsage from '@/components/motion/MotionUsage.astro';
import { glossaryHref } from '@/lib/motion-glossary';

/** Text with inline code between backticks, as parts to render. */
const parts = (text: string) => text.split('`').map((value, index) => ({ value, code: index % 2 === 1 }));

const coreModel = `import { defineMotion, motion } from '@udixio/motion';

// 1. Define: you get a reference, and the name is registered for the whole page.
const toastIn = defineMotion('toast-in', {
  verb: 'appear',
  keyframes: [
    { opacity: 0, y: 16 },
    { opacity: 1, y: 0 },
  ],
});

// 2. Attach: you get a binding, the link between this element and this motion.
const toast = document.querySelector<HTMLElement>('#saved')!;
const binding = motion(toast, toastIn, { present: false });

// 3. Trigger: ask for the element to be present. Its entry starts now.
const outcome = binding.setPresent(true);

// 4. Play: the handle controls the entry while it plays.
console.log(binding.handle?.duration); // in milliseconds
console.log(await outcome); // 'finished', or 'cancelled' when something interrupted it`;

/** The seven verbs, with the same four facts each. */
const verbs: { verb: string; kind: string; trigger: string; keyframes: string; ends: string }[] = [
  {
    verb: 'appear',
    kind: 'presence',
    trigger: 'Shown or inserted: the entry plays. Hidden or removed: the exit plays.',
    keyframes: 'Required. The entry plays them forward, the exit backward.',
    ends: 'The entry ends at rest on the last keyframe. After the exit, the element is hidden or removed.',
  },
  {
    verb: 'disappear',
    kind: 'presence',
    trigger: 'Hidden or removed: the exit plays. Shown: the element is in place at once, with no entry.',
    keyframes: 'Required. The exit plays them forward.',
    ends: 'After the exit, the element is hidden or removed.',
  },
  {
    verb: 'emphasize',
    kind: 'emphasis',
    trigger: 'A new state value, or a call to `play()`.',
    keyframes: 'Required. End them where they start.',
    ends: 'At rest on the last keyframe, until the next trigger.',
  },
  {
    verb: 'reveal',
    kind: 'view',
    trigger: 'The element enters the view. A new state value, or `play()`, replays it.',
    keyframes: 'Required. Out of view, the element waits on the first one.',
    ends: 'At rest on the last keyframe, once. With `repeat: \'always\'`, again on each entry into the view.',
  },
  {
    verb: 'scrub',
    kind: 'view',
    trigger: 'The scroll, while the element crosses its `range` of the view.',
    keyframes: 'Required. No timing: the scroll sets the progress.',
    ends: 'Never: it follows the scroll in both directions.',
  },
  {
    verb: 'loop',
    kind: 'loop',
    trigger: 'Being bound: it starts at once, while the element is in view.',
    keyframes: 'Required. Its timing is a duration (a token or milliseconds) and an easing, not a spring.',
    ends: 'Never: it repeats until you pause it, and waits while out of view.',
  },
  {
    verb: 'layout',
    kind: 'layout',
    trigger: 'A change of the layout in its scope, a new state value (after an inline style), or a call to `play()`.',
    keyframes: 'None: it measures the old and the new box.',
    ends: 'At rest in the new place.',
  },
];

const verbColumns = [
  { key: 'kind', label: 'Kind' },
  { key: 'trigger', label: 'What triggers it' },
  { key: 'keyframes', label: 'Keyframes' },
  { key: 'ends', label: 'How it ends' },
] as const;

const timingGrammar = `// A spring token: the motion follows a spring.
timing: 'spring.default.spatial'

// A curve: a duration and an easing, each a token…
timing: { duration: 'duration.medium2', easing: 'easing.standard' }

// …or a value of its own: milliseconds, a CSS easing.
timing: { duration: 3000, easing: 'cubic-bezier(0.2, 0, 0, 1)' }`;

/** What each nature of timing accepts, from the manifest's `timing.accepts`: four rows, one rule each. */
const timingNatures: { what: string; accepts: string; why: string }[] = [
  {
    what: 'A scrub',
    accepts: 'No timing',
    why: 'The scroll position sets its progress.',
  },
  {
    what: 'A loop',
    accepts: 'A curve only',
    why: 'It repeats a cycle of a fixed length, which a spring does not have. The duration takes milliseconds for a slow cycle.',
  },
  {
    what: 'What follows a moving target: `createSpring()`, the release of a gesture, the smoothing of a value',
    accepts: 'A spring only (a value also takes `none`)',
    why: 'A spring keeps its velocity when the target moves again.',
  },
  {
    what: 'Everything else: the motions (`appear`, `disappear`, `emphasize`, `reveal`, `layout`), a sequence step, `animateStyle()`, `morph()`',
    accepts: 'A spring or a curve',
    why: 'It plays from a start to an end: a spring by default, a curve when you need a set duration.',
  },
];

/** Combinations of names on one element, written the same way in every framework but for the attribute or prop. */
const combinations: { names: string; works: boolean; result: string }[] = [
  { names: 'cascade reflow', works: true, result: 'A list item: it enters in a cascade (presence), and moves when its neighbours change (layout).' },
  { names: 'slide press', works: true, result: 'It slides in and out (presence), and presses when its state changes (emphasis).' },
  { names: 'rise breathe', works: true, result: 'It rises into view (reveal), then swells and comes back, forever (loop).' },
  { names: 'fade slide', works: false, result: 'Two presences: `fade`, listed first, plays, and `slide` is ignored. Define one motion that fades and slides instead: `slide` already does both.' },
  { names: 'rise parallax', works: false, result: 'A reveal and a scrub are both view motions: `rise` plays, and `parallax` is ignored. Put the scrub on a wrapper element.' },
];

/** The families of the API: what each is for, what you call, where you import it from, and its page. */
const families: { family: string; purpose: string; importPath: string; pages: { label: string; href: string }[] }[] = [
  {
    family: 'Motions',
    purpose: 'Elements that enter and leave, draw attention, follow the layout, the view or the scroll, or loop. Seven verbs, one definition each.',
    importPath: '`@udixio/motion`, and `@udixio/motion/presets` for the presets',
    pages: [
      { label: 'Presets', href: '/motion/presets' },
      { label: 'Presence', href: '/motion/presence' },
    ],
  },
  {
    family: 'Values',
    purpose: 'A number that follows the pointer, the scroll, a state or time, written as a CSS variable that your styles use. A value is not a motion: it has no verb and no keyframes.',
    importPath: '`@udixio/motion/value`',
    pages: [
      { label: 'Values', href: '/motion/values' },
      { label: 'Counters', href: '/motion/values#counters' },
    ],
  },
  {
    family: 'Gestures',
    purpose: 'Drag, swipe or reorder an element with the pointer, with a keyboard alternative.',
    importPath: '`@udixio/motion/gesture`',
    pages: [{ label: 'Gestures', href: '/motion/gestures' }],
  },
  {
    family: 'Sequences',
    purpose: 'A timeline of steps on the children of one root, with one handle. Its verb, `appear` or `reveal`, says when it plays, and each step is written as an `appear` motion, plus `at`, when the step starts.',
    importPath: '`@udixio/motion/sequence`',
    pages: [{ label: 'Sequences', href: '/motion/sequences' }],
  },
  {
    family: 'Functions',
    purpose: 'Calls that play at once, with no definition and no binding: `animateStyle` for any CSS property beyond the keyframe fields, `createSpring` for a number on a spring, `morph` for an SVG path.',
    importPath: '`@udixio/motion/animate`, `/svg`',
    pages: [
      { label: 'animateStyle and springs', href: '/motion/animate' },
      { label: 'SVG', href: '/motion/svg' },
    ],
  },
  {
    family: 'System',
    purpose: 'What every motion follows: the timing tokens, the presets, the reduced-motion policy, the motion per breakpoint, and the tools to inspect or revert the motions of a section.',
    importPath: '`@udixio/motion` (`defineTokens`), `/policy`, `/active`, `/scope`, `/manifest`',
    pages: [
      { label: 'Tokens', href: '/motion/tokens' },
      { label: 'Accessibility', href: '/motion/accessibility' },
      { label: 'Per breakpoint', href: '/motion/per-breakpoint' },
    ],
  },
];

const stepClass = 'relative grid grid-cols-1 gap-x-4 pb-4 last:pb-0 sm:grid-cols-[2.5rem_minmax(0,1fr)] sm:pb-6';
const connectorClass = 'absolute bottom-0 left-5 top-12 hidden w-px -translate-x-1/2 bg-outline-variant sm:block';
const badgeClass = 'hidden size-10 items-center justify-center rounded-full bg-primary-container text-title-medium text-on-primary-container sm:flex';
/** The number of a step inside its card, on a phone, where the rail of badges is hidden. */
const inlineBadgeClass = 'mr-3 inline-flex size-8 items-center justify-center rounded-full bg-primary-container align-middle text-title-small text-on-primary-container sm:hidden';
const cardClass = 'grid gap-5 rounded-3xl bg-surface-container-low p-4 sm:p-5 md:grid-cols-2 md:gap-6';
const stepTitleClass = 'text-title-large text-on-surface';
const labelClass = 'text-label-medium uppercase tracking-[0.08em] text-on-surface-variant';
const bodyClass = 'mt-2 text-body-medium text-on-surface-variant [overflow-wrap:break-word]';
const inlineCodeClass = 'rounded bg-surface-container-highest px-1 py-0.5 font-mono text-body-small text-on-surface';
const thClass = 'border-b border-outline-variant px-3 py-3 text-left align-bottom text-label-large text-on-surface';
const tdClass = 'border-b border-outline-variant px-3 py-3 align-top text-body-medium text-on-surface-variant';
---
<MotionPage
  slug="how-it-works"
  title="Motion: how it works"
  description="How @udixio/motion is made: define, attach, trigger, play; the seven verbs; what one element can carry; and the families of the API."
  frameworkSwitch
>
  <ForFramework as="span" slot="summary">
    <Fragment slot="html">You define a motion, attach it with <code>data-motion</code>, and the page triggers it: the runtime plays it. This page names each part, the seven verbs, and what one element can carry.</Fragment>
    <Fragment slot="react">You define a motion, attach it with <code>&lt;Motion&gt;</code> or <code>useMotion</code>, and your state triggers it: the runtime plays it. This page names each part, the seven verbs, and what one element can carry.</Fragment>
    <Fragment slot="angular">You define a motion, attach it with <code>udxMotion</code>, and your template triggers it: the runtime plays it. This page names each part, the seven verbs, and what one element can carry.</Fragment>
    <Fragment slot="svelte">You define a motion, attach it with <code>motion()</code>, and your state triggers it: the runtime plays it. This page names each part, the seven verbs, and what one element can carry.</Fragment>
  </ForFramework>

  <p>
    Read this page once before the others. The other pages show how to do one thing each; this one says what each part of the
    library is for and how the parts fit. The <DocLink href="/motion/glossary">Glossary</DocLink> defines each word that the pages
    use.
  </p>

  <h2 id="model">The model: define, attach, trigger, play</h2>
  <p>
    Every motion goes through the same four steps. You do the first two. The third is something that happens on the page. The
    runtime does the fourth.
  </p>

  <ol class="not-prose mt-8" aria-label="The four steps of a motion">
    <li class={stepClass}>
      <span aria-hidden="true" class={connectorClass}></span>
      <span aria-hidden="true" class={badgeClass}>1</span>
      <div class={cardClass}>
        <div>
          <p class={stepTitleClass}><span aria-hidden="true" class={inlineBadgeClass}>1</span>Define</p>
          <p class={bodyClass}>
            Describe the motion once, under a name: its <DocLink class="text-primary underline underline-offset-4" href={glossaryHref('verb')}>verb</DocLink>,
            its keyframes, its timing. Or import the presets, which are already defined.
          </p>
          <p class={`${labelClass} mt-4`}>You write</p>
          <p class={bodyClass}>
            <code class={inlineCodeClass}>defineMotion(name, spec)</code>, or <code class={inlineCodeClass}>import '@udixio/motion/presets'</code>.
            The same in every framework.
          </p>
        </div>
        <div>
          <p class={labelClass}>You get back</p>
          <p class={bodyClass}>
            A <DocLink class="text-primary underline underline-offset-4" href={glossaryHref('definition')}>reference</DocLink>,
            <code class={inlineCodeClass}>&#123; name, spec &#125;</code>. The name is registered for the whole page, so any
            element can name it, even one rendered before the definition runs.
          </p>
        </div>
      </div>
    </li>
    <li class={stepClass}>
      <span aria-hidden="true" class={connectorClass}></span>
      <span aria-hidden="true" class={badgeClass}>2</span>
      <div class={cardClass}>
        <div>
          <p class={stepTitleClass}><span aria-hidden="true" class={inlineBadgeClass}>2</span>Attach</p>
          <p class={bodyClass}>Name the motion on the element it moves.</p>
          <p class={`${labelClass} mt-4`}>You write</p>
          <ForFramework>
            <p slot="html" class={bodyClass}>
              <code class={inlineCodeClass}>data-motion="toast-in"</code> on the element, and
              <code class={inlineCodeClass}>connectMotion()</code> once for the page. It binds every
              <code class={inlineCodeClass}>data-motion</code> element, now and as you add them.
            </p>
            <p slot="react" class={bodyClass}>
              <code class={inlineCodeClass}>&lt;Motion name="toast-in"&gt;</code>, which renders the element, or
              <code class={inlineCodeClass}>useMotion('toast-in')</code>, whose <code class={inlineCodeClass}>ref</code> you put
              on your own element. Both come from <code class={inlineCodeClass}>@udixio/ui-react</code>.
            </p>
            <p slot="angular" class={bodyClass}>
              <code class={inlineCodeClass}>udxMotion="toast-in"</code> on the element, with <code class={inlineCodeClass}>Motion</code>
              from <code class={inlineCodeClass}>@udixio/ui-angular</code> in the component's <code class={inlineCodeClass}>imports</code>.
            </p>
            <p slot="svelte" class={bodyClass}>
              <code class={inlineCodeClass}>&#123;&#64;attach motion('toast-in')&#125;</code> on the element, with
              <code class={inlineCodeClass}>motion</code> from <code class={inlineCodeClass}>@udixio/ui-svelte</code>.
            </p>
          </ForFramework>
        </div>
        <div>
          <p class={labelClass}>You get back</p>
          <p class={bodyClass}>
            A <DocLink class="text-primary underline underline-offset-4" href={glossaryHref('binding')}>binding</DocLink> per element and
            per <DocLink class="text-primary underline underline-offset-4" href={glossaryHref('kind')}>kind</DocLink>: it replays,
            pauses, shows or hides the element, and holds the handle of its last play.
          </p>
          <ForFramework>
            <p slot="html" class={bodyClass}>Read it with <code class={inlineCodeClass}>getMotion(element, 'presence')</code>, from <code class={inlineCodeClass}>@udixio/motion</code>.</p>
            <p slot="react" class={bodyClass}>Read it with <code class={inlineCodeClass}>getBinding('presence')</code>, from <code class={inlineCodeClass}>useMotion</code> or from the <code class={inlineCodeClass}>motionRef</code> of a <code class={inlineCodeClass}>&lt;Motion&gt;</code>.</p>
            <p slot="angular" class={bodyClass}>Take the directive in a template reference, <code class={inlineCodeClass}>#toast="udxMotion"</code>, and read <code class={inlineCodeClass}>toast.bindingOf('presence')</code>.</p>
            <p slot="svelte" class={bodyClass}>Take the element with <code class={inlineCodeClass}>bind:this</code>, and read <code class={inlineCodeClass}>getMotion(element, 'presence')</code>, from <code class={inlineCodeClass}>@udixio/motion</code>.</p>
          </ForFramework>
        </div>
      </div>
    </li>
    <li class={stepClass}>
      <span aria-hidden="true" class={connectorClass}></span>
      <span aria-hidden="true" class={badgeClass}>3</span>
      <div class={cardClass}>
        <div>
          <p class={stepTitleClass}><span aria-hidden="true" class={inlineBadgeClass}>3</span>Trigger</p>
          <p class={bodyClass}>
            Something happens on the page, and the binding plays. What counts as a
            <DocLink class="text-primary underline underline-offset-4" href={glossaryHref('trigger')}>trigger</DocLink> depends on the
            verb: the element is shown or hidden, its state changes, it enters the view, the page scrolls, the layout around it
            changes. A loop needs none: it starts when it is bound.
          </p>
        </div>
        <div>
          <p class={labelClass}>You write</p>
          <ForFramework>
            <p slot="html" class={bodyClass}>
              For a presence, remove or set <code class={inlineCodeClass}>hidden</code>, or insert the element. For an emphasis,
              change <code class={inlineCodeClass}>data-motion-state</code>.
            </p>
            <p slot="react" class={bodyClass}>
              For a presence, render the element or stop rendering it inside a <code class={inlineCodeClass}>&lt;Presence&gt;</code>,
              or change its <code class={inlineCodeClass}>present</code> prop. For an emphasis, change <code class={inlineCodeClass}>state</code>,
              or call <code class={inlineCodeClass}>play()</code> from its <code class={inlineCodeClass}>motionRef</code> (or from <code class={inlineCodeClass}>useMotion</code>).
            </p>
            <p slot="angular" class={bodyClass}>
              For a presence, add or remove the element with <code class={inlineCodeClass}>&#64;if</code>, or bind
              <code class={inlineCodeClass}>[udxMotionPresent]</code>. For an emphasis, change the value bound to
              <code class={inlineCodeClass}>[udxMotionState]</code>.
            </p>
            <p slot="svelte" class={bodyClass}>
              For a presence, add or remove the element with <code class={inlineCodeClass}>&#123;#if&#125;</code> and
              <code class={inlineCodeClass}>transition:presence</code>, or pass <code class={inlineCodeClass}>present</code> in
              the options. For an emphasis, change the <code class={inlineCodeClass}>state</code> option.
            </p>
          </ForFramework>
        </div>
      </div>
    </li>
    <li class={stepClass}>
      <span aria-hidden="true" class={badgeClass}>4</span>
      <div class={cardClass}>
        <div>
          <p class={stepTitleClass}><span aria-hidden="true" class={inlineBadgeClass}>4</span>Play</p>
          <p class={bodyClass}>
            The runtime reads the timing <DocLink class="text-primary underline underline-offset-4" href={glossaryHref('token')}>tokens</DocLink>,
            applies the reduced-motion <DocLink class="text-primary underline underline-offset-4" href={glossaryHref('policy')}>policy</DocLink>,
            and plays the keyframes on the element with the Web Animations API. When the motion ends, the element is
            <DocLink class="text-primary underline underline-offset-4" href={glossaryHref('at rest')}>at rest</DocLink>: your stylesheet
            applies again.
          </p>
        </div>
        <div>
          <p class={labelClass}>You get back</p>
          <p class={bodyClass}>
            A <DocLink class="text-primary underline underline-offset-4" href={glossaryHref('handle')}>handle</DocLink>, as the
            binding's <code class={inlineCodeClass}>handle</code>: <code class={inlineCodeClass}>pause()</code>,
            <code class={inlineCodeClass}>reverse()</code>, <code class={inlineCodeClass}>seek()</code>,
            <code class={inlineCodeClass}>cancel()</code>, and <code class={inlineCodeClass}>finished</code>, which resolves to
            <code class={inlineCodeClass}>'finished'</code> or <code class={inlineCodeClass}>'cancelled'</code>. A presence also
            writes <code class={inlineCodeClass}>data-motion-presence</code> on the element: <code class={inlineCodeClass}>entering</code>,
            <code class={inlineCodeClass}>present</code> or <code class={inlineCodeClass}>exiting</code>.
          </p>
        </div>
      </div>
    </li>
  </ol>

  <h3>The four steps in your framework</h3>
  <ForFramework>
    <p slot="html">
      The toast below takes the four steps. <code>defineMotion()</code> defines it, <code>data-motion</code> and
      <code>connectMotion()</code> attach it, and the button triggers it by changing <code>hidden</code>.
    </p>
    <p slot="react">
      The toast below takes the four steps. <code>defineMotion()</code> defines it, <code>&lt;Motion&gt;</code> attaches it,
      and the button triggers it: rendering the toast plays its entry, and <code>&lt;Presence&gt;</code> keeps it on the page
      until its exit has played.
    </p>
    <p slot="angular">
      The toast below takes the four steps. <code>defineMotion()</code> defines it, <code>udxMotion</code> attaches it, and the
      button triggers it: <code>&#64;if</code> adds the toast and its entry plays, and Angular removes it once its exit has
      played.
    </p>
    <p slot="svelte">
      The toast below takes the four steps. <code>defineMotion()</code> defines it, <code>motion()</code> attaches it, and the
      button triggers it: the <code>&#123;#if&#125;</code> block adds the toast and its entry plays, and
      <code>transition:presence</code> keeps it until its exit has played.
    </p>
  </ForFramework>
  <MotionUsage name="motion-how-it-works-model" live={false} />

  <h3>The same steps without a framework</h3>
  <p>
    Each adapter calls <code>motion()</code> from <code>@udixio/motion</code> for you. Called by hand, it shows what each step
    returns. Use it in your own code when no adapter fits, such as a web component or a script that runs before your framework.
  </p>
  <Code data-code={coreModel} data-language="ts" />

  <h2 id="verbs">The seven verbs</h2>
  <p>
    The verb of a definition says what triggers the motion and how it ends. Each verb belongs to a
    <DocLink href={glossaryHref('kind')}>kind</DocLink>, and an element holds one motion of each kind.
  </p>
  <div class="not-prose mt-6">
    <table class="hidden w-full border-collapse md:table">
      <caption class="sr-only">The seven verbs: the kind of each one, what triggers it, its keyframes, and how it ends</caption>
      <thead>
        <tr>
          <th scope="col" class={thClass}>Verb</th>
          {verbColumns.map(({ label }) => <th scope="col" class={thClass}>{label}</th>)}
        </tr>
      </thead>
      <tbody>
        {verbs.map((row) => (
          <tr>
            <th scope="row" class={`${tdClass} text-left font-normal`}>
              <code class={inlineCodeClass}>{row.verb}</code>
            </th>
            {verbColumns.map(({ key }) => (
              <td class={tdClass}>{parts(row[key]).map((part) => (part.code ? <code class={inlineCodeClass}>{part.value}</code> : part.value))}</td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
    <ul class="grid gap-3 md:hidden" aria-label="The seven verbs">
      {verbs.map((row) => (
        <li class="rounded-3xl bg-surface-container-low p-5">
          <p><code class={inlineCodeClass}>{row.verb}</code></p>
          <dl class="mt-3 grid gap-3">
            {verbColumns.map(({ key, label }) => (
              <div>
                <dt class={labelClass}>{label}</dt>
                <dd class="mt-1 text-body-medium text-on-surface-variant">{parts(row[key]).map((part) => (part.code ? <code class={inlineCodeClass}>{part.value}</code> : part.value))}</dd>
              </div>
            ))}
          </dl>
        </li>
      ))}
    </ul>
  </div>
  <p>
    A verb stacks with the verbs of every other kind, and not with a second motion of its own kind. Three cases follow from
    that rule, or add to it:
  </p>
  <ul>
    <li><code>appear</code> and <code>disappear</code> exclude each other: both are presence.</li>
    <li><code>reveal</code> and <code>scrub</code> exclude each other: both are view. Put the scrub on a wrapper element.</li>
    <li><code>layout</code> applies to HTML elements only: on an SVG element, <code>motion()</code> throws, and <code>connectMotion()</code> ignores the name and says so in the console.</li>
  </ul>
  <p>
    <code>shared</code>, <code>split</code> and <code>stagger</code> are options, not verbs. <code>shared</code> gives a layout
    motion a <DocLink href={glossaryHref('shared identity')}>shared identity</DocLink>. <code>split</code> plays an <code>appear</code>,
    a <code>disappear</code> or a <code>reveal</code> on the words, letters or lines of a text. <code>stagger</code> makes
    the elements of those three verbs that start together play one after another. The options of each verb are on its
    page, and <DocLink href="/motion/presets">Presets</DocLink> shows how to write a definition.
  </p>

  <h2 id="timing">One timing grammar</h2>
  <p>
    Every part of the API that times something takes one option, <code>timing</code>, written one way: a spring
    <DocLink href={glossaryHref('token')}>token</DocLink>, or a curve, <code>&#123; duration, easing &#125;</code>, whose duration is a
    token or milliseconds and whose easing is a token or a CSS easing function. The tokens are the recommended path: they
    follow the theme's scheme and the motion scale. A duration in milliseconds is multiplied by
    <code>--udx-motion-scale</code> as a token is, and <code>resolveCurve()</code> gives a curve back in milliseconds, with
    its CSS easing as written.
  </p>
  <Code data-code={timingGrammar} data-language="ts" />
  <p>What a part accepts follows its nature:</p>
  <div class="not-prose mt-6">
    <table class="hidden w-full border-collapse md:table">
      <caption class="sr-only">The forms of timing each part of the API accepts, and why</caption>
      <thead>
        <tr>
          <th scope="col" class={thClass}>What it times</th>
          <th scope="col" class={thClass}>Accepts</th>
          <th scope="col" class={thClass}>Because</th>
        </tr>
      </thead>
      <tbody>
        {timingNatures.map((row) => (
          <tr>
            <th scope="row" class={`${tdClass} text-left font-normal`}>{parts(row.what).map((part) => (part.code ? <code class={inlineCodeClass}>{part.value}</code> : part.value))}</th>
            <td class={tdClass}>{parts(row.accepts).map((part) => (part.code ? <code class={inlineCodeClass}>{part.value}</code> : part.value))}</td>
            <td class={tdClass}>{row.why}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <ul class="grid gap-3 md:hidden" aria-label="The forms of timing each part of the API accepts">
      {timingNatures.map((row) => (
        <li class="rounded-3xl bg-surface-container-low p-5">
          <p class="text-body-medium text-on-surface">{parts(row.what).map((part) => (part.code ? <code class={inlineCodeClass}>{part.value}</code> : part.value))}</p>
          <dl class="mt-3 grid gap-3">
            <div>
              <dt class={labelClass}>Accepts</dt>
              <dd class="mt-1 text-body-medium text-on-surface-variant">{parts(row.accepts).map((part) => (part.code ? <code class={inlineCodeClass}>{part.value}</code> : part.value))}</dd>
            </div>
            <div>
              <dt class={labelClass}>Because</dt>
              <dd class="mt-1 text-body-medium text-on-surface-variant">{row.why}</dd>
            </div>
          </dl>
        </li>
      ))}
    </ul>
  </div>
  <p>
    The development checks refuse a form that a part does not accept, as they refuse any invalid option. The tokens and their
    values are on <DocLink href="/motion/tokens">Timing and tokens</DocLink>.
  </p>

  <h2 id="stacking">What one element can carry</h2>
  <p>An element can carry several motions at once, under these rules.</p>
  <ul>
    <li>
      <strong>One motion of each kind.</strong> The kinds are presence (<code>appear</code>, <code>disappear</code>), emphasis
      (<code>emphasize</code>), view (<code>reveal</code>, <code>scrub</code>), loop and layout. So an element carries five
      motions at most, and a reveal and a scrub never share an element.
    </li>
    <li>
      <strong>Several names, separated by spaces.</strong> Write the names in one place, in any order:
      <ApiName
        html={'data-motion="cascade reflow"'}
        react={'<Motion name="cascade reflow">'}
        angular={'udxMotion="cascade reflow"'}
        svelte="motion('cascade reflow')"
      />.
      <ForFramework as="span">
        <Fragment slot="react"> A list works too: <code>name=&#123;['cascade', 'reflow']&#125;</code>.</Fragment>
        <Fragment slot="angular"> A list works too: <code>[udxMotion]="['cascade', 'reflow']"</code>.</Fragment>
        <Fragment slot="svelte"> A list works too: <code>motion(['cascade', 'reflow'])</code>.</Fragment>
      </ForFramework>
    </li>
    <li>
      <strong>Never two names of one kind.</strong> To combine two effects, such as a fade and a slide, define one motion whose
      keyframes do both. If you write two, the first listed is bound and the second is ignored, whatever the order in which
      the names are defined, and in development the console says so, once per element:
      <code>"slide" ignored on an element that already has a presence motion ("fade")</code>.
    </li>
    <li>
      <strong>A component holds the kinds it animates itself.</strong> A Udixio component that animates one of its elements
      holds that <DocLink href={glossaryHref('reserved kind')}>kind</DocLink> there, with <code>reserveMotion()</code>: a Snackbar holds
      the presence of its panel, a NavigationRail the layout of its rail. A motion of that kind on it is ignored, and in
      development the console names the owner; the other kinds stay free. The list is in
      <DocLink href="/motion/choosing-an-api#element-or-component">Choosing an API</DocLink>.
    </li>
    <li>
      <strong>Values, a gesture and a sequence do not count among the five.</strong> A value and a gesture are not motions:
      they have no verb and no keyframes. A sequence has a verb and keyframes, but it is bound to its root and plays its steps
      on the children. So an element can carry its motions, any number of values, one gesture, and be the root of one
      sequence.
    </li>
    <li>
      <strong>Replace a motion by its kind.</strong> A list keeps the first name of a kind; a call replaces. In JavaScript,
      <code>motion(element, name)</code> with a motion of a kind the element already holds destroys the old binding first,
      which then does nothing when it is called, and keeps the bindings of the other kinds. Per breakpoint,
      <code class={inlineCodeClass}>--udx-motion</code> plays another motion in place of the element's own, if both are of the same kind (and, for a
      view motion, of the same verb): see <DocLink href="/motion/per-breakpoint">Per breakpoint</DocLink>.
    </li>
  </ul>
  <p>
    A motion moves the element's <DocLink href={glossaryHref('box')}>box</DocLink>, which is the element itself unless the element is
    declared with no box,
    <ForFramework as="span">
      <Fragment slot="html">as a wrapper with <code>data-motion-box="child"</code> is.</Fragment>
      <Fragment slot="react">as the element that <code>&lt;Motion as=&#123;Button&#125;&gt;</code> puts around a component is.</Fragment>
      <Fragment slot="angular">as the host of a Udixio component, such as <code>&lt;udx-button&gt;</code>, is.</Fragment>
      <Fragment slot="svelte">as a wrapper with <code>data-motion-box="child"</code> is; a Udixio component passes your attachment to its root, which is its own box.</Fragment>
    </ForFramework>
    Such an element gives its motion to its child marked <code>data-motion-box</code>, or else to its first element child.
    The element you wrote keeps the state, <code>hidden</code>, <code>data-motion-presence</code> and <code>inert</code>,
    and its box takes the pixels. An element marked <code>data-motion-box="none"</code> has no box to give: a motion on it
    binds nothing.
  </p>
  <div class="not-prose mt-6 overflow-x-auto">
    <table class="w-full min-w-[20rem] border-collapse">
      <caption class="sr-only">Combinations of motion names on one element, and what each gives</caption>
      <thead>
        <tr>
          <th scope="col" class={thClass}>Names</th>
          <th scope="col" class={thClass}>What the element does</th>
        </tr>
      </thead>
      <tbody>
        {combinations.map((row) => (
          <tr>
            <th scope="row" class={`${tdClass} whitespace-nowrap text-left font-normal`}>
              <code class={inlineCodeClass}>{row.names}</code>
              <span class={`mt-1 block text-label-medium ${row.works ? 'text-primary' : 'text-error'}`}>{row.works ? 'Works' : 'Do not'}</span>
            </th>
            <td class={tdClass}>{parts(row.result).map((part) => (part.code ? <code class={inlineCodeClass}>{part.value}</code> : part.value))}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 id="families">The families of the API</h2>
  <p>
    Motions are one family among six. Each family has its own import path, so a page loads only the ones it uses. Start from the
    need: if two families seem to answer it, <DocLink href="/motion/choosing-an-api">Choosing an API</DocLink> says which one to take.
  </p>
  <div class="not-prose mt-6">
    <ul class="grid gap-3 md:grid-cols-2">
      {families.map((row) => (
        <li class="flex flex-col gap-3 rounded-3xl bg-surface-container-low p-5">
          <p class="text-title-large text-on-surface">{row.family}</p>
          <p class="text-body-medium text-on-surface-variant">{parts(row.purpose).map((part) => (part.code ? <code class={inlineCodeClass}>{part.value}</code> : part.value))}</p>
          <p class="text-body-medium text-on-surface-variant [overflow-wrap:anywhere]">
            <span class={labelClass}>Import from</span><br />
            {parts(row.importPath).map((part) => (part.code ? <code class={inlineCodeClass}>{part.value}</code> : part.value))}
          </p>
          <p class="mt-auto flex flex-wrap gap-x-4 gap-y-1">
            {row.pages.map((page) => (
              <DocLink class="text-label-large text-primary underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-surface" href={page.href}>{page.label}</DocLink>
            ))}
          </p>
        </li>
      ))}
    </ul>
  </div>
  <p>The framework adapters attach motions, values, gestures and sequences. Their names, per framework:</p>
  <div class="not-prose mt-4 overflow-x-auto">
    <table class="w-full min-w-[20rem] border-collapse">
      <caption class="sr-only">How each framework attaches a motion, a value, a gesture and a sequence</caption>
      <thead>
        <tr>
          <th scope="col" class={thClass}>Family</th>
          <th scope="col" class={thClass}>You define it with</th>
          <th scope="col" class={thClass}>You attach it with</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row" class={`${tdClass} text-left font-normal`}>Motion</th>
          <td class={tdClass}><code class={inlineCodeClass}>defineMotion</code></td>
          <td class={tdClass}><ApiName html="data-motion" react="<Motion name> · useMotion" angular="udxMotion" svelte="motion()" /></td>
        </tr>
        <tr>
          <th scope="row" class={`${tdClass} text-left font-normal`}>Value</th>
          <td class={tdClass}><code class={inlineCodeClass}>defineValue</code></td>
          <td class={tdClass}><ApiName html="data-motion-value" react="useMotionValue" angular="udxMotionValue" svelte="motionValue()" /></td>
        </tr>
        <tr>
          <th scope="row" class={`${tdClass} text-left font-normal`}>Gesture</th>
          <td class={tdClass}><code class={inlineCodeClass}>defineGesture</code></td>
          <td class={tdClass}><ApiName html="data-motion-gesture" react="<Motion gesture> · useMotionGesture" angular="udxMotionGesture" svelte="motionGesture()" /></td>
        </tr>
        <tr>
          <th scope="row" class={`${tdClass} text-left font-normal`}>Sequence</th>
          <td class={tdClass}><code class={inlineCodeClass}>defineSequence</code></td>
          <td class={tdClass}><ApiName html="data-motion + data-motion-step" react="useMotionSequence + <Motion step>" angular="udxMotionSequence + data-motion-step" svelte="motionSequence() + data-motion-step" /></td>
        </tr>
      </tbody>
    </table>
  </div>
  <p>
    The functions and the system have no adapter: they are the same in every framework. Call a function from an event
    handler or an effect, and keep the handle it returns.
  </p>

  <h2 id="who-plays">What plays the animation</h2>
  <p>The runtime hands each animation to the browser, or plays it itself, by what it animates:</p>
  <ul>
    <li>
      <strong>The Web Animations API</strong> plays every motion (presence, emphasis, reveal, loop, layout), the steps of a
      sequence, and <code>animateStyle()</code>. A scrub too: its animation runs on a view timeline, where the browser has one.
    </li>
    <li>
      <strong>The runtime's frame loop</strong> moves the numbers that follow a spring: values, the release of a gesture,
      <code>createSpring()</code>. A value writes its number as a CSS variable, and your CSS
      decides what it moves.
    </li>
    <li>
      <strong>anime.js</strong> plays <code>morph()</code>, from <code>@udixio/motion/svg</code>: it resamples the two shapes
      of a path, so they need not have the same points. The provider <code>@udixio/motion/providers/animejs</code> uses it
      too. That is why anime.js is a dependency of the package: the install brings it in, and only these two import paths load
      it.
    </li>
  </ul>
  <p>
    Import the stylesheet <code>@udixio/motion/motion.css</code> once in the document when CSS must read the motion system:
    for page transitions, whose route rules it holds, and for CSS that uses the <code>--udx-motion-*</code> variables, yours
    or a Udixio component's, such as a spring, a duration or <code>--udx-motion-scale</code>. The motions, values, gestures,
    sequences and functions play without it: the runtime holds the tokens in JavaScript and applies the reduced-motion policy
    itself. See <DocLink href="/motion/tokens">Tokens</DocLink>.
  </p>
</MotionPage>
