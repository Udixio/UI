---
import MotionPage from '@/components/MotionPage.astro';
import ForFramework from '@/components/ForFramework.astro';
import ApiName from '@/components/ApiName.astro';
import Code from '@/components/Code.astro';
import Choices from '@/components/motion/Choices.astro';
import Choice from '@/components/motion/Choice.astro';
import Steps from '@/components/motion/Steps.astro';
import Step from '@/components/motion/Step.astro';
import GoodToKnow from '@/components/motion/GoodToKnow.astro';
import Fact from '@/components/motion/Fact.astro';
import HtmlExample from '@/components/motion/HtmlExample.astro';
import MotionUsage from '@/components/motion/MotionUsage.astro';
import MotionOptions from '@/components/motion/MotionOptions.astro';
import MotionTokens from '@/components/motion/MotionTokens.astro';
import { MotionPresenceReact } from '@/examples/react/motion-presence.tsx';
import { MotionPresenceAngular } from '@/examples/angular/motion-presence.ts';
import MotionPresenceSvelte from '@/examples/svelte/motion-presence.svelte';
import { glossaryHref } from '@/lib/motion-glossary';

// The same in every framework: a definition is attached by its name.
const ownMotion = `import { defineMotion } from '@udixio/motion';

// Enters through its keyframes, and leaves through them backward.
defineMotion('toast', {
  verb: 'appear',
  keyframes: [
    { opacity: 0, y: 16, scale: 0.96 },
    { opacity: 1, y: 0, scale: 1 },
  ],
});`;
---
<MotionPage
  slug="presence"
  title="Motion: presence, show and hide"
  description="Presence plays an entry when an element appears and an exit before it leaves, in HTML, React, Angular and Svelte."
  frameworkSwitch
>
  <Fragment slot="summary">
    An element that appears plays an entry, and an element that leaves plays its exit before it is gone: nothing on the
    page pops in or vanishes.
  </Fragment>

  <h2 id="when-to-use-it">When to use it</h2>
  <Choices size="compact">
    <Choice lead href="/motion/choosing-an-api#remove-or-keep" link="Compare in Choosing an API">
      <Fragment slot="title"><ApiName html={'data-motion + hidden'} react="<Presence> + <Motion>" angular="@if + udxMotion" svelte="{#if} + transition:presence" /></Fragment>
      <Fragment slot="when">an element enters the page and leaves it: a toast, a dialog, a panel, a message.</Fragment>
      <Fragment slot="because">its exit plays before it is gone, nobody can click it while it leaves, and under reduced motion it fades instead of moving.</Fragment>
    </Choice>
    <Choice when="Prefer it when" frameworks={['react', 'angular', 'svelte']} href="#keep-the-element-in-the-dom" link="Keep it in the DOM">
      <Fragment slot="title"><ApiName react="present" angular="[udxMotionPresent]" svelte="present" /></Fragment>
      <Fragment slot="when">the content is navigation or text that must be in the server HTML: a menu, an accordion answer.</Fragment>
      <Fragment slot="because">the element stays in the DOM, <code>hidden</code> once its exit has played.</Fragment>
    </Choice>
    <Choice code={false} title="Lists" when="Prefer it when" href="/motion/lists" link="Lists">
      <Fragment slot="when">several items enter and leave together: a queue, search results.</Fragment>
      <Fragment slot="because">they enter one after another, and the others close the gap when one leaves.</Fragment>
    </Choice>
    <Choice code={false} title="Layout" when="Prefer it when" href="/motion/layout" link="Layout">
      <Fragment slot="when">the element moves or changes size, and never leaves: a mini-player that grows.</Fragment>
      <Fragment slot="because">a layout motion carries it from its old place to its new one.</Fragment>
    </Choice>
  </Choices>

  <h2 id="show-a-toast">Show a toast</h2>
  <p>
    Save a track: a toast says so, and leaves by itself four seconds later, or at once when you press Undo. Its
    <a href={glossaryHref('entry and exit')}>entry and its exit</a> are the
    <a href={glossaryHref('preset')}>preset</a> <code>slide</code>: it rises 24 px as it fades in, and goes back down as
    it fades out.
  </p>
  <ForFramework>
    <p slot="html">Set <code>hidden</code> on the toast and its exit plays, then it is hidden. Remove <code>hidden</code> and its entry plays. <code>connectMotion()</code> watches the attribute for every element with <code>data-motion</code>.</p>
    <p slot="react">Render the toast as a <code>&lt;Motion&gt;</code> inside a <code>&lt;Presence&gt;</code>. When you stop rendering it, <code>&lt;Presence&gt;</code> keeps it until its exit has played, then React removes it.</p>
    <p slot="angular">Put <code>udxMotion</code> on the toast, inside an <code>&#64;if</code>, and add <code>Motion</code> to the component's <code>imports</code>. When the condition turns false, Angular keeps the toast until its exit has played, then removes it.</p>
    <p slot="svelte">Attach <code>motion()</code> to the toast and add <code>transition:presence</code>, inside an <code>&#123;#if&#125;</code>. When the condition turns false, Svelte keeps the toast until its exit has played, then removes it.</p>
  </ForFramework>
  <MotionUsage name="motion-presence" layout="split" previewHeight={208}>
    <HtmlExample slot="html" name="motion-presence" />
    <MotionPresenceReact slot="react" client:visible />
    <MotionPresenceAngular slot="angular" client:visible />
    <MotionPresenceSvelte slot="svelte" client:visible />
  </MotionUsage>

  <h2 id="how-it-behaves">How it behaves</h2>
  <h3 id="what-starts-it">What starts it</h3>
  <ForFramework>
    <p slot="html">The <a href={glossaryHref('trigger')}>trigger</a> is <code>hidden</code>: removing it plays the entry, and so does inserting an element; setting it plays the exit. An element on the page when <code>connectMotion()</code> runs is <a href={glossaryHref('settled')}>settled</a>: it plays no entry.</p>
    <p slot="react">The <a href={glossaryHref('trigger')}>trigger</a> is rendering: a <code>&lt;Motion&gt;</code> child of <code>&lt;Presence&gt;</code> plays its entry when you render it, and its exit when you stop. Give each child a <code>key</code>: that is how <code>&lt;Presence&gt;</code> knows which one left. Content the server rendered is <a href={glossaryHref('settled')}>settled</a> when React hydrates it: it plays no entry.</p>
    <p slot="angular">The <a href={glossaryHref('trigger')}>trigger</a> is the <code>&#64;if</code>: when it turns true the element plays its entry, and when it turns false, its exit. Content the server rendered is <a href={glossaryHref('settled')}>settled</a> when Angular hydrates it: it plays no entry.</p>
    <p slot="svelte">The <a href={glossaryHref('trigger')}>trigger</a> is the <code>&#123;#if&#125;</code>: when it turns true the element plays its entry, and when it turns false, its exit. Svelte plays the entry of server content again when it hydrates: pass <code>settled: true</code> in the options of <code>motion()</code> for an element that is already in place (<a href={glossaryHref('settled')}>settled</a>).</p>
  </ForFramework>

  <h3 id="from-entry-to-exit">From entry to exit</h3>
  <Steps label="The life of a presence">
    <Step title="Entry" state="entering">The entry plays from the first keyframe to the last.</Step>
    <Step title="At rest" state="present">The motion lets go of its inline styles: your classes apply again (<a href={glossaryHref('at rest')}>at rest</a>).</Step>
    <Step title="Exit" state="exiting">The exit plays backward. The element is <code>inert</code>: it can no longer be clicked or focused.</Step>
    <Step title="Gone">
      <ForFramework as="span" slot="state">
        <Fragment slot="html">hidden</Fragment>
        <Fragment slot="react">removed</Fragment>
        <Fragment slot="angular">removed</Fragment>
        <Fragment slot="svelte">removed</Fragment>
      </ForFramework>
      <ForFramework as="span">
        <Fragment slot="html">The element stays in the DOM, <code>hidden</code>.</Fragment>
        <Fragment slot="react">React removes the element.</Fragment>
        <Fragment slot="angular">Angular removes the element.</Fragment>
        <Fragment slot="svelte">Svelte removes the element.</Fragment>
      </ForFramework>
    </Step>
  </Steps>
  <p>
    If you show the element again during its exit, its entry starts from where the exit is: nothing jumps. The runtime
    writes the state in <code>data-motion-presence</code>. Style it with Tailwind, such as
    <code>data-[motion-presence=exiting]:pointer-events-none</code>, and do not set it yourself.
  </p>

  <h3 id="rules">Rules</h3>
  <ul>
    <li>
      An element holds one presence: one motion of each <a href={glossaryHref('kind')}>kind</a>. Of two presence names on
      one element, such as <ApiName html={'data-motion="fade slide"'} react={'name="fade slide"'} angular={'udxMotion="fade slide"'} svelte="motion('fade slide')" />, the first is bound and development reports the other.
    </li>
    <li>
      A Udixio component that shows and hides itself, such as Snackbar, Menu or SideSheet, holds its own presence
      (a <a href={glossaryHref('reserved kind')}>reserved kind</a>): a presence you put on it is ignored. Time it with its
      own <code>motion</code> prop. That is why this toast is a plain element.
    </li>
    <li>
      If focus is inside the element when it leaves, the browser drops it once the element is <code>inert</code>: name
      where it goes (<a href="#give-focus-back-when-the-element-leaves">Give focus back</a>).
    </li>
  </ul>

  <h2 id="variants">Variants</h2>
  <h3 id="keep-the-element-in-the-dom">Keep the element in the DOM</h3>
  <ForFramework>
    <Fragment slot="html">
      <p>In HTML, the element always stays in the DOM: <code>hidden</code> hides it once its exit has played. To drive it from JavaScript instead, bind it with <code>motion()</code> and call <code>setPresent()</code>, which resolves to <code>'finished'</code>, or to <code>'cancelled'</code> when a later call took over. After its exit, the element is transparent and <code>inert</code>, and keeps its space: set <code>hidden</code> once <code>setPresent(false)</code> has resolved to take it out of the layout.</p>
    </Fragment>
    <p slot="react">For a menu or an accordion answer, whose links and text must stay in the server HTML, pass <code>present</code> to <code>&lt;Motion&gt;</code> instead of rendering it with a condition. Its exit plays when <code>present</code> turns false, then <code>hidden</code> hides it; its entry plays when it turns true. It is rendered <code>hidden</code> from the server render on, and it needs no <code>&lt;Presence&gt;</code>.</p>
    <p slot="angular">For a menu or an accordion answer, whose links and text must stay in the server HTML, bind <code>[udxMotionPresent]</code> instead of using <code>&#64;if</code>. Its exit plays when it turns false, then <code>hidden</code> hides the element; its entry plays when it turns true. Angular sets <code>hidden</code> from the first render, so the server HTML hides a closed element.</p>
    <p slot="svelte">For a menu or an accordion answer, whose links and text must stay in the server HTML, pass <code>present</code> in the options of <code>motion()</code> instead of using <code>&#123;#if&#125;</code>. Its exit plays when it turns false, then <code>hidden</code> hides the element. The server runs no attachment, so write <code>hidden=&#123;!open&#125;</code> on the element as well.</p>
  </ForFramework>
  <MotionUsage name="motion-presence-flag" live={false} />

  <h3 id="use-your-own-motion">Use your own motion</h3>
  <p>
    Any presence preset works by its name: <code>fade</code>, <code>slide</code> or <code>scale</code>. For other
    <a href={glossaryHref('keyframes')}>keyframes</a>, define your own motion with the
    <a href={glossaryHref('verb')}>verb</a> <code>appear</code>: it enters through its keyframes and leaves through them
    backward. Then name it as you name a preset:
    <ApiName html={'data-motion="toast"'} react={'name="toast"'} angular={'udxMotion="toast"'} svelte="motion('toast')" />.
  </p>
  <Code data-code={ownMotion} data-language="ts" />
  <p>
    <a href="/motion/choosing-an-api#preset-or-definition">Choosing an API</a> says when a preset is enough.
  </p>

  <h3 id="give-focus-back-when-the-element-leaves">Give focus back when the element leaves</h3>
  <p>
    When the element leaves with focus inside it, such as a panel closed by its own Close button, name where focus goes:
    the exit moves it there before the element turns <code>inert</code> (WCAG 2.4.3).
  </p>
  <ForFramework>
    <p slot="html">Set <code>data-motion-restore-focus</code> to a CSS selector: it is looked up when the exit starts, and it must match an element outside the one that leaves.</p>
    <p slot="react">Pass <code>restoreFocus</code> to <code>&lt;Motion&gt;</code>: an element, or a function that returns one when the exit starts, such as the button that opened the panel.</p>
    <p slot="angular">Bind <code>[udxMotionRestoreFocus]</code> to an element, or to a function that returns one when the exit starts, such as the button that opened the panel.</p>
    <p slot="svelte">Pass <code>restoreFocus</code> in the options of <code>motion()</code>: an element, or a function that returns one when the exit starts, such as the button that opened the panel.</p>
  </ForFramework>
  <MotionUsage name="motion-presence-focus" live={false} />
  <p>If you name no target, the element stays focusable until focus leaves it or the exit ends, and development warns you once.</p>

  <h3 id="make-several-elements-follow-one-another">Make several elements follow one another</h3>
  <p>
    To make the elements that enter together follow one another, or to close the gap when one leaves, see
    <a href="/motion/lists">Lists</a>. To show a text word by word, see <a href="/motion/text">Text</a>.
  </p>

  <h2 id="options">Options</h2>
  <p>
    A presence of your own takes the verb <code>appear</code>, which enters through its keyframes and leaves backward, or
    <code>disappear</code>, which does the reverse. Both take these options.
  </p>
  <MotionOptions verb="appear" />

  <h2 id="good-to-know">Good to know</h2>
  <GoodToKnow>
    <Fact label="Reduced motion">
      <p>
        Under reduced motion (<code>prefers-reduced-motion: reduce</code>, or <code>data-motion-policy="reduce"</code> on
        <code>&lt;html&gt;</code>: the <a href={glossaryHref('policy')}>policy</a>), the entry and the exit become a short
        fade, and the element does not move. With <code>--udx-motion: none</code> on the element or an ancestor, it appears
        and disappears at once. See <a href="/motion/accessibility">Accessibility</a>.
      </p>
    </Fact>
    <Fact label="Timing">
      <p>
        Without a <code>timing</code>, an entry moves on the default spatial spring and fades on the default effects
        spring (<a href={glossaryHref('spatial and effects springs')}>spatial and effects</a>), and an exit plays on the
        default effects spring.
      </p>
      <MotionTokens tokens={['spring.default.spatial', 'spring.default.effects']} />
    </Fact>
    <Fact label="Limits">
      <ul>
        <ForFramework as="li">
          <Fragment slot="html">If you remove the element from the DOM, it goes at once, with no exit: set <code>hidden</code> instead.</Fragment>
          <Fragment slot="react">If you stop rendering the <code>&lt;Presence&gt;</code> itself, its children go at once: keep it rendered, and put the condition inside it.</Fragment>
          <Fragment slot="angular">If the element that leaves is in a child component's template, Angular does not wait for its exit: put <code>udxMotion</code> on the child's host element, in the parent's template.</Fragment>
          <Fragment slot="svelte">If a parent block removes the element, Svelte plays no transition: put <code>transition:presence</code> on the element that its own block adds and removes.</Fragment>
        </ForFramework>
        <ForFramework as="li">
          <Fragment slot="react">If a child of <code>&lt;Presence&gt;</code> holds no <code>&lt;Motion&gt;</code>, it leaves at once: put the motion on the element that plays the exit.</Fragment>
        </ForFramework>
        <li>Something else? See <a href="/motion/troubleshooting">Troubleshooting</a> and <a href="/motion/limits">Limits</a>.</li>
      </ul>
    </Fact>
  </GoodToKnow>
</MotionPage>
