---
import MotionPage from '@/components/MotionPage.astro';
import MotionStage from '@/components/motion/MotionStage.astro';
import MotionUsage from '@/components/motion/MotionUsage.astro';
import MotionOptions from '@/components/motion/MotionOptions.astro';
import MotionTokens from '@/components/motion/MotionTokens.astro';
import Pointer from '@/components/motion/scenes/Pointer.astro';
import { PointerControls } from '@/components/motion/scenes/PointerControls';
import { MotionPointerReact } from '@/examples/react/motion-pointer.tsx';
import { MotionPointerAngular } from '@/examples/angular/motion-pointer.ts';
import MotionPointerSvelte from '@/examples/svelte/motion-pointer.svelte';
import { chipClass } from '@/components/motionDemo';
---
<MotionPage
  slug="values"
  title="Motion: follow pointer or state"
  description="A continuous value, from the pointer, the scroll, a state or the time, is written to a CSS variable. In HTML, React, Angular and Svelte."
>
  <MotionStage scene="pointer" label="Live example: Follow pointer or state" height={360}>
    <Fragment slot="controls"><PointerControls client:visible /></Fragment>
    <Pointer size="page" />
    <Fragment slot="readout"><span class={`${chipClass} tracking-normal`} data-pointer-readout>level: 0.60</span></Fragment>
  </MotionStage>

  <h2>How to use it</h2>
  <p>
    A value is a continuous number that CSS can use. An element names the values it uses in
    <code>data-motion-value</code>, and the runtime writes each one on that element as
    <code>--udx-motion-value-&lt;name&gt;</code>, for as long as the element is bound.
  </p>
  <pre><code>{`<div data-motion-value="tilt-x tilt-y"
     style="transform: rotateY(calc(var(--udx-motion-value-tilt-x, 0) * 1deg))">…</div>

import { defineValue } from '@udixio/motion/value';

defineValue('tilt-x', { source: 'pointer', axis: 'x', range: [-8, 8] });`}</code></pre>

  <h2>Sources</h2>
  <ul>
    <li><code>pointer</code>: the place of the pointer across the element, on the <code>axis</code> <code>x</code>, <code>y</code> or <code>both</code>. It returns to the middle when the pointer leaves. With <code>both</code>, one value writes two variables, <code>-x</code> and <code>-y</code>, each on its own spring.</li>
    <li><code>scroll</code>: the progress of the page's scroll, on <code>block</code> or <code>inline</code>.</li>
    <li><code>state</code>: a number the page sets, clamped to its <code>range</code>.</li>
    <li><code>time</code>: a loop, whose period is the duration of its <code>timing</code>: one second by default.</li>
  </ul>
  <p>
    <code>range</code> gives the two ends, and defaults to <code>[0, 1]</code>. A value moves on
    <code>spring.default.spatial</code> and keeps its velocity when its target moves again; <code>spring: 'none'</code>
    writes it at once. A state value with a <code>format</code> is a counter: see <a href="/motion/counters">Count a number</a>.
  </p>
  <pre><code>{`import { value } from '@udixio/motion/value';

const gauge = value(bar, 'level');   // writes --udx-motion-value-level on bar
gauge.set(0.8);                      // moves to 0.8, clamped to the range
const stop = gauge.subscribe((number) => console.log(number)); // each frame
gauge.destroy();                     // stops writing and removes the variable`}</code></pre>
  <p>
    A <code>unit</code> writes the number a second time with its unit, so the CSS needs no <code>calc()</code>:
  </p>
  <pre><code>{`defineValue('tilt', { source: 'pointer', axis: 'both', range: [-8, 8], unit: 'deg' });`}</code></pre>
  <pre><code>{`<div data-motion-value="tilt"
     style="transform: rotateX(var(--udx-motion-value-tilt-y-deg)) rotateY(var(--udx-motion-value-tilt-x-deg))">…</div>`}</code></pre>

  <h2>Use it in the frameworks</h2>
  <p>
    The example names each value on the element it moves. React <code>useMotionValue('tilt-x')</code> returns a
    <code>ref</code> and <code>get()</code>, <code>set()</code> and <code>subscribe()</code>; Angular
    <code>udxMotionValue="tilt-x"</code>; Svelte <code>&#123;&#64;attach motionValue('tilt-x')&#125;</code>. Each value
    of an element is a binding of its own, so the two tilts sit on two nested elements.
  </p>
  <MotionUsage name="motion-pointer">
    <MotionPointerReact slot="react" client:visible />
    <MotionPointerAngular slot="angular" client:visible />
    <MotionPointerSvelte slot="svelte" client:visible />
  </MotionUsage>

  <h2>Options</h2>
  <MotionOptions
    rows={[
      { name: 'source', values: 'pointer · scroll · state · time', description: 'Where the number comes from.' },
      { name: 'axis', values: 'x · y · both, or block · inline', default: 'x, or block', description: 'The axis a pointer or a scroll value follows. both (pointer only) writes an -x and a -y variable.' },
      { name: 'unit', values: 'deg · px · rem · %', description: 'Also writes the number with its unit, in a variable named after it (-deg, -px, -rem, -percent).' },
      { name: 'range', values: '[from, to]', default: '[0, 1]', description: 'The two ends of the number; the state value is clamped to them.' },
      { name: 'spring', values: 'spring.* token, or none', default: 'spring.default.spatial', description: 'How the value moves to its target. none writes it at once.' },
      { name: 'timing', values: 'a curve, { duration, easing }', default: '1 s, linear', description: 'The period of a time value. It applies to time only.' },
      { name: 'format', values: 'integer · decimal · percent · currency', description: 'Writes a state value as text, in the language of the page.' },
      { name: 'currency', values: 'an ISO 4217 code, such as EUR', description: 'Required with the currency format, and refused without it.' },
    ]}
  />

  <h2>Timing and tokens</h2>
  <p>A smoothed value moves on the default spatial spring. A counter, which is a formatted state, moves on the effects spring so that it never overshoots.</p>
  <MotionTokens tokens={['spring.default.spatial', 'spring.default.effects']} />

  <h2>Reduced motion</h2>
  <ul>
    <li>A smoothed value is written at once, with no spring. The scene's card does not turn: its stylesheet removes the tilt.</li>
    <li>A <code>time</code> value holds the first end of its range.</li>
    <li>Set <code>--udx-motion: none</code> on the element to write its values at once, whatever the policy.</li>
  </ul>

  <h2>Limits</h2>
  <ul>
    <li>A value's number is rounded to four decimals.</li>
    <li>A <code>pointer</code> value is read over its element only.</li>
    <li>A <code>scroll</code> value follows the scroll of the window, not that of a scrolling element inside the page.</li>
  </ul>
</MotionPage>
