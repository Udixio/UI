---
import DocLink from '@/components/DocLink.astro';
import MotionPage from '@/components/MotionPage.astro';
import ForFramework from '@/components/ForFramework.astro';
import ApiName from '@/components/ApiName.astro';
import Code from '@/components/Code.astro';
import Choices from '@/components/motion/Choices.astro';
import Choice from '@/components/motion/Choice.astro';
import Steps from '@/components/motion/Steps.astro';
import Step from '@/components/motion/Step.astro';
import GoodToKnow from '@/components/motion/GoodToKnow.astro';
import Fact from '@/components/motion/Fact.astro';
import HtmlExample from '@/components/motion/HtmlExample.astro';
import MotionUsage from '@/components/motion/MotionUsage.astro';
import MotionOptions from '@/components/motion/MotionOptions.astro';
import MotionTokens from '@/components/motion/MotionTokens.astro';
import { MotionRevealReact } from '@/examples/react/motion-reveal.tsx';
import { MotionRevealAngular } from '@/examples/angular/motion-reveal.ts';
import MotionRevealSvelte from '@/examples/svelte/motion-reveal.svelte';
import { glossaryHref } from '@/lib/motion-glossary';

const defineRiseAgain = `import { defineMotion } from '@udixio/motion';

// Each entry plays the reveal again: the element goes back to its first frame when it leaves the view.
defineMotion('rise-again', {
  verb: 'reveal',
  keyframes: [{ opacity: 0, y: 24 }, { opacity: 1, y: 0 }],
  stagger: 'normal',
  repeat: 'always',
});`;
---
<MotionPage
  slug="reveal"
  title="Motion: reveal on scroll"
  description="Reveal an element when it enters the view, in HTML, React, Angular and Svelte: it waits in its first frame, then plays once, or on each entry with repeat."
  frameworkSwitch
>
  <Fragment slot="summary">
    An element waits in its first frame until it scrolls into view, then plays once: a track list rises as the reader
    reaches each track.
  </Fragment>

  <h2 id="when-to-use-it">When to use it</h2>
  <Choices size="compact">
    <Choice lead href="/motion/choosing-an-api#scroll" link="Compare in Choosing an API">
      <Fragment slot="title"><ApiName html={'data-motion="rise"'} react={'<Motion name="rise">'} angular={'udxMotion="rise"'} svelte="motion('rise')" /></Fragment>
      <Fragment slot="when">elements sit below the fold and must play when the reader scrolls to them: a feed, a track list, the sections of a page.</Fragment>
      <Fragment slot="because">each one waits in its first frame until it enters the view, so nothing plays off screen and the reader sees it arrive.</Fragment>
    </Choice>
    <Choice code={false} title="Scrub" when="Prefer it when" href="/motion/scrub" link="Scrub">
      <Fragment slot="when">the motion must follow the scroll position, not play once: a progress line along a long page.</Fragment>
      <Fragment slot="because">it runs from its first frame to its last as the reader scrolls, forwards and backwards.</Fragment>
    </Choice>
    <Choice code={false} title="Lists" when="Prefer it when" href="/motion/lists" link="Lists">
      <Fragment slot="when">the items must enter together, after an action: a queue after Add.</Fragment>
      <Fragment slot="because">they cascade in visual order, and a leaving item lets the others close the gap.</Fragment>
    </Choice>
    <Choice code={false} title="Text" when="Prefer it when" href="/motion/text" link="Text">
      <Fragment slot="when">the words of a sentence must arrive one after another.</Fragment>
      <Fragment slot="because">each word waits in its first frame, then plays in turn.</Fragment>
    </Choice>
  </Choices>

  <h2 id="rise-each-track-as-it-arrives">Rise each track as it arrives</h2>
  <p>
    A track list in a box that scrolls: each track rises once, as it comes into the view of the list. Scroll the list to
    see the rest arrive. The <DocLink href={glossaryHref('preset')}>preset</DocLink> <code>rise</code> fades each track in while it
    rises 24 px.
  </p>
  <ForFramework>
    <p slot="html">Put <code>data-motion="rise"</code> on each track: it waits in its first frame until it scrolls into view, then plays once.</p>
    <p slot="react">Render each track as a <code>&lt;Motion as="li" name="rise"&gt;</code>: it waits in its first frame until it enters the view, then plays once.</p>
    <p slot="angular">Put <code>udxMotion="rise"</code> on each track: it waits in its first frame until it enters the view, then plays once.</p>
    <p slot="svelte">Attach <code>motion('rise')</code> to each track: it waits in its first frame until it enters the view, then plays once.</p>
  </ForFramework>
  {/* Hydrated when idle, below the fold: the tracks in view rise as the demo enters the view. */}
  <MotionUsage name="motion-reveal" layout="split" previewHeight={[320, 296]}>
    <HtmlExample slot="html" name="motion-reveal" />
    <MotionRevealReact slot="react" client:idle />
    <MotionRevealAngular slot="angular" client:idle />
    <MotionRevealSvelte slot="svelte" client:idle />
  </MotionUsage>

  <h2 id="how-it-behaves">How it behaves</h2>
  <h3 id="what-starts-it">What starts it</h3>
  <p>
    The <DocLink href={glossaryHref('trigger')}>trigger</DocLink> is the view: an element that scrolls into view plays once. An element
    that is already in view when it mounts stays in its natural state: nothing plays. If nothing plays, see
    <DocLink href="/motion/troubleshooting#nothing-animates">Nothing animates</DocLink>.
  </p>

  <h3 id="from-waiting-to-rest">From waiting to rest</h3>
  <Steps label="The life of a reveal">
    <Step title="Waiting">The element waits in its first frame, out of sight, until it enters the view.</Step>
    <Step title="Entry">The reveal plays from its first frame to its last, once.</Step>
    <Step title="At rest">The motion lets go of its inline styles: your classes apply again (<DocLink href={glossaryHref('at rest')}>at rest</DocLink>).</Step>
  </Steps>

  <h3 id="rules">Rules</h3>
  <ul>
    <li>
      An element holds one <DocLink href={glossaryHref('view motion')}>view motion</DocLink>: a reveal and a scrub exclude each other.
    </li>
    <li>
      Elements that enter the view together start one step apart, in visual order: the
      <DocLink href={glossaryHref('stagger')}>stagger</DocLink> of the preset.
    </li>
    <li>
      An element counts as in view while any part of it shows above the bottom tenth of the viewport. A box that scrolls
      around it clips the view too, so a card in a feed plays when the feed shows it.
    </li>
  </ul>

  <h2 id="variants">Variants</h2>
  <h3 id="play-the-reveal-again-on-each-entry">Play the reveal again on each entry</h3>
  <p>
    Give the definition <code>repeat: 'always'</code>. Each time the element enters the view, the reveal plays from its first
    frame, and when the element leaves the view, it goes back to its first frame. Define it once, in a module that runs
    before the element is bound, then use its name as you use the name of a preset:
  </p>
  <Code data-code={defineRiseAgain} data-language="ts" />
  <p>
    The name goes where the preset went:
    <ApiName html={'data-motion="rise-again"'} react={'<Motion name="rise-again">'} angular={'udxMotion="rise-again"'} svelte="motion('rise-again')" />.
  </p>

  <h3 id="replay-a-reveal-from-script">Replay a reveal from script</h3>
  <ForFramework>
    <p slot="html">To replay a reveal from its first frame, call <code>play()</code> on its binding: <code>getMotion(element, 'view')?.play()</code>, from <code>@udixio/motion</code>.</p>
    <p slot="react">Give the <code>&lt;Motion&gt;</code> a <code>motionRef</code>, and call <code>motionRef.current?.play()</code> from a handler. The <code>play()</code> that <code>useMotion</code> returns replays the reveal too.</p>
    <p slot="angular">Take the directive in a template reference, <code>#rise="udxMotion"</code>, and call its <code>play()</code> from a handler.</p>
    <p slot="svelte">Take the element with <code>bind:this</code>, and call <code>getMotion(element, 'view')?.play()</code>, from <code>@udixio/motion</code>.</p>
  </ForFramework>

  <h2 id="options">Options</h2>
  <p>
    <code>stagger</code> sets the step between the elements that enter the view together: they start in visual order, one step
    apart. <code>origin</code> sets where that cascade starts. <code>axis</code> makes the reveal watch the horizontal view,
    for a row of cards that scrolls sideways. <code>split</code>, which reveals a text piece by piece, is on
    <DocLink href="/motion/text#options">Text</DocLink>.
  </p>
  <MotionOptions verb="reveal" omit={['split']} />

  <h2 id="good-to-know">Good to know</h2>
  <GoodToKnow>
    <Fact label="Reduced motion">
      <ul>
        <li>Under reduced motion, a reveal shows its element at once, in its end state. This is the default, <code>reduced: 'instant'</code>.</li>
        <li>To fade the element in instead, set <code>reduced: 'fade'</code>: only the opacity changes, and nothing moves.</li>
        <li>A reveal that is running when reduced motion turns on jumps to its end.</li>
        <li>With <code>--udx-motion: none</code> on the element or an ancestor, the element shows at once, whatever the <DocLink href={glossaryHref('policy')}>policy</DocLink>.</li>
      </ul>
      <p>To set the policy, see <DocLink href="/motion/accessibility">Accessibility</DocLink>.</p>
    </Fact>
    <Fact label="Timing">
      <p>
        Without a timing, a reveal moves on the <DocLink href={glossaryHref('spatial and effects springs')}>default spatial spring</DocLink>
        and fades on the default effects spring, as an entry does. The words or letters of a split text do too. A timing you
        set applies to every field.
      </p>
      <MotionTokens tokens={['spring.default.spatial', 'spring.default.effects', 'stagger.normal']} />
    </Fact>
    <Fact label="Limits">
      <ul>
        <li>If the browser has no <code>IntersectionObserver</code>, the element is shown in its end state at once, and nothing plays.</li>
        <li>If an element must keep its reveal once it has played, leave <code>repeat</code> at <code>once</code>: an <code>always</code> reveal hides the element again when it leaves the view, even while it is still revealing.</li>
        <li>Something else? See <DocLink href="/motion/troubleshooting">Troubleshooting</DocLink> and <DocLink href="/motion/limits">Limits</DocLink>.</li>
      </ul>
    </Fact>
  </GoodToKnow>
</MotionPage>
