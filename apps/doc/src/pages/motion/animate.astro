---
import MotionPage from '@/components/MotionPage.astro';
import ForFramework from '@/components/ForFramework.astro';
import Code from '@/components/Code.astro';
import Choices from '@/components/motion/Choices.astro';
import Choice from '@/components/motion/Choice.astro';
import GoodToKnow from '@/components/motion/GoodToKnow.astro';
import Fact from '@/components/motion/Fact.astro';
import MotionUsage from '@/components/motion/MotionUsage.astro';
import HtmlExample from '@/components/motion/HtmlExample.astro';
import MotionOptions from '@/components/motion/MotionOptions.astro';
import MotionTokens from '@/components/motion/MotionTokens.astro';
import { MotionAnimatePlayerReact } from '@/examples/react/motion-animate-player.tsx';
import { MotionAnimatePlayerAngular } from '@/examples/angular/motion-animate-player.ts';
import MotionAnimatePlayerSvelte from '@/examples/svelte/motion-animate-player.svelte';
import { glossaryHref } from '@/lib/motion-glossary';

// A number that follows its target over a spring. Each frame writes the number, so the spring needs no CSS transition.
const springDot = `import { createSpring } from '@udixio/motion/animate';

const dot = document.getElementById('dot') as HTMLElement;
// Each frame writes the position of the dot, so the spring needs no CSS transition.
const offset = createSpring(0, {
  timing: 'spring.default.spatial',
  onUpdate: (value) => {
    dot.style.translate = \`\${value}px 0\`;
  },
});
offset.to(120); // moves the dot to 120 px, keeping the velocity it has`;

const cascade = `import { animateStyle, composeHandles, staggerCap, staggerDelay, staggerStep } from '@udixio/motion/animate';

const list = document.getElementById('list') as HTMLElement;
const items = [...list.children] as HTMLElement[];
// The stagger tokens are custom properties, so the computed style of the list gives their steps and their cap.
const style = getComputedStyle(list);
const handles = items.map((item, rank) =>
  animateStyle(item, { opacity: 1 }, {
    delay: staggerDelay(rank, staggerStep(style, 'normal'), staggerCap(style)),
    timing: 'spring.default.effects',
  }),
);
// One handle for the cascade: it ends with its last item.
const all = composeHandles(handles);
await all.finished; // 'finished' once every item has ended`;

const transition = `import { cssTiming } from '@udixio/motion/animate';

const panel = document.getElementById('panel') as HTMLElement;
// The transition takes the duration and the easing of the token, so the CSS and the motion match.
const { duration, easing } = cssTiming('spring.fast.effects');
panel.style.transition = \`opacity \${duration} \${easing}\`;`;
---
<MotionPage
  slug="animate"
  title="Motion: animate any CSS"
  description="Animate CSS properties of an element over a motion token, follow a number with a spring, and compose handles, with the timing helpers of the stagger. In HTML, React, Angular and Svelte."
  frameworkSwitch
>
  <Fragment slot="summary">
    Animates any CSS property of an element on a timing, and makes a number follow a moving target over a spring.
  </Fragment>

  <h2 id="when-to-use-it">When to use it</h2>
  <Choices size="compact">
    <Choice lead title="animateStyle" href="/motion/choosing-an-api#motion-or-animate-style" link="Compare in Choosing an API">
      <Fragment slot="when">a CSS property is outside the <a href={glossaryHref('keyframe')}>keyframe</a> fields (opacity, x, y, scale, rotate): a background colour, a radius, a clip path, or a number that a script follows.</Fragment>
      <Fragment slot="because">it starts from the element's current style and leaves the element at its last frame, over the same timings as the motions.</Fragment>
    </Choice>
    <Choice code={false} title="Presence" when="Prefer it when" href="/motion/presence" link="Presence">
      <Fragment slot="when">an element enters or leaves the page: a toast, a panel, a message.</Fragment>
      <Fragment slot="because">its exit plays before it is gone, which a style animation does not do for you.</Fragment>
    </Choice>
    <Choice code={false} title="Values" when="Prefer it when" href="/motion/values" link="Values">
      <Fragment slot="when">a number follows the pointer, the scroll or the time, and your styles read it.</Fragment>
      <Fragment slot="because">the value is written to a CSS variable, and your stylesheet decides what it drives.</Fragment>
    </Choice>
  </Choices>

  <h2 id="change-the-colour-of-the-player">Change the colour of the player</h2>
  <p>
    The player changes its colour, its corners and its clip when the visitor goes to the next track. None of these is a
    keyframe field, so <code>animateStyle()</code> animates them over a timing.
  </p>
  <ForFramework>
    <p slot="html">Call <code>animateStyle()</code> from the button's click listener, on the player found with <code>getElementById</code>.</p>
    <p slot="react">Call <code>animateStyle()</code> on the player's <code>ref</code>, from the button's <code>onClick</code>.</p>
    <p slot="angular">Call <code>animateStyle()</code> on the player read with <code>viewChild</code>, from a method that the button's <code>(click)</code> runs.</p>
    <p slot="svelte">Call <code>animateStyle()</code> on the player bound with <code>bind:this</code>, from the button's <code>onclick</code>.</p>
  </ForFramework>
  <MotionUsage name="motion-animate-player" layout="split" previewHeight={200}>
    <HtmlExample slot="html" name="motion-animate-player" />
    <MotionAnimatePlayerReact slot="react" client:visible />
    <MotionAnimatePlayerAngular slot="angular" client:visible />
    <MotionAnimatePlayerSvelte slot="svelte" client:visible />
  </MotionUsage>

  <h2 id="how-it-behaves">How it behaves</h2>
  <h3 id="what-starts-it">What starts it</h3>
  <p>
    A call to <code>animateStyle()</code> starts it, from a handler or an effect: nothing is bound to the element first. It
    returns a handle whose <code>finished</code> promise resolves to <code>'finished'</code> when the animation ends, or to
    <code>'cancelled'</code> when a later animation of the same properties takes over.
  </p>
  <p>
    <code>createSpring()</code> starts a number at rest, and <code>to()</code> moves it, keeping the velocity it has.
  </p>

  <h3 id="rules">Rules</h3>
  <ul>
    <li>
      A single keyframe starts from the element's current computed style, so the change
      goes on from where the element is: that is the <code>carry</code> option, on by default for one keyframe.
    </li>
    <li>With several keyframes, the motion plays from the first to the last, and <code>carry</code> is off unless you set it.</li>
    <li>
      A number from <code>createSpring()</code> takes a spring <a href={glossaryHref('token')}>token</a> only: a curve is not
      accepted.
    </li>
    <li>Under reduced motion, the element shows the frame that the <code>reduced</code> option names, at once.</li>
  </ul>

  <h2 id="variants">Variants</h2>
  <h3 id="follow-a-number-with-a-spring">Follow a number with a spring</h3>
  <p>
    <code>createSpring()</code> returns a number that follows its targets over a spring, for a value that drives a layout
    or a script. <code>onUpdate</code> receives the number once per frame while it moves, and <code>onRest</code> receives
    its target once it is at rest.
  </p>
  <Code data-code={springDot} data-language="ts" />
  <ul>
    <li><code>to(target)</code> moves the number from where it is, and keeps its velocity.</li>
    <li><code>jump(value)</code> sets it at rest, at once.</li>
    <li><code>stop()</code> leaves it where it is: no callback runs after it.</li>
  </ul>

  <h3 id="keep-the-element-and-the-spring-in-your-component">Keep the element and the spring in your component</h3>
  <ForFramework>
    <p slot="html">Keep the element and the spring as variables of the script, and create the spring when the script runs. Call <code>stop()</code> on the spring before you remove the element from the page.</p>
    <p slot="react">Put a <code>ref</code> on the element. Create the spring in a <code>useEffect</code>, and return its <code>stop()</code> as the cleanup, so that the spring stops when the component unmounts.</p>
    <p slot="angular">Read the element with <code>viewChild</code>. Create the spring in <code>ngAfterViewInit</code>, when the view exists, and call its <code>stop()</code> in <code>ngOnDestroy</code>.</p>
    <p slot="svelte">Bind the element with <code>bind:this</code>. Create the spring in the component, and return its <code>stop()</code> from an <code>$effect</code>: the cleanup runs when the component is removed.</p>
  </ForFramework>

  <h3 id="stagger-a-cascade-and-compose-its-handles">Stagger a cascade and compose its handles</h3>
  <p>
    <code>staggerDelay(rank, step, max)</code> returns the delay of a rank, <code>min(rank * step, max)</code>. The
    <a href={glossaryHref('stagger')}>stagger</a> tokens are read with <code>staggerStep()</code> and <code>staggerCap()</code>,
    from a computed style, as the runtime does for lists. <code>composeHandles()</code> joins several handles into one: its
    delay is the earliest of their delays, and its end is the latest of their ends.
  </p>
  <Code data-code={cascade} data-language="ts" />

  <h3 id="give-a-css-transition-the-same-timing">Give a CSS transition the same timing</h3>
  <p>
    <code>cssTiming()</code> returns the CSS <code>duration</code> and <code>easing</code> of a spring token or a curve, for a
    CSS transition.
  </p>
  <Code data-code={transition} data-language="ts" />

  <h2 id="options">Options</h2>
  <p><code>animateStyle</code> takes the first table, and <code>createSpring</code> the second.</p>
  <h3>animateStyle</h3>
  <MotionOptions
    rows={[
      { name: 'timing', values: 'spring.* token, a curve, or { duration, easing }', default: 'spring.default.spatial', description: 'The motion of the keyframes. --udx-motion-scale multiplies its duration.' },
      { name: 'delay', values: 'milliseconds', default: '0', description: 'Milliseconds before the motion starts.' },
      { name: 'iterations', values: 'a number, or Infinity', default: '1', description: 'How many times the motion plays. Infinity makes a loop.' },
      { name: 'carry', values: 'true · false', default: 'true for one keyframe, false for several', description: 'Whether the motion starts from the current computed values of the element.' },
      { name: 'reduced', values: 'end · start · a keyframe', default: 'end, or start for a loop', description: 'The frame that reduced motion, or a scale of 0, shows: the last keyframe, the first, or a keyframe of your own.' },
    ]}
  />
  <h3>createSpring</h3>
  <MotionOptions
    rows={[
      { name: 'timing', values: 'spring.* token', default: 'spring.default.spatial', description: 'The spring that moves the number. A curve is not accepted.' },
      { name: 'onUpdate', values: 'a function', description: 'Receives the number once per frame while it moves, and the value it jumps to.' },
      { name: 'onRest', values: 'a function', description: 'Receives the target once the number is at rest on it.' },
    ]}
  />

  <h2 id="good-to-know">Good to know</h2>
  <GoodToKnow>
    <Fact label="Reduced motion">
      <p>
        A number from <code>createSpring()</code> reaches its target at once under the reduced-motion
        <a href={glossaryHref('policy')}>policy</a>, or with <code>--udx-motion: none</code> on the document.
        <code>animateStyle()</code> shows the frame that its <code>reduced</code> option names: the last keyframe by default.
      </p>
    </Fact>
    <Fact label="Timing">
      <p>
        The player changes its colour and corners on the <a href={glossaryHref('spatial and effects springs')}>effects</a>
        spring, which never overshoots. A number that follows a target moves on the spatial spring, unless
        <code>timing</code> names another token.
      </p>
      <MotionTokens tokens={['spring.default.effects', 'spring.default.spatial']} />
    </Fact>
    <Fact label="Limits">
      <ul>
        <li>If you need a spring that takes a curve, use <code>animateStyle()</code> with <code>&#123; duration, easing &#125;</code>: <code>createSpring()</code> takes a spring token only.</li>
        <li>If you animate a custom property, such as <code>--x</code>, register it with <code>@property</code>: until then it does not interpolate.</li>
        <ForFramework as="li">
          <Fragment slot="html">If the script runs before the element is in the page, <code>getElementById()</code> returns <code>null</code>: load the script after the markup.</Fragment>
          <Fragment slot="react">If you read <code>ref.current</code> during render, it is <code>null</code>: call <code>animateStyle()</code> from a handler or an effect.</Fragment>
          <Fragment slot="angular">If you read a <code>viewChild</code> before the view exists, Angular throws: read it after <code>ngAfterViewInit</code>.</Fragment>
          <Fragment slot="svelte">If you call <code>animateStyle()</code> before the component mounts, the <code>bind:this</code> variable is still <code>undefined</code>: call it from a handler or an effect.</Fragment>
        </ForFramework>
        <li>Something else? See <a href="/motion/troubleshooting">Troubleshooting</a> and <a href="/motion/limits">Limits</a>.</li>
      </ul>
    </Fact>
  </GoodToKnow>
</MotionPage>
