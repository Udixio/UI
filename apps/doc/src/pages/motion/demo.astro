---
import MotionPage from '@/components/MotionPage.astro';
import Code from '@/components/Code.astro';
import { MotionPresenceReact } from '@/examples/react/motion-presence.tsx';
import { MotionPresenceAngular } from '@/examples/angular/motion-presence.ts';
import MotionPresenceSvelte from '@/examples/svelte/motion-presence.svelte';
import reactSource from '@/examples/react/motion-presence.tsx?raw';
import angularSource from '@/examples/angular/motion-presence.ts?raw';
import svelteSource from '@/examples/svelte/motion-presence.svelte?raw';
const example = `<!-- Markup: reference a motion by name -->
<div data-motion="fade">
  <h3>fade</h3>
  <p>Fades in when inserted, fades out when hidden.</p>
</div>
<button type="button" data-motion="press" data-state="off">Press me</button>
<ul><li data-motion="reflow">One</li></ul>

// Hide or show a card: set or remove its hidden attribute
card.hidden = true;
card.hidden = false;

// Start the runtime once, in the layout
import { connectMotion } from '@udixio/motion';
import '@udixio/motion/presets';

connectMotion();`;
---
<MotionPage title="Motion demo" description="A live demonstration of data-motion: elements reference a named motion and the runtime animates them.">
  <h1>Motion demo</h1>
  <p>Motions are defined once in TypeScript and referenced in HTML by name with <code>data-motion="&lt;name&gt;"</code>. A runtime started once by <code>connectMotion()</code> animates those elements when they are shown, hidden or change state.</p>
  <p>Content already on the page when the runtime connects does not animate. An element inserted later plays its entry.</p>

  <h2>Presence</h2>
  <p>The three cards use the <code>fade</code>, <code>slide</code> and <code>scale</code> presets. The button sets or removes <code>hidden</code> on each card: hiding plays the exit, then the card stays hidden; showing plays the entry.</p>
  <div class="not-prose flex flex-col gap-6">
    <div>
      <button type="button" data-demo-toggle aria-expanded="true" aria-controls="demo-cards" class="rounded-full bg-primary px-6 py-2.5 text-label-large text-on-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-surface">Hide cards</button>
    </div>
    <div id="demo-cards" class="grid gap-4 sm:grid-cols-3">
      <div data-motion="fade" class="rounded-2xl bg-surface-container-high p-6">
        <h3 class="text-title-medium text-on-surface">fade</h3>
        <p class="text-body-medium text-on-surface-variant">Fades in and out.</p>
      </div>
      <div data-motion="slide" class="rounded-2xl bg-surface-container-high p-6">
        <h3 class="text-title-medium text-on-surface">slide</h3>
        <p class="text-body-medium text-on-surface-variant">Fades in while rising.</p>
      </div>
      <div data-motion="scale" class="rounded-2xl bg-surface-container-high p-6">
        <h3 class="text-title-medium text-on-surface">scale</h3>
        <p class="text-body-medium text-on-surface-variant">Fades in while growing.</p>
      </div>
    </div>
  </div>

  <h2>Emphasis</h2>
  <p>An emphasis motion replays each time the element's <code>data-state</code> changes. This button flips its state between <code>off</code> and <code>on</code> on every click.</p>
  <div class="not-prose">
    <button type="button" data-motion="press" data-demo-press data-state="off" class="rounded-full bg-primary px-6 py-2.5 text-label-large text-on-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-surface">Press me</button>
  </div>

  <h2>Layout</h2>
  <p>An element with a layout motion moves to its new place when the layout around it changes; nothing is measured by hand. Each demo below changes its layout with one button.</p>
  <h3>Alignment</h3>
  <div class="not-prose flex flex-col gap-4">
    <div>
      <button type="button" data-demo-align class="rounded-full bg-primary px-6 py-2.5 text-label-large text-on-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-surface">Toggle alignment</button>
    </div>
    <div id="demo-align" class="flex justify-start rounded-2xl bg-surface-container p-4">
      <div data-motion="reflow" data-demo-layout="pill" class="rounded-full bg-primary px-6 py-3 text-label-large text-on-primary">Pill</div>
    </div>
  </div>
  <h3>List</h3>
  <div class="not-prose flex flex-col gap-4">
    <div class="flex flex-wrap gap-3">
      <button type="button" data-demo-shuffle class="rounded-full bg-primary px-6 py-2.5 text-label-large text-on-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-surface">Shuffle</button>
      <button type="button" data-demo-rotate class="rounded-full bg-primary px-6 py-2.5 text-label-large text-on-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-surface">Move first to end</button>
    </div>
    <ul id="demo-list" class="flex flex-col gap-2">
      <li data-motion="reflow" data-demo-layout="item" class="rounded-xl bg-surface-container-high px-4 py-3 text-body-large text-on-surface"><span>One</span></li>
      <li data-motion="reflow" data-demo-layout="item" class="rounded-xl bg-surface-container-high px-4 py-3 text-body-large text-on-surface"><span>Two</span></li>
      <li data-motion="reflow" data-demo-layout="item" class="rounded-xl bg-surface-container-high px-4 py-3 text-body-large text-on-surface"><span>Three</span></li>
      <li data-motion="reflow" data-demo-layout="item" class="rounded-xl bg-surface-container-high px-4 py-3 text-body-large text-on-surface"><span>Four</span></li>
      <li data-motion="reflow" data-demo-layout="item" class="rounded-xl bg-surface-container-high px-4 py-3 text-body-large text-on-surface"><span>Five</span></li>
    </ul>
  </div>
  <h3>Size</h3>
  <p>The content of a card keeps its shape while the card changes size.</p>
  <div class="not-prose flex flex-col gap-4">
    <div>
      <button type="button" data-demo-grow class="rounded-full bg-primary px-6 py-2.5 text-label-large text-on-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-surface">Toggle width</button>
    </div>
    <div id="demo-size" class="flex gap-4">
      <div data-motion="reflow" data-demo-layout="card" class="flex-1 rounded-2xl bg-surface-container-high p-6">
        <div class="flex items-center gap-3">
          <h4 class="text-title-medium text-on-surface">First card</h4>
          <span data-demo-layout="chip" class="ml-auto rounded-full bg-primary px-3 py-1 text-label-medium text-on-primary">New</span>
        </div>
        <p class="mt-2 text-body-medium text-on-surface-variant">The content keeps its shape while the card resizes.</p>
      </div>
      <div data-motion="reflow" data-demo-layout="card" class="flex-1 rounded-2xl bg-surface-container-high p-6">
        <div class="flex items-center gap-3">
          <h4 class="text-title-medium text-on-surface">Second card</h4>
          <span data-demo-layout="chip" class="ml-auto rounded-full bg-primary px-3 py-1 text-label-medium text-on-primary">Beta</span>
        </div>
        <p class="mt-2 text-body-medium text-on-surface-variant">A second card, resized at the same time.</p>
      </div>
    </div>
  </div>

  <h2>Reduced motion</h2>
  <p>While checked, this control sets <code>data-motion-policy="reduce"</code> on the <code>html</code> element: entries and exits become a short fade, and emphasis does nothing.</p>
  <div class="not-prose">
    <label class="flex items-center gap-3 text-body-large text-on-surface">
      <input type="checkbox" data-demo-reduce autocomplete="off" class="size-5 accent-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-surface" />
      Reduce motion on this page
    </label>
  </div>

  <h2>Frameworks</h2>
  <p>The same named motions are available in each framework: the framework mounts and unmounts each card, and its exit plays before the card is removed.</p>
  <h3>React</h3>
  <Code codes={{ react: reactSource }}>
    <MotionPresenceReact slot="react" client:only="react" />
  </Code>
  <h3>Angular</h3>
  <Code codes={{ angular: angularSource }}>
    <MotionPresenceAngular slot="angular" client:load />
  </Code>
  <h3>Svelte</h3>
  <Code codes={{ svelte: svelteSource }}>
    <MotionPresenceSvelte slot="svelte" client:only="svelte" />
  </Code>

  <h2>The HTML</h2>
  <p>An author writes the markup below and starts the runtime once.</p>
  <pre><code>{example}</code></pre>

  <script>
    // Event delegation on document: a page script runs once, so listeners attached
    // to the elements themselves would be lost after a client-side navigation.
    document.addEventListener('click', event => {
      if (!(event.target instanceof Element)) return;
      const toggle = event.target.closest<HTMLButtonElement>('[data-demo-toggle]');
      if (toggle) {
        const hide = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!hide));
        toggle.textContent = hide ? 'Show cards' : 'Hide cards';
        for (const card of document.querySelectorAll<HTMLElement>('#demo-cards [data-motion]')) card.hidden = hide;
        return;
      }
      const press = event.target.closest<HTMLElement>('[data-demo-press]');
      if (press) press.setAttribute('data-state', press.getAttribute('data-state') === 'on' ? 'off' : 'on');
      if (event.target.closest('[data-demo-align]')) {
        const row = document.getElementById('demo-align');
        if (row) {
          const toEnd = row.classList.contains('justify-start');
          row.classList.toggle('justify-start', !toEnd);
          row.classList.toggle('justify-end', toEnd);
        }
        return;
      }
      if (event.target.closest('[data-demo-shuffle]')) {
        const list = document.getElementById('demo-list');
        if (list) list.append(...shuffled([...list.querySelectorAll<HTMLElement>('li')]));
        return;
      }
      if (event.target.closest('[data-demo-rotate]')) {
        const list = document.getElementById('demo-list');
        const first = list?.firstElementChild;
        if (list && first) list.append(first);
        return;
      }
      if (event.target.closest('[data-demo-grow]')) {
        document.querySelector<HTMLElement>('#demo-size [data-demo-layout="card"]')?.classList.toggle('grow-[3]');
      }
    });

    document.addEventListener('change', event => {
      if (!(event.target instanceof Element)) return;
      const reduce = event.target.closest<HTMLInputElement>('[data-demo-reduce]');
      if (!reduce) return;
      if (reduce.checked) document.documentElement.setAttribute('data-motion-policy', 'reduce');
      else document.documentElement.removeAttribute('data-motion-policy');
    });

    // A random order of the items that differs from their current one.
    function shuffled(items: HTMLElement[]): HTMLElement[] {
      const order = [...items];
      do {
        for (let i = order.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [order[i], order[j]] = [order[j], order[i]];
        }
      } while (items.length > 1 && order.every((item, index) => item === items[index]));
      return order;
    }
  </script>
</MotionPage>
