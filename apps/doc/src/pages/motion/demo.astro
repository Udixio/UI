  <h2>Frameworks</h2>
  <p>The same named motions are available in each framework: the framework mounts and unmounts each card, and its exit plays before the card is removed.</p>
  <h3>React</h3>
  <Code codes={{ react: reactSource }}>
    <MotionPresenceReact slot="react" client:only="react" />
  </Code>
  <h3>Angular</h3>
  <Code codes={{ angular: angularSource }}>
    <MotionPresenceAngular slot="angular" client:load />
  </Code>
  <h3>Svelte</h3>
  <Code codes={{ svelte: svelteSource }}>
    <MotionPresenceSvelte slot="svelte" client:only="svelte" />
  </Code>

  <h2>The HTML</h2>
  <p>An author writes the markup below and starts the runtime once.</p>
  <pre><code>{example}</code></pre>

  <script>
    import { defineMotion, getMotion } from '@udixio/motion';
    import { defineValue } from '@udixio/motion/value';
    import { defineSequence, getSequence } from '@udixio/motion/sequence';
    import { defineGesture } from '@udixio/motion/gesture';
    import { morph } from '@udixio/motion/svg';
    import { scrollTo } from '@udixio/motion/scroll';

    // Gestures: a drag, a swipe that takes its item out of the list, and a reorder. Each has a keyboard alternative.
    defineGesture('demo-drag', { kind: 'drag', alternative: 'arrows' });
    defineGesture('demo-swipe', { kind: 'swipe', alternative: 'action' });
    defineGesture('demo-reorder', { kind: 'reorder', alternative: 'grab' });

    // Values: a number written on each element that names it, as --udx-motion-value-<name>.
    defineValue('demo-tilt-x', { source: 'pointer', axis: 'x', range: [-8, 8] });
    defineValue('demo-tilt-y', { source: 'pointer', axis: 'y', range: [6, -6] });
    defineValue('demo-reading', { source: 'scroll' });
    // Counters: a state value with a format, also written as the text of its element.
    defineValue('demo-count', { source: 'state', format: 'integer', range: [0, 100000] });
    defineValue('demo-share', { source: 'state', format: 'percent', range: [0, 1] });
    // A sequence: the steps of the children of its root, with one handle for all of them.
    defineSequence('demo-hero', {
      verb: 'reveal',
      steps: {
        title: { keyframes: [{ opacity: 0, y: 24 }, { opacity: 1, y: 0 }] },
        subtitle: { keyframes: [{ opacity: 0 }, { opacity: 1 }], at: '+=normal' },
        actions: { keyframes: [{ opacity: 0, scale: 0.9 }, { opacity: 1, scale: 1 }], stagger: 'tight' },
      },
    });

    // A cascade whose exit takes the item out of the flow, so that its neighbours close the gap as it fades.
    defineMotion('demo-leave', {
      verb: 'appear',
      keyframes: [{ opacity: 0, y: 16 }, { opacity: 1, y: 0 }],
      stagger: 'normal',
      exit: 'out-of-flow',
    });

    // Text: a heading revealed by its words, and a line written by its letters.
    defineMotion('demo-title-words', {
      verb: 'reveal',
      split: 'words',
      keyframes: [{ opacity: 0, y: 12 }, { opacity: 1, y: 0 }],
    });
    defineMotion('demo-letters', {
      verb: 'appear',
      split: 'chars',
      keyframes: [{ opacity: 0, y: 6 }, { opacity: 1, y: 0 }],
    });
    // A dot that travels along the offset path of its track, out and back again on replay.
    defineMotion('demo-travel', { verb: 'appear', keyframes: [{ along: 0 }, { along: 1 }] });
    // The two icons the morph joins: a play triangle and a pause mark, in the same 24 by 24 box.
    const PLAY = 'M8 5 L19 12 L8 19 Z';
    const PAUSE = 'M7 5 H10 V19 H7 Z M14 5 H17 V19 H14 Z';
    // The morph in progress, if any: a new morph replaces it from the shape it has reached.
    let morphing: ReturnType<typeof morph> | undefined;

    // Event delegation on document: a page script runs once, so listeners attached
    // to the elements themselves would be lost after a client-side navigation.
    document.addEventListener('click', event => {
      if (!(event.target instanceof Element)) return;
      const toggle = event.target.closest<HTMLButtonElement>('[data-demo-toggle]');
      if (toggle) {
        const hide = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!hide));
        toggle.textContent = hide ? 'Show cards' : 'Hide cards';
        for (const card of document.querySelectorAll<HTMLElement>('#demo-cards [data-motion]')) card.hidden = hide;
        return;
      }
      const press = event.target.closest<HTMLElement>('[data-demo-press]');
      if (press) press.setAttribute('data-state', press.getAttribute('data-state') === 'on' ? 'off' : 'on');
      if (event.target.closest('[data-demo-align]')) {
        const row = document.getElementById('demo-align');
        if (row) {
          const toEnd = row.classList.contains('justify-start');
          row.classList.toggle('justify-start', !toEnd);
          row.classList.toggle('justify-end', toEnd);
        }
        return;
      }
      if (event.target.closest('[data-demo-shuffle]')) {
        const list = document.getElementById('demo-list');
        if (list) list.append(...shuffled([...list.querySelectorAll<HTMLElement>('li')]));
        return;
      }
      if (event.target.closest('[data-demo-rotate]')) {
        const list = document.getElementById('demo-list');
        const first = list?.firstElementChild;
        if (list && first) list.append(first);
        return;
      }
      if (event.target.closest('[data-demo-grow]')) {
        document.querySelector<HTMLElement>('#demo-size [data-demo-layout="card"]')?.classList.toggle('grow-[3]');
        return;
      }
      if (event.target.closest('[data-demo-add]')) {
        document.getElementById('demo-items')?.prepend(makeItem());
        return;
      }
      if (event.target.closest('[data-demo-add-five]')) {
        document.getElementById('demo-items')?.append(...Array.from({ length: 5 }, () => makeItem()));
        return;
      }
      if (event.target.closest('[data-demo-remove]')) {
        const first = document.querySelector<HTMLElement>('#demo-items [data-demo-list="item"]:not([hidden])');
        if (first) removeWhenHidden(first);
      }
      if (event.target.closest('[data-demo-close]')) {
        closeShot();
        return;
      }
      const pauseLoops = event.target.closest<HTMLButtonElement>('[data-demo-pause-loops]');
      if (pauseLoops) {
        // The label says what the button does next; it is the only state announced (no aria-pressed on top of it).
        const paused = !pauseLoops.hasAttribute('data-paused');
        pauseLoops.toggleAttribute('data-paused', paused);
        pauseLoops.textContent = paused ? 'Play loops' : 'Pause loops';
        for (const loop of document.querySelectorAll<HTMLElement>('[data-demo-loop]')) {
          if (paused) loop.setAttribute('data-motion-paused', '');
          else loop.removeAttribute('data-motion-paused');
        }
        return;
      }
      const replay = event.target.closest<HTMLElement>('[data-demo-replay]');
      if (replay) {
        const root = replay.closest<HTMLElement>('[data-motion="demo-hero"]');
        if (root) getSequence(root)?.play();
        return;
      }
      const shake = event.target.closest<HTMLElement>('[data-demo-shake]');
      if (shake) {
        // Each change of data-state replays the shake emphasis.
        shake.setAttribute('data-state', String(Number(shake.getAttribute('data-state')) + 1));
        return;
      }
      if (event.target.closest('[data-demo-add-count]')) {
        // The count moves to the new number: a counter in view counts up to it.
        const count = document.querySelector<HTMLElement>('[data-demo-count]');
        if (count) count.setAttribute('value', String(Number(count.getAttribute('value')) + 1000));
        return;
      }
      if (event.target.closest('[data-demo-swipe-restore]')) {
        // The four notifications again: the list is rebuilt, and the new items are bound as the others were.
        document.getElementById('demo-swipe-list')?.replaceChildren(...[1, 2, 3, 4].map(makeNotification));
        return;
      }
      if (event.target.closest('[data-demo-replay-letters]')) {
        const letters = document.getElementById('demo-letters');
        if (letters) void replayPresence(letters);
        return;
      }
      if (event.target.closest('[data-demo-draw-again]')) {
        const check = document.querySelector<SVGPathElement>('[data-demo-draw]');
        if (check) void replayPresence(check);
        return;
      }
      if (event.target.closest('[data-demo-move-again]')) {
        const dot = document.querySelector<HTMLElement>('[data-demo-travel]');
        if (dot) void replayPresence(dot);
        return;
      }
      const morphButton = event.target.closest<HTMLButtonElement>('[data-demo-morph-button]');
      if (morphButton) {
        // The name of the button stays the same: aria-pressed says whether the icon shows the pause mark.
        const pressed = morphButton.getAttribute('aria-pressed') !== 'true';
        morphButton.setAttribute('aria-pressed', String(pressed));
        const icon = document.querySelector<SVGPathElement>('[data-demo-morph]');
        if (icon) {
          morphing?.cancel();
          morphing = morph(icon, pressed ? PAUSE : PLAY);
        }
        return;
      }
      if (event.target.closest('[data-demo-scroll-back]')) {
        const text = document.getElementById('demo-text');
        if (text) scrollTo(text, { focus: true });
        return;
      }
      const shot = event.target.closest<HTMLElement>('[data-demo-shot]');
      if (shot) {
        const detail = document.getElementById('demo-detail');
        if (!detail) return;
        closeShot();
        const number = shot.dataset.demoShot ?? '';
        detail.setAttribute('data-motion-shared', 'shot-' + number);
        const label = detail.querySelector<HTMLElement>('[data-demo-detail-label]');
        if (label) label.textContent = number;
        openShot = shot;
        // In the same task: the detail appears where the thumbnail was, and the thumbnail is hidden.
        shot.hidden = true;
        detail.hidden = false;
      }
    });

    document.addEventListener('change', event => {
      if (!(event.target instanceof Element)) return;
      if (event.target.closest('[data-demo-outflow]')) {
        // The items already on the page take the motions the checkbox selects.
        const checked = outflowChecked();
        for (const item of document.querySelectorAll<HTMLElement>('#demo-items [data-demo-list="item"]'))
          item.setAttribute('data-motion', checked ? 'demo-leave reflow' : 'cascade reflow');
        return;
      }
      const reduce = event.target.closest<HTMLInputElement>('[data-demo-reduce]');
      if (!reduce) return;
      if (reduce.checked) document.documentElement.setAttribute('data-motion-policy', 'reduce');
      else document.documentElement.removeAttribute('data-motion-policy');
    });

    // A swipe the page does not refuse: the item flies out, and is aria-hidden once it is out of sight. Then it leaves the
    // list, and the items below it close the gap. Listening on the document, as the click handler does, survives a client navigation.
    document.addEventListener('motion-swipe', event => {
      const item = event.target;
      if (!(item instanceof HTMLElement) || event.defaultPrevented || !item.closest('#demo-swipe-list')) return;
      const leave = new MutationObserver(() => {
        if (item.getAttribute('aria-hidden') !== 'true') return;
        leave.disconnect();
        item.remove();
      });
      leave.observe(item, { attributes: true, attributeFilter: ['aria-hidden'] });
    });

    // A notification of the swipe list, with the gesture and the motion the markup gives the others.
    function makeNotification(number: number): HTMLLIElement {
      const item = document.createElement('li');
      item.className = 'rounded-xl bg-surface-container-high px-4 py-3 text-body-large text-on-surface';
      item.setAttribute('data-motion-gesture', 'demo-swipe');
      item.setAttribute('data-motion', 'reflow');
      item.setAttribute('data-demo-swipe', '');
      item.textContent = `Notification ${number}`;
      return item;
    }

    // A random order of the items that differs from their current one.
    function shuffled(items: HTMLElement[]): HTMLElement[] {
      const order = [...items];
      do {
        for (let i = order.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [order[i], order[j]] = [order[j], order[i]];
        }
      } while (items.length > 1 && order.every((item, index) => item === items[index]));
      return order;
    }

    // The items of the markup are 1 to 3; each new item takes the next number.
    let itemCount = 3;

    // A new item, with the motions the checkbox selects.
    function makeItem(): HTMLLIElement {
      itemCount += 1;
      const item = document.createElement('li');
      item.className = 'rounded-xl bg-surface-container-high px-4 py-3 text-body-large text-on-surface';
      item.setAttribute('data-demo-list', 'item');
      item.setAttribute('data-motion', outflowChecked() ? 'demo-leave reflow' : 'cascade reflow');
      const label = document.createElement('span');
      label.textContent = `Item ${itemCount}`;
      item.append(label);
      return item;
    }

    function outflowChecked(): boolean {
      return document.querySelector<HTMLInputElement>('[data-demo-outflow]')?.checked ?? false;
    }

    // Hiding plays the exit; the node is removed once the exit has ended and the item is display: none.
    // The first check waits a frame: the hidden attribute alone already hides the item.
    function removeWhenHidden(item: HTMLElement): void {
      item.hidden = true;
      const check = () => {
        if (!item.isConnected || getComputedStyle(item).display === 'none') item.remove();
        else requestAnimationFrame(check);
      };
      requestAnimationFrame(check);
    }

    // Plays a presence motion again: its exit, then its entry, on the same element. The element ends where it was, shown.
    async function replayPresence(element: HTMLElement | SVGElement): Promise<void> {
      const presence = getMotion(element, 'presence');
      if (!presence) return;
      await presence.setPresent(false);
      await presence.setPresent(true);
    }

    // The thumbnail whose detail is open, if any.
    let openShot: HTMLElement | undefined;

    // Close the open detail: its thumbnail comes back in its place.
    function closeShot(): void {
      const detail = document.getElementById('demo-detail');
      if (!detail || !openShot) return;
      detail.hidden = true;
      openShot.hidden = false;
      openShot = undefined;
    }
  </script>
</MotionPage>
