---
import MotionPage from '@/components/MotionPage.astro';
import Code from '@/components/Code.astro';
import { MotionPresenceReact } from '@/examples/react/motion-presence.tsx';
import { MotionPresenceAngular } from '@/examples/angular/motion-presence.ts';
import MotionPresenceSvelte from '@/examples/svelte/motion-presence.svelte';
import reactSource from '@/examples/react/motion-presence.tsx?raw';
import angularSource from '@/examples/angular/motion-presence.ts?raw';
import svelteSource from '@/examples/svelte/motion-presence.svelte?raw';
const example = `<!-- Markup: reference a motion by name -->
<div data-motion="fade">
  <h3>fade</h3>
  <p>Fades in when inserted, fades out when hidden.</p>
</div>
<button type="button" data-motion="press" data-state="off">Press me</button>
<ul><li data-motion="reflow">One</li></ul>

// Hide or show a card: set or remove its hidden attribute
card.hidden = true;
card.hidden = false;

// Start the runtime once, in the layout
import { connectMotion } from '@udixio/motion';
import '@udixio/motion/presets';

connectMotion();`;
const listExample = `<!-- A list item enters and leaves with cascade, and follows its neighbours with reflow -->
<li data-motion="cascade reflow">…</li>

// Add an item at the top: it cascades in, and the items below move down
list.prepend(item);

// Remove it: setting hidden plays its exit, then it is display: none
item.hidden = true;

// A leaving item that takes itself out of the flow: the neighbours close the gap as it fades
import { defineMotion } from '@udixio/motion';
defineMotion('demo-leave', {
  verb: 'appear',
  keyframes: [{ opacity: 0, y: 16 }, { opacity: 1, y: 0 }],
  stagger: 'normal',
  exit: 'out-of-flow',
});`;
const sharedExample = `<!-- Two elements with the same key: the one that appears starts from where the other was -->
<button type="button" data-motion="reflow" data-motion-shared="shot-1">1</button>
<div data-motion="reflow" data-motion-shared="shot-1" hidden>Detail of 1</div>

// Open the detail in place of the thumbnail: both changes happen in the same task
thumbnail.hidden = true;
detail.hidden = false;`;
const revealExample = `<!-- An element rises into place when it scrolls into view; elements that enter the view together cascade -->
<div data-motion="rise">…</div>

// A reveal that goes back to its first frame when it leaves the view, and plays again on each entry
import { defineMotion } from '@udixio/motion';
defineMotion('rise-again', {
  verb: 'reveal',
  keyframes: [{ opacity: 0, y: 24 }, { opacity: 1, y: 0 }],
  stagger: 'normal',
  repeat: 'always',
});`;
const scrubExample = `<!-- The keyframes follow the scroll position: the element drifts as the page scrolls past it -->
<div data-motion="parallax">…</div>

// A scrub over the entry of the element into the view
import { defineMotion } from '@udixio/motion';
defineMotion('drift-in', {
  verb: 'scrub',
  keyframes: [{ opacity: 0, y: 48 }, { opacity: 1, y: 0 }],
  range: 'enter',
});`;
const loopExample = `<!-- A loop plays forever, and pauses by itself while it is out of view -->
<span data-motion="rotate">…</span>

// The page offers a control: pause and play the loop from script, or with the attribute
import { defineMotion, getMotion } from '@udixio/motion';
getMotion(spinner, 'loop')?.pause();
getMotion(spinner, 'loop')?.play();
spinner.setAttribute('data-motion-paused', '');
spinner.removeAttribute('data-motion-paused');

// A loop that is the content itself cannot be paused: its definition gives the reason
defineMotion('progress-spin', {
  verb: 'loop',
  keyframes: [{ rotate: 0 }, { rotate: 360 }],
  pause: 'essential',
  reason: 'An indeterminate progress indicator is the only sign that the page is loading.',
});`;
const valuesExample = `<!-- A value writes its number on the element that names it, as --udx-motion-value-<name> -->
<div data-motion-value="tilt-x tilt-y" style="transform: perspective(600px) rotateY(calc(var(--udx-motion-value-tilt-x, 0) * 1deg)) rotateX(calc(var(--udx-motion-value-tilt-y, 0) * 1deg))">…</div>
<div data-motion-value="reading" style="scale: var(--udx-motion-value-reading, 0) 1"></div>

// Define the values once, before the page meets them
import { defineValue } from '@udixio/motion/value';
defineValue('tilt-x', { source: 'pointer', axis: 'x', range: [-8, 8] });
defineValue('tilt-y', { source: 'pointer', axis: 'y', range: [6, -6] });
defineValue('reading', { source: 'scroll' });`;
const countersExample = `<!-- A counter is a state value with a format: its number is also written as the text -->
<data value="12480" data-motion-value="visitors">12480</data>

// Define it once: integer, decimal, percent or currency (with its ISO code)
import { defineValue } from '@udixio/motion/value';
defineValue('visitors', { source: 'state', format: 'integer', range: [0, 100000] });

// A new number: the count moves to it
document.querySelector('[data-motion-value="visitors"]').setAttribute('value', '13480');`;
const sequenceExample = `<!-- The root names the sequence; its children name their steps -->
<div data-motion="hero">
  <h3 data-motion-step="title">…</h3>
  <p data-motion-step="subtitle">…</p>
  <button type="button" data-motion-step="actions">…</button>
  <button type="button" data-motion-step="actions">…</button>
</div>

// Define the steps once. A step without "at" starts when the steps before it have ended
import { defineSequence } from '@udixio/motion/sequence';
defineSequence('hero', {
  verb: 'reveal',
  steps: {
    title: { keyframes: [{ opacity: 0, y: 24 }, { opacity: 1, y: 0 }] },
    subtitle: { keyframes: [{ opacity: 0 }, { opacity: 1 }], at: '+=normal' },
    actions: { keyframes: [{ opacity: 0, scale: 0.9 }, { opacity: 1, scale: 1 }], stagger: 'tight' },
  },
});`;
---
<MotionPage title="Motion demo" description="A live demonstration of data-motion: elements reference a named motion and the runtime animates them.">
  <h1>Motion demo</h1>
  <p>Motions are defined once in TypeScript and referenced in HTML by name with <code>data-motion="&lt;name&gt;"</code>. A runtime started once by <code>connectMotion()</code> animates those elements when they are shown, hidden or change state.</p>
  <p>Content already on the page when the runtime connects does not animate. An element inserted later plays its entry.</p>

  <h2>Presence</h2>
  <p>The three cards use the <code>fade</code>, <code>slide</code> and <code>scale</code> presets. The button sets or removes <code>hidden</code> on each card: hiding plays the exit, then the card stays hidden; showing plays the entry.</p>
  <div class="not-prose flex flex-col gap-6">
    <div>
      <button type="button" data-demo-toggle aria-expanded="true" aria-controls="demo-cards" class="rounded-full bg-primary px-6 py-2.5 text-label-large text-on-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-surface">Hide cards</button>
    </div>
    <div id="demo-cards" class="grid gap-4 sm:grid-cols-3">
      <div data-motion="fade" class="rounded-2xl bg-surface-container-high p-6">
        <h3 class="text-title-medium text-on-surface">fade</h3>
        <p class="text-body-medium text-on-surface-variant">Fades in and out.</p>
      </div>
      <div data-motion="slide" class="rounded-2xl bg-surface-container-high p-6">
        <h3 class="text-title-medium text-on-surface">slide</h3>
        <p class="text-body-medium text-on-surface-variant">Fades in while rising.</p>
      </div>
      <div data-motion="scale" class="rounded-2xl bg-surface-container-high p-6">
        <h3 class="text-title-medium text-on-surface">scale</h3>
        <p class="text-body-medium text-on-surface-variant">Fades in while growing.</p>
      </div>
    </div>
  </div>

  <h2>Emphasis</h2>
  <p>An emphasis motion replays each time the element's <code>data-state</code> changes. This button flips its state between <code>off</code> and <code>on</code> on every click.</p>
  <div class="not-prose">
    <button type="button" data-motion="press" data-demo-press data-state="off" class="rounded-full bg-primary px-6 py-2.5 text-label-large text-on-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-surface">Press me</button>
  </div>

  <h2>Layout</h2>
  <p>An element with a layout motion moves to its new place when the layout around it changes; nothing is measured by hand. Each demo below changes its layout with one button.</p>
  <h3>Alignment</h3>
  <div class="not-prose flex flex-col gap-4">
    <div>
      <button type="button" data-demo-align class="rounded-full bg-primary px-6 py-2.5 text-label-large text-on-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-surface">Toggle alignment</button>
    </div>
    <div id="demo-align" class="flex justify-start rounded-2xl bg-surface-container p-4">
      <div data-motion="reflow" data-demo-layout="pill" class="rounded-full bg-primary px-6 py-3 text-label-large text-on-primary">Pill</div>
    </div>
  </div>
  <h3>List</h3>
  <div class="not-prose flex flex-col gap-4">
    <div class="flex flex-wrap gap-3">
      <button type="button" data-demo-shuffle class="rounded-full bg-primary px-6 py-2.5 text-label-large text-on-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-surface">Shuffle</button>
      <button type="button" data-demo-rotate class="rounded-full bg-primary px-6 py-2.5 text-label-large text-on-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-surface">Move first to end</button>
    </div>
    <ul id="demo-list" class="flex flex-col gap-2">
      <li data-motion="reflow" data-demo-layout="item" class="rounded-xl bg-surface-container-high px-4 py-3 text-body-large text-on-surface"><span>One</span></li>
      <li data-motion="reflow" data-demo-layout="item" class="rounded-xl bg-surface-container-high px-4 py-3 text-body-large text-on-surface"><span>Two</span></li>
      <li data-motion="reflow" data-demo-layout="item" class="rounded-xl bg-surface-container-high px-4 py-3 text-body-large text-on-surface"><span>Three</span></li>
      <li data-motion="reflow" data-demo-layout="item" class="rounded-xl bg-surface-container-high px-4 py-3 text-body-large text-on-surface"><span>Four</span></li>
      <li data-motion="reflow" data-demo-layout="item" class="rounded-xl bg-surface-container-high px-4 py-3 text-body-large text-on-surface"><span>Five</span></li>
    </ul>
  </div>
  <h3>Size</h3>
  <p>The content of a card keeps its shape while the card changes size.</p>
  <div class="not-prose flex flex-col gap-4">
    <div>
      <button type="button" data-demo-grow class="rounded-full bg-primary px-6 py-2.5 text-label-large text-on-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-surface">Toggle width</button>
    </div>
    <div id="demo-size" class="flex gap-4">
      <div data-motion="reflow" data-demo-layout="card" class="flex-1 rounded-2xl bg-surface-container-high p-6">
        <div class="flex items-center gap-3">
          <h4 class="text-title-medium text-on-surface">First card</h4>
          <span data-demo-layout="chip" class="ml-auto rounded-full bg-primary px-3 py-1 text-label-medium text-on-primary">New</span>
        </div>
        <p class="mt-2 text-body-medium text-on-surface-variant">The content keeps its shape while the card resizes.</p>
      </div>
      <div data-motion="reflow" data-demo-layout="card" class="flex-1 rounded-2xl bg-surface-container-high p-6">
        <div class="flex items-center gap-3">
          <h4 class="text-title-medium text-on-surface">Second card</h4>
          <span data-demo-layout="chip" class="ml-auto rounded-full bg-primary px-3 py-1 text-label-medium text-on-primary">Beta</span>
        </div>
        <p class="mt-2 text-body-medium text-on-surface-variant">A second card, resized at the same time.</p>
      </div>
    </div>
  </div>

  <h2>Lists</h2>
  <p>A list item carries two motions in its <code>data-motion</code> attribute: <code>cascade</code> makes it enter and leave, and <code>reflow</code> makes it follow its neighbours when the layout changes. Items added together start one after the other, in visual order.</p>
  <div class="not-prose flex flex-col gap-4">
    <div class="flex flex-wrap gap-3">
      <button type="button" data-demo-add class="rounded-full bg-primary px-6 py-2.5 text-label-large text-on-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-surface">Add item</button>
      <button type="button" data-demo-add-five class="rounded-full bg-primary px-6 py-2.5 text-label-large text-on-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-surface">Add five</button>
      <button type="button" data-demo-remove class="rounded-full bg-primary px-6 py-2.5 text-label-large text-on-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-surface">Remove first</button>
    </div>
    <label class="flex items-center gap-3 text-body-large text-on-surface">
      <input type="checkbox" data-demo-outflow autocomplete="off" class="size-5 accent-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-surface" />
      Close the gap while leaving
    </label>
    <ul id="demo-items" class="relative flex flex-col gap-2">
      <li data-motion="cascade reflow" data-demo-list="item" class="rounded-xl bg-surface-container-high px-4 py-3 text-body-large text-on-surface"><span>Item 1</span></li>
      <li data-motion="cascade reflow" data-demo-list="item" class="rounded-xl bg-surface-container-high px-4 py-3 text-body-large text-on-surface"><span>Item 2</span></li>
      <li data-motion="cascade reflow" data-demo-list="item" class="rounded-xl bg-surface-container-high px-4 py-3 text-body-large text-on-surface"><span>Item 3</span></li>
    </ul>
  </div>
  <p>Unchecked, a removed item keeps its place while it fades, and the items below it move up once it is gone. Checked, it leaves the flow as it fades, so the items below close the gap during its exit.</p>
  <pre><code>{listExample}</code></pre>

  <h2>Shared element</h2>
  <p>Two elements that carry the same key are one thing for the eye: when one replaces the other, it starts from where the other was. Each thumbnail has its own key, and the detail card takes the key of the thumbnail it opens.</p>
  <div class="not-prose">
    <div id="demo-shots" class="grid grid-cols-4 gap-3">
      <button type="button" data-demo-shot="1" data-motion="reflow" data-motion-shared="shot-1" class="h-16 rounded-xl bg-primary text-label-large text-on-primary">1</button>
      <button type="button" data-demo-shot="2" data-motion="reflow" data-motion-shared="shot-2" class="h-16 rounded-xl bg-primary text-label-large text-on-primary">2</button>
      <button type="button" data-demo-shot="3" data-motion="reflow" data-motion-shared="shot-3" class="h-16 rounded-xl bg-primary text-label-large text-on-primary">3</button>
      <button type="button" data-demo-shot="4" data-motion="reflow" data-motion-shared="shot-4" class="h-16 rounded-xl bg-primary text-label-large text-on-primary">4</button>
    </div>
    <div id="demo-detail" hidden data-motion="reflow" data-motion-shared="" class="mt-4 flex h-48 items-center justify-center gap-4 rounded-3xl bg-primary text-display-small text-on-primary">
      <span data-demo-detail-label></span>
      <button type="button" data-demo-close class="rounded-full bg-surface-container-high px-6 py-2.5 text-label-large text-on-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-primary">Close</button>
    </div>
  </div>
  <pre><code>{sharedExample}</code></pre>

  <h2>Reveal</h2>
  <p>A <code>reveal</code> motion waits in its first frame while its element is out of view, and plays when the element scrolls into view. Scroll down: the twelve cards rise into place as they reach the view, and the cards that enter the view together cascade.</p>
  <div class="not-prose flex flex-col gap-4 pt-[60vh]">
    <div data-motion="rise" data-demo-reveal class="rounded-2xl bg-surface-container-high p-6 text-body-large text-on-surface">Card 1</div>
    <div data-motion="rise" data-demo-reveal class="rounded-2xl bg-surface-container-high p-6 text-body-large text-on-surface">Card 2</div>
    <div data-motion="rise" data-demo-reveal class="rounded-2xl bg-surface-container-high p-6 text-body-large text-on-surface">Card 3</div>
    <div data-motion="rise" data-demo-reveal class="rounded-2xl bg-surface-container-high p-6 text-body-large text-on-surface">Card 4</div>
    <div data-motion="rise" data-demo-reveal class="rounded-2xl bg-surface-container-high p-6 text-body-large text-on-surface">Card 5</div>
    <div data-motion="rise" data-demo-reveal class="rounded-2xl bg-surface-container-high p-6 text-body-large text-on-surface">Card 6</div>
    <div data-motion="rise" data-demo-reveal class="rounded-2xl bg-surface-container-high p-6 text-body-large text-on-surface">Card 7</div>
    <div data-motion="rise" data-demo-reveal class="rounded-2xl bg-surface-container-high p-6 text-body-large text-on-surface">Card 8</div>
    <div data-motion="rise" data-demo-reveal class="rounded-2xl bg-surface-container-high p-6 text-body-large text-on-surface">Card 9</div>
    <div data-motion="rise" data-demo-reveal class="rounded-2xl bg-surface-container-high p-6 text-body-large text-on-surface">Card 10</div>
    <div data-motion="rise" data-demo-reveal class="rounded-2xl bg-surface-container-high p-6 text-body-large text-on-surface">Card 11</div>
    <div data-motion="rise" data-demo-reveal class="rounded-2xl bg-surface-container-high p-6 text-body-large text-on-surface">Card 12</div>
  </div>
  <pre><code>{revealExample}</code></pre>

  <h2>Scrub</h2>
  <p>A <code>scrub</code> motion follows the scroll position: as a tile crosses the viewport its keyframes play forward, and scrolling back plays them backward. The <code>parallax</code> preset drifts each tile from 48px below its place to 48px above it. Browsers without scroll-driven animations, and reduced motion, show the tiles still.</p>
  <div class="not-prose flex gap-4 py-24">
    <div data-motion="parallax" data-demo-scrub class="h-32 flex-1 rounded-2xl bg-primary"></div>
    <div data-motion="parallax" data-demo-scrub class="h-32 flex-1 rounded-2xl bg-primary"></div>
    <div data-motion="parallax" data-demo-scrub class="h-32 flex-1 rounded-2xl bg-primary"></div>
  </div>
  <pre><code>{scrubExample}</code></pre>

  <h2>Loop</h2>
  <p>A <code>loop</code> motion plays forever, from the moment it is bound, and pauses by itself while its element is out of view. A loop that never ends must be pausable, so the page offers a control: this button pauses and plays the three loops below.</p>
  <div class="not-prose flex flex-col gap-4">
    <div class="flex flex-wrap items-center gap-6">
      <div data-motion="rotate" data-demo-loop="rotate" class="size-6 rounded-full border-4 border-primary border-t-transparent"></div>
      <div data-motion="breathe" data-demo-loop="breathe" class="size-6 rounded-full bg-primary"></div>
      <div data-motion="blink" data-demo-loop="blink" class="size-6 rounded-full bg-primary"></div>
    </div>
    <div>
      <button type="button" data-demo-pause-loops class="rounded-full bg-primary px-6 py-2.5 text-label-large text-on-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-surface">Pause loops</button>
    </div>
  </div>
  <p>The <code>shake</code> emphasis, which signals a refused action, is not a loop: it replays each time the element's <code>data-state</code> changes. Each click on this button sets the next state.</p>
  <div class="not-prose">
    <button type="button" data-motion="shake" data-state="0" data-demo-shake class="rounded-full bg-primary px-6 py-2.5 text-label-large text-on-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-surface">Shake</button>
  </div>
  <pre><code>{loopExample}</code></pre>

  <h2>Values</h2>
  <p>A value is a continuous number that CSS can use. The runtime writes it on each element that names it with <code>data-motion-value</code>, as <code>--udx-motion-value-&lt;name&gt;</code>, and keeps it in step with its source. The card below turns with the pointer: its number is the pointer's place across the card, from -8 to 8, and goes back to the middle when the pointer leaves. The bar under it fills with the progress of the page's scroll.</p>
  <div class="not-prose flex flex-col gap-4">
    <div data-motion-value="demo-tilt-x demo-tilt-y" data-demo-tilt class="rounded-3xl bg-surface-container-high p-8 text-title-medium text-on-surface" style="transform: perspective(600px) rotateY(calc(var(--udx-motion-value-demo-tilt-x, 0) * 1deg)) rotateX(calc(var(--udx-motion-value-demo-tilt-y, 0) * 1deg))">Move the pointer over me</div>
    <div class="h-2 rounded-full bg-surface-container-high">
      <div data-motion-value="demo-reading" data-demo-reading class="h-2 origin-left rounded-full bg-primary" style="scale: var(--udx-motion-value-demo-reading, 0) 1"></div>
    </div>
  </div>
  <pre><code>{valuesExample}</code></pre>

  <h2>Counters</h2>
  <p>A counter is a state value with a <code>format</code>: its number is also written as the element's text, in the page's language. A counter that is out of view when the page loads starts at 0 and counts up when it scrolls into view. Changing its <code>value</code> counts to the new number. While it counts, a screen reader reads the final number.</p>
  <div class="not-prose flex flex-col gap-6 pt-[60vh]">
    <div class="flex flex-wrap items-end gap-10">
      <div>
        <data value="12480" data-motion-value="demo-count" data-demo-count class="block text-display-small text-on-surface">12480</data>
        <p class="text-body-medium text-on-surface-variant">visitors</p>
      </div>
      <div>
        <data value="0.42" data-motion-value="demo-share" data-demo-share class="block text-display-small text-on-surface">42%</data>
        <p class="text-body-medium text-on-surface-variant">of them return</p>
      </div>
    </div>
    <div>
      <button type="button" data-demo-add-count class="rounded-full bg-primary px-6 py-2.5 text-label-large text-on-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-surface">Add 1,000 visitors</button>
    </div>
  </div>
  <pre><code>{countersExample}</code></pre>

  <h2>Sequence</h2>
  <p>A sequence plays the children of one root in steps, with one handle for the whole choreography. The root names the sequence with <code>data-motion</code>; each child that carries <code>data-motion-step</code> belongs to the step of that name. Here the subtitle starts 50 ms after the title, the actions start when the title and the subtitle have ended, and the three buttons cascade 20 ms apart. The sequence is a <code>reveal</code>: it plays when the hero scrolls into view.</p>
  <div class="not-prose">
    <div data-motion="demo-hero" class="flex flex-col items-start gap-4 pt-[60vh]">
      <h3 data-motion-step="title" class="text-display-small text-on-surface">Steps, in order</h3>
      <p data-motion-step="subtitle" class="text-body-large text-on-surface-variant">Each step starts when the one before it has ended, or after a set delay.</p>
      <div class="flex flex-wrap gap-3">
        <button type="button" data-motion-step="actions" class="rounded-full bg-primary px-6 py-2.5 text-label-large text-on-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-surface">Start</button>
        <button type="button" data-motion-step="actions" class="rounded-full bg-secondary-container px-6 py-2.5 text-label-large text-on-secondary-container focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-surface">Details</button>
        <button type="button" data-motion-step="actions" class="rounded-full bg-secondary-container px-6 py-2.5 text-label-large text-on-secondary-container focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-surface">Later</button>
      </div>
    </div>
  </div>
  <pre><code>{sequenceExample}</code></pre>

  <h2>Reduced motion</h2>
  <p>While checked, this control sets <code>data-motion-policy="reduce"</code> on the <code>html</code> element: entries and exits become a short fade, and emphasis does nothing.</p>
  <div class="not-prose">
    <label class="flex items-center gap-3 text-body-large text-on-surface">
      <input type="checkbox" data-demo-reduce autocomplete="off" class="size-5 accent-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-surface" />
      Reduce motion on this page
    </label>
  </div>

  <h2>Frameworks</h2>
  <p>The same named motions are available in each framework: the framework mounts and unmounts each card, and its exit plays before the card is removed.</p>
  <h3>React</h3>
  <Code codes={{ react: reactSource }}>
    <MotionPresenceReact slot="react" client:only="react" />
  </Code>
  <h3>Angular</h3>
  <Code codes={{ angular: angularSource }}>
    <MotionPresenceAngular slot="angular" client:load />
  </Code>
  <h3>Svelte</h3>
  <Code codes={{ svelte: svelteSource }}>
    <MotionPresenceSvelte slot="svelte" client:only="svelte" />
  </Code>

  <h2>The HTML</h2>
  <p>An author writes the markup below and starts the runtime once.</p>
  <pre><code>{example}</code></pre>

  <script>
    import { defineMotion } from '@udixio/motion';
    import { defineValue } from '@udixio/motion/value';
    import { defineSequence } from '@udixio/motion/sequence';

    // Values: a number written on each element that names it, as --udx-motion-value-<name>.
    defineValue('demo-tilt-x', { source: 'pointer', axis: 'x', range: [-8, 8] });
    defineValue('demo-tilt-y', { source: 'pointer', axis: 'y', range: [6, -6] });
    defineValue('demo-reading', { source: 'scroll' });
    // Counters: a state value with a format, also written as the text of its element.
    defineValue('demo-count', { source: 'state', format: 'integer', range: [0, 100000] });
    defineValue('demo-share', { source: 'state', format: 'percent', range: [0, 1] });
    // A sequence: the steps of the children of its root, with one handle for all of them.
    defineSequence('demo-hero', {
      verb: 'reveal',
      steps: {
        title: { keyframes: [{ opacity: 0, y: 24 }, { opacity: 1, y: 0 }] },
        subtitle: { keyframes: [{ opacity: 0 }, { opacity: 1 }], at: '+=normal' },
        actions: { keyframes: [{ opacity: 0, scale: 0.9 }, { opacity: 1, scale: 1 }], stagger: 'tight' },
      },
    });

    // A cascade whose exit takes the item out of the flow, so that its neighbours close the gap as it fades.
    defineMotion('demo-leave', {
      verb: 'appear',
      keyframes: [{ opacity: 0, y: 16 }, { opacity: 1, y: 0 }],
      stagger: 'normal',
      exit: 'out-of-flow',
    });

    // Event delegation on document: a page script runs once, so listeners attached
    // to the elements themselves would be lost after a client-side navigation.
    document.addEventListener('click', event => {
      if (!(event.target instanceof Element)) return;
      const toggle = event.target.closest<HTMLButtonElement>('[data-demo-toggle]');
      if (toggle) {
        const hide = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!hide));
        toggle.textContent = hide ? 'Show cards' : 'Hide cards';
        for (const card of document.querySelectorAll<HTMLElement>('#demo-cards [data-motion]')) card.hidden = hide;
        return;
      }
      const press = event.target.closest<HTMLElement>('[data-demo-press]');
      if (press) press.setAttribute('data-state', press.getAttribute('data-state') === 'on' ? 'off' : 'on');
      if (event.target.closest('[data-demo-align]')) {
        const row = document.getElementById('demo-align');
        if (row) {
          const toEnd = row.classList.contains('justify-start');
          row.classList.toggle('justify-start', !toEnd);
          row.classList.toggle('justify-end', toEnd);
        }
        return;
      }
      if (event.target.closest('[data-demo-shuffle]')) {
        const list = document.getElementById('demo-list');
        if (list) list.append(...shuffled([...list.querySelectorAll<HTMLElement>('li')]));
        return;
      }
      if (event.target.closest('[data-demo-rotate]')) {
        const list = document.getElementById('demo-list');
        const first = list?.firstElementChild;
        if (list && first) list.append(first);
        return;
      }
      if (event.target.closest('[data-demo-grow]')) {
        document.querySelector<HTMLElement>('#demo-size [data-demo-layout="card"]')?.classList.toggle('grow-[3]');
        return;
      }
      if (event.target.closest('[data-demo-add]')) {
        document.getElementById('demo-items')?.prepend(makeItem());
        return;
      }
      if (event.target.closest('[data-demo-add-five]')) {
        document.getElementById('demo-items')?.append(...Array.from({ length: 5 }, () => makeItem()));
        return;
      }
      if (event.target.closest('[data-demo-remove]')) {
        const first = document.querySelector<HTMLElement>('#demo-items [data-demo-list="item"]:not([hidden])');
        if (first) removeWhenHidden(first);
      }
      if (event.target.closest('[data-demo-close]')) {
        closeShot();
        return;
      }
      const pauseLoops = event.target.closest<HTMLButtonElement>('[data-demo-pause-loops]');
      if (pauseLoops) {
        // The label says what the button does next; it is the only state announced (no aria-pressed on top of it).
        const paused = !pauseLoops.hasAttribute('data-paused');
        pauseLoops.toggleAttribute('data-paused', paused);
        pauseLoops.textContent = paused ? 'Play loops' : 'Pause loops';
        for (const loop of document.querySelectorAll<HTMLElement>('[data-demo-loop]')) {
          if (paused) loop.setAttribute('data-motion-paused', '');
          else loop.removeAttribute('data-motion-paused');
        }
        return;
      }
      const shake = event.target.closest<HTMLElement>('[data-demo-shake]');
      if (shake) {
        // Each change of data-state replays the shake emphasis.
        shake.setAttribute('data-state', String(Number(shake.getAttribute('data-state')) + 1));
        return;
      }
      if (event.target.closest('[data-demo-add-count]')) {
        // The count moves to the new number: a counter in view counts up to it.
        const count = document.querySelector<HTMLElement>('[data-demo-count]');
        if (count) count.setAttribute('value', String(Number(count.getAttribute('value')) + 1000));
        return;
      }
      const shot = event.target.closest<HTMLElement>('[data-demo-shot]');
      if (shot) {
        const detail = document.getElementById('demo-detail');
        if (!detail) return;
        closeShot();
        const number = shot.dataset.demoShot ?? '';
        detail.setAttribute('data-motion-shared', 'shot-' + number);
        const label = detail.querySelector<HTMLElement>('[data-demo-detail-label]');
        if (label) label.textContent = number;
        openShot = shot;
        // In the same task: the detail appears where the thumbnail was, and the thumbnail is hidden.
        shot.hidden = true;
        detail.hidden = false;
      }
    });

    document.addEventListener('change', event => {
      if (!(event.target instanceof Element)) return;
      if (event.target.closest('[data-demo-outflow]')) {
        // The items already on the page take the motions the checkbox selects.
        const checked = outflowChecked();
        for (const item of document.querySelectorAll<HTMLElement>('#demo-items [data-demo-list="item"]'))
          item.setAttribute('data-motion', checked ? 'demo-leave reflow' : 'cascade reflow');
        return;
      }
      const reduce = event.target.closest<HTMLInputElement>('[data-demo-reduce]');
      if (!reduce) return;
      if (reduce.checked) document.documentElement.setAttribute('data-motion-policy', 'reduce');
      else document.documentElement.removeAttribute('data-motion-policy');
    });

    // A random order of the items that differs from their current one.
    function shuffled(items: HTMLElement[]): HTMLElement[] {
      const order = [...items];
      do {
        for (let i = order.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [order[i], order[j]] = [order[j], order[i]];
        }
      } while (items.length > 1 && order.every((item, index) => item === items[index]));
      return order;
    }

    // The items of the markup are 1 to 3; each new item takes the next number.
    let itemCount = 3;

    // A new item, with the motions the checkbox selects.
    function makeItem(): HTMLLIElement {
      itemCount += 1;
      const item = document.createElement('li');
      item.className = 'rounded-xl bg-surface-container-high px-4 py-3 text-body-large text-on-surface';
      item.setAttribute('data-demo-list', 'item');
      item.setAttribute('data-motion', outflowChecked() ? 'demo-leave reflow' : 'cascade reflow');
      const label = document.createElement('span');
      label.textContent = `Item ${itemCount}`;
      item.append(label);
      return item;
    }

    function outflowChecked(): boolean {
      return document.querySelector<HTMLInputElement>('[data-demo-outflow]')?.checked ?? false;
    }

    // Hiding plays the exit; the node is removed once the exit has ended and the item is display: none.
    // The first check waits a frame: the hidden attribute alone already hides the item.
    function removeWhenHidden(item: HTMLElement): void {
      item.hidden = true;
      const check = () => {
        if (!item.isConnected || getComputedStyle(item).display === 'none') item.remove();
        else requestAnimationFrame(check);
      };
      requestAnimationFrame(check);
    }

    // The thumbnail whose detail is open, if any.
    let openShot: HTMLElement | undefined;

    // Close the open detail: its thumbnail comes back in its place.
    function closeShot(): void {
      const detail = document.getElementById('demo-detail');
      if (!detail || !openShot) return;
      detail.hidden = true;
      openShot.hidden = false;
      openShot = undefined;
    }
  </script>
</MotionPage>
