---
import MotionPage from '@/components/MotionPage.astro';
import MotionStage from '@/components/motion/MotionStage.astro';
import MotionUsage from '@/components/motion/MotionUsage.astro';
import MotionOptions from '@/components/motion/MotionOptions.astro';
import MotionTokens from '@/components/motion/MotionTokens.astro';
import Counters from '@/components/motion/scenes/Counters.astro';
import { CountersControls } from '@/components/motion/scenes/CountersControls';
import { MotionValuesReact } from '@/examples/react/motion-values.tsx';
import { MotionValuesAngular } from '@/examples/angular/motion-values.ts';
import MotionValuesSvelte from '@/examples/svelte/motion-values.svelte';
import { chipClass } from '@/components/motionDemo';
---
<MotionPage
  slug="counters"
  title="Motion: count a number"
  description="A formatted value that counts to each new number, in the language of the page; a screen reader gets the final number. In HTML, React, Angular and Svelte."
>
  <MotionStage scene="counters" label="Live example: Count a number" height={[304, 392]}>
    <Fragment slot="controls"><CountersControls client:visible size="page" /></Fragment>
    <Counters size="page" />
    <Fragment slot="readout"><span class={`${chipClass} tracking-normal`} data-counters-readout>lang: 'en'</span></Fragment>
  </MotionStage>

  <h2>How to use it</h2>
  <p>
    A counter is a state value with a <code>format</code>. Its number is the <code>value</code> attribute of its element,
    and the element's text is that number in the language of the nearest <code>lang</code> attribute. A counter that is out
    of view when the page loads starts at 0, and counts up when it scrolls into view.
  </p>
  <pre><code>{`<data value="12480" data-motion-value="visitors">12,480</data>

import { defineValue } from '@udixio/motion/value';

defineValue('visitors', { source: 'state', format: 'integer', range: [0, 100000] });

count.setAttribute('value', '13480'); // counts up to 13,480 while it is in view`}</code></pre>
  <ul>
    <li><code>integer</code>: whole numbers.</li>
    <li><code>decimal</code>: as many decimals as the <code>value</code> attribute has when the element is bound: <code>4.8</code> has one.</li>
    <li><code>percent</code>: a fraction shown as a percentage, with no decimals: <code>0.42</code> is 42 %.</li>
    <li><code>currency</code>: an amount in the currency named by <code>currency</code>, which is required with this format.</li>
  </ul>
  <p>
    While a counter counts, its element holds the number in an <code>aria-hidden</code> span, and the final number in a
    visually hidden span: a screen reader reads the final number once.
  </p>

  <h2>Use it in the frameworks</h2>
  <p>
    React <code>useMotionValue('visitors-count')</code>, with <code>ref</code> and <code>value</code> set from the state;
    Angular <code>udxMotionValue="visitors-count"</code> with <code>[attr.value]</code>; Svelte
    <code>&#123;&#64;attach motionValue('visitors-count')&#125;</code>. Each example counts visitors up by a thousand.
  </p>
  <MotionUsage name="motion-values">
    <MotionValuesReact slot="react" client:visible />
    <MotionValuesAngular slot="angular" client:visible />
    <MotionValuesSvelte slot="svelte" client:visible />
  </MotionUsage>

  <h2>Options</h2>
  <MotionOptions
    rows={[
      { name: 'format', values: 'integer · decimal · percent · currency', description: 'How the number is written as text.' },
      { name: 'currency', values: 'an ISO 4217 code, such as EUR', description: 'The currency of the currency format.' },
      { name: 'range', values: '[from, to]', default: '[0, 1]', description: 'The two ends of the number; a counter is clamped to them.' },
      { name: 'spring', values: 'spring.* token, or none', default: 'spring.default.effects', description: 'How the count moves. The effects spring never overshoots.' },
    ]}
  />

  <h2>Timing and tokens</h2>
  <p>A counter counts on the effects spring, which is critically damped: a count reaches its value and does not pass it.</p>
  <MotionTokens tokens={['spring.default.effects']} />

  <h2>Reduced motion</h2>
  <ul>
    <li>The number is written at once, with no count.</li>
    <li>A counter that is out of view starts at 0, and shows its number at once when it comes into view.</li>
  </ul>

  <h2>Limits</h2>
  <ul>
    <li>A counter's number is the only text of its element: once the counter moves, the content of the element is replaced by it.</li>
    <li>The language is read when the counter is bound: a new <code>lang</code> is applied by binding the counter again.</li>
    <li>The currency format needs its ISO 4217 code, and the decimals of a decimal counter come from its <code>value</code> attribute.</li>
  </ul>
</MotionPage>
