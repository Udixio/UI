---
import MotionPage from '@/components/MotionPage.astro';
import ForFramework from '@/components/ForFramework.astro';
import Code from '@/components/Code.astro';
import MotionStage from '@/components/motion/MotionStage.astro';
import MotionUsage from '@/components/motion/MotionUsage.astro';
import MotionOptions from '@/components/motion/MotionOptions.astro';
import MotionTokens from '@/components/motion/MotionTokens.astro';
import Counters from '@/components/motion/scenes/Counters.astro';
import { CountersControls } from '@/components/motion/scenes/CountersControls';
import { MotionCountersVisitorsReact } from '@/examples/react/motion-counters-visitors.tsx';
import { MotionCountersVisitorsAngular } from '@/examples/angular/motion-counters-visitors.ts';
import MotionCountersVisitorsSvelte from '@/examples/svelte/motion-counters-visitors.svelte';
import { chipClass } from '@/components/motionDemo';

const defineVisitors = `import { defineValue } from '@udixio/motion/value';

// A state value with a format: the element's text is its number, formatted for the language of the page.
defineValue('visitors', { source: 'state', format: 'integer', range: [0, 100000] });`;
---
<MotionPage
  slug="counters"
  title="Motion: count a number"
  description="A formatted value that counts to each new number, in the language of the page; a screen reader gets the final number. In HTML, React, Angular and Svelte."
  frameworkSwitch
>
  <ForFramework as="span" slot="summary">
    <Fragment slot="html">Put <code>data-motion-value</code> on a <code>&lt;data&gt;</code> element: when its <code>value</code> attribute changes, the runtime counts to the new number.</Fragment>
    <Fragment slot="react">Call <code>useMotionValue()</code> on a <code>&lt;data&gt;</code> element, and pass the number from your state as its <code>value</code>: the element counts to each new number.</Fragment>
    <Fragment slot="angular">Put <code>udxMotionValue</code> on a <code>&lt;data&gt;</code> element, and bind its <code>[attr.value]</code> to your number: the element counts to each new number.</Fragment>
    <Fragment slot="svelte">Attach <code>motionValue()</code> to a <code>&lt;data&gt;</code> element, and bind its <code>value</code> to your number: the element counts to each new number.</Fragment>
  </ForFramework>

  <MotionStage scene="counters" label="Live example: Count a number" height={[304, 392]}>
    <Fragment slot="controls"><CountersControls client:visible size="page" /></Fragment>
    <Counters size="page" />
    <Fragment slot="readout"><span class={`${chipClass} tracking-normal`} data-counters-readout>lang: 'en'</span></Fragment>
  </MotionStage>

  <h2>Define a counter</h2>
  <p>
    A counter is a state value with a <code>format</code>. Its number is the <code>value</code> attribute of its element, and the
    element's text is that number, formatted in the language of the nearest <code>lang</code> attribute.
  </p>
  <Code data-code={defineVisitors} data-language="ts" />
  <ul>
    <li><code>integer</code>: whole numbers.</li>
    <li><code>decimal</code>: at least one decimal, and as many as the <code>value</code> attribute has when the element is bound: <code>4.8</code> has one.</li>
    <li><code>percent</code>: a fraction shown as a percentage, with no decimals: <code>0.42</code> shows as 42%.</li>
    <li><code>currency</code>: an amount in the currency named by <code>currency</code>, which this format requires.</li>
  </ul>

  <h2>Show a counter in your component</h2>
  <ForFramework>
    <p slot="html">Put <code>data-motion-value</code> on the <code>&lt;data&gt;</code> element, and call <code>connectMotion()</code> once for the page. Set its <code>value</code> attribute from your script: <code>count.setAttribute('value', '13480')</code> counts it up to 13,480.</p>
    <p slot="react">Call <code>useMotionValue()</code> with the name of the counter, and put its <code>ref</code> on the <code>&lt;data&gt;</code> element. Pass your number from state as the element's <code>value</code>: each new number counts up.</p>
    <p slot="angular">Add <code>MotionValue</code> to your component's <code>imports</code>, put <code>udxMotionValue</code> on the <code>&lt;data&gt;</code> element, and bind <code>[attr.value]</code> to your number: each new number counts up.</p>
    <p slot="svelte">Attach <code>motionValue()</code> to the <code>&lt;data&gt;</code> element, and bind its <code>value</code> to your number: each new number counts up.</p>
  </ForFramework>
  <MotionUsage name="motion-counters-visitors" previewHeight={[176, 152]}>
    <MotionCountersVisitorsReact slot="react" client:visible />
    <MotionCountersVisitorsAngular slot="angular" client:visible />
    <MotionCountersVisitorsSvelte slot="svelte" client:visible />
  </MotionUsage>

  <h2>Count when the counter comes into view</h2>
  <p>
    A counter that is out of view when the page loads starts at the start of its range, 0 here, and counts up when it scrolls into
    view. A counter that is in view when the page loads keeps the number its server rendered, until its value changes.
  </p>

  <h2>Let a screen reader read the final number</h2>
  <p>
    While a counter counts, its moving number is <code>aria-hidden</code>, and the final number is in a visually hidden text. A screen
    reader reads the final number once.
  </p>

  <h2>Options</h2>
  <MotionOptions
    rows={[
      { name: 'format', values: 'integer · decimal · percent · currency', description: 'How the number is written as text.' },
      { name: 'currency', values: 'an ISO 4217 code, such as EUR', description: 'The currency of the currency format. Required with it.' },
      { name: 'range', values: '[from, to]', default: '[0, 1]', description: 'The two ends of the number. A counter is clamped to them.' },
      { name: 'spring', values: 'spring.* token, or none', default: 'spring.default.effects', description: 'How the count moves. none writes the number at once.' },
    ]}
  />

  <h2>Timing and tokens</h2>
  <p>A counter counts on the effects spring, which is critically damped: a count reaches its value and does not pass it.</p>
  <MotionTokens tokens={['spring.default.effects']} />

  <h2>Reduced motion</h2>
  <ul>
    <li>The number is written at once, with no count.</li>
    <li>A counter that is out of view starts at the start of its range, and shows its number at once when it comes into view.</li>
  </ul>

  <h2>Limits</h2>
  <ul>
    <li>If the element needs other text, put it in a sibling element: once the counter moves, its number replaces the content of the element.</li>
    <li>If you change the language, bind the counter again: its language is read when it is bound.</li>
    <li>If you change the number of decimals, bind the counter again: the decimals are read from the <code>value</code> attribute when it is bound.</li>
    <li>If you use the currency format, write its ISO 4217 code in <code>currency</code>: in development, a definition without it is refused.</li>
  </ul>
</MotionPage>
