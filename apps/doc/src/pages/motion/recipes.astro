---
// The landing of the Recipes section: what the recipes share, and one card per recipe page (src/pages/motion/recipes/).
// Each card keeps the anchor the recipe had when the five were one page (/motion/recipes#accordion), so old links land on it.
import MotionPage from '@/components/MotionPage.astro';
import { MOTION_NEEDS } from '@/lib/motion-nav';

const ANCHORS: Record<string, string> = {
  'recipes/dialog': 'modal-dialog',
  'recipes/toasts': 'toasts',
  'recipes/accordion': 'accordion',
  'recipes/tab-indicator': 'tab-indicator',
  'recipes/navigation-menu': 'navigation-menu',
};
const recipes = MOTION_NEEDS.filter((need) => need.section === 'Recipes' && need.slug !== 'recipes');
---
<MotionPage
  slug="recipes"
  title="Motion: recipes"
  description="Complete examples of a modal dialog, a toast queue, an accordion, a tab indicator and a navigation menu with submenus, animated with @udixio/motion in HTML, React, Angular and Svelte."
>
  <p>
    Each recipe is a complete example you can copy: choose your framework in its tabs. The HTML tab runs with
    <code>connectMotion()</code>; React, Angular and Svelte use the Udixio components where one exists. Every recipe says
    why it is accessible and which motion and timing tokens it plays.
  </p>
  <p>
    Two rules decide how content comes and goes. A dialog or a toast is transient: render it only while it is shown, and let
    <code>&lt;Presence&gt;</code>, <code>&#64;if</code> or <code>&#123;#if&#125;</code> keep it until its exit has played.
    An answer, a tab panel or a submenu is content: keep it in the DOM and hide it with <code>hidden</code>, so its text and
    its links are in the server HTML, where search engines and assistants read them.
  </p>

  <ul class="not-prose mt-10 grid grid-cols-[repeat(auto-fit,minmax(min(100%,16rem),1fr))] gap-4" aria-label="Recipes">
    {recipes.map((recipe) => (
      <li id={ANCHORS[recipe.slug]} class="scroll-mt-24">
        <a
          href={recipe.href}
          class="flex h-full flex-col gap-2 rounded-3xl bg-surface-container-low p-5 transition-colors hover:bg-surface-container-high focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-surface"
        >
          <span class="text-title-large text-on-surface">{recipe.label}</span>
          {recipe.need && <span class="text-title-small text-on-surface-variant">{recipe.need}</span>}
          <span class="mt-1 text-body-medium text-on-surface-variant">{recipe.summary}</span>
        </a>
      </li>
    ))}
  </ul>
</MotionPage>
