---
import MotionPage from '@/components/MotionPage.astro';
import ForFramework from '@/components/ForFramework.astro';
import Code from '@/components/Code.astro';
import MotionStage from '@/components/motion/MotionStage.astro';
import MotionUsage from '@/components/motion/MotionUsage.astro';
import MotionOptions from '@/components/motion/MotionOptions.astro';
import Thread from '@/components/motion/scenes/Thread.astro';
import { MotionScrubReact } from '@/examples/react/motion-scrub.tsx';
import { MotionScrubAngular } from '@/examples/angular/motion-scrub.ts';
import MotionScrubSvelte from '@/examples/svelte/motion-scrub.svelte';
import { DEGRADATIONS, FEATURES } from '@/lib/motion-facts';

// The view timeline, from motion-facts: the first release of each engine that has it, and the oldest supported browsers
// that lack it, with the releases that lack it.
const timeline = FEATURES.find((feature) => feature.name === 'view timeline');
if (timeline === undefined) throw new Error('scrub: "view timeline" is not a feature of motion-facts');
const join = (items: string[]) => (items.length < 2 ? items.join('') : `${items.slice(0, -1).join(', ')} and ${items[items.length - 1]}`);
const firstRelease = join((['Chrome', 'Firefox', 'Safari'] as const).map((engine) => `${engine} ${timeline.first[engine]}`));
const withoutTimeline = join(
  DEGRADATIONS.flatMap(({ browser, lacks }) =>
    lacks
      .filter(({ feature }) => feature === timeline)
      .map(({ from, to }) => `${browser.name} ${from} to ${to}`),
  ),
);

const defineDriftIn = `import { defineMotion } from '@udixio/motion';

// The card fades in and rises as it enters the viewport, and plays backward when the page scrolls back.
defineMotion('drift-in', {
  verb: 'scrub',
  keyframes: [{ opacity: 0, y: 48 }, { opacity: 1, y: 0 }],
  range: 'enter',
});`;
---
<MotionPage
  slug="scrub"
  title="Motion: link to the scroll"
  description="Link a motion to the scroll position, so that it plays forward and backward as the page scrolls, in HTML, React, Angular and Svelte."
  frameworkSwitch
>
  <ForFramework as="span" slot="summary">
    <Fragment slot="html">Put <code>data-motion</code> on an element: its keyframes follow the scroll position, forward as the element crosses the viewport and backward when the page scrolls back.</Fragment>
    <Fragment slot="react">Render an element as a <code>&lt;Motion&gt;</code> with the name of a scrub: its keyframes follow the scroll position, forward as the element crosses the viewport and backward when the page scrolls back.</Fragment>
    <Fragment slot="angular">Put <code>udxMotion</code> on an element: its keyframes follow the scroll position, forward as the element crosses the viewport and backward when the page scrolls back.</Fragment>
    <Fragment slot="svelte">Attach <code>motion()</code> to an element: its keyframes follow the scroll position, forward as the element crosses the viewport and backward when the page scrolls back.</Fragment>
  </ForFramework>

  <MotionStage scene="thread" label="Live example: Link to the scroll" height={[528, 552]}>
    <Thread size="page" />
  </MotionStage>

  <h2>Link an element to the scroll</h2>
  <ForFramework>
    <Fragment slot="html">
      <p>Put <code>data-motion</code> on the element with the name of a scrub, and call <code>connectMotion()</code> once for the page.</p>
    </Fragment>
    <Fragment slot="react">
      <p>Render the element as a <code>&lt;Motion&gt;</code> with the name of a scrub, such as <code>name="parallax"</code>.</p>
    </Fragment>
    <Fragment slot="angular">
      <p>Add <code>Motion</code> to your component's <code>imports</code>, and put <code>udxMotion</code> on the element with the name of a scrub.</p>
    </Fragment>
    <Fragment slot="svelte">
      <p>Import <code>motion</code> from <code>@udixio/ui-svelte</code>, and attach it to the element with <code>&#123;&#64;attach motion('parallax')&#125;</code>.</p>
    </Fragment>
  </ForFramework>
  <ul>
    <li>As the element crosses the viewport, its keyframes play forward. When the page scrolls back, they play backward.</li>
    <li>Before the element enters the viewport, the first keyframe holds. After it leaves, the last keyframe holds.</li>
    <li>A scrub has no timing: the scroll alone sets how far it has played.</li>
  </ul>
  <p>The live example has two cards that move against the scroll as they cross the viewport. Both use the preset <code>parallax</code>.</p>
  <MotionUsage name="motion-scrub" previewHeight={[240, 256]}>
    <MotionScrubReact slot="react" client:visible />
    <MotionScrubAngular slot="angular" client:visible />
    <MotionScrubSvelte slot="svelte" client:visible />
  </MotionUsage>

  <h2>Define your own scrub</h2>
  <p>
    Define a motion with the verb <code>scrub</code>, and give it keyframes. Its <code>range</code> chooses the part of the scroll
    the keyframes span: <code>enter</code> (the element entering the viewport), <code>cross</code> (the default: its crossing of
    the viewport), <code>exit</code> (leaving it), or <code>contain</code> (its containment in the viewport). Then attach it by
    its name, as you would a preset.
  </p>
  <Code data-code={defineDriftIn} data-language="ts" />

  <h2>Options</h2>
  <p>Use <code>axis</code> to follow the horizontal scroll of a row, and <code>range</code> to choose the part of the scroll the keyframes span.</p>
  <MotionOptions verb="scrub" />

  <h2>Timing and tokens</h2>
  <p>
    A scrub has no timing and no spring to choose. Its distances follow <code>--udx-motion-scale</code>, which is read when
    the scrub starts.
  </p>

  <h2>Reduced motion</h2>
  <p>
    Under reduced motion, a scrub stays still: the element keeps its stylesheet state. Turning reduced motion on stops the
    scroll link, and turning it off links the scroll again at the current position. See
    <a href="/motion/accessibility">Accessibility</a>.
  </p>

  <h2>Limits</h2>
  <ul>
    <li>If the browser has no view timeline, the element keeps its stylesheet state at every scroll position: write the state you want in the stylesheet. Call <code>supportsViewTimeline()</code>, from <code>@udixio/motion/continuous</code>, to tell whether the browser has one. The view timeline comes with {firstRelease}. Among the oldest supported browsers, {withoutTimeline} have none.</li>
    <li>If the browser refuses the scroll link, the element keeps its stylesheet state too. In a development build, the refusal is logged once on the console.</li>
  </ul>
</MotionPage>
