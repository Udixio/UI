---
import DocLink from '@/components/DocLink.astro';
import MotionPage from '@/components/MotionPage.astro';
import ForFramework from '@/components/ForFramework.astro';
import HtmlExample from '@/components/motion/HtmlExample.astro';
import MotionUsage from '@/components/motion/MotionUsage.astro';
import { MotionRecipeTabsReact } from '@/examples/react/motion-recipe-tabs.tsx';
import { MotionRecipeTabsAngular } from '@/examples/angular/motion-recipe-tabs.ts';
import MotionRecipeTabsSvelte from '@/examples/svelte/motion-recipe-tabs.svelte';
---
<MotionPage
  slug="recipes/tab-indicator"
  title="Motion: tab indicator recipe"
  description="A tab indicator that travels from the tab you leave to the tab you choose, with every panel kept in the page, in HTML, React, Angular and Svelte."
  frameworkSwitch
>
  <h2 id="switch-between-tabs">Switch between tabs</h2>
  <p>
    Move one indicator from the tab you leave to the tab you choose, and keep every panel in the page: the new panel slides in
    from the side of the tab you chose.
  </p>
  <ForFramework>
    <p slot="html">The tabs are your own: each tab holds an indicator, and only the selected one is shown. Every panel stays in the DOM, hidden while inactive.</p>
    <p>The demo is the Udixio <DocLink href="/components/tabs/overview">Tabs</DocLink>: their indicator travels between tabs, and a <code>lazy</code> panel renders only while it is selected.</p>
  </ForFramework>
  <MotionUsage name="motion-recipe-tabs" layout="split" previewHeight={[168, 176]}>
    <HtmlExample slot="html" name="motion-recipe-tabs" />
    <MotionRecipeTabsReact slot="react" client:visible />
    <MotionRecipeTabsAngular slot="angular" client:visible />
    <MotionRecipeTabsSvelte slot="svelte" client:visible />
  </MotionUsage>

  <h2 id="build-the-indicator-yourself">Build the indicator yourself</h2>
  <p>
    To keep the Udixio indicator out of it, give the indicator of each tab the shared key <code>tab-indicator</code>, and show
    only the one of the selected tab: the indicator that appears travels from the box of the one that went.
  </p>
  <ForFramework>
    <p slot="html">Put <code>data-motion="reflow"</code> and <code>data-motion-shared="tab-indicator"</code> on the indicator of each tab, and set <code>hidden</code> on all but the selected one.</p>
    <p slot="react">Render <code>&lt;Motion name="reflow" shared="tab-indicator"&gt;</code> in the selected tab only.</p>
    <p slot="angular">Put <code>udxMotion="reflow"</code> and <code>udxMotionShared="tab-indicator"</code> on the indicator of the selected tab only.</p>
    <p slot="svelte">Attach <code>&#123;@attach motion('reflow', () =&gt; (&#123; shared: 'tab-indicator' &#125;))&#125;</code> to the indicator of the selected tab only.</p>
  </ForFramework>

  <h2 id="why-it-is-accessible">Why it is accessible</h2>
  <ul>
    <li>The tabs follow the WAI-ARIA tabs pattern: <code>role="tablist"</code>, <code>tab</code> and <code>tabpanel</code>, <code>aria-selected</code>, and the arrow keys move between tabs.</li>
    <li>An inactive panel is <code>hidden</code>: in the HTML, out of the reading order.</li>
    <li>The indicator is decoration; the selection is read from <code>aria-selected</code>. Under reduced motion, it takes its new place at once.</li>
  </ul>

  <h2 id="motion-and-timing">Motion and timing</h2>
  <p>
    The Udixio indicator moves on <code>spring.default.spatial</code>; the new panel slides on
    <code>spring.default.spatial</code> and fades in on <code>spring.default.effects</code>. The shared indicator of the HTML
    tab is a layout motion, <code>reflow</code>, on <code>spring.default.spatial</code>. See
    <DocLink href="/motion/shared-elements">Shared elements</DocLink>.
  </p>
</MotionPage>
