---
import DocLink from '@/components/DocLink.astro';
import MotionPage from '@/components/MotionPage.astro';
import ForFramework from '@/components/ForFramework.astro';
import ApiName from '@/components/ApiName.astro';
import Code from '@/components/Code.astro';
import Choices from '@/components/motion/Choices.astro';
import Choice from '@/components/motion/Choice.astro';
import Steps from '@/components/motion/Steps.astro';
import Step from '@/components/motion/Step.astro';
import GoodToKnow from '@/components/motion/GoodToKnow.astro';
import Fact from '@/components/motion/Fact.astro';
import HtmlExample from '@/components/motion/HtmlExample.astro';
import MotionUsage from '@/components/motion/MotionUsage.astro';
import MotionOptions from '@/components/motion/MotionOptions.astro';
import MotionTokens from '@/components/motion/MotionTokens.astro';
import { MotionEmphasisReact } from '@/examples/react/motion-emphasis.tsx';
import { MotionEmphasisAngular } from '@/examples/angular/motion-emphasis.ts';
import MotionEmphasisSvelte from '@/examples/svelte/motion-emphasis.svelte';
import { glossaryHref } from '@/lib/motion-glossary';

const defineLikePop = `import { defineMotion } from '@udixio/motion';

// Grows to 135 % and comes back, on the fast spatial spring.
defineMotion('like-pop', {
  verb: 'emphasize',
  keyframes: [{ scale: 1 }, { scale: 1.35 }, { scale: 1 }],
  timing: 'spring.fast.spatial',
});`;
---
<MotionPage
  slug="emphasis"
  title="Motion: draw attention"
  description="Replay a short emphasis on an element, in HTML, React, Angular and Svelte: a press on a button, or a shake on a field whose value is refused."
>
  <Fragment slot="summary">
    An element that stays on the page answers each change of its state with a short motion, so that the eye finds what
    changed.
  </Fragment>

  <h2 id="when-to-use-it">When to use it</h2>
  <Choices size="compact">
    <Choice lead href="/motion/choosing-an-api#replay" link="Compare in Choosing an API">
      <Fragment slot="title"><ApiName html={'data-motion="press"'} react={'<Motion name="press">'} angular={'udxMotion="press"'} svelte="motion('press')" /></Fragment>
      <Fragment slot="when">an element stays on the page and a change of its state must show: a like, or a field whose value is refused.</Fragment>
      <Fragment slot="because">the same short motion replays on each change, and the element never leaves the page, so the reader keeps their place.</Fragment>
    </Choice>
    <Choice code={false} title="Presence" when="Prefer it when" href="/motion/presence" link="Presence">
      <Fragment slot="when">the element enters the page or leaves it: a toast, a dialog, a message.</Fragment>
      <Fragment slot="because">its entry and its exit play, so nothing pops in or vanishes.</Fragment>
    </Choice>
    <Choice code={false} title="Layout" when="Prefer it when" href="/motion/layout" link="Layout">
      <Fragment slot="when">the element changes its place or its size: a mini-player that grows.</Fragment>
      <Fragment slot="because">a layout motion carries it from its old place to its new one.</Fragment>
    </Choice>
    <Choice code={false} title="Values" when="Prefer it when" href="/motion/values" link="Values">
      <Fragment slot="when">a number changes and the page must follow it: a progress bar, a play count.</Fragment>
      <Fragment slot="because">the number is written to a CSS variable, and your CSS decides what it moves.</Fragment>
    </Choice>
  </Choices>

  <h2 id="press-a-button-on-each-click">Press a button on each click</h2>
  <p>
    Each click on Like presses the button and adds a like. The count is the state of the button, and each new value
    replays the <DocLink href={glossaryHref('emphasis')}>emphasis</DocLink>: the <DocLink href={glossaryHref('preset')}>preset</DocLink>
    <code>press</code> dips to 96 % and comes back.
  </p>
  <ForFramework>
    <p slot="html">Set <code>data-motion-state</code> to the count: each new value replays the press.</p>
    <p slot="react">Pass the count as <code>state</code> to a <code>&lt;Motion as=&#123;Button&#125;&gt;</code>: each new value replays the press.</p>
    <p slot="angular">Bind the count to <code>[udxMotionState]</code>, on the <code>udx-button</code>: each new value replays the press.</p>
    <p slot="svelte">Pass the count as <code>state</code> in the options of <code>motion()</code>: each new value replays the press.</p>
  </ForFramework>
  <MotionUsage name="motion-emphasis" layout="split" previewHeight={160}>
    <HtmlExample slot="html" name="motion-emphasis" />
    <MotionEmphasisReact slot="react" client:visible />
    <MotionEmphasisAngular slot="angular" client:visible />
    <MotionEmphasisSvelte slot="svelte" client:visible />
  </MotionUsage>

  <h2 id="how-it-behaves">How it behaves</h2>
  <h3 id="what-starts-it">What starts it</h3>
  <ForFramework>
    <p slot="html">The <DocLink href={glossaryHref('trigger')}>trigger</DocLink> is a change of <code>data-motion-state</code>: a new value replays the emphasis.</p>
    <p slot="react">The <DocLink href={glossaryHref('trigger')}>trigger</DocLink> is a change of <code>state</code>: a new value replays the emphasis.</p>
    <p slot="angular">The <DocLink href={glossaryHref('trigger')}>trigger</DocLink> is a change of <code>[udxMotionState]</code>: a new value replays the emphasis.</p>
    <p slot="svelte">The <DocLink href={glossaryHref('trigger')}>trigger</DocLink> is a change of <code>state</code> in the options of <code>motion()</code>: a new value replays the emphasis.</p>
  </ForFramework>

  <h3 id="from-the-trigger-to-rest">From the trigger to rest</h3>
  <Steps label="The life of an emphasis">
    <Step title="Trigger">The state takes a new value.</Step>
    <Step title="Replay">The keyframes play from the first one to the last, on the spring of the preset.</Step>
    <Step title="At rest">The motion lets go of its inline styles: your classes apply again (<DocLink href={glossaryHref('at rest')}>at rest</DocLink>).</Step>
  </Steps>

  <h3 id="rules">Rules</h3>
  <ul>
    <li>
      An element holds one motion of each <DocLink href={glossaryHref('kind')}>kind</DocLink>: an emphasis goes beside a
      <DocLink href={glossaryHref('presence')}>presence</DocLink>, not in its place.
    </li>
    <li>
      Put the motion on the component itself, not on a wrapper: the press moves the whole button. See
      <DocLink href="/motion/choosing-an-api#element-or-component">Put the motion on an element, or on a component</DocLink>.
    </li>
    <li>
      A replay that comes while the previous one still plays follows the <a href="#options">interrupt option</a>.
    </li>
  </ul>

  <h2 id="variants">Variants</h2>
  <h3 id="shake-a-field-when-its-value-is-refused">Shake a field when its value is refused</h3>
  <p>
    The other preset of the <DocLink href={glossaryHref('verb')}>verb</DocLink> <code>emphasize</code> is <code>shake</code>: it moves
    the element 6 px from side to side, then settles. Each refusal is a new value of the state, so each one shakes the
    field, with its label and its error.
  </p>
  <ForFramework>
    <p slot="html">Set <code>data-motion-state</code> on the field to the count of refusals.</p>
    <p slot="react">Pass the count of refusals as <code>state</code> to a <code>&lt;Motion as=&#123;TextField&#125;&gt;</code>.</p>
    <p slot="angular">Bind the count of refusals to <code>[udxMotionState]</code>, on the <code>udx-text-field</code>.</p>
    <p slot="svelte">Pass the count of refusals as <code>state</code> in the options of <code>motion()</code>, on the field.</p>
  </ForFramework>
  <MotionUsage name="motion-emphasis-shake" live={false} />

  <h3 id="replay-without-a-change-of-state">Replay it without a change of state</h3>
  <ForFramework>
    <p slot="html">Call <code>play()</code> on the binding of the element: <code>getMotion(element, 'emphasis')?.play()</code>, from <code>@udixio/motion</code>. The state stays as it is.</p>
    <p slot="react">Give the <code>&lt;Motion&gt;</code> a <code>motionRef</code>, and call <code>motionRef.current?.play()</code> from a handler. On an element that you render yourself, <code>useMotion('press')</code> gives a <code>ref</code> to put on it, and the same <code>play()</code>.</p>
    <p slot="angular">Take the directive in a template reference, <code>&lt;udx-button udxMotion="press" #press="udxMotion"&gt;</code>, and call <code>press.play()</code> from a handler.</p>
    <p slot="svelte">Take the element, and call <code>getMotion(element, 'emphasis')?.play()</code> from <code>@udixio/motion</code>. Take an HTML element with <code>bind:this</code>, and a component's element with an attachment of your own: <code>&#123;&#64;attach (element) =&gt; &#123; button = element; &#125;&#125;</code>, since <code>bind:this</code> on a component gives the component.</p>
  </ForFramework>

  <h3 id="define-your-own-emphasis">Define your own emphasis</h3>
  <p>
    Define a motion with the verb <code>emphasize</code>: its keyframes play forward on each replay, so end them where they
    start, and the element comes back to rest. This one grows the element to 135 % and back, on the fast spatial spring:
  </p>
  <Code data-code={defineLikePop} data-language="ts" />
  <p>
    Define it once, in a module that runs before the element is bound, then attach it by its name, as you would a preset:
    <ApiName html={'data-motion="like-pop"'} react={'<Motion name="like-pop">'} angular={'udxMotion="like-pop"'} svelte="motion('like-pop')" />.
    <DocLink href="/motion/choosing-an-api#preset-or-definition">Choosing an API</DocLink> says when a preset is enough.
  </p>

  <h2 id="options">Options</h2>
  <p>
    When a replay comes while the previous one still plays, <DocLink href={glossaryHref('interrupt')}>interrupt</DocLink> decides:
    <code>restart</code> plays it again from the first frame, and <code>carry</code> goes on from where the element is.
  </p>
  <MotionOptions verb="emphasize" />

  <h2 id="good-to-know">Good to know</h2>
  <GoodToKnow>
    <Fact label="Reduced motion">
      <p>
        Under reduced motion (<code>prefers-reduced-motion: reduce</code>, or <code>data-motion-policy="reduce"</code> on
        <code>&lt;html&gt;</code>: the <DocLink href={glossaryHref('policy')}>policy</DocLink>), and with <code>--udx-motion: none</code>
        on the element or an ancestor, an emphasis does not move: the element shows its end frame at once. So do not let the
        motion alone say what happened: the refused field of the variant above also shows its error and sets
        <code>aria-invalid</code>. See <DocLink href="/motion/accessibility">Accessibility</DocLink>.
      </p>
    </Fact>
    <Fact label="Timing">
      <p>
        A press plays on the fast spatial spring, the default of an emphasis. A shake sets its own timing, a linear curve of
        400 ms: each of its five moves takes 80 ms and reaches its full 6 px.
      </p>
      <MotionTokens tokens={['spring.fast.spatial', 'duration.medium4', 'easing.linear']} />
    </Fact>
    <Fact label="Limits">
      <ul>
        <li>
          If the element must also enter and leave, give it a presence as well, such as
          <ApiName html={'data-motion="slide press"'} react={'<Motion name="slide press">'} angular={'udxMotion="slide press"'} svelte="motion('slide press')" />.
        </li>
        <li>Something else? See <DocLink href="/motion/troubleshooting">Troubleshooting</DocLink> and <DocLink href="/motion/limits">Limits</DocLink>.</li>
      </ul>
    </Fact>
  </GoodToKnow>
</MotionPage>
