---
import Layout from '@/layouts/layout.astro';
import { MOTION_NEEDS, SECTION_LANDINGS } from '@/lib/motion-nav';
import { chipClass } from '@/components/motionDemo';
import MotionRelated from '@/components/motion/MotionRelated.astro';
import FrameworkSwitch from '@/components/FrameworkSwitch.astro';

type Props = {
  title: string;
  description?: string;
  /** The need this page answers, a key of `MOTION_NEEDS`: it sets the header and the related needs. */
  slug?: string;
  /** The table of contents, shown from the lg breakpoint. */
  docSidebar?: boolean;
  /**
   * The page is written for the reader's framework (`ForFramework`, `ApiName`): the header shows the framework it is
   * written for, and lets the reader change it.
   */
  frameworkSwitch?: boolean;
  /** Keeps the page out of search engines: a test fixture that is not part of the documentation. */
  noindex?: boolean;
};

const { title, description, slug, docSidebar = true, frameworkSwitch = false, noindex = false } = Astro.props;

const need = slug === undefined ? undefined : MOTION_NEEDS.find((item) => item.slug === slug);
if (slug !== undefined && need === undefined) {
  throw new Error(`MotionPage: "${slug}" is not a need of MOTION_NEEDS`);
}
/** The section's landing, linked from the eyebrow of the section's other pages. */
const landing = need && SECTION_LANDINGS[need.section] !== need.href ? SECTION_LANDINGS[need.section] : undefined;

/*
 * The measure of the page (review 6, M1, Y6). One axis, two widths:
 * - prose (headings, paragraphs, lists, cards, steps, facts) is at most `--container-2xl` (42rem, 672 px: about 76ch of
 *   the body text), centred;
 * - a wide block (a code block, a demo, a table) is as wide as the prose column plus `--page-breakout` on each side, and at
 *   most `--container-5xl` (64rem, 1024 px), centred on the same axis: every wide block has the same width and the same
 *   left edge.
 * The article's content box is capped so that its wide blocks stop at 64rem: 64rem - 2 x breakout, plus its padding. The
 * `!` beats `.prose-markdown`'s `max-w-none`, which is not in a layer. `--page-breakout` is set from lg, where the
 * article has 48 px of side padding (16 px are kept from the side panel and the table of contents); below, it is unset,
 * and so is the margin. Below 672 px of column, prose and wide blocks are as wide as the column (1280 px: 616 / 680 px).
 * ForFramework's variants are `display: contents`: their children are measured as the article's own.
 */
// Tailwind reads classes as written: the list of wide blocks is spelled out in each of them (a code block, a MotionUsage,
// a MotionStage, a table or its wrapper, a wrapper of a MotionUsage, a bare `pre`).
const articleClass = [
  'prose-markdown mx-auto px-6 py-12 lg:px-12 lg:py-20 lg:[--page-breakout:--spacing(8)]',
  'lg:max-w-[calc(var(--container-5xl)-2*var(--page-breakout)+--spacing(24))]!',
  '[:is(&>:not(.contents),&>.contents>*):not(.card-code,.motion-usage,[data-motion-scene],table,:has(>table),:has(>.motion-usage),pre)]:mx-auto',
  '[:is(&>:not(.contents),&>.contents>*):not(.card-code,.motion-usage,[data-motion-scene],table,:has(>table),:has(>.motion-usage),pre)]:max-w-2xl',
  '[:is(&>*,&>.contents>*):is(.card-code,.motion-usage,[data-motion-scene],table,:has(>table),:has(>.motion-usage),pre)]:mx-[calc(var(--page-breakout,0px)*-1)]',
].join(' ');
---
<Layout title={title} description={description ?? need?.summary} docSidebar={docSidebar} noindex={noindex}>
  <article class={articleClass}>
    {need && (
      <header class="not-prose mb-12">
        <div class="max-w-[60ch]">
          <p class="text-label-large uppercase tracking-[0.1em] text-primary">
            {landing ? (
              <a href={landing} class="text-inherit no-underline hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-surface">{need.section}</a>
            ) : need.section}
          </p>
          {/* The H1 is the concept word the API uses; the need, in the reader's words, is its subtitle. */}
          <h1 class="mt-2 text-display-small text-on-surface">{need.label}</h1>
          {need.need && <p class="mt-2 text-headline-small text-on-surface-variant">{need.need}</p>}
          {/* The `summary` slot replaces the need's summary, for a page that says it per framework (ForFramework). */}
          <p class="mt-4 text-body-large text-on-surface-variant">
            {Astro.slots.has('summary') ? <slot name="summary" /> : need.summary}
          </p>
          {need.hints.length > 0 && (
            <ul class="mt-5 flex flex-wrap gap-2" aria-label="API">
              {need.hints.map((hint) => (
                <li class={chipClass}>{hint}</li>
              ))}
            </ul>
          )}
          {frameworkSwitch && <div class="mt-8"><FrameworkSwitch /></div>}
        </div>
      </header>
    )}
    <slot />
    {need && <MotionRelated slug={need.slug} />}
  </article>
</Layout>
<script>
  import '@/components/motion/scenes/loader';
</script>
