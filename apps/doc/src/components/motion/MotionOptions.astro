---
import manifest from '@udixio/motion/motion-manifest.json';
import { optionDocs, TIMING_LEAD } from '@/lib/motionDocs';

type Props = {
  /** A verb of the manifest: its options, values and defaults are read from `verbs[verb]` and `defaults[verb]`. */
  verb?: string;
  /** Rows for an API that the manifest has no verb table for (values, gestures, sequences, scrollTo). */
  rows?: { name: string; values: string; default?: string; description: string }[];
  /**
   * What a verb's row says on this page, where the shared sentence is wrong or vague for it: its values, its default, its
   * description. A page sets them here rather than in this file, which every page shares.
   */
  overrides?: Record<string, { values?: string; default?: string; description?: string }>;
  /** Options of the verb that do not apply on this page: their rows are left out. */
  omit?: string[];
  /**
   * The table's caption, read by screen readers only: what the table is about. Give one when a page has several tables, so
   * that each one is told apart.
   */
  caption?: string;
};

const { verb, rows = [], overrides = {}, omit = [], caption = 'Options and their defaults' } = Astro.props;

const domains = manifest.domains as unknown as Record<string, readonly string[]>;
const verbs = manifest.verbs as unknown as Record<string, { options: string[]; timing: string }>;
const defaults = manifest.defaults as unknown as Record<string, Record<string, unknown>>;
/** The values of `reduced` that each verb takes (`spec.reducedValues`). A verb that is not listed takes no `reduced`. */
const reducedValues = manifest.spec.reducedValues as unknown as Record<string, readonly string[]>;

/** The manifest domain of each option that takes one of its values. */
const DOMAIN: Record<string, string> = {
  reduced: 'reduced',
  interrupt: 'interrupt',
  stagger: 'stagger',
  origin: 'origin',
  split: 'split',
  exit: 'exit',
  repeat: 'repeat',
  axis: 'axis',
  range: 'range',
  pause: 'pause',
};
/** The values of `timing`, by the kind of timing the manifest gives its verb (`verbs[verb].timing`). */
const TIMING_VALUES: Record<string, string> = {
  'spring-or-curve': 'spring.* · { duration, easing }',
  curve: '{ duration, easing }',
};
/**
 * What each value of `reduced` does for a verb, in words; the values a verb takes come from the manifest (`reducedValues`).
 * Under reduced motion, every value other than `fade` gives the end state at once (@udixio/motion, play.ts), so a verb lists
 * `fade` and the name it gives to that. A scrub, a loop and a layout follow reduced motion their own way whatever the option
 * says (continuous.ts, layout/flush.ts): they take no `reduced`, and their pages say what they do.
 */
const REDUCED_TEXT: Record<string, string> = {
  appear:
    'What the entry and the exit show under reduced motion. fade: a short fade of the opacity, while the other fields are set at once. instant: the end state at once.',
  disappear:
    'What the exit and the entry show under reduced motion. fade: a short fade of the opacity, while the other fields are set at once. instant: the end state at once.',
  emphasize:
    'What a replay shows under reduced motion. static: the end frame at once, with no motion. fade: a short fade of the opacity keyframes, or a fade in from transparent when there are none.',
  reveal:
    'What the reveal shows under reduced motion. instant: the element at once, in its end state. fade: a short fade of the opacity, while the other fields are set at once.',
};
/** The defaults that the runtime applies and the manifest does not list. */
const IMPLICIT_DEFAULTS: Record<string, string> = {
  origin: 'first',
  exit: 'in-place',
  repeat: 'once',
  axis: 'block',
  range: 'cross',
};
/**
 * The spring a verb's motion plays on without a `timing`, from the manifest (play.ts, planGroups): one spring for every field,
 * except appear and reveal, which have two (a movement, then an opacity). An exit plays the disappear defaults (directedVerb).
 */
const springOf = (verb: string, index = 0): string => ((defaults[verb]?.timing as string[] | undefined) ?? [])[index] ?? '';
/** Without a stagger, a split's pieces cascade at tight (split-play.ts); the elements that enter together do not. */
const CASCADE = { default: 'tight, in a split' };
/**
 * What a row says for one verb, where the general sentence of `optionDocs` would be vague for it. Its default comes from the
 * manifest (`defaultOf`) unless the row sets one here.
 */
const VERB_ROWS: Record<string, Record<string, { default?: string; description?: string }>> = {
  appear: {
    timing: {
      description: `${TIMING_LEAD} Without it, an entry moves on ${springOf('appear', 0)} and fades on ${springOf('appear', 1)}; an exit plays every field on ${springOf('disappear')}.`,
    },
    stagger: CASCADE,
  },
  disappear: {
    timing: { description: `${TIMING_LEAD} Without it, every field plays on ${springOf('disappear')}.` },
    stagger: CASCADE,
  },
  emphasize: { timing: { description: `${TIMING_LEAD} Without it, every field plays on ${springOf('emphasize')}.` } },
  reveal: {
    timing: {
      description: `${TIMING_LEAD} Without it, a reveal moves on ${springOf('reveal', 0)} and fades on ${springOf('reveal', 1)}, as an entry does, in a split too.`,
    },
    stagger: CASCADE,
  },
  layout: { timing: { description: `${TIMING_LEAD} Without it, the move plays on ${springOf('layout')}.` } },
  loop: {
    timing: {
      description:
        'A curve, { duration, easing }, for every field of the motion: a loop has no spring. Its duration is a token or milliseconds. Without it, the loop runs on its default curve.',
    },
    pause: { description: `${optionDocs.pause} Every loop states one: there is no default.` },
  },
};

/** The values of the options that take something else than a domain value. */
const OTHER_VALUES: Record<string, string> = {
  shared: 'a key, as a string',
  reason: 'a sentence',
};

/**
 * The default of an option, as the Default column shows it: the manifest's own, the curve of a loop for its timing (a loop has
 * no spring), the runtime's where the manifest does not list it, and none where the option is `required` (pause).
 */
function defaultOf(verb: string, name: string): string | undefined {
  const value = defaults[verb]?.[name];
  if (name === 'timing') {
    if (Array.isArray(value) && value.length > 0) return value.join(' · ');
    const curve = defaults[verb]?.curve as { duration: string; easing: string } | undefined;
    return curve === undefined ? undefined : `${curve.duration} · ${curve.easing}`;
  }
  if (value === 'required') return undefined;
  if (Array.isArray(value)) return value.join(' · ');
  if (typeof value === 'string') return value;
  return IMPLICIT_DEFAULTS[name];
}

const verbRows = (() => {
  if (verb === undefined) return [];
  const entry = verbs[verb];
  if (entry === undefined) throw new Error(`MotionOptions: "${verb}" is not a verb of the manifest`);
  const takes = reducedValues[verb];
  return entry.options
    .filter((name) => name !== 'reduced' || takes !== undefined)
    .filter((name) => !omit.includes(name))
    .map((name) => {
      const own = { ...VERB_ROWS[verb]?.[name], ...overrides[name] };
      const description = own.description ?? (name === 'reduced' ? REDUCED_TEXT[verb] : undefined) ?? optionDocs[name];
      if (description === undefined) throw new Error(`MotionOptions: no description for the option "${name}"`);
      const domain = DOMAIN[name];
      const values =
        name === 'reduced'
          ? (takes ?? [])
          : name === 'timing'
            ? [TIMING_VALUES[entry.timing] ?? '']
            : domain !== undefined
              ? domains[domain]!
              : [OTHER_VALUES[name] ?? ''];
      return {
        name,
        values: own.values ?? values.join(' · '),
        default: own.default ?? defaultOf(verb, name),
        description,
      };
    });
})();

const allRows = [...verbRows, ...rows];
if (allRows.length === 0) throw new Error('MotionOptions needs a verb or rows');
---
{/*
  From 600 px, a table: one row per option. Below (a phone), the same rows as stacked cards: a table of four columns would
  be about 576 px wide in a 343 px column (review 6, M2). The cards are for the eye of a phone; a screen reader reads the
  one shown, and the search indexes the table only.
*/}
<div class="not-prose my-6 overflow-x-auto rounded-2xl bg-surface-container-low max-[600px]:hidden">
  <table class="w-full min-w-[36rem] border-collapse text-left">
    <caption class="sr-only">{caption}</caption>
    <thead>
      <tr class="text-label-large text-on-surface-variant">
        <th scope="col" class="px-4 py-3 font-normal">Option</th>
        <th scope="col" class="px-4 py-3 font-normal">Values</th>
        <th scope="col" class="px-4 py-3 font-normal">Default</th>
        <th scope="col" class="px-4 py-3 font-normal">What it does</th>
      </tr>
    </thead>
    <tbody>
      {allRows.map((row) => (
        <tr class="border-t border-outline-variant align-top">
          <th scope="row" class="px-4 py-3 text-left font-normal">
            <code class="font-mono text-body-medium text-on-surface">{row.name}</code>
          </th>
          <td class="px-4 py-3 font-mono text-body-small text-on-surface-variant">{row.values}</td>
          <td class="px-4 py-3 font-mono text-body-small text-on-surface-variant">
            {row.default ?? <><span aria-hidden="true">—</span><span class="sr-only">No default</span></>}
          </td>
          <td class="px-4 py-3 text-body-medium text-on-surface">{row.description}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
<ul class="not-prose my-6 grid list-none gap-3 p-0 min-[600px]:hidden" aria-label={caption} data-pagefind-ignore>
  {allRows.map((row) => (
    <li class="rounded-2xl bg-surface-container-low p-4">
      <code class="font-mono text-body-medium text-on-surface">{row.name}</code>
      <dl class="mt-3 mb-0 grid grid-cols-[auto_minmax(0,1fr)] items-baseline gap-x-4 gap-y-1.5">
        <dt class="text-label-medium text-on-surface-variant">Values</dt>
        <dd class="m-0 font-mono text-body-small wrap-anywhere text-on-surface-variant">{row.values}</dd>
        <dt class="text-label-medium text-on-surface-variant">Default</dt>
        <dd class="m-0 font-mono text-body-small wrap-anywhere text-on-surface-variant">
          {row.default ?? <><span aria-hidden="true">—</span><span class="sr-only">No default</span></>}
        </dd>
      </dl>
      <p class="mt-3 mb-0 text-body-medium text-on-surface">{row.description}</p>
    </li>
  ))}
</ul>
