---
import Code from '@/components/Code.astro';
import type { ExampleFramework } from '@/stores/exampleFrameworkStore';

type Props = {
  /** The example's base name, as in `examples/<framework>/<name>.<extension>`, e.g. `motion-list`. */
  name: string;
  /** False for a code-only example: the live previews given in the slots are then left out. */
  live?: boolean;
  /**
   * The reserved height of the live previews in px, or `[wide, narrow]` (DemoSurface), from the example's largest state
   * in any framework: what enters, leaves or resizes in the preview never pushes the page.
   */
  previewHeight?: number | readonly [number, number];
};

const { name, live = true, previewHeight } = Astro.props;

/** The file extension of each framework's example. */
const EXTENSIONS: Record<ExampleFramework, string> = {
  html: 'html',
  react: 'tsx',
  angular: 'ts',
  svelte: 'svelte',
};

/** Every motion example, read as raw text at build time. The tabs show the frameworks that have a file for `name`. */
const sources = import.meta.glob<string>('/src/examples/*/motion-*.*', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const codes: Partial<Record<ExampleFramework, string>> = {};
for (const framework of Object.keys(EXTENSIONS) as ExampleFramework[]) {
  const source = sources[`/src/examples/${framework}/${name}.${EXTENSIONS[framework]}`];
  if (source !== undefined) codes[framework] = source;
}
if (Object.keys(codes).length === 0) {
  throw new Error(`MotionUsage: no example named "${name}" in src/examples`);
}

// The page's own slots tell which previews it gave. Code must not read the slots below: the compiler registers every
// slot written in this template, so each one would look filled.
const previews = (Object.keys(EXTENSIONS) as ExampleFramework[]).filter(
  (framework) => live && Astro.slots.has(framework),
);

---
<div class="motion-usage">
  <Code codes={codes} previews={previews} previewHeight={previewHeight}>
    {live && Astro.slots.has('html') && <Fragment slot="html"><slot name="html" /></Fragment>}
    {live && Astro.slots.has('react') && <Fragment slot="react"><slot name="react" /></Fragment>}
    {live && Astro.slots.has('angular') && <Fragment slot="angular"><slot name="angular" /></Fragment>}
    {live && Astro.slots.has('svelte') && <Fragment slot="svelte"><slot name="svelte" /></Fragment>}
  </Code>
</div>

<style>
  /*
   * The block is a container: below 560 px of its own width (a phone, or a narrow column) the framework pills give way to
   * the framework select, which sets the same preference. The toolbar's copy button and Preview / Code switch stay.
   */
  .motion-usage {
    container: motion-usage / inline-size;
  }

  @container motion-usage (max-width: 559px) {
    .motion-usage :global(.code-framework-pills) {
      display: none;
    }

    .motion-usage :global(.code-framework-select) {
      display: flex;
    }
  }
</style>
