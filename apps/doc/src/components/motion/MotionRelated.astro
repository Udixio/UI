---
import MotionNeedLink from '@/components/motion/MotionNeedLink.astro';
import { readingFramework, withFramework } from '@/lib/framework-url';
import { MOTION_NEEDS } from '@/lib/motion-nav';

type Props = {
  /** The need whose related needs are shown: `MOTION_NEEDS[slug].related`. */
  slug: string;
};

const { slug } = Astro.props;

const need = MOTION_NEEDS.find((item) => item.slug === slug);
if (need === undefined) throw new Error(`MotionRelated: "${slug}" is not a need of MOTION_NEEDS`);

const related = need.related.map((relatedSlug) => {
  const item = MOTION_NEEDS.find((candidate) => candidate.slug === relatedSlug);
  if (item === undefined) throw new Error(`MotionRelated: "${relatedSlug}" (related to "${slug}") is not a need`);
  return item;
});
/** On a reading, the cards link to the readings of the same framework (framework-urls spec §2.8). */
const framework = readingFramework(Astro.params.framework);
---
{related.length > 0 && (
  <section class="not-prose mt-16 border-t border-outline-variant pt-10" aria-labelledby="related-needs">
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
      <h2 id="related-needs" class="text-headline-small text-on-surface">Related needs</h2>
      <a
        href="/motion"
        class="text-label-large text-primary underline-offset-4 lg:hidden hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-surface"
      >All needs</a>
    </div>
    <ul class="mt-6 grid grid-cols-[repeat(auto-fit,minmax(min(100%,16rem),1fr))] gap-4">
      {related.map((item) => (
        <MotionNeedLink need={item} href={withFramework(item.href, framework)} />
      ))}
    </ul>
  </section>
)}
