---
import manifest from '@udixio/motion/motion-manifest.json';

/**
 * The tokens a motion page uses: one sentence that names them and links to Tokens (/motion/tokens), where their values and
 * CSS variables are: the values live on one page. Each name is checked against the manifest, so a typo fails the build.
 */
type Props = {
  /** Token names of the manifest: `spring.fast.spatial`, `duration.medium4`, `easing.standard`, `stagger.normal`, `distance.md`. */
  tokens: string[];
};

const { tokens } = Astro.props;
const TOKENS_PAGE = '/motion/tokens';

const values = manifest.tokens as unknown as {
  duration: Record<string, number>;
  easing: Record<string, string>;
  distance: Record<string, number>;
  stagger: Record<string, number>;
  springs: Record<string, unknown>;
};
/** The groups of the manifest that hold a token by its key: `duration.medium4` is `values.duration.medium4`. */
const GROUPS = ['duration', 'easing', 'stagger', 'distance'] as const;

for (const name of tokens) {
  if (name in values.springs) continue;
  const [group, key] = name.split('.', 2) as [(typeof GROUPS)[number], string];
  if (!GROUPS.includes(group) || !(key in values[group])) throw new Error(`MotionTokens: unknown token "${name}"`);
}
---
<p>
  {tokens.length === 1 ? 'Token used here: ' : 'Tokens used here: '}
  {tokens.map((name, index) => (
    <>{index === 0 ? '' : index === tokens.length - 1 ? ' and ' : ', '}<code>{name}</code></>
  ))}. Their values and CSS variables are in <a href={TOKENS_PAGE}>Tokens</a>.
</p>
