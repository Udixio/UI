---
/**
 * The live preview of an HTML example (`src/examples/html/<name>.html`), made of the example itself: its markup is
 * rendered as written, and its `<script type="module">` runs as written, bundled by the doc's bundler: its
 * `@udixio/motion` and `@udixio/motion/<entry>` imports resolve to the runtime the page runs (lib/html-example.ts). So the
 * HTML tab of a usage block shows the code that runs, as the framework tabs do.
 *
 * The page connects the runtime (layouts/layout.astro), right after it has run the examples of the page: the example's
 * `connectMotion()` line is left out of what runs, and nothing else is. An example that imports anything other than
 * `@udixio/motion` stops the build.
 *
 * Its script finds its elements from its own root (an id): a document-wide selector would also reach the other
 * frameworks' previews of the same block.
 *
 * @example
 * ```astro
 * <MotionUsage name="motion-presence" layout="split" previewHeight={200}>
 *   <HtmlExample slot="html" name="motion-presence" />
 *   <MotionPresenceReact slot="react" client:visible />
 * </MotionUsage>
 * ```
 */
import { htmlExampleParts } from '@/lib/html-example';

type Props = {
  /** The example's base name, as in `examples/html/<name>.html`. */
  name: string;
};

const { name } = Astro.props;

const sources = import.meta.glob<string>('/src/examples/html/motion-*.html', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const source = sources[`/src/examples/html/${name}.html`];
if (source === undefined) throw new Error(`HtmlExample: no example named "${name}" in src/examples/html`);

const { markup, body } = htmlExampleParts(source, name);
---
<Fragment set:html={markup} />
{/* The layout runs the example's script once for each of these markers (lib/html-example-runner.ts); a template renders nothing. */}
{body !== '' && <template data-html-example={name}></template>}

