---
/**
 * The live preview of an HTML example (`src/examples/html/<name>.html`), made of the example itself: its markup is
 * rendered as written, and its `<script type="module">` runs as written, as an inline module. So the HTML tab of a usage
 * block shows the code that runs, as the framework tabs do.
 *
 * The page already does what the first lines of every HTML example do: the layout imports `@udixio/motion/presets` and
 * calls `connectMotion()` (layouts/layout.astro). Those lines are left out of what runs here, and nothing else is: an
 * example that imports anything more cannot run inline, and the build stops on it.
 *
 * @example
 * ```astro
 * <MotionUsage name="motion-presence" layout="split" previewHeight={200}>
 *   <HtmlExample slot="html" name="motion-presence" />
 *   <MotionPresenceReact slot="react" client:visible />
 * </MotionUsage>
 * ```
 */
type Props = {
  /** The example's base name, as in `examples/html/<name>.html`. */
  name: string;
};

const { name } = Astro.props;

const sources = import.meta.glob<string>('/src/examples/html/motion-*.html', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const source = sources[`/src/examples/html/${name}.html`];
if (source === undefined) throw new Error(`HtmlExample: no example named "${name}" in src/examples/html`);

const [markup, rest = ''] = source.split(/<script type="module">/);
const body = rest.replace(/<\/script>\s*$/, '');

/** The lines the page has already run: the layout connects the runtime and defines the presets. */
const DONE_BY_THE_PAGE = [
  /^\s*import \{ connectMotion \} from '@udixio\/motion';\s*$/,
  /^\s*import '@udixio\/motion\/presets';\s*$/,
  /^\s*connectMotion\(\);\s*$/,
];
const script = body
  .split('\n')
  .filter((line) => !DONE_BY_THE_PAGE.some((done) => done.test(line)))
  .join('\n')
  .trim();
if (/^\s*import\b/m.test(script)) {
  throw new Error(`HtmlExample: "${name}" imports more than the page provides; it cannot run as an inline preview`);
}
---
<Fragment set:html={markup} />
{script !== '' && <Fragment set:html={`<script type="module">\n${script}\n</script>`} />}
