---
/**
 * The gallery of the root page: every need, in the order of the side panel, as a small card that links to its page
 * (`NeedCard.astro`). The heading and the cards rise into view with the library's `rise` preset (a reveal that cascades
 * the cards entering together, in visual order); each card's preview then plays once (`root/previews.ts`, imported when
 * the gallery first nears the view).
 */
import NeedCard from './NeedCard.astro';
import { MOTION_NEEDS } from '@/lib/motion-nav';

/** The needs: the pages of the side panel that have a scene, which leaves out the start and reference pages. */
const needs = MOTION_NEEDS.filter((need) => need.scene !== undefined);
---
<section class="grid gap-6" aria-labelledby="gallery-title" data-gallery>
  <div class="grid max-w-[62ch] gap-2" data-motion="rise">
    <h2 id="gallery-title" class="m-0 text-headline-medium text-on-surface">What it does</h2>
    <p class="m-0 text-body-large text-on-surface-variant">
      {needs.length} needs, each with a live example and its code in the four frameworks on its page.
    </p>
  </div>
  {/* Two cards a row on a phone, three from 600 px of page, four from 800 px. */}
  <ul class="m-0 grid list-none grid-cols-2 gap-3 p-0 @min-[600px]/motion-root:grid-cols-3 @min-[800px]/motion-root:grid-cols-4">
    {needs.map((need) => (
      <li class="grid min-w-0" data-motion="rise"><NeedCard slug={need.slug} /></li>
    ))}
  </ul>
</section>

<script>
  // The previews' module (and its animate entry) loads when the gallery is half a viewport away, never with the shell.
  let teardown: (() => void) | undefined;
  let observer: IntersectionObserver | undefined;

  document.addEventListener('astro:page-load', () => {
    const gallery = document.querySelector<HTMLElement>('[data-gallery]');
    if (!gallery) return;
    observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer?.disconnect();
        observer = undefined;
        void import('./previews').then(({ mountPreviews }) => {
          if (gallery.isConnected) teardown = mountPreviews(gallery);
        });
      },
      { rootMargin: '50% 0px' },
    );
    observer.observe(gallery);
  });

  document.addEventListener('astro:before-swap', () => {
    observer?.disconnect();
    observer = undefined;
    teardown?.();
    teardown = undefined;
  });
</script>
