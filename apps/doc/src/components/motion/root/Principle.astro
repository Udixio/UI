---
/**
 * The principle of the package, on the root page: one complete example, in the four frameworks, next to its result. The
 * code is the example file itself (`examples/<framework>/motion-principle.*`), and the result beside it is that same file
 * running: the React, Angular and Svelte components as islands (hydrated when their variant is first shown), the HTML
 * markup with the script below, which does what the file's module script does. The framework follows the site's choice:
 * the code's tabs are the code blocks' Udixio tabs (root/PrincipleToolbar.tsx), the layout's head script shows the stored
 * choice before the first paint, and the results follow the store (root/framework.ts). The section rises into view as one
 * block (`rise`): its heading and its result share a row.
 */
import { Code } from 'astro:components';
import { Saved as SavedReact } from '@/examples/react/motion-principle.tsx';
import { Saved as SavedAngular } from '@/examples/angular/motion-principle.ts';
import SavedSvelte from '@/examples/svelte/motion-principle.svelte';
import { motionCodeTokens } from '@/components/motion/codeTokens';
import { EXAMPLE_FRAMEWORKS, type ExampleFramework } from '@/stores/exampleFrameworkStore';
import { PrincipleToolbar } from './PrincipleToolbar';
import { demoSurfaceClass } from '@/components/demoSurface';

/** The example files, read as text at build time (a glob, as MotionUsage reads the motion examples). */
const files = import.meta.glob<string>('/src/examples/*/motion-principle.*', { query: '?raw', import: 'default', eager: true });
const EXTENSIONS: Record<ExampleFramework, string> = { html: 'html', react: 'tsx', angular: 'ts', svelte: 'svelte' };
const sources = Object.fromEntries(
  EXAMPLE_FRAMEWORKS.map((framework) => {
    const source = files[`/src/examples/${framework}/motion-principle.${EXTENSIONS[framework]}`];
    if (source === undefined) throw new Error(`Principle: no motion-principle example for ${framework}`);
    return [framework, source.trim()];
  }),
) as Record<ExampleFramework, string>;
const htmlSource = sources.html;
const LANGUAGES: Record<ExampleFramework, 'html' | 'tsx' | 'ts' | 'svelte'> = {
  html: 'html',
  react: 'tsx',
  angular: 'ts',
  svelte: 'svelte',
};
/** The markup of the HTML example, without its module script: the page's script below plays that part. */
const htmlMarkup = htmlSource.slice(0, htmlSource.indexOf('<script')).trim();
/** The site's default framework: the server's choice, which the layout's head script replaces with the stored one. */
const initial: ExampleFramework = 'react';

/** The focus ring of the code block's controls: a 2 px outline in the on-surface tone (each control sets its own offset). */
const focusRing = 'focus-visible:outline-2 focus-visible:outline-solid focus-visible:outline-on-surface';
/** The code of the example: the tokens take the theme's roles, the block the page's type, and no chrome of its own. */
const code = [
  '[&_.tok-foreground,&_.tok-parameter]:text-on-surface',
  '[&_.tok-keyword,&_.tok-string,&_.tok-string-expression]:text-tertiary',
  '[&_.tok-function,&_.tok-constant,&_.tok-link]:text-primary',
  '[&_.tok-punctuation,&_.tok-comment]:text-on-surface-variant',
  '[&_pre.astro-code]:[--astro-code-foreground:var(--color-on-surface)] [&_pre.astro-code]:[--astro-code-background:transparent]',
  '[&_pre.astro-code]:m-0 [&_pre.astro-code]:!bg-transparent [&_pre.astro-code]:pt-4.5 [&_pre.astro-code]:px-5 [&_pre.astro-code]:pb-5',
  '[&_pre.astro-code]:font-mono [&_pre.astro-code]:text-[13px] [&_pre.astro-code]:leading-[1.7] [&_pre.astro-code]:tracking-normal',
  '[&_pre.astro-code]:[tab-size:2] [&_pre.astro-code]:whitespace-pre [&_pre.astro-code]:overflow-visible',
  '@max-[560px]/motion-root:[&_pre.astro-code]:pt-3.5 @max-[560px]/motion-root:[&_pre.astro-code]:px-4 @max-[560px]/motion-root:[&_pre.astro-code]:pb-4 @max-[560px]/motion-root:[&_pre.astro-code]:text-[12px]',
].join(' ');
/** A result: the example running as the page dresses it: its paragraph, and the HTML example's native button (`#toggle`; the
 * framework examples toggle with the Udixio Button, which dresses itself). */
const result = [
  'flex min-h-29.5 flex-col items-center gap-3.5',
  // Astro sets its islands to `display: contents` in unlayered CSS, which a utility (in a layer) loses to: the island's flex is important.
  '[&_astro-island]:!flex [&_app-saved]:flex [&_astro-island,&_app-saved]:min-h-29.5 [&_astro-island,&_app-saved]:flex-col [&_astro-island,&_app-saved]:items-center [&_astro-island,&_app-saved]:gap-3.5',
  '[&_#toggle]:h-10 [&_#toggle]:cursor-pointer [&_#toggle]:rounded-full [&_#toggle]:bg-primary [&_#toggle]:px-6 [&_#toggle]:text-[0.875rem] [&_#toggle]:font-medium [&_#toggle]:tracking-[0.006em] [&_#toggle]:text-on-primary [&_#toggle]:transition-[background-color] [&_#toggle]:duration-150 [&_#toggle]:ease-[ease]',
  '[&_#toggle:hover]:bg-[color-mix(in_oklab,var(--color-primary)_90%,var(--color-on-primary))]',
  '[&_#toggle:focus-visible]:outline-2 [&_#toggle:focus-visible]:outline-solid [&_#toggle:focus-visible]:outline-offset-2 [&_#toggle:focus-visible]:outline-on-surface',
  '[&_p]:m-0 [&_p]:rounded-[20px] [&_p]:bg-secondary-container [&_p]:px-5.5 [&_p]:py-4 [&_p]:text-base [&_p]:text-on-secondary-container',
].join(' ');
---
<section class="grid gap-6 @min-[820px]/motion-root:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] @min-[820px]/motion-root:items-end @min-[820px]/motion-root:gap-x-8" aria-labelledby="principle-title" data-motion="rise">
  <div class="grid max-w-[62ch] gap-2">
    <h2 id="principle-title" class="m-0 text-headline-medium text-on-surface">One example, four frameworks</h2>
    <p class="m-0 text-body-large text-on-surface-variant">
      The definition is the same in every tab; only the lines that attach it speak your framework.
    </p>
  </div>

  {/* Wide: the code, then its result beside it. Narrow: the result under the code. */}
  <div class="grid grid-cols-1 gap-3 @min-[820px]/motion-root:contents">
    <div class="flex min-w-0 flex-col overflow-hidden rounded-3xl bg-surface-container-high @min-[820px]/motion-root:col-span-full @max-[560px]/motion-root:rounded-[20px]" data-code-tabs data-code-frameworks={EXAMPLE_FRAMEWORKS.join(' ')}>
      <PrincipleToolbar client:load />
      {EXAMPLE_FRAMEWORKS.map((framework) => (
        <div
          class={`min-w-0 overflow-x-auto ${focusRing} focus-visible:-outline-offset-2 ${code}`}
          role="tabpanel"
          id={`principle-code-${framework}`}
          aria-labelledby={`principle-tab-${framework}`}
          tabindex="0"
          data-example-panel
          data-framework={framework}
          data-view="code"
          hidden={framework !== initial}
        >
          <Code code={sources[framework]} lang={LANGUAGES[framework]} theme="css-variables" transformers={[motionCodeTokens]} />
        </div>
      ))}
    </div>

    <div
      class={`flex min-w-0 flex-col rounded-3xl border border-outline-variant @min-[820px]/motion-root:row-start-1 @min-[820px]/motion-root:col-start-2 @max-[560px]/motion-root:rounded-[20px] ${demoSurfaceClass}`}
      role="group"
      aria-labelledby="principle-result-label"
    >
      <p id="principle-result-label" class="m-0 px-5 pt-4 text-label-medium text-on-surface-variant">Result</p>
      <div class="grid min-h-42 flex-1 place-items-center px-5 pt-2 pb-5">
        <div class={`result-variant ${result}`} data-framework-variant="html" hidden data-principle-html>
          <Fragment set:html={htmlMarkup} />
        </div>
        <div class={`result-variant ${result}`} data-framework-variant="react">
          <SavedReact client:visible />
        </div>
        <div class={`result-variant ${result}`} data-framework-variant="angular" hidden>
          <SavedAngular client:visible />
        </div>
        <div class={`result-variant ${result}`} data-framework-variant="svelte" hidden>
          <SavedSvelte client:visible />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // The module script of examples/html/motion-principle.html, for the HTML result: the page has connected the runtime
  // already (layouts/layout.astro), so what is left is the definition and the toggle.
  import { defineMotion } from '@udixio/motion';

  defineMotion('pop', {
    verb: 'appear',
    keyframes: [{ opacity: 0, scale: 0.9 }, { opacity: 1, scale: 1 }],
  });

  document.addEventListener('click', (event) => {
    const toggle = event.target instanceof Element ? event.target.closest('[data-principle-html] #toggle') : null;
    const note = toggle?.parentElement?.querySelector<HTMLElement>('#note');
    if (note) note.hidden = !note.hidden;
  });
</script>
