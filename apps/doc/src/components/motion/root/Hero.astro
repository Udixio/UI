---
/**
 * The first screen of the root page: what the package does in one sentence, its install command (for the framework the
 * visitor chose, `root/framework.ts`), the signature scene, and three facts. The weight is the size budget of the core
 * entry (`packages/motion/.size-limit.json`, enforced by `pnpm size`), so it cannot go stale; the third fact holds the
 * page's only Reduce motion switch.
 */
import { iArrowForward } from '@udixio/icons-rounded-400/arrow_forward';
import { MotionPolicySwitch } from '@/components/motion/MotionPolicySwitch';
import Player from '@/components/motion/scenes/Player.astro';
import CopyButton from './CopyButton.astro';
import { INSTALL, FRAMEWORK_LABELS, coreBudget } from '@/lib/motion-facts';
import { EXAMPLE_FRAMEWORKS } from '@/stores/exampleFrameworkStore';
---
<header class="hero">
  <div class="hero-copy">
    <p class="eyebrow text-label-large text-on-surface-variant">
      Animation <span aria-hidden="true">·</span> <code class="text-primary">@udixio/motion</code>
    </p>
    <h1 class="title text-on-surface">Define a motion once, attach it by&nbsp;name.</h1>

    <div class="install" data-copy-group>
      <span class="install-prompt" aria-hidden="true">$</span>
      {EXAMPLE_FRAMEWORKS.map((framework) => (
        <code
          class="install-command"
          data-framework-variant={framework}
          data-copy-source
          hidden={framework !== 'react'}
          aria-label={`Install command for ${FRAMEWORK_LABELS[framework]}`}
        >{INSTALL[framework].split(' ').map((word, index, words) => (
          // Words break between packages only: "npm i" stays with the first package. The text copied is the command.
          index < 2 ? null : <><span class="install-chunk">{index === 2 ? words.slice(0, 3).join(' ') : word}</span>{index < words.length - 1 && ' '}</>
        ))}</code>
      ))}
      <CopyButton label="Copy the install command" />
    </div>

    <a href="/motion/getting-started" class="start-link text-label-large text-primary">
      Getting started<span class="start-arrow" aria-hidden="true" set:html={iArrowForward} />
    </a>
  </div>

  <div class="hero-stage" role="group" aria-label="Live example: a mini-player opens into the player" data-motion-scene="player">
    <Player />
    <p class="stage-caption text-label-medium text-on-surface-variant" aria-hidden="true">Open the player</p>
  </div>

  <ul class="facts" aria-label="In short">
    <li class="fact">
      <span class="fact-figure text-headline-small text-on-surface">{coreBudget}</span>
      <span class="fact-text text-body-medium text-on-surface-variant">at most for the core, gzipped. The rest loads on first use.</span>
    </li>
    <li class="fact">
      <span class="fact-figure text-headline-small text-on-surface">4 frameworks</span>
      <span class="fact-text text-body-medium text-on-surface-variant">HTML, React, Angular and Svelte, one motion definition for all.</span>
    </li>
    <li class="fact fact-policy">
      <span class="fact-figure text-headline-small text-on-surface">Reduced motion</span>
      <span class="fact-text text-body-medium text-on-surface-variant">built in: movement becomes a fade, loops rest. Try it here.</span>
      <div class="fact-switch"><MotionPolicySwitch client:idle compact /></div>
    </li>
  </ul>
</header>

<style>
  /* Wide: the words on the left, the stage on the right, the facts across. Narrow: one column. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
    padding: 48px 0 0;
  }

  @container motion-root (min-width: 820px) {
    .hero {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      align-items: center;
      column-gap: 48px;
      row-gap: 40px;
      padding-top: 56px;
    }

    .facts {
      grid-column: 1 / -1;
    }
  }

  .hero-copy {
    display: grid;
    justify-items: start;
    gap: 20px;
  }

  .eyebrow {
    margin: 0;
  }

  .eyebrow code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
    font-size: 14px;
    letter-spacing: 0;
  }

  .title {
    margin: 0;
    font-size: clamp(32px, 5.4cqi, 56px);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  /* The install command: one line, a prompt, and a copy button at its end. */
  .install {
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 100%;
    margin-top: 4px;
    padding: 6px 6px 6px 16px;
    border-radius: 16px;
    background: var(--color-surface-container-high);
  }

  .install-prompt,
  .install-command {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: 0;
  }

  .install-prompt {
    color: var(--color-on-surface-variant);
    user-select: none;
  }

  .install-command {
    min-width: 0;
    color: var(--color-on-surface);
    overflow-wrap: anywhere;
  }

  .install-chunk {
    white-space: nowrap;
  }

  .install-command[hidden] {
    display: none;
  }

  .start-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin: -6px 0 0 -10px;
    padding: 6px 10px;
    border-radius: 999px;
    text-decoration: none;
    transition: background-color 150ms;
  }

  .start-link:hover {
    background: color-mix(in oklab, var(--color-primary) 8%, transparent);
  }

  .start-link:focus-visible {
    outline: 2px solid var(--color-on-surface);
    outline-offset: 2px;
  }

  .start-arrow {
    display: inline-grid;
    width: 18px;
    height: 18px;
    transition: translate 200ms;
  }

  .start-link:hover .start-arrow {
    translate: 2px 0;
  }

  .start-arrow :global(svg) {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  /* The stage: a fixed height, so that opening the player shifts nothing around it. */
  .hero-stage {
    position: relative;
    display: grid;
    min-width: 0;
    height: 440px;
    min-height: 440px;
    border-radius: 32px;
    background: var(--color-surface-container-low);
    overflow: clip;
  }

  .stage-caption {
    position: absolute;
    top: 22px;
    right: 22px;
    margin: 0;
    pointer-events: none;
    transition: opacity 200ms;
  }

  .hero-stage:has([data-player-full]:not([hidden])) .stage-caption {
    opacity: 0;
  }

  @container motion-root (max-width: 559px) {
    .hero {
      padding-top: 32px;
    }

    .install-prompt,
    .install-command {
      font-size: 13px;
    }

    .hero-stage {
      height: 400px;
      min-height: 400px;
      border-radius: 28px;
    }
  }

  /* The facts: three columns on a wide page, separated by a hairline; one under the other on a phone. */
  .facts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    margin: 0;
    padding: 24px 0 0;
    border-top: 1px solid var(--color-outline-variant);
    list-style: none;
  }

  @container motion-root (min-width: 680px) {
    .facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 32px;
    }
  }

  .fact {
    display: grid;
    align-content: start;
    gap: 6px;
  }

  .fact-figure {
    letter-spacing: -0.01em;
  }

  .fact-text {
    max-width: 34ch;
  }

  .fact-switch {
    margin-top: 6px;
  }
</style>
