---
/**
 * The facts of the root page: the browsers the package is verified on, and the weight of each entry with the needs it
 * serves. Both come from `lib/motion-facts.ts`: the verification run (shared with the roadmap) and the size budgets of
 * `packages/motion/.size-limit.json`, which `pnpm size` enforces.
 */
import { iArrowForward } from '@udixio/icons-rounded-400/arrow_forward';
import { MOTION_NEEDS } from '@/lib/motion-nav';
import {
  MOTION_ENTRIES,
  engines,
  formatKb,
  suiteFiles,
  verifiedCommit,
  verifiedOn,
  type EntryLoad,
} from '@/lib/motion-facts';

const heaviest = Math.max(...MOTION_ENTRIES.map((entry) => entry.bytes));
const LOADS: Record<EntryLoad, string> = {
  core: 'Always',
  auto: 'On first use',
  import: 'When imported',
};
const labelOf = (slug: string) => MOTION_NEEDS.find((need) => need.slug === slug);
const date = new Date(`${verifiedOn}T12:00:00Z`).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const exceptions = MOTION_ENTRIES.filter((entry) => entry.browsers);
---
<section class="facts" aria-labelledby="facts-title">
  <div class="facts-head">
    <h2 id="facts-title" class="text-headline-medium text-on-surface">Browsers and weight</h2>
  </div>

  <div class="browsers">
    <ul class="engines" aria-label="Verified engines">
      {engines.map((engine) => (
        <li class="engine">
          <span class="engine-name text-title-small text-on-surface">{engine.name} <span class="text-on-surface-variant">{engine.version.split('.')[0]}</span></span>
          <span class="text-body-small text-on-surface-variant">{engine.passed} browser tests pass</span>
        </li>
      ))}
    </ul>
    <div class="browsers-text text-body-medium text-on-surface-variant">
      <p>
        Every family passes its {suiteFiles} browser suites on all three engines, verified on {date} at
        <code>{verifiedCommit}</code>. Older browsers are simulated: the suites remove <code>linear()</code> and the view
        timeline, and check the fallbacks.
      </p>
      {exceptions.map((entry) => <p>{entry.browsers}</p>)}
      <a href="/motion/roadmap" class="more text-label-large text-primary">
        The full matrix<span class="more-arrow" aria-hidden="true" set:html={iArrowForward} />
      </a>
    </div>
  </div>

  <div class="weights">
    <p class="weights-intro text-body-medium text-on-surface-variant">
      The core binds every motion; the other entries load the first time a page needs them, or when you import them. Each
      weight is the budget the build enforces, gzipped.
    </p>
    <ul class="weights-list">
      {MOTION_ENTRIES.map((entry) => (
        <li class="weight">
          <code class="weight-path">{entry.path.replace('@udixio/motion', '') || '@udixio/motion'}</code>
          <span class="weight-bar" aria-hidden="true"><span style={`--share: ${(entry.bytes / heaviest).toFixed(3)}`} /></span>
          <span class="weight-kb text-label-large text-on-surface">
            {formatKb(entry.bytes)}<span class="sr-only"> at most, gzipped</span>
          </span>
          <span class="weight-meta text-body-small text-on-surface-variant">
            <span class="weight-load">{LOADS[entry.load]}</span>
            <span aria-hidden="true"> · </span>
            {entry.needs.map((slug, index) => {
              const need = labelOf(slug);
              return need ? (
                <>{index > 0 && ', '}<a href={need.href}>{need.label}</a></>
              ) : null;
            })}
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .facts {
    display: grid;
    gap: 24px;
  }

  .facts-head h2 {
    margin: 0;
  }

  .facts code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
    font-size: 0.92em;
    letter-spacing: 0;
  }

  /* Browsers: the three engines, then what the run says. */
  .browsers {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px 32px;
  }

  @container motion-root (min-width: 820px) {
    .browsers {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  .engines {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .engine {
    display: grid;
    gap: 4px;
    padding: 16px;
    border-radius: 20px;
    background: var(--color-surface-container-low);
  }

  .engine-name {
    overflow-wrap: anywhere;
  }

  .browsers-text {
    display: grid;
    justify-items: start;
    gap: 10px;
  }

  .browsers-text p {
    margin: 0;
    max-width: 52ch;
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-left: -10px;
    padding: 6px 10px;
    border-radius: 999px;
    text-decoration: none;
    transition: background-color 150ms;
  }

  .more:hover {
    background: color-mix(in oklab, var(--color-primary) 8%, transparent);
  }

  .more:focus-visible {
    outline: 2px solid var(--color-on-surface);
    outline-offset: 2px;
  }

  .more-arrow {
    display: inline-grid;
    width: 18px;
    height: 18px;
  }

  .more-arrow :global(svg) {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  /* Weight: one row per entry, its budget as a bar on one scale (the heaviest entry fills it), and the figure. */
  .weights {
    display: grid;
    gap: 12px;
  }

  .weights-intro {
    margin: 0;
    max-width: 68ch;
  }

  .weights-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    column-gap: 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @container motion-root (min-width: 760px) {
    .weights-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-flow: column;
      grid-template-rows: repeat(7, auto);
    }
  }

  .weight {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 2px 12px;
    padding: 10px 0 11px;
    border-top: 1px solid var(--color-outline-variant);
  }

  .weight-path {
    color: var(--color-on-surface);
    font-size: 13px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .weight-meta {
    grid-column: 1 / -1;
  }

  .weight-meta a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--color-outline-variant);
    text-underline-offset: 3px;
    border-radius: 4px;
  }

  .weight-meta a:hover {
    color: var(--color-on-surface);
    text-decoration-color: currentColor;
  }

  .weight-meta a:focus-visible {
    outline: 2px solid var(--color-on-surface);
    outline-offset: 2px;
  }

  .weight-bar {
    display: block;
    width: 96px;
    height: 6px;
    border-radius: 999px;
    background: var(--color-surface-container-high);
  }

  .weight-bar > span {
    display: block;
    width: calc(var(--share) * 100%);
    min-width: 6px;
    height: 100%;
    border-radius: inherit;
    background: var(--color-primary);
  }

  .weight-kb {
    min-width: 52px;
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  /* Narrow: each entry on two lines, its path and figure first, then when it loads and what it is for. */
  @container motion-root (max-width: 679px) {
    .engines {
      grid-template-columns: minmax(0, 1fr);
    }

    .engine {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: baseline;
      padding: 12px 16px;
    }

    .weight-bar {
      width: 56px;
    }
  }
</style>
