---
/**
 * The facts of the root page, from `lib/motion-facts.ts`: the oldest browsers the package supports, the releases of each
 * browser where a feature it falls back from is missing, the first release of each feature, and the measured weight of the
 * core with the entries and the adapters (`WeightTable.astro`, shared with Getting started).
 */
import WeightTable from '@/components/motion/WeightTable.astro';
import { DEGRADATIONS, FEATURES } from '@/lib/motion-facts';

const CELL = 'py-1.5 pr-3 align-top';
---
{/* The browsers in a row of four from 900 px of page, two on a narrower one, one on a phone; the table below them. */}
<section class="grid gap-6" aria-labelledby="facts-title">
  <div data-motion="rise">
    <h2 id="facts-title" class="m-0 text-headline-medium text-on-surface">Browsers and weight</h2>
  </div>

  <div class="grid gap-5" data-motion="rise">
    <ul class="m-0 grid list-none grid-cols-1 gap-2 p-0 @min-[560px]/motion-root:grid-cols-2 @min-[900px]/motion-root:grid-cols-4" aria-label="Oldest supported browsers">
      {DEGRADATIONS.map(({ browser, lacks }) => (
        <li class="grid content-start gap-2 rounded-2xl bg-surface-container-low p-4">
          <span class="text-title-small text-on-surface">
            {browser.name} <span class="text-on-surface-variant">{browser.version}+</span>
            {browser.note && <span class="text-body-small text-on-surface-variant"> · {browser.note}</span>}
          </span>
          {lacks.length === 0 ? (
            <span class="text-body-small text-on-surface-variant">Every feature in the table is there.</span>
          ) : (
            <ul class="m-0 grid list-none gap-1 p-0 text-body-small text-on-surface-variant">
              {lacks.map(({ feature, from, to }) => (
                <li>{from}–{to}: {feature.without} ({feature.name})</li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>

    <div class="grid gap-3">
      <p class="m-0 max-w-[62ch] text-body-medium text-on-surface-variant">
        The browsers are the oldest releases of browserslist's <code class="font-mono text-[0.92em]">defaults</code> query, the rule the package
        is built to. Older releases are not run: the fallbacks suite removes one feature at a time, as an older engine lacks it, and checks
        what the package does.
      </p>
      <table class="w-full border-collapse text-left text-body-small text-on-surface-variant">
        <caption class="sr-only">The first release of each engine that has each feature the package falls back from</caption>
        <thead>
          <tr class="border-b border-outline-variant text-on-surface">
            <th scope="col" class={`${CELL} font-normal`}>Feature</th>
            <th scope="col" class={`${CELL} font-normal`}>Chrome</th>
            <th scope="col" class={`${CELL} font-normal`}>Firefox</th>
            <th scope="col" class={`${CELL} font-normal`}>Safari</th>
          </tr>
        </thead>
        <tbody>
          {FEATURES.map((feature) => (
            <tr class="border-b border-outline-variant">
              <th scope="row" class={`${CELL} font-normal text-on-surface`}>{feature.name}</th>
              <td class={`${CELL} tabular-nums`}>{feature.first.Chrome}</td>
              <td class={`${CELL} tabular-nums`}>{feature.first.Firefox}</td>
              <td class={`${CELL} tabular-nums`}>{feature.first.Safari}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <div data-motion="rise"><WeightTable compact /></div>
</section>
