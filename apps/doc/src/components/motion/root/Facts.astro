---
/**
 * The facts of the root page: the browsers the package is verified on (from `lib/motion-facts.ts`, shared with the
 * roadmap), and the weight of the core, with one line about the entries that load on demand. The full table of weights
 * is on Getting started (`WeightTable.astro`).
 */
import { iArrowForward } from '@udixio/icons-rounded-400/arrow_forward';
import WeightTable from '@/components/motion/WeightTable.astro';
import { MOTION_ENTRIES, engines, suiteFiles, verifiedCommit, verifiedOn } from '@/lib/motion-facts';

const date = new Date(`${verifiedOn}T12:00:00Z`).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const exceptions = MOTION_ENTRIES.filter((entry) => entry.browsers);
---
<section class="facts" aria-labelledby="facts-title">
  <div class="facts-head">
    <h2 id="facts-title" class="text-headline-medium text-on-surface">Browsers and weight</h2>
  </div>

  <div class="browsers">
    <ul class="engines" aria-label="Verified engines">
      {engines.map((engine) => (
        <li class="engine">
          <span class="engine-name text-title-small text-on-surface">{engine.name} <span class="text-on-surface-variant">{engine.version.split('.')[0]}</span></span>
          <span class="text-body-small text-on-surface-variant">{engine.passed} browser tests pass</span>
        </li>
      ))}
    </ul>
    <div class="browsers-text text-body-medium text-on-surface-variant">
      <p>
        Every family passes its {suiteFiles} browser suites on all three engines, verified on {date} at
        <code>{verifiedCommit}</code>. Older browsers are simulated: the suites remove <code>linear()</code> and the view
        timeline, and check the fallbacks.
      </p>
      {exceptions.map((entry) => <p>{entry.browsers}</p>)}
      <a href="/motion/roadmap" class="more text-label-large text-primary">
        The full matrix<span class="more-arrow" aria-hidden="true" set:html={iArrowForward} />
      </a>
    </div>
  </div>

  <WeightTable compact />
</section>

<style>
  .facts {
    display: grid;
    gap: 24px;
  }

  .facts-head h2 {
    margin: 0;
  }

  .facts code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
    font-size: 0.92em;
    letter-spacing: 0;
  }

  /* Browsers: the three engines, then what the run says. */
  .browsers {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px 32px;
  }

  @container motion-root (min-width: 820px) {
    .browsers {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  .engines {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .engine {
    display: grid;
    gap: 4px;
    padding: 16px;
    border-radius: 20px;
    background: var(--color-surface-container-low);
  }

  .engine-name {
    overflow-wrap: anywhere;
  }

  .browsers-text {
    display: grid;
    justify-items: start;
    gap: 10px;
  }

  .browsers-text p {
    margin: 0;
    max-width: 52ch;
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-left: -10px;
    padding: 6px 10px;
    border-radius: 999px;
    text-decoration: none;
    transition: background-color 150ms;
  }

  .more:hover {
    background: color-mix(in oklab, var(--color-primary) 8%, transparent);
  }

  .more:focus-visible {
    outline: 2px solid var(--color-on-surface);
    outline-offset: 2px;
  }

  .more-arrow {
    display: inline-grid;
    width: 18px;
    height: 18px;
  }

  .more-arrow :global(svg) {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  /* Narrow: the three engines in one column. */
  @container motion-root (max-width: 679px) {
    .engines {
      grid-template-columns: minmax(0, 1fr);
    }

    .engine {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: baseline;
      padding: 12px 16px;
    }
  }
</style>
