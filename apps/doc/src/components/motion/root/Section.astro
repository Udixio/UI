---
/** A section of the root page: its heading, its sentence, and its tiles in a grid (the tiles lay themselves out). */
import { MOTION_ROOT_SECTIONS } from '@/lib/motion-nav';

type Props = {
  /** The anchor of the section, a key of `MOTION_ROOT_SECTIONS`. */
  id: string;
};

const { id } = Astro.props;
const section = MOTION_ROOT_SECTIONS.find((item) => item.id === id);
if (section === undefined) throw new Error(`Section: "${id}" is not a section of MOTION_ROOT_SECTIONS`);
---
<section class="root-section" id={id} aria-labelledby={`${id}-title`} data-root-section>
  <header class="section-head">
    <h2 id={`${id}-title`} class="text-headline-large text-on-surface" tabindex="-1">{section.section}</h2>
    <p class="text-body-large text-on-surface-variant">{section.intro}</p>
  </header>
  <div class="tiles">
    <slot />
  </div>
</section>

<style>
  .root-section {
    margin-top: 72px;
    scroll-margin-top: 72px;
  }

  .root-section:first-of-type {
    margin-top: 48px;
  }

  .section-head {
    display: grid;
    gap: 4px;
    margin-bottom: 24px;
  }

  .section-head h2 {
    justify-self: start;
    margin: 0;
    scroll-margin-top: 88px;
    border-radius: 4px;
  }

  .section-head h2:focus {
    outline: none;
  }

  .section-head h2:focus-visible {
    outline: 2px solid var(--color-on-surface);
    outline-offset: 4px;
  }

  .section-head p {
    margin: 0;
    max-width: 60ch;
  }

  .tiles {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }

  /* Two tiles per row: the tiles span two rows each (stage, body) so that the stages of a row line up. */
  @container motion-root (min-width: 860px) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 0;
    }

    .tiles > :global(.need-tile) {
      margin-bottom: 16px;
    }
  }

  @container motion-root (max-width: 559px) {
    .root-section {
      margin-top: 56px;
    }

    .section-head {
      margin-bottom: 16px;
    }

    .tiles {
      gap: 12px;
    }
  }
</style>
