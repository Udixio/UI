---
/**
 * One need in the gallery of the root page: a small preview, the need in the reader's words (`need`, the subtitle of its
 * page; the page's concept word when it has none) and the function a developer calls first for
 * it (its first chip in `MOTION_NEEDS`; none when the need has no function of its own); the whole card links to
 * the need's page. The preview plays once each time the card enters the view, a beat after the cards before it, and again
 * when the card is hovered or focused (`root/previews.ts`, loaded when the gallery nears the view), with `@udixio/motion`
 * (`animateStyle` and `createSpring`, over the motion tokens), and it rests under reduced motion. Its marks are decoration
 * (`aria-hidden`): the card's name is the link's name.
 */
import { MOTION_NEEDS } from '@/lib/motion-nav';
import { shapePath } from '@/lib/m3-shapes';
import { demoSurfaceClass } from '@/components/demoSurface';

type Props = {
  /** The need, a slug of `MOTION_NEEDS`. */
  slug: string;
};

const { slug } = Astro.props;
const need = MOTION_NEEDS.find((item) => item.slug === slug);
if (need === undefined) throw new Error(`NeedCard: "${slug}" is not a need of MOTION_NEEDS`);

const cookie = shapePath(9, 0.14, 0);
const sunny = shapePath(8, 0.16, 0);
const clover = shapePath(4, 0.32, Math.PI / 4);
const letters = [...'Motion'];

/** The card's chip, the need's first API chip (`motion-nav.ts`): the function a developer calls first, and the word of its spec. */
const api = need.hints[0] === undefined ? undefined : (([call, word]) => ({ call, word }))(need.hints[0].split(' · '));

/** The marks every preview is made of, in the theme's tones: a bar (a line of text), a dot, a row, a lane, a device. */
const bar = (width: string, tone = 'bg-outline-variant') => `block h-1.5 rounded-full ${width} ${tone}`;
const dot = (size: string, tone: string) => `flex-none rounded-full ${size} ${tone}`;
const row = 'flex items-center gap-2 rounded-lg px-2';
const lane =
  "relative flex h-3.5 items-center before:absolute before:inset-x-0 before:h-0.5 before:rounded-full before:bg-outline-variant before:content-['']";
const pin = 'size-2 rounded-full bg-on-surface-variant';
const device = 'grid place-items-center overflow-clip rounded-[10px] border-[1.5px] border-outline-variant';
const deviceCard = 'h-[40%] w-[60%] rounded-md bg-primary-container';
const feedCard = 'h-13 rounded-[10px] bg-secondary-container';
/** The scrollbar of the reveal and scrub previews, and its thumb. */
const scrollbar = 'absolute top-0 right-0 bottom-0 w-1 rounded-full bg-surface-container-high';
const thumb = 'block h-6 w-1 rounded-full bg-outline';
---
<a
  href={need.href}
  class="@container/card flex min-w-0 flex-col gap-0.5 rounded-3xl bg-surface-container-low p-1.5 text-[inherit] no-underline transition-[background-color] duration-200 ease-[ease] [&:hover]:bg-surface-container focus-visible:outline-2 focus-visible:outline-solid focus-visible:outline-offset-2 focus-visible:outline-on-surface"
  data-need-card={slug}
>
  {/* The preview: a fixed box, its marks centred in it. Its marks are drawn at 0.8 when the preview is narrow (150 px or less). */}
  <span
    class:list={[
      // The demo surface of every live example (its tone and dot grid); the card around it is its edge.
      demoSurfaceClass,
      '@container/preview relative grid h-28 place-items-center overflow-clip rounded-[18px] forced-colors:border forced-colors:border-solid forced-colors:border-[color:CanvasText] [@container_preview_(width_<=_150px)]:[&>*]:zoom-[0.8]',
    ]}
    aria-hidden="true"
    data-preview={slug}
  >
    {slug === 'presence' && (
      <span class="flex items-center gap-2.5 rounded-[14px] bg-secondary-container py-2.5 pr-4 pl-3" data-p="toast">
        <span class={dot('size-3', 'bg-tertiary')} />
        <span class={bar('w-14', 'bg-on-secondary-container/35')} />
      </span>
    )}

    {slug === 'lists' && (
      <span class="grid w-30 gap-1.5">
        {[0, 1, 2].map(() => (
          <span class={`${row} h-5.5 bg-surface-container-high`} data-p="row">
            <span class={dot('size-2.5', 'bg-primary')} />
            <span class={bar('w-12')} />
          </span>
        ))}
      </span>
    )}

    {slug === 'emphasis' && (
      <span class="flex gap-2.5 rounded-xl border-[1.5px] border-outline px-4 py-2.75" data-p="field">
        <span class={pin} />
        <span class={pin} />
        <span class={pin} />
        <span class={pin} />
      </span>
    )}

    {slug === 'layout' && (
      <span class="grid w-32 gap-2.5">
        <span class="flex h-8.5 w-14 items-center rounded-xl bg-primary-container px-2.5" data-p="card">
          <span class={bar('w-8', 'bg-on-primary-container/40')} />
        </span>
        <span class="flex h-4">
          <span class="h-4 w-9 rounded-full bg-secondary-container" data-p="chip" />
        </span>
      </span>
    )}

    {slug === 'shared-elements' && (
      <span class="absolute inset-3 grid grid-cols-3 items-end gap-2">
        <span
          class="absolute inset-0 z-1 rounded-xl bg-tertiary-container text-on-tertiary-container [clip-path:inset(calc(100%_-_36px)_calc(100%_-_36px)_0_0_round_10px)]"
          data-p="panel"
        >
          {/* At rest the shape sits in the thumbnail, the panel's bottom-left square; opening carries it to the centre. */}
          <svg class="absolute bottom-1.75 left-1.75 size-5.5 fill-current" viewBox="0 0 100 100" data-p="shape"><path d={cookie} /></svg>
        </span>
        <span class="col-start-2 size-9 rounded-[10px] bg-surface-container-high" />
        <span class="col-start-3 size-9 rounded-[10px] bg-surface-container-high" />
      </span>
    )}

    {slug === 'gestures' && (
      <span class="grid w-30 gap-1.5">
        {[0, 1, 2].map((index) => (
          <span class:list={[row, 'h-5.5 bg-surface-container-high', index === 0 && 'relative z-1']} data-p="row">
            <span class="h-2.5 w-1.5 [border-inline:2px_dotted_var(--color-outline)]" />
            <span class={bar('w-12')} />
          </span>
        ))}
      </span>
    )}

    {slug === 'reveal' && (
      <span class="relative grid h-21 w-33">
        <span class="grid grid-cols-3 items-end gap-1.5 pr-3.5">
          {[0, 1, 2].map(() => <span class={feedCard} data-p="feed" />)}
        </span>
        <span class={scrollbar}>
          <span class={thumb} data-p="thumb" />
        </span>
      </span>
    )}

    {slug === 'scrub' && (
      <span class="relative grid h-21 w-33 content-between justify-items-center pr-3.5">
        <span class="h-1.5 justify-self-stretch overflow-clip rounded-full bg-surface-container-high">
          <span class="block h-full w-full origin-left rounded-[inherit] bg-primary [scale:0.1_1]" data-p="fill" />
        </span>
        <svg class="w-13 fill-primary-container" viewBox="0 0 100 100" data-p="spin"><path d={clover} /></svg>
        <span class={scrollbar}>
          <span class={thumb} data-p="thumb" />
        </span>
      </span>
    )}

    {slug === 'values' && (
      <span class="perspective-[400px]">
        <span class="grid h-18 w-26 transform-3d content-center gap-1.75 rounded-[14px] bg-secondary-container px-3.5 py-3" data-p="tilt">
          <span class={dot('size-3', 'bg-tertiary')} />
          <span class={bar('w-12', 'bg-on-secondary-container/35')} />
          <span class={bar('w-8', 'bg-on-secondary-container/35')} />
        </span>
      </span>
    )}

    {slug === 'counters' && (
      <span class="grid justify-items-center gap-2.5">
        <span class="text-[28px] leading-8 font-medium tracking-[-0.01em] tabular-nums text-on-surface" data-p="number">0</span>
        <span class={bar('w-10')} />
      </span>
    )}

    {slug === 'sequences' && (
      <span class="grid w-32 gap-3">
        <span class="flex h-9 items-center justify-between">
          <span class="size-7.5 rounded-full bg-primary-container" data-p="step" />
          <span class="h-4.5 w-11 rounded-full bg-secondary-container" data-p="step" />
          <span class="size-7 rounded-lg bg-tertiary-container" data-p="step" />
        </span>
        <span class="relative h-0.5 rounded-full bg-outline-variant">
          <span class="absolute -top-1 left-0 h-2.5 w-0.5 rounded-full bg-primary" data-p="playhead" />
        </span>
      </span>
    )}

    {slug === 'text' && (
      <span class="flex text-[30px] leading-9 font-medium tracking-[-0.01em] text-on-surface">
        {letters.map((letter) => <span class="inline-block" data-p="letter">{letter}</span>)}
      </span>
    )}

    {slug === 'svg' && (
      <svg class="size-16 fill-none [stroke-linecap:round] [stroke-linejoin:round]" viewBox="0 0 64 64">
        <circle class="origin-center [rotate:-90deg] stroke-4 stroke-primary-container [stroke-dasharray:1]" cx="32" cy="32" r="26" pathLength="1" data-p="ring" />
        <path class="stroke-5 stroke-primary [stroke-dasharray:1]" d="M21 33 l8 8 l15 -17" pathLength="1" data-p="tick" />
      </svg>
    )}

    {slug === 'loop' && (
      <svg class="w-15 fill-tertiary-container" viewBox="0 0 100 100" data-p="spinner"><path d={sunny} /></svg>
    )}

    {slug === 'tokens' && (
      <span class="grid w-32 gap-2.5">
        {['fast', 'default', 'slow'].map((speed) => (
          <span class={lane}>
            <span class="relative size-3.5 rounded-full bg-primary" data-p="ball" data-speed={speed} />
          </span>
        ))}
      </span>
    )}

    {slug === 'per-breakpoint' && (
      <span class="flex items-end gap-2.5">
        <span class={`${device} h-17.5 w-10`}>
          <span class={deviceCard} data-p="phone-card" />
        </span>
        <span class={`${device} h-14 w-21`}>
          <span class={deviceCard} data-p="desk-card" />
        </span>
      </span>
    )}

    {slug === 'animate' && (
      <span class="size-14 rounded-[14px] bg-primary" data-p="swatch" />
    )}

    {slug === 'accessibility' && (
      <span class="grid w-32 gap-2.5">
        <span class={lane}>
          <span class="relative size-3.5 rounded-full bg-primary" data-p="full" />
        </span>
        <span class={lane}>
          <span class="relative ml-auto size-3.5 rounded-full bg-tertiary opacity-0" data-p="reduced" />
        </span>
      </span>
    )}
  </span>
  <span class="flex flex-col items-start gap-1.5 p-2.5">
    <span class="card-name text-title-small text-on-surface">{need.need ?? need.label}</span>
    {api && (
      // The function, then the word of its spec that makes the need, in the stronger tone; a card too narrow for the line breaks
      // before the dot, and a card too narrow for the function (two a row on a phone) leaves the chip to the need's page.
      <code class="card-api max-w-full rounded-lg bg-surface-container-high px-1.5 py-0.5 font-mono text-[11px] leading-[18px] tracking-normal text-on-surface-variant @max-[159px]/card:hidden">{api.call}{api.word && <>{' '}<span class="whitespace-nowrap">{'· '}<span class="text-on-surface">{api.word}</span></span></>}</code>
    )}
  </span>
</a>
