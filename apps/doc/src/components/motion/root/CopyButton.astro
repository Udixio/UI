---
/**
 * A copy button of the root page: Udixio's icon button (CopyFromPageButton, a React island). It copies the visible
 * `[data-copy-source]` of its `[data-copy-group]` (or the code of the visible tab panel of its `[data-code-tabs]`), shows a
 * check for a moment and says so in its polite live region.
 */
import { CopyFromPageButton } from '@/components/CopyCodeButton';

type Props = {
  /** The accessible name, e.g. "Copy the install command". */
  label: string;
};

const { label } = Astro.props;
---
<CopyFromPageButton client:load label={label} />
