---
/**
 * A copy button of the root page. It copies the visible `[data-copy-source]` of its `[data-copy-group]` (or the code of
 * the group's visible tab panel), and says so in the page's polite live region (`root/framework.ts`).
 */
import { iCheck } from '@udixio/icons-rounded-400/check';
import { iContentCopy } from '@udixio/icons-rounded-400/content_copy';

type Props = {
  /** The accessible name, e.g. "Copy the install command". */
  label: string;
};

const { label } = Astro.props;
---
<button type="button" class="copy" aria-label={label} data-code-copy>
  <span class="copy-icon" data-icon="copy" aria-hidden="true" set:html={iContentCopy} />
  <span class="copy-icon" data-icon="done" aria-hidden="true" hidden set:html={iCheck} />
</button>

<style>
  .copy {
    display: grid;
    flex: none;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-left: auto;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--color-on-surface-variant);
    cursor: pointer;
    transition: background-color 150ms, color 150ms;
  }

  .copy:hover {
    background: color-mix(in oklab, var(--color-on-surface) 8%, transparent);
    color: var(--color-on-surface);
  }

  .copy:focus-visible {
    outline: 2px solid var(--color-on-surface);
    outline-offset: 2px;
  }

  .copy[data-copied] {
    color: var(--color-primary);
  }

  .copy-icon {
    display: grid;
    width: 20px;
    height: 20px;
  }

  .copy-icon[hidden] {
    display: none;
  }

  .copy-icon :global(svg) {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }
</style>
