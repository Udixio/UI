---
/**
 * The weight of @udixio/motion's entries: one row per entry, its budget as a bar on one scale (the heaviest entry fills
 * it), and the figure. `compact` keeps the core row and one line about the others, with a link to the full table on
 * Getting started. The budgets come from `lib/motion-facts.ts`, which reads `packages/motion/.size-limit.json`.
 */
import { MOTION_NEEDS } from '@/lib/motion-nav';
import { MOTION_ENTRIES, formatKb, type EntryLoad } from '@/lib/motion-facts';

type Props = {
  /** The core row and a line about the other entries, with a link to the full table. */
  compact?: boolean;
};

const { compact = false } = Astro.props;
const core = MOTION_ENTRIES.find((entry) => entry.load === 'core') ?? MOTION_ENTRIES[0];
const others = MOTION_ENTRIES.filter((entry) => entry !== core);
const heaviest = Math.max(...MOTION_ENTRIES.map((entry) => entry.bytes));
const largestOther = Math.max(...others.map((entry) => entry.bytes));
const entries = compact ? [core] : MOTION_ENTRIES;
const LOADS: Record<EntryLoad, string> = {
  core: 'Always',
  auto: 'On first use',
  import: 'When imported',
};
const labelOf = (slug: string) => MOTION_NEEDS.find((need) => need.slug === slug);
---
<div class="weights" data-weights={compact ? 'compact' : 'full'}>
  <ul class="weights-list">
    {entries.map((entry) => (
      <li class="weight">
        <code class="weight-path">{entry.path.replace('@udixio/motion', '') || '@udixio/motion'}</code>
        <span class="weight-bar" aria-hidden="true"><span style={`--share: ${(entry.bytes / heaviest).toFixed(3)}`} /></span>
        <span class="weight-kb text-label-large text-on-surface">
          {formatKb(entry.bytes)}<span class="sr-only"> at most, gzipped</span>
        </span>
        <span class="weight-meta text-body-small text-on-surface-variant">
          <span class="weight-load">{LOADS[entry.load]}</span>
          {!compact && (
            <>
              <span aria-hidden="true"> · </span>
              {entry.needs.map((slug, index) => {
                const need = labelOf(slug);
                return need ? (
                  <>{index > 0 && ', '}<a href={need.href}>{need.label}</a></>
                ) : null;
              })}
            </>
          )}
        </span>
      </li>
    ))}
  </ul>
  {compact && (
    <p class="weights-more text-body-medium text-on-surface-variant">
      {others.length} more entries, each at most {formatKb(largestOther)} gzipped, load when a page first needs them or when you
      import them. <a href="/motion/getting-started#weight" class="weights-link text-label-large text-primary">The full table</a>
    </p>
  )}
</div>

<style>
  .weights {
    display: grid;
    gap: 16px;
  }

  .weights-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    column-gap: 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 760px) {
    .weights:not([data-weights='compact']) .weights-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-flow: column;
      grid-template-rows: repeat(7, auto);
    }
  }

  .weight {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 2px 12px;
    padding: 10px 0 11px;
    border-top: 1px solid var(--color-outline-variant);
  }

  .weight-path {
    color: var(--color-on-surface);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
    font-size: 13px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .weight-meta {
    grid-column: 1 / -1;
  }

  .weight-meta a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--color-outline-variant);
    text-underline-offset: 3px;
    border-radius: 4px;
  }

  .weight-meta a:hover {
    color: var(--color-on-surface);
    text-decoration-color: currentColor;
  }

  .weight-meta a:focus-visible,
  .weights-link:focus-visible {
    outline: 2px solid var(--color-on-surface);
    outline-offset: 2px;
  }

  .weight-bar {
    display: block;
    width: 72px;
    height: 6px;
    border-radius: 999px;
    background: var(--color-surface-container-high);
  }

  .weight-bar > span {
    display: block;
    width: calc(var(--share) * 100%);
    min-width: 6px;
    height: 100%;
    border-radius: inherit;
    background: var(--color-primary);
  }

  .weight-kb {
    min-width: 52px;
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .weights-more {
    margin: 0;
    max-width: 68ch;
  }

  .weights-link {
    text-decoration: none;
    white-space: nowrap;
  }

  .weights-link:hover {
    text-decoration: underline;
  }

  /* Narrow: a long path (the core's) wraps rather than being cut, as the column is only a few words wide. */
  @media (max-width: 679px) {
    .weight-bar {
      width: 56px;
    }

    .weight-path {
      white-space: normal;
      overflow-wrap: anywhere;
    }
  }
</style>
