---
// A type, its names of exports linked to their entries. Styled by apiStyles.ts (`code[data-type]`).
import { typeSegments } from '@/lib/motionApi';

type Props = {
  /** A TypeScript type, as the source writes it. */
  type: string;
  /** The adapter whose symbols a name links to first. */
  framework?: string;
  /** The anchor of the symbol being described: its own name is not linked. */
  self?: string;
};

const { type, framework, self } = Astro.props;
const segments = typeSegments(type, framework, self);
---
<code data-type>{segments.map((segment) => (segment.href ? <a href={segment.href}>{segment.text}</a> : segment.text))}</code>
