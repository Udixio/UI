---
// Unstyled on purpose: apiStyles.ts styles the reference's prose, code spans and links from the element around them.
import { blocks, inline, type Segment } from '@/lib/motionApi';

type Props = {
  /** TSDoc prose: `code` spans, blank lines between paragraphs, `- ` items. */
  text: string;
  /** The adapter whose symbols a name links to first. */
  framework?: string;
  /** One line, with no paragraph around it: for a table cell or a summary. */
  inline?: boolean;
  /** Links the names of exports to their entries. Off inside a summary, which is itself the control that opens an entry. */
  links?: boolean;
};

const { text, framework, inline: isInline = false, links = true } = Astro.props;
const content = isInline ? [] : blocks(text, framework);
const line = isInline ? inline(text.replace(/\s+/g, ' '), framework) : [];
const href = (segment: Segment) => (links ? segment.href : undefined);
---
{isInline ? line.map((segment) => segment.code
  ? (href(segment) ? <a href={href(segment)}><code>{segment.text}</code></a> : <code>{segment.text}</code>)
  : segment.text) : (
  <div data-text>
    {content.map((block) => block.list ? (
      <ul>{block.items.map((item) => <li>{item.map((segment) => segment.code
        ? (href(segment) ? <a href={href(segment)}><code>{segment.text}</code></a> : <code>{segment.text}</code>)
        : segment.text)}</li>)}</ul>
    ) : (
      <p>{block.segments.map((segment) => segment.code
        ? (href(segment) ? <a href={href(segment)}><code>{segment.text}</code></a> : <code>{segment.text}</code>)
        : segment.text)}</p>
    ))}
  </div>
)}
