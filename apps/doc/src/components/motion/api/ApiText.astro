---
import { blocks, inline } from '@/lib/motionApi';

type Props = {
  /** TSDoc prose: `code` spans, blank lines between paragraphs, `- ` items. */
  text: string;
  /** The adapter whose symbols a name links to first. */
  framework?: string;
  /** One line, with no paragraph around it: for a table cell. */
  inline?: boolean;
  class?: string;
};

const { text, framework, inline: isInline = false, class: className = '' } = Astro.props;
const codeClass = 'rounded bg-surface-container-highest px-1 font-mono text-[0.9em] text-on-surface';
const linkClass = 'text-primary underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-surface';
const content = isInline ? [] : blocks(text, framework);
const line = isInline ? inline(text.replace(/\s+/g, ' '), framework) : [];
---
{isInline ? (
  <span class={className}>
    {line.map((segment) => segment.code
      ? (segment.href ? <a href={segment.href} class={linkClass}><code class={codeClass}>{segment.text}</code></a> : <code class={codeClass}>{segment.text}</code>)
      : segment.text)}
  </span>
) : (
  <div class={`flex flex-col gap-2 ${className}`}>
    {content.map((block) => block.list ? (
      <ul class="flex list-disc flex-col gap-1 ps-5">
        {block.items.map((item) => (
          <li>
            {item.map((segment) => segment.code
              ? (segment.href ? <a href={segment.href} class={linkClass}><code class={codeClass}>{segment.text}</code></a> : <code class={codeClass}>{segment.text}</code>)
              : segment.text)}
          </li>
        ))}
      </ul>
    ) : (
      <p>
        {block.segments.map((segment) => segment.code
          ? (segment.href ? <a href={segment.href} class={linkClass}><code class={codeClass}>{segment.text}</code></a> : <code class={codeClass}>{segment.text}</code>)
          : segment.text)}
      </p>
    ))}
  </div>
)}
