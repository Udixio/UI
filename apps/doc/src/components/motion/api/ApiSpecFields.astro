---
// The fields of a motion spec, read from the manifest (which verbs take each one, and its values) and from the option
// descriptions the need pages share (src/lib/motionDocs.ts). The type of MotionSpec is a union per verb that does not
// read as a table, so the reference shows this one instead.
import manifest from '@udixio/motion/motion-manifest.json';
import { optionDocs } from '@/lib/motionDocs';

const domains = manifest.domains as unknown as Record<string, readonly string[]>;
const verbs = manifest.verbs as unknown as Record<string, { keyframes: string; options: string[] }>;
const spec = manifest.spec as unknown as { required: string[]; optional: string[] };

/** The two required fields, which optionDocs does not hold: they are not options. */
const OWN: Record<string, { values: string; description: string }> = {
  verb: { values: domains.verbs!.join(' · '), description: 'What the motion does; it sets its trigger, its default timing and the options it takes.' },
  keyframes: { values: `frames of ${domains.visualFields!.join(' · ')}`, description: 'The frames the motion plays, at least one. A layout takes none (omit them, or give an empty list): it moves between two measured boxes.' },
};
const OTHER_VALUES: Record<string, string> = {
  timing: 'spring.* token, or a curve { duration, easing }',
  shared: 'a key, as a string',
  reason: 'a sentence',
};

const rows = [...spec.required, ...spec.optional].map((name) => {
  const takenBy = Object.entries(verbs)
    .filter(([, verb]) => name === 'verb' || name === 'keyframes' || verb.options.includes(name))
    .map(([verb]) => verb);
  const own = OWN[name];
  const description = own?.description ?? optionDocs[name];
  if (description === undefined) throw new Error(`ApiSpecFields: no description for the field "${name}"`);
  const values = own?.values ?? OTHER_VALUES[name] ?? (domains[name] ?? []).join(' · ');
  return { name, required: spec.required.includes(name), values, verbs: takenBy.length === Object.keys(verbs).length ? 'all' : takenBy.join(', '), description };
});
---
<div>
  <p data-title>Fields</p>
  <dl data-rows>
    {rows.map((row) => (
      <div>
        <dt>{row.name}{row.required && <small data-required>required</small>}</dt>
        <dd><span>{row.description}</span><small>values <code>{row.values}</code> · verbs <code>{row.verbs}</code></small></dd>
      </div>
    ))}
  </dl>
  <p class="mt-2 text-body-small">The defaults of each verb are in the <a href="/motion/presets">Presets</a> tables.</p>
</div>
