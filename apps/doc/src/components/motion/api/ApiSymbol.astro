---
// One export of the reference: a fold whose summary is its name, its kind and its first sentence; the rest (signature,
// tables, notes, examples) opens under it. The markup is plain: apiStyles.ts styles it from the element around the
// entries. The id is the anchor (`#api-motion`): the page opens the entry it points to (api.astro).
import ApiTable from './ApiTable.astro';
import ApiText from './ApiText.astro';
import ApiType from './ApiType.astro';
import ApiSpecFields from './ApiSpecFields.astro';
import { NOTE_TAGS, importLine, kindLabel, needLabel, splitSummary, type ApiSymbol } from '@/lib/motionApi';

type Props = {
  symbol: ApiSymbol;
  /** The heading level: under a group, or under a section of it. */
  level: 3 | 4 | 5;
};

const { symbol, level } = Astro.props;
const Heading = `h${level}` as 'h3' | 'h4' | 'h5';
const { framework } = symbol;
const kind = kindLabel(symbol);
const notes = NOTE_TAGS.filter(([tag]) => symbol.tags[tag] !== undefined);
const hasParams = (symbol.params?.length ?? 0) > 0;
// A React component and an Angular directive document their props or inputs: their one `props` parameter says nothing more.
const showParams = hasParams && !(kind === 'component' && symbol.params!.length === 1);
const { summary, rest } = splitSummary(symbol.description);
const otherEntries = symbol.entries.slice(1);
---
<details id={symbol.id} data-api-entry>
  <summary><Heading>{symbol.name}</Heading><span>{kind}{symbol.selector && <>{' · '}<code>{symbol.selector}</code></>}</span>{summary && <span data-sum><ApiText text={summary} framework={framework} inline links={false} /></span>}</summary>
  <div>
    {rest && <ApiText text={rest} framework={framework} />}
    {symbol.variants?.map((variant) => (
      <p>From <code>{variant.entry}</code>: <ApiText text={variant.description} framework={framework} inline /></p>
    ))}
    <pre><code>{importLine(symbol)}{'\n'}{symbol.signatures.join('\n')}</code></pre>
    {otherEntries.length > 0 && <p>Also exported by {otherEntries.map((entry, index) => <>{index > 0 && ', '}<code>{entry}</code></>)}.</p>}
    {symbol.resolved && <p>One of <ApiType type={symbol.resolved} framework={framework} />.</p>}
    {showParams && (
      <div><p data-title>Parameters</p><ApiTable rows={symbol.params!} framework={framework} self={symbol.id} /></div>
    )}
    {symbol.returns && symbol.returns.type && symbol.returns.type !== 'void' && kind !== 'component' && (
      <p><span data-title>Returns</span>{' '}<ApiType type={symbol.returns.type} framework={framework} self={symbol.id} />{symbol.returns.description && <>{' — '}<ApiText text={symbol.returns.description} framework={framework} inline /></>}</p>
    )}
    {symbol.members && symbol.members.length > 0 && (
      <div><p data-title>{symbol.kind === 'constant' ? 'Fields' : 'Members'}</p><ApiTable rows={symbol.members} framework={framework} self={symbol.id} /></div>
    )}
    {symbol.id === 'api-MotionSpec' && <ApiSpecFields />}
    {symbol.inputs && symbol.inputs.length > 0 && (
      <div><p data-title>Inputs</p><ApiTable rows={symbol.inputs} framework={framework} self={symbol.id} /></div>
    )}
    {symbol.outputs && symbol.outputs.length > 0 && (
      <div><p data-title>Outputs</p><ApiTable rows={symbol.outputs} framework={framework} self={symbol.id} /></div>
    )}
    {symbol.methods && symbol.methods.length > 0 && (
      <div>
        <p data-title>Methods and properties</p>
        <dl data-methods>
          {symbol.methods.map((method) => (
            <div><dt><ApiType type={method.signature} framework={framework} self={symbol.id} /></dt><dd><ApiText text={method.description} framework={framework} inline /></dd></div>
          ))}
        </dl>
      </div>
    )}
    {notes.map(([tag, title]) => (
      <div><p data-title>{title}</p><ApiText text={symbol.tags[tag]!} framework={framework} /></div>
    ))}
    {symbol.examples.length > 0 && (
      <div class="flex flex-col gap-3"><p data-title class="mb-0!">{symbol.examples.length > 1 ? 'Examples' : 'Example'}</p>{symbol.examples.map((example) => <pre><code>{example}</code></pre>)}</div>
    )}
    {symbol.need && <p>In use: <a href={symbol.need}>{needLabel(symbol.need)}</a></p>}
  </div>
</details>
