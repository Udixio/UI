---
// A table of rows (parameters, members, inputs, outputs), as a `dl[data-rows]` styled by apiStyles.ts. Its label is the
// `[data-title]` paragraph before it (Parameters, Members…).
import ApiText from './ApiText.astro';
import ApiType from './ApiType.astro';
import { rowDescription, type ApiRow } from '@/lib/motionApi';

type Props = {
  rows: ApiRow[];
  framework?: string;
  self?: string;
};

const { rows, framework, self } = Astro.props;

/** The rows, each inline options object followed by its fields as `options.field`. */
const flat = rows.flatMap((row) => [
  row,
  ...(row.fields ?? []).map((field) => ({ ...field, name: `${row.name}.${field.name}` })),
]);
const required = (row: ApiRow) => row.required === true || (row.required === undefined && row.optional === false);
/** An empty options object, `{}` or `() => ({})`, is no default worth a line. */
const shownDefault = (value: string | null) => (value === null || /^(?:\{\}|\(\) => \(\{\}\))$/.test(value) ? null : value);
---
<dl data-rows>
  {flat.map((row) => {
    const fallback = shownDefault(row.default);
    const description = rowDescription(row, framework);
    return (
      <div>
        <dt>{row.name}{required(row) && <small data-required>required</small>}{row.readonly && <small>read-only</small>}{row.property && row.property !== row.name && <small data-block>property {row.property}</small>}</dt>
        <dd>{description && <span><ApiText text={description} framework={framework} inline /></span>}<small>{row.type ? <ApiType type={row.type} framework={framework} self={self} /> : 'type: see the source'}{fallback && <>{' · default '}<code>{fallback}</code></>}</small></dd>
      </div>
    );
  })}
</dl>
