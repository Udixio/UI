---
import { buttonClass, stageControlsClass } from '@/components/motionDemo';

type Props = {
  /** The scene module (`scenes/<scene>.ts`) that mounts in this stage. */
  scene: string;
  /** The accessible name of the stage. */
  label: string;
  /** The minimum height of the scene area: 240, 360 or 480 px. */
  height?: 'sm' | 'md' | 'lg';
  /** Adds a Replay button to the controls; the scene listens to `[data-motion-replay]`. */
  replay?: boolean;
};

const { scene, label, height = 'md', replay = false } = Astro.props;

const sceneHeight = {
  sm: 'min-h-[240px]',
  md: 'min-h-[360px]',
  lg: 'min-h-[480px]',
}[height];
const hasControls = replay || Astro.slots.has('controls');
---
<section class="not-prose my-8" aria-label={label} data-motion-scene={scene}>
  {hasControls && (
    <div class={`${stageControlsClass} mb-3`}>
      <slot name="controls" />
      {replay && (
        <button type="button" class={buttonClass} data-motion-replay>Replay</button>
      )}
    </div>
  )}
  <div class={`relative grid place-items-center overflow-clip rounded-[28px] bg-surface-container-low p-5 ${sceneHeight}`}>
    <slot />
  </div>
  {Astro.slots.has('readout') && (
    <pre class="mt-3 overflow-x-auto rounded-2xl bg-surface-container-high p-4 font-mono text-body-small text-on-surface-variant"><slot name="readout" /></pre>
  )}
</section>
