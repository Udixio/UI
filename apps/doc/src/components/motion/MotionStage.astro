---
import DemoSurface from '@/components/DemoSurface.astro';
import { stageControlsClass } from '@/components/motionDemo';
import { ReplayButton } from './ReplayButton';

type Props = {
  /** The scene module (`scenes/<scene>.ts`) that mounts in this stage. */
  scene: string;
  /** The accessible name of the stage. */
  label: string;
  /**
   * The reserved height of the scene, in px, or `[wide, narrow]` where `narrow` applies below 560 px of the stage's width.
   * Chosen from the scene's largest state, so that nothing the scene adds, removes or resizes pushes the page.
   */
  height: number | readonly [number, number];
  /** Adds a Replay button to the controls; the scene listens to `[data-motion-replay]`. */
  replay?: boolean;
};

const { scene, label, height, replay = false } = Astro.props;

const hasControls = replay || Astro.slots.has('controls');
---
<section class="not-prose my-8" aria-label={label} data-motion-scene={scene}>
  {hasControls && (
    <div class={`${stageControlsClass} mb-3`}>
      <slot name="controls" />
      {replay && <ReplayButton client:visible />}
    </div>
  )}
  <DemoSurface height={height} class="relative grid grid-cols-[minmax(0,1fr)] place-items-center overflow-clip p-5">
    <slot />
  </DemoSurface>
  {Astro.slots.has('readout') && (
    <pre class="mt-3 overflow-x-auto rounded-2xl bg-surface-container-high p-4 font-mono text-body-small text-on-surface-variant"><slot name="readout" /></pre>
  )}
</section>
