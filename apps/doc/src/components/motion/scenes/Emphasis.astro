---
/**
 * The markup of the "Draw attention" scene (`emphasis.ts`): a code field and its Check button. The field shakes when the
 * code is refused, and the badge of the button counts the refusals and pops at each one. Styles are theme tokens only.
 */
---
<div class="flex w-full max-w-[19rem] flex-col gap-4 rounded-3xl bg-surface-container-high p-5" data-emphasis-scene>
  <label class="flex flex-col gap-2" for="emphasis-code">
    <span class="text-label-large text-on-surface-variant">Code</span>
    <input
      id="emphasis-code"
      type="text"
      inputmode="numeric"
      maxlength="4"
      autocomplete="off"
      placeholder="0000"
      aria-invalid="false"
      aria-describedby="emphasis-message"
      class="h-12 w-full rounded-xl border border-outline bg-surface-container-lowest px-4 text-center font-mono text-title-medium tracking-[0.4em] text-on-surface placeholder:text-outline-variant outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-surface aria-[invalid=true]:border-error"
      data-emphasis-field
      data-motion="shake"
      data-state="0"
    />
  </label>
  <div class="flex items-center gap-3">
    <button
      type="button"
      class="relative h-10 rounded-full bg-primary px-6 text-label-large text-on-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-surface"
      data-emphasis-check
      data-motion="press"
      data-state="0"
    >
      Check
      <span
        class="absolute -right-2 -top-2 grid h-5 min-w-5 place-items-center rounded-full bg-error px-1 text-label-small text-on-error"
        aria-hidden="true"
        data-emphasis-badge
        data-state="0"
      >0</span>
    </button>
    <p id="emphasis-message" class="min-w-0 flex-1 text-body-small text-on-surface-variant" role="status" data-emphasis-message></p>
  </div>
</div>
