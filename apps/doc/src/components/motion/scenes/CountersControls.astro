---
/**
 * The controls of the "Count a number" scene (`counters.ts`): Add 1,000, and on the need page the language group (en · fr ·
 * de), which sets the language of the numbers. On the page, the stage's readout names the language.
 */
import { filledControl, segmentControl, segmentedControl } from './controls';

type Props = {
  size?: 'tile' | 'page';
};

const { size = 'tile' } = Astro.props;
const languages = ['en', 'fr', 'de'] as const;
---
<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
  <button type="button" class={filledControl} data-counters-add>Add 1,000</button>
  {size === 'page' && (
    <div class={segmentedControl} role="group" aria-label="Language of the numbers">
      {languages.map((lang) => (
        <button type="button" class={segmentControl} aria-pressed={String(lang === 'en')} data-counters-lang={lang}>{lang}</button>
      ))}
    </div>
  )}
</div>
