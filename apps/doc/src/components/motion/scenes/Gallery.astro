---
/**
 * The markup of the "Morph one into another" scene (`gallery.ts`): six thumbnails, and one detail that they share a key
 * with. A thumbnail opens into the detail, which takes its key and colours. The detail is a disclosure that covers the
 * whole scene: the scene fills the height of its stage, at least the height the detail needs, with the grid centred in it.
 * `heading` is h4 in a root-page tile and h3 on a need page. Its Close button is a Udixio Button (`GalleryClose.tsx`).
 */
import { shapePath } from '@/lib/m3-shapes';
import { GALLERY_ITEMS } from './data/gallery';
import { GalleryClose } from './GalleryClose';

type Props = {
  heading?: 'h3' | 'h4';
};

const { heading = 'h4' } = Astro.props;
const Heading = heading;
const shapes = GALLERY_ITEMS.map(({ shape }) => shapePath(shape.n, shape.d, shape.phi));
// A thumbnail is a column, its shape above its name. In the list layout (the scene's `data-mode="list"`) it is a row, its
// shape at the left, and the grid of thumbnails is one column.
const thumbClass =
  'flex min-w-0 flex-col items-center gap-2 rounded-2xl p-3 text-center transition-[background-color] duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-surface [[data-mode=list]_&]:flex-row [[data-mode=list]_&]:justify-start [[data-mode=list]_&]:py-2 [[data-mode=list]_&]:pl-2 [[data-mode=list]_&]:pr-3.5 [[data-mode=list]_&]:text-left';
---
<div class="relative grid min-h-[18rem] w-full max-w-[34rem] items-center self-stretch" data-gallery-scene data-mode="grid">
  <div class="grid grid-cols-3 gap-3 [[data-mode=list]_&]:grid-cols-[minmax(0,1fr)]" data-gallery-grid>
    {GALLERY_ITEMS.map((item, index) => (
      <button
        type="button"
        class={`${thumbClass} ${item.colours}`}
        aria-expanded="false"
        aria-controls="gallery-detail"
        data-motion="reflow"
        data-motion-shared={`shape-${index}`}
        data-gallery-thumb
        data-gallery-role={item.role}
        data-gallery-colours={item.colours}
        data-gallery-text={item.text}
      >
        <svg class="size-14 flex-none fill-current" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
          <path d={shapes[index]} />
        </svg>
        <span class="text-label-large" data-gallery-name>{item.name}</span>
      </button>
    ))}
  </div>
  <div
    id="gallery-detail"
    class="absolute inset-0 flex items-center justify-center overflow-clip rounded-[28px]"
    hidden
    data-motion="reflow"
    data-motion-shared=""
    data-gallery-detail
  >
    <div class="flex size-full flex-col items-center justify-center gap-3 p-5 text-center" data-gallery-panel>
      <svg class="size-24 flex-none fill-current" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
        <path d={shapes[0]} data-gallery-detail-shape />
      </svg>
      <Heading class="text-headline-small" data-gallery-detail-name>Cookie</Heading>
      <p class="max-w-[30ch] text-body-medium" data-gallery-detail-text>{GALLERY_ITEMS[0].text}</p>
      <GalleryClose client:visible />
    </div>
  </div>
</div>
