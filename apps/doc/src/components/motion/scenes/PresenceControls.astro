---
/**
 * The controls of the "Show and hide" scene (`presence.ts`): the Hide toggle, the preset group (fade · slide · scale) and,
 * in a tile, the chip that shows the preset in code. `toggleId` is the id of the toggle, which the card names as the place
 * focus returns to.
 */
import { chipClass } from '@/components/motionDemo';
import { filledControl, segmentControl, segmentedControl } from './controls';

type Props = {
  /** The id of the toggle; the card of the scene names it in `data-motion-restore-focus`. */
  toggleId: string;
  /** The id of the card the toggle shows and hides. */
  cardId: string;
  size?: 'tile' | 'page';
};

const { toggleId, cardId, size = 'tile' } = Astro.props;
const presets = ['fade', 'slide', 'scale'] as const;
---
<div class="flex flex-col gap-3">
  <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
    <button
      type="button"
      id={toggleId}
      class={`${filledControl} min-w-[5.5rem]`}
      aria-expanded="true"
      aria-controls={cardId}
      data-presence-toggle
    >Hide</button>
    <div class={segmentedControl} role="group" aria-label="Preset">
      {presets.map((preset) => (
        <button type="button" class={segmentControl} aria-pressed={String(preset === 'slide')} data-presence-preset={preset}>{preset}</button>
      ))}
    </div>
    {size === 'tile' && <code class={`${chipClass} tracking-normal`} data-presence-readout>data-motion="slide"</code>}
  </div>
</div>
