---
/**
 * The markup of the "Animate text" scene (`text.ts`): one sentence, which the module splits and plays. The sentence is
 * read as written: its pieces are a visual copy that the library hides from assistive technology. `size` sets its size.
 */

type Props = {
  size?: 'tile' | 'page';
};

const { size = 'tile' } = Astro.props;
---
<div class="flex w-full max-w-[34rem] flex-col items-center justify-center text-center" data-text-scene>
  <p class:list={['max-w-[22ch] text-on-surface', size === 'page' ? 'text-display-small' : 'text-headline-medium']} data-text-line>
    Every word arrives in turn, and is read once.
  </p>
</div>
