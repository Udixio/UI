---
/**
 * The markup of the "Move to a new place" scene (`resize.ts`): a card that widens, a pill that moves from the start to the
 * end of its row, and a list that shuffles. They share one scope, so that a change of any of them moves the others. The
 * list has three rows in a tile and five on a need page.
 */

type Props = {
  size?: 'tile' | 'page';
};

const { size = 'tile' } = Astro.props;
const rows = size === 'page' ? ['Build', 'Review', 'Release', 'Docs', 'Tests'] : ['Build', 'Review', 'Release'];
---
<div class="resize-scene flex w-full max-w-[22rem] flex-col gap-3" data-motion-scope data-resize-scene>
  <div
    class="resize-card flex items-center justify-between gap-3 rounded-3xl bg-primary-container px-5 py-4 text-on-primary-container"
    data-motion="reflow"
    data-resize-card
  >
    <span class="min-w-0">
      <span class="block text-title-medium">Widen me</span>
      <span class="block text-body-small">The text keeps its shape as the card resizes.</span>
    </span>
    <span class="flex-none rounded-full bg-primary px-3 py-1 text-label-medium text-on-primary" data-motion="reflow">New</span>
  </div>
  <div class="resize-row flex" data-resize-row>
    <span class="rounded-full bg-secondary-container px-4 py-2 text-label-large text-on-secondary-container" data-motion="reflow">
      Start · End
    </span>
  </div>
  <ul class="flex flex-col gap-2" data-resize-list>
    {rows.map((label) => (
      <li class="rounded-xl bg-surface-container-high px-4 py-3 text-body-large text-on-surface" data-motion="reflow">{label}</li>
    ))}
  </ul>
</div>

<style>
  /* The card starts at 60 % of the scene, and Widen takes it to the full width (an inline style, resize.ts). */
  .resize-scene {
    container-type: inline-size;
  }

  .resize-card {
    width: 60%;
  }

  /* On a phone the card starts wider, and its chip goes under its text, so that the text keeps a few words per line. */
  @container (max-width: 20rem) {
    .resize-card {
      width: 80%;
      flex-direction: column;
      align-items: flex-start;
      padding-inline: 16px;
    }
  }

  /* The pill moves to the end of its row when the row takes data-end: the layout follows the attribute. */
  .resize-row {
    justify-content: flex-start;
  }

  .resize-row[data-end] {
    justify-content: flex-end;
  }
</style>
