---
/**
 * The markup of the hero of /motion/presets (`presets.ts`): the thirteen presets in one wall, one tile each, with the verb
 * of each as a chip. A tile is a button when pressing it replays the preset (appear, emphasize, layout and reveal), a link
 * when it leads elsewhere (scrub), and a plain box when it runs by itself (loop). Its specimen is the element that carries
 * the preset in data-motion (see PresetSpecimen.astro). The two presets that travel (reflow, parallax) have wide tiles.
 */
import PresetSpecimen from './PresetSpecimen.astro';

const PRESETS = [
  { name: 'fade', verb: 'appear', role: 'button' },
  { name: 'slide', verb: 'appear', role: 'button' },
  { name: 'cascade', verb: 'appear', role: 'button' },
  { name: 'scale', verb: 'appear', role: 'button' },
  { name: 'draw', verb: 'appear', role: 'button' },
  { name: 'press', verb: 'emphasize', role: 'button' },
  { name: 'shake', verb: 'emphasize', role: 'button' },
  { name: 'reflow', verb: 'layout', role: 'button', wide: true },
  { name: 'rise', verb: 'reveal', role: 'button' },
  { name: 'parallax', verb: 'scrub', role: 'link', wide: true },
  { name: 'rotate', verb: 'loop', role: 'box' },
  { name: 'breathe', verb: 'loop', role: 'box' },
  { name: 'blink', verb: 'loop', role: 'box' },
] as const;

const tile =
  'flex min-w-0 flex-col items-start gap-3 rounded-2xl bg-surface-container-high p-4 text-start transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-surface';
const interactive = 'hover:bg-surface-container-highest';
// The specimen is clipped to its box: a parallax tile drifts up and down, and must not reach the name under it.
const specimen = 'flex h-16 w-full items-center justify-center overflow-clip';
// The verb of a tile is plain mono text: a chip background would be the tile's own colour.
const verbClass = 'font-mono text-label-medium text-on-surface-variant';
---
<div class="@container w-full">
  {/*
    Three columns where they have the room: the two presets that travel (reflow, parallax) take two cells each, so the
    thirteen tiles fill five full rows, the three loops together in the last. Two columns (from 20 rem of wall): parallax
    alone is wide, its tenth child, and the grid packs the tiles densely. One column on a phone. From 30 rem the flow is
    row again, so that the tiles keep their order.
  */}
  <ul class="grid grid-cols-1 gap-3 @min-[20rem]:grid-cols-2 @min-[20rem]:grid-flow-row-dense @min-[20rem]:[&>li:nth-child(10)]:col-span-2 @min-[30rem]:grid-cols-3 @min-[30rem]:grid-flow-row" aria-label="Presets">
    {PRESETS.map(({ name, verb, role, ...rest }) => (
      <li class:list={['flex min-w-0', { '@min-[30rem]:col-span-2': 'wide' in rest }]}>
        {role === 'button' && (
          <button type="button" class={`${tile} ${interactive} w-full`} data-preset-tile={name} data-verb={verb}>
            <span class={specimen}><PresetSpecimen name={name} /></span>
            <span class="flex flex-col gap-0.5">
              <span class="text-title-small text-on-surface">{name}</span>
              <span class={verbClass}>{verb}</span>
            </span>
          </button>
        )}
        {role === 'link' && (
          <a href="/motion/scrub" class={`${tile} ${interactive} w-full no-underline`} data-preset-tile={name} data-verb={verb}>
            <span class={specimen}><PresetSpecimen name={name} /></span>
            <span class="flex flex-col gap-0.5">
              <span class="text-title-small text-on-surface">{name}</span>
              <span class={verbClass}>{verb} · open</span>
            </span>
          </a>
        )}
        {role === 'box' && (
          <div class={`${tile} w-full`} data-preset-tile={name} data-verb={verb}>
            <span class={specimen}><PresetSpecimen name={name} /></span>
            <span class="flex flex-col gap-0.5">
              <span class="text-title-small text-on-surface">{name}</span>
              <span class={verbClass}>{verb}</span>
            </span>
          </div>
        )}
      </li>
    ))}
  </ul>
</div>
