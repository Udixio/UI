---
/**
 * The markup of the "Animate any CSS" scene (`animate.ts`): a card whose background, corner radius and clip path change
 * with `animateStyle`. On the need page, a track below it holds a dot that follows the Position slider over a spring
 * (`createSpring`): the slider is the keyboard alternative of the drag.
 */
import { AnimatePosition } from './AnimatePosition';

type Props = {
  size?: 'tile' | 'page';
};

const { size = 'tile' } = Astro.props;
---
<div class="flex w-full max-w-[28rem] flex-col items-center gap-6" data-animate-scene>
  {/* The card starts in its first state (28 px corners, clipped to them), so that the first Next state animates from it. */}
  <div class="flex min-h-32 w-full flex-col justify-between gap-6 rounded-[28px] bg-primary-container p-5 text-on-primary-container [clip-path:inset(0%_round_28px)]" data-animate-card>
    <p class="text-label-large" data-animate-state>State 1 of 3</p>
    <p class="text-title-medium">Colour, corners and clip change together.</p>
  </div>
  {size === 'page' && (
    <div class="flex w-full flex-col gap-3">
      <AnimatePosition client:visible />
      {/* The dot is written as a fraction of its track by the spring (--p) and travels the track less its own width. */}
      <div class="@container relative h-8 overflow-clip rounded-full bg-surface-container-highest" aria-hidden="true">
        <span class="absolute left-1 top-1 block size-6 rounded-full bg-tertiary [translate:calc(var(--p,0)*(100cqi_-_1.5rem))_0]" data-animate-dot></span>
      </div>
    </div>
  )}
</div>
