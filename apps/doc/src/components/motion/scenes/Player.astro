---
/**
 * The markup of the signature scene of the root page (`player.ts`): a music app whose mini-player opens into the full
 * player. The mini-player and the player share the key `player`: on opening, the bar grows into the screen, and the
 * player's cover, title, progress and controls arrive in turn once it has grown; closing shrinks it back into the bar,
 * whose content fades in. Everything else on the screen is still decoration (`aria-hidden`).
 *
 * The two surfaces are neutral markup: they are the shared element. The bar is a native button because it IS the surface
 * that grows; the player's controls are Udixio IconButtons in islands (`PlayerControls.tsx`), hydrated when the page is
 * idle, so that they are live before the first opening and no hydration lands in the middle of a morph.
 */
import { iKeyboardArrowUp } from '@udixio/icons-rounded-400/keyboard_arrow_up';
import { shapePath } from '@/lib/m3-shapes';
import { PlayerClose, PlayerControls } from './PlayerControls';

/** The cover of the track: a Material 3 "cookie" in the tertiary tones; the shelf behind it uses three other shapes. */
const cover = shapePath(9, 0.14, 0);
const shelf = [
  { path: shapePath(4, 0.32, Math.PI / 4), tone: 'bg-primary-container text-on-primary-container' },
  { path: shapePath(6, 0.22, 0), tone: 'bg-secondary-container text-on-secondary-container' },
  { path: shapePath(12, 0.1, 0), tone: 'bg-surface-container-highest text-on-surface-variant' },
];
/** A line of the shelf, a placeholder for a title: the highest tone of the surface, its ends round. */
const line = 'block h-2 rounded-full bg-surface-container-highest';
---
{/* The screen: the shelf at the top, the mini-player docked at the bottom; the player covers the whole screen. */}
<div class="relative flex h-full min-h-[inherit] w-full flex-col justify-between gap-5 p-5" data-player-scene data-motion-scope>
  <div class="grid gap-3.5" aria-hidden="true">
    <p class="m-0 text-title-medium text-on-surface">Listen now</p>
    <div class="grid grid-cols-3 gap-2.5">
      {shelf.map(({ path, tone }) => (
        <span class="grid gap-1.5">
          <span class={`grid aspect-square place-items-center rounded-[18px] ${tone}`}>
            <svg class="w-[52%] fill-current opacity-90" viewBox="0 0 100 100" focusable="false"><path d={path} /></svg>
          </span>
          {/* The first line sits 4 px under its cover; the second is shorter. */}
          <span class={`${line} mt-1 w-[80%]`} />
          <span class={`${line} w-[52%] opacity-60`} />
        </span>
      ))}
    </div>
    {/* Up next: two quiet rows under the shelf. */}
    <ul class="mt-1 grid list-none gap-2.5 p-0">
      {shelf.slice(0, 2).map(({ tone }) => (
        <li class="flex items-center gap-3">
          <span class={`size-9 flex-none rounded-[10px] ${tone}`} />
          <span class="grid flex-1 gap-1.5">
            <span class={`${line} w-[56%]`} />
            <span class={`${line} w-[34%] opacity-60`} />
          </span>
        </li>
      ))}
    </ul>
  </div>

  {/* The mini-player: a tertiary bar, its cover at the start, an arrow at the end. Its height is fixed: the bar keeps its
    size while its content waits hidden (player.ts), so the morph ends on it. Its focus ring waits while the surface morphs
    (`data-morphing`): a ring drawn on a surface that is morphing would be stretched with it. */}
  <button
    type="button"
    class="flex h-16 w-full flex-none cursor-pointer items-center gap-3 overflow-clip rounded-[20px] bg-surface-container-highest py-2 pr-3 pl-2 text-left text-on-surface focus-visible:outline-2 focus-visible:outline-solid focus-visible:outline-offset-2 focus-visible:outline-on-surface [[data-morphing]_&]:focus-visible:outline-transparent"
    aria-expanded="false"
    aria-controls="player-full"
    data-motion="reflow"
    data-motion-shared="player"
    data-player-open
  >
    <span class="grid size-12 flex-none place-items-center rounded-[14px] bg-tertiary-container text-on-tertiary-container" data-motion="fade" data-player-mini-item>
      <svg class="w-[62%] fill-current" viewBox="0 0 100 100" aria-hidden="true" focusable="false"><path d={cover} /></svg>
    </span>
    <span class="min-w-0 flex-1" data-motion="fade" data-player-mini-item>
      <span class="block truncate text-title-small text-on-surface">Slow Tide</span>
      <span class="block truncate text-body-small text-on-surface-variant">Mira Lane</span>
    </span>
    <span class="grid size-6 flex-none [&_svg]:size-full [&_svg]:fill-current" aria-hidden="true" data-motion="fade" data-player-mini-item set:html={iKeyboardArrowUp} />
    <span class="sr-only">Open the player</span>
  </button>

  {/* The player: the whole screen, its cover large, then the title, the progress and the controls. */}
  <div
    id="player-full"
    class="absolute inset-0 flex flex-col items-center gap-3.5 overflow-clip rounded-[inherit] bg-surface-container-highest px-6 pt-3 pb-5"
    role="region"
    aria-label="Now playing"
    hidden
    data-motion="reflow"
    data-motion-shared="player"
    data-player-full
  >
    <PlayerClose client:idle />
    <div class="-mt-2 grid aspect-square w-[min(48%,160px)] place-items-center rounded-4xl bg-tertiary-container text-on-tertiary-container" data-motion="scale" data-player-item hidden>
      <svg class="w-[62%] fill-current" viewBox="0 0 100 100" aria-hidden="true" focusable="false"><path d={cover} /></svg>
    </div>
    <div class="w-full text-center" data-motion="slide" data-player-item hidden>
      <p class="m-0 text-headline-small text-on-surface">Slow Tide</p>
      <p class="m-0 text-body-medium text-on-surface-variant">Mira Lane · Low Orbit</p>
    </div>
    <div class="grid w-full gap-1.5" data-motion="slide" data-player-item hidden aria-hidden="true">
      <span class="block h-1 overflow-hidden rounded-full bg-surface-container-highest">
        <span class="block h-full w-[32%] rounded-[inherit] bg-tertiary" />
      </span>
      <span class="flex justify-between text-label-small text-on-surface-variant"><span>1:12</span><span>3:42</span></span>
    </div>
    <div class="mt-auto" data-motion="slide" data-player-item hidden>
      <PlayerControls client:idle />
    </div>
  </div>
</div>
