---
/**
 * The controls of the "Reduced motion" scene (`policy.ts`): Hide, which hides the card (its exit plays, and Show brings it
 * back), Move, which moves the pill to the other end of its row, and Pause, which holds the loop.
 */
import { filledControl, tonalControl } from './controls';
---
<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
  <button type="button" id="policy-toggle" class={filledControl} aria-expanded="true" aria-controls="policy-card" data-policy-toggle>Hide</button>
  <button type="button" class={tonalControl} data-policy-move>Move</button>
  <button type="button" class={tonalControl} data-policy-pause>Pause</button>
</div>
