---
/**
 * The controls of the "Springs and tokens" scene (`springs.ts`): Send, which moves every ball to the far end of its lane
 * and back, and on the need page Play curves, which runs each curve's bar.
 */
import { filledControl, tonalControl } from './controls';

type Props = {
  size?: 'tile' | 'page';
};

const { size = 'tile' } = Astro.props;
---
<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
  <button type="button" class={filledControl} data-springs-send>Send</button>
  {size === 'page' && (
    <button type="button" class={tonalControl} data-springs-curves>Play curves</button>
  )}
</div>
