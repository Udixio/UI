---
/**
 * The markup of the "Count a number" scene (`counters.ts`): two counters on the tile (visitors, returning), four on the need
 * page (visitors, returning, revenue in EUR, a rating with a decimal). Each `<data>` holds its number in its `value`
 * attribute and its text in the language of the page; the module counts to each new number. `lang` is set on the scene
 * by the page's language group.
 */

type Props = {
  size?: 'tile' | 'page';
};

const { size = 'tile' } = Astro.props;
---
<div class="flex w-full flex-wrap gap-x-10 gap-y-6" data-counters-scene lang={size === 'page' ? 'en' : undefined}>
  <div class="flex flex-col gap-1">
    <data value="12480" data-counter="counter-visitors" class="block text-display-small tabular-nums text-on-surface">12,480</data>
    <span class="text-body-medium text-on-surface-variant">visitors</span>
  </div>
  <div class="flex flex-col gap-1">
    <data value="0.42" data-counter="counter-returning" class="block text-display-small tabular-nums text-on-surface">42%</data>
    <span class="text-body-medium text-on-surface-variant">returning</span>
  </div>
  {size === 'page' && (
    <>
      <div class="flex flex-col gap-1">
        <data value="248300" data-counter="counter-revenue" class="block text-display-small tabular-nums text-on-surface">€248,300.00</data>
        <span class="text-body-medium text-on-surface-variant">revenue this month</span>
      </div>
      <div class="flex flex-col gap-1">
        <data value="4.8" data-counter="counter-rating" class="block text-display-small tabular-nums text-on-surface">4.8</data>
        <span class="text-body-medium text-on-surface-variant">average rating</span>
      </div>
    </>
  )}
</div>
