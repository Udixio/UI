---
/**
 * The controls of the "Move to a new place" scene (`resize.ts`): Widen, Start · End and Shuffle, and on a need page also
 * Move first to end. They sit in the stage's control row.
 */
import { filledControl, tonalControl } from './controls';

type Props = {
  /** `page` adds the button that moves the first row to the end. */
  size?: 'tile' | 'page';
};

const { size = 'tile' } = Astro.props;
---
<div class="flex flex-wrap gap-2">
  <button type="button" class={filledControl} data-resize-widen>Widen</button>
  <button type="button" class={tonalControl} data-resize-align>Start · End</button>
  <button type="button" class={tonalControl} data-resize-shuffle>Shuffle</button>
  {size === 'page' && <button type="button" class={tonalControl} data-resize-rotate>Move first to end</button>}
</div>
