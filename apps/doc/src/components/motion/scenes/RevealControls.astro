---
/**
 * The controls of the "Reveal on scroll" scene (`reveal.ts`): the Once · Always group, which sets how each card of the feed
 * plays on each entry. In a tile, the chip shows the motion in code.
 */
import { segmentControl, segmentedControl } from './controls';

type Props = {
  size?: 'tile' | 'page';
};

const { size = 'tile' } = Astro.props;
const modes = [
  ['once', 'Once'],
  ['always', 'Always'],
] as const;
---
<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
  <div class={segmentedControl} role="group" aria-label="Repeat">
    {modes.map(([value, label]) => (
      <button type="button" class={segmentControl} aria-pressed={String(value === 'once')} data-reveal-mode={value}>{label}</button>
    ))}
  </div>
  {size === 'tile' && <code class="inline-flex items-center rounded-lg bg-surface-container-high px-2.5 py-1 font-mono text-label-medium tracking-normal text-on-surface-variant" data-reveal-readout>repeat: 'once'</code>}
</div>
