---
/**
 * The list of the "Make a list appear" scene (`inbox.ts`): the messages in the page at load, which play no entry. Its height
 * holds five messages, so adding never pushes the page; it is positioned, as an `out-of-flow` exit needs. A leaving message
 * is painted under its neighbours (`isolation` and `z-index`), so the text of the two never collides. The scene gives these
 * messages their presence motion and their gesture when it mounts, once it has defined them.
 */
import {
  INBOX_INITIAL,
  INBOX_MESSAGES,
  INBOX_TINTS,
  inboxAvatarClass,
  inboxHeadClass,
  inboxItemClass,
  inboxNameClass,
  inboxTextClass,
  inboxTimeClass,
} from './data/inbox';

const items = INBOX_INITIAL.map(({ index, time }) => ({
  ...INBOX_MESSAGES[index],
  tint: INBOX_TINTS[index % INBOX_TINTS.length],
  time,
}));
const next = Math.max(...INBOX_INITIAL.map(({ index }) => index)) + 1;
---
<ul class="inbox-list relative flex w-full flex-col gap-2" aria-label="Notifications" data-inbox-list data-inbox-next={next}>
  {items.map((item) => (
    <li class={inboxItemClass} tabindex="0" data-motion="reflow">
      <span class={`${inboxAvatarClass} ${item.tint}`} aria-hidden="true">{item.name[0]}</span>
      <span class="min-w-0">
        <span class={inboxHeadClass}>
          <span class={inboxNameClass}>{item.name}</span>
          <span class={inboxTimeClass}>{item.time}</span>
        </span>
        <span class={inboxTextClass}>{item.text}</span>
      </span>
    </li>
  ))}
</ul>
<style>
  /* Five messages of 56 px with their gaps: the list keeps its height while messages come and go. */
  .inbox-list {
    min-height: calc(5 * 56px + 4 * 0.5rem);
    isolation: isolate;
  }

  /*
   * A message that is leaving stays at its place while it fades, out of the flow: it goes under the messages around it, so
   * that they cover it as they move, and its text fades first, faster than the surface, so that no text shows between two
   * moving messages. `:global`: the messages added by the scene are not in this template.
   */
  .inbox-list > :global([data-presence='exiting']) {
    z-index: -1;
  }

  .inbox-list > :global([data-presence='exiting']) > :global(*) {
    opacity: 0;
    transition: opacity 90ms linear;
  }
</style>
