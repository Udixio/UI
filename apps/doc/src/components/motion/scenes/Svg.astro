---
/**
 * The markup of the "Draw or morph SVG" scene (`svg.ts`): an M3 shape that morphs between four targets (their paths sit in
 * a hidden SVG, so that the morph reads them from the page), and a check mark drawn once. On a need page, a track on which a
 * dot travels along an arc. The shapes are the gallery's, computed at build time.
 */
import { shapePath } from '@/lib/m3-shapes';
import { GALLERY_ITEMS } from './data/gallery';
import { SVG_SHAPES } from './SvgControls';

type Props = {
  size?: 'tile' | 'page';
};

const { size = 'tile' } = Astro.props;
const shapes = SVG_SHAPES.map((name) => {
  const item = GALLERY_ITEMS.find((each) => each.name === name);
  if (item === undefined) throw new Error(`Svg: "${name}" is not a shape of the gallery`);
  return { name, d: shapePath(item.shape.n, item.shape.d, item.shape.phi) };
});
const ARC = "M16 72C96 0 192 0 272 72";
---
<div class="flex w-full max-w-[30rem] flex-col items-center gap-6" data-svg-scene>
  <svg class="hidden" aria-hidden="true" focusable="false">
    {shapes.map(({ name, d }) => <path d={d} data-svg-target={name} />)}
  </svg>
  <div class="flex items-center gap-4 sm:gap-8">
    <svg viewBox="0 0 100 100" class="size-24 flex-none fill-current text-primary sm:size-36" aria-hidden="true" focusable="false">
      <path d={shapes[0].d} data-svg-morph />
    </svg>
    <svg
      viewBox="0 0 48 48"
      class="size-16 flex-none text-primary sm:size-24"
      fill="none"
      stroke="currentColor"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M44 24A20 20 0 1 1 4 24A20 20 0 1 1 44 24Z M16 25L22 31L33 19" data-svg-check />
    </svg>
  </div>
  {size === 'page' && (
    <div class="relative h-24 w-full max-w-72 flex-none rounded-2xl bg-surface-container-high">
      <svg viewBox="0 0 288 96" class="absolute inset-0 size-full text-on-surface-variant" fill="none" stroke="currentColor" stroke-dasharray="4 6" aria-hidden="true" focusable="false">
        <path d={ARC} />
      </svg>
      <span class="absolute left-0 top-0 size-4 rounded-full bg-primary" style={`offset-path: path('${ARC}'); offset-distance: 100%`} data-svg-travel></span>
    </div>
  )}
</div>
