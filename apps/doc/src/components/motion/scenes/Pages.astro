---
/**
 * The markup of the "Change pages" scene (`pages.ts`): a forward link and a Back link, and a diagram of two page frames
 * with the arrow between them, drawn when it comes into view. `size` only words the forward link.
 */

type Props = {
  size?: 'tile' | 'page';
};

const { size = 'tile' } = Astro.props;
// The forward link names the page it goes to; a tile says where the link leads, a hero that it is the next page.
const next = { href: '/motion/scroll', label: size === 'page' ? 'Forward to “Scroll to a target”' : 'Go to “Scroll to a target”' };
const linkClass =
  'inline-flex h-10 items-center gap-2 rounded-full px-5 text-label-large focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-surface';
---
<div class="flex w-full max-w-[28rem] flex-col items-start gap-6" data-pages-scene>
  <svg class="w-full text-outline" viewBox="0 0 320 128" aria-hidden="true" focusable="false">
    <g fill="none" stroke="currentColor" stroke-width="2">
      <rect data-pages-draw x="6" y="10" width="124" height="108" rx="18" />
      <rect data-pages-draw x="190" y="10" width="124" height="108" rx="18" class="text-primary" stroke="currentColor" />
      <path data-pages-draw d="M140 64 H180 M172 56 L180 64 L172 72" stroke-linecap="round" stroke-linejoin="round" class="text-primary" stroke="currentColor" />
    </g>
    <g class="fill-surface-container-highest">
      <rect x="20" y="28" width="96" height="12" rx="6" />
      <rect x="20" y="50" width="72" height="8" rx="4" />
      <rect x="20" y="66" width="84" height="8" rx="4" />
    </g>
    <g class="fill-primary-container">
      <rect x="204" y="28" width="96" height="12" rx="6" />
      <rect x="204" y="50" width="72" height="8" rx="4" />
      <rect x="204" y="66" width="84" height="8" rx="4" />
    </g>
  </svg>
  <div class="flex flex-wrap items-center gap-3">
    <a href={next.href} class={`${linkClass} bg-primary text-on-primary`}>{next.label} →</a>
    <a href="/motion" class={`${linkClass} bg-secondary-container text-on-secondary-container`} data-pages-back>← Back</a>
  </div>
</div>
