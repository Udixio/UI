---
/**
 * The markup of the "Follow pointer or state" scene (`pointer.ts`): a card that tilts with the pointer, and a gauge that the
 * Level slider (`PointerControls.tsx`) fills. On a need page, a reading bar follows the scroll. The gauge starts at the value
 * of its `value` attribute, so that it does not move on mount. Under reduced motion the card does not tilt. Styles are
 * Tailwind classes with theme tokens only.
 */

type Props = {
  /** `page` adds the reading bar, which follows the scroll. */
  size?: 'tile' | 'page';
};

const { size = 'tile' } = Astro.props;
---
<div class="flex w-full max-w-[17rem] flex-col gap-5" data-pointer-scene>
  {/* The card turns with the two pointer values, in perspective; it does not turn under reduced motion, from the system or the page. */}
  <div class="rounded-3xl bg-primary-container p-5 text-on-primary-container [transform:perspective(600px)_rotateY(calc(var(--udx-motion-value-pointer-tilt-x,0)*1deg))_rotateX(calc(var(--udx-motion-value-pointer-tilt-y,0)*1deg))] motion-reduce:[transform:none] [html[data-motion-policy=reduce]_&]:[transform:none]" aria-hidden="true" data-pointer-card>
    <p class="text-label-large">Pointer</p>
    <p class="mt-8 text-title-large">Move over this card</p>
    <p class="mt-1 text-body-small">It turns toward the pointer, and rests when the pointer leaves.</p>
  </div>
  {/* Each bar is scaled by its value, from its left edge: the gauge by the level, the reading bar by the scroll. */}
  <div class="h-3 overflow-hidden rounded-full bg-surface-container-highest" aria-hidden="true">
    <data value="0.6" class="block h-full w-full origin-left rounded-full bg-primary [scale:var(--udx-motion-value-pointer-level,0)_1]" data-pointer-gauge></data>
  </div>
  {size === 'page' && (
    <div class="h-2 overflow-hidden rounded-full bg-surface-container-highest" aria-hidden="true">
      <span class="block h-full w-full origin-left rounded-full bg-tertiary [scale:var(--udx-motion-value-pointer-reading,0)_1]" data-pointer-reading></span>
    </div>
  )}
</div>
