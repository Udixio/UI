---
/**
 * A decision as a list of choices, one `Choice` card each: what to take, when to take it, and why. Choosing an API puts
 * the competing answers side by side; a motion page opens with the card of its own API ("Take it when"), followed by the
 * cards of the pages to prefer in other cases ("Prefer it when"), as task-template.md describes.
 *
 * @example
 * ```astro
 * <Choices>
 *   <Choice title="<Presence>" href="#show-a-toast" link="See it">
 *     <Fragment slot="when">an element enters and leaves: a toast, a dialog.</Fragment>
 *     <Fragment slot="because">its exit plays before it is gone.</Fragment>
 *   </Choice>
 *   <Choice title="Lists" code={false} when="Prefer it when" href="/motion/lists" link="Lists">…</Choice>
 * </Choices>
 * ```
 */
type Props = {
  /**
   * `wide` (the default): a grid of cards of at least 15rem, for long sentences (Choosing an API). `compact`: cards of at
   * least 12rem, three to a row of the prose column (631 px at 1280, 672 px at most: MotionPage), for the "Take it when" card
   * of a motion page and its "Prefer it when" cards. The compact cards wrap in rows that they fill: the `lead` card takes
   * a row of its own, and two or three cards after it share the next one equally (a grid's tracks, under a card that
   * spans them all, would stay empty: review 6, M1).
   */
  size?: 'wide' | 'compact';
};

const { size = 'wide' } = Astro.props;
---
<ul
  class:list={[
    'not-prose my-6 gap-4',
    size === 'wide'
      ? 'grid grid-cols-[repeat(auto-fit,minmax(min(100%,15rem),1fr))]'
      : 'flex flex-wrap [&>li]:min-w-0 [&>li]:grow [&>li]:basis-48 [&>li[data-lead]]:basis-full',
  ]}
>
  <slot />
</ul>
