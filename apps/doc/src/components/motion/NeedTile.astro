---
/**
 * One need on the root page of the Animation section: its live scene on a stage, then its name, its sentence, its code
 * in four frameworks and what reduced motion does. Without a scene (default slot), the stage says the example is coming.
 *
 * The scene markup goes in the default slot and its controls in `controls`: rows, first the actions, then each option
 * group followed by the chip that shows its value in code (`chipClass`). The scene module named by
 * `need.scene` mounts on the stage (`scenes/loader.ts`). The code comes from `examples/motion-snippets/<slug>.ts`.
 */
import { Code } from 'astro:components';
import { iArrowForward } from '@udixio/icons-rounded-400/arrow_forward';
import { iCheck } from '@udixio/icons-rounded-400/check';
import { iContentCopy } from '@udixio/icons-rounded-400/content_copy';
import { MOTION_NEEDS } from '@/lib/motion-nav';
import { chipClass } from '@/components/motionDemo';
import { EXAMPLE_FRAMEWORKS, type ExampleFramework } from '@/stores/exampleFrameworkStore';
import '@/components/code-framework-select.css';

type Props = {
  /** The need, a key of `MOTION_NEEDS`. */
  slug: string;
  /** The hint under the scene: how to use it, with the keyboard alternative of a gesture. */
  hint?: string;
};

const { slug, hint } = Astro.props;

const need = MOTION_NEEDS.find((item) => item.slug === slug);
if (need === undefined) throw new Error(`NeedTile: "${slug}" is not a need of MOTION_NEEDS`);

type Snippets = Partial<Record<ExampleFramework, string>>;
const snippetModules = import.meta.glob<Snippets>('/src/examples/motion-snippets/*.ts', { eager: true });
const snippets = snippetModules[`/src/examples/motion-snippets/${slug}.ts`];
const frameworks = EXAMPLE_FRAMEWORKS.filter((framework) => typeof snippets?.[framework] === 'string');

const LABELS: Record<ExampleFramework, string> = { html: 'HTML', react: 'React', angular: 'Angular', svelte: 'Svelte' };
const LANGUAGES: Record<ExampleFramework, 'html' | 'tsx' | 'ts' | 'svelte'> = {
  html: 'html',
  react: 'tsx',
  angular: 'ts',
  svelte: 'svelte',
};
/** The site's default framework; the visitor's stored choice is applied before the first paint (`root/tabs.ts`). */
const initial: ExampleFramework = frameworks.includes('react') ? 'react' : frameworks[0];

/** The short name of the need's page, for its link: `/motion/shared-elements` gives "Shared elements". */
const last = need.href.split('/').filter(Boolean).at(-1) ?? '';
const pageName = last === 'svg' ? 'SVG' : last.charAt(0).toUpperCase() + last.slice(1).replaceAll('-', ' ');

const hasScene = Astro.slots.has('default') && need.scene !== undefined;
const hasControls = Astro.slots.has('controls');
const id = `need-${slug}`;
const reduced = need.reduced && need.reduced.charAt(0).toLowerCase() + need.reduced.slice(1);
---
<article class:list={['need-tile', { feature: need.feature }]} id={id} aria-labelledby={`${id}-title`}>
  {hasScene ? (
    <div
      class="stage"
      role="group"
      aria-label={`Live example: ${need.label}`}
      data-motion-scene={need.scene}
      data-size="tile"
      data-motion-scope
    >
      {hasControls && <div class="stage-controls"><slot name="controls" /></div>}
      <div class="stage-scene"><slot /></div>
      {hint && <p class="stage-hint text-body-small">{hint}</p>}
    </div>
  ) : (
    <div class="stage stage-soon" role="group" aria-label={`Live example: ${need.label}, coming in this release`}>
      <div class="soon">
        {need.hints.length > 0 && (
          <ul class="soon-hints" aria-label="API">
            {need.hints.map((name) => <li class={chipClass}>{name}</li>)}
          </ul>
        )}
        <p class="soon-text">Coming in this release</p>
      </div>
    </div>
  )}

  <div class="body">
    <div class="title-row">
      <h3 id={`${id}-title`} class="text-headline-small text-on-surface">{need.label}</h3>
      <a href={need.href} class="page-link text-label-large text-primary">
        {pageName}<span class="page-arrow" aria-hidden="true" set:html={iArrowForward} />
      </a>
    </div>
    <p class="summary text-body-medium text-on-surface-variant">{need.summary}</p>

    {frameworks.length > 0 && (
      <div class="code" data-code-tabs data-code-slug={slug}>
        <div class="code-bar">
          <div class="code-tabs" role="tablist" aria-label={`Code of ${need.label}`}>
            {frameworks.map((framework) => (
              <button
                type="button"
                role="tab"
                class="code-tab text-label-large"
                id={`${id}-tab-${framework}`}
                aria-controls={`${id}-code-${framework}`}
                aria-selected={String(framework === initial)}
                tabindex={framework === initial ? 0 : -1}
                data-framework={framework}
              >
                {LABELS[framework]}
                <span
                  class="code-tab-indicator"
                  data-motion="reflow"
                  data-motion-shared={`code-${slug}`}
                  hidden={framework !== initial}
                />
              </button>
            ))}
          </div>
          <div class="code-framework-select">
            <select class="text-label-large" aria-label="Framework" data-code-select>
              {frameworks.map((framework) => (
                <option value={framework} selected={framework === initial}>{LABELS[framework]}</option>
              ))}
            </select>
          </div>
          <button
            type="button"
            class="code-copy"
            aria-label={`Copy ${LABELS[initial]} code`}
            data-code-copy
          >
            <span class="code-copy-icon" data-icon="copy" aria-hidden="true" set:html={iContentCopy} />
            <span class="code-copy-icon" data-icon="done" aria-hidden="true" hidden set:html={iCheck} />
          </button>
        </div>
        {frameworks.map((framework) => (
          <div
            class="code-panel"
            role="tabpanel"
            id={`${id}-code-${framework}`}
            aria-labelledby={`${id}-tab-${framework}`}
            tabindex="0"
            data-framework={framework}
            hidden={framework !== initial}
          >
            <Code code={snippets?.[framework] ?? ''} lang={LANGUAGES[framework]} theme="css-variables" />
          </div>
        ))}
      </div>
    )}

    {reduced && (
      <p class="reduced text-body-small text-on-surface-variant">
        <span><span class="reduced-label text-on-surface">Reduced motion:</span> {reduced}</span>
      </p>
    )}
  </div>
</article>

<style>
  /* Tile: the stage inset in its card, the body under it (beside it for a feature tile, see root/Section.astro). */
  .need-tile {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-radius: 28px;
    background: var(--color-surface-container-low);
    overflow: hidden;
    scroll-margin-top: 88px;
  }

  .need-tile.feature {
    grid-column: 1 / -1;
  }

  .stage {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
    min-height: 260px;
    margin: 6px;
    padding: 20px;
    border-radius: 22px;
    background: var(--color-surface-container-lowest);
    overflow: clip;
  }

  .feature .stage {
    min-height: 420px;
  }

  /* Rows of controls: the actions, then each option group with its value in code. */
  .stage-controls {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  /* The scene fills the space between the controls and the foot, centred in it, and never wider than the stage. */
  .stage-scene {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    place-items: center;
    min-width: 0;
  }

  .stage-hint {
    margin: 0;
    color: var(--color-on-surface-variant);
  }

  /* A need whose scene is not built yet: its API names on a quiet dotted ground. */
  .stage-soon {
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 1px 1px, var(--color-outline-variant) 1px, transparent 1.5px) 0 0 / 16px 16px,
      var(--color-surface-container-lowest);
  }

  .soon {
    display: grid;
    justify-items: center;
    gap: 12px;
    padding: 16px 20px;
    border-radius: 20px;
    background: var(--color-surface-container-lowest);
    box-shadow: 0 0 0 12px var(--color-surface-container-lowest);
  }

  .soon-hints {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .soon-text {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1rem;
    letter-spacing: 0.04em;
    color: var(--color-on-surface-variant);
  }

  /* Body */
  .body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
    padding: 16px 22px 22px;
  }

  /* The page link sits after the title, and goes under it when the title needs the room. */
  .title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 12px;
  }

  .title-row h3 {
    margin: 0;
    min-width: 0;
  }

  .page-link {
    display: inline-flex;
    flex: none;
    margin-left: auto;
    align-items: center;
    gap: 4px;
    margin-right: -8px;
    padding: 6px 8px;
    border-radius: 999px;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 150ms;
  }

  .page-link:hover {
    background: color-mix(in oklab, var(--color-primary) 8%, transparent);
  }

  .page-link:focus-visible,
  .code-tab:focus-visible,
  .code-copy:focus-visible,
  .code-panel:focus-visible {
    outline: 2px solid var(--color-on-surface);
    outline-offset: 2px;
  }

  .page-arrow {
    display: inline-grid;
    width: 18px;
    height: 18px;
    transition: translate 200ms;
  }

  .page-link:hover .page-arrow {
    translate: 2px 0;
  }

  .page-arrow :global(svg) {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .summary {
    margin: 0;
    max-width: 60ch;
  }

  /* Code: tabs, a copy button, and the snippet of the selected framework. */
  .code {
    display: flex;
    flex-direction: column;
    min-width: 0;
    margin-top: 4px;
    border-radius: 16px;
    background: var(--color-surface-container-high);
    overflow: hidden;
  }

  .code-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 0 4px 0 6px;
    border-bottom: 1px solid var(--color-outline-variant);
  }

  .code-tabs {
    position: relative;
    display: flex;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .code-tab {
    position: relative;
    flex: none;
    height: 40px;
    padding: 0 10px;
    border: 0;
    background: none;
    color: var(--color-on-surface-variant);
    cursor: pointer;
    transition: color 150ms;
  }

  .code-tab:hover {
    color: var(--color-on-surface);
  }

  .code-tab[aria-selected='true'] {
    color: var(--color-primary);
  }

  .code-tab-indicator {
    position: absolute;
    left: 8px;
    right: 8px;
    bottom: 0;
    height: 3px;
    border-radius: 3px 3px 0 0;
    background: var(--color-primary);
  }

  .code-tab-indicator[hidden] {
    display: none;
  }

  .code-copy {
    display: grid;
    flex: none;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--color-on-surface-variant);
    cursor: pointer;
    transition: background-color 150ms, color 150ms;
  }

  .code-copy:hover {
    background: color-mix(in oklab, var(--color-on-surface) 8%, transparent);
    color: var(--color-on-surface);
  }

  .code-copy[data-copied] {
    color: var(--color-primary);
  }

  .code-copy-icon {
    display: grid;
    width: 20px;
    height: 20px;
  }

  .code-copy-icon[hidden] {
    display: none;
  }

  .code-copy-icon :global(svg) {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .code-panel {
    min-width: 0;
    overflow-x: auto;
    border-radius: 0 0 16px 16px;
  }

  .code-panel[hidden] {
    display: none;
  }

  /*
   * The snippet's colours come from the theme: keywords, names and strings take the role colours, so the code recolours
   * with the theme as the rest of the page does.
   */
  .code-panel :global(pre.astro-code) {
    --astro-code-foreground: var(--color-on-surface);
    --astro-code-background: transparent;
    --astro-code-token-keyword: var(--color-tertiary);
    --astro-code-token-function: var(--color-primary);
    --astro-code-token-constant: var(--color-primary);
    --astro-code-token-parameter: var(--color-on-surface);
    --astro-code-token-string: var(--color-tertiary);
    --astro-code-token-string-expression: var(--color-tertiary);
    --astro-code-token-punctuation: var(--color-on-surface-variant);
    --astro-code-token-comment: var(--color-on-surface-variant);
    --astro-code-token-link: var(--color-primary);
    margin: 0;
    padding: 14px 16px 16px;
    background: transparent !important;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
    font-size: 12px;
    line-height: 1.65;
    letter-spacing: 0;
    tab-size: 2;
    white-space: pre;
    overflow: visible;
  }

  .reduced {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 2px 0 0;
  }

  .reduced::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-outline);
    translate: 0 -1px;
  }

  .reduced-label {
    font-weight: 500;
  }

  /*
   * Layout by the width of the page (the `motion-root` container, see pages/motion/index.astro). From 860 px two tiles
   * share a row and their stages line up (subgrid); a tile left alone in its row lays its body beside its stage. From
   * 920 px a feature tile does the same; below, its body is under its stage.
   */
  @container motion-root (min-width: 860px) {
    .need-tile:not(.feature) {
      grid-row: span 2;
      grid-template-rows: subgrid;
    }

    .need-tile:not(.feature):last-child:nth-child(even) {
      grid-column: 1 / -1;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: 10px;
    }

    .need-tile:not(.feature):last-child:nth-child(even) > * {
      grid-row: 1 / -1;
    }
  }

  @container motion-root (min-width: 920px) {
    .need-tile.feature {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      column-gap: 10px;
    }

    .feature .body {
      padding-top: 22px;
    }
  }

  /*
   * Below 560 px the four tabs and the copy button do not fit: the framework select stands for the tabs (same preference,
   * the same copy button), so the tab row is not laid out at all.
   */
  @container motion-root (max-width: 559px) {
    .need-tile {
      border-radius: 24px;
    }

    .stage,
    .feature .stage {
      min-height: 220px;
      padding: 14px;
      border-radius: 18px;
    }

    .body {
      padding: 14px 16px 18px;
    }

    .code-tabs {
      display: none;
    }

    .code-framework-select {
      display: flex;
    }
  }
</style>
