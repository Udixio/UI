---
import { Code } from 'astro:components';
import DemoSurface from '@/components/DemoSurface.astro';
import {
  CodePreview,
  codePreviewClass,
  codeCardClass,
  codeBodyClass,
  codePanelClass,
  codeSplitBodyClass,
  codeSplitPreviewClass,
  codeSplitPreviewTopClass,
} from '@/components/CodePreview';
import {
  EXAMPLE_FRAMEWORKS,
  resolveExampleFramework,
  type ExampleFramework,
} from '@/stores/exampleFrameworkStore';

type Props = {
  codes?: Partial<Record<ExampleFramework, string>>;
  id?: string;
  'data-code'?: string;
  'data-language'?: string;
  /** Centers the preview area; set false for layouts meant to hug an edge (e.g. a sidebar rail). */
  center?: boolean;
  /**
   * The frameworks with a live preview. Left out, a preview is any framework whose slot the page fills; a wrapper that
   * always declares its slots (MotionUsage) passes the list itself.
   */
  previews?: ExampleFramework[];
  /**
   * The reserved height of the live previews, in px, or `[wide, narrow]` (DemoSurface): an example whose content enters,
   * leaves or resizes reserves its largest state, so it never pushes the page. Left out, the preview hugs its content.
   */
  previewHeight?: number | readonly [number, number];
  /**
   * `tabs` (the default): the preview, with a Preview / Code switch in the toolbar. `split`: the code and the preview side by
   * side when the card is wide (code first, on the left), stacked when it is narrow (code first, on top), with no switch;
   * the preview takes the height of the code, and at least `previewHeight`. Only a block with live previews uses it.
   */
  layout?: 'tabs' | 'split';
  [key: string]: unknown;
};

const {
  codes,
  id,
  'data-code': dataCode,
  'data-language': dataLanguage,
  center = true,
  previews: previewsProp,
  previewHeight,
  layout = 'tabs',
  ...htmlProps
} = Astro.props as Props;

const frameworkLanguages: Record<ExampleFramework, 'html' | 'tsx' | 'ts' | 'svelte'> = {
  html: 'html',
  react: 'tsx',
  angular: 'ts',
  svelte: 'svelte',
};
// A framework is listed when it has a source. Its live preview exists only when the page fills its slot; a listed
// framework without one shows its code alone.
const frameworks = EXAMPLE_FRAMEWORKS.filter(
  (framework) =>
    typeof codes?.[framework] === 'string' && codes[framework].trim() !== '',
);
const previews = frameworks.filter((framework) =>
  previewsProp ? previewsProp.includes(framework) : Astro.slots.has(framework),
);
const isMultiFramework = frameworks.length > 0;
const split = layout === 'split';
// The site's preference (React by default) when it is listed, otherwise the first listed framework: its preview when it has
// one, else its code. The block carries its frameworks and previews (`data-code-*`), so that the layout's head script shows
// the visitor's framework before the first paint, and `data-code-ssr` until its toolbar has hydrated (CodePreview), which
// takes over from there (lib/framework-choice.ts tells the contract). Its panels are the tab panels of the toolbar's
// framework tabs: `<rootId>-<framework>-<view>`, labelled by the tab `<rootId>-tab-<framework>`.
const initialFramework = resolveExampleFramework('react', frameworks);
const rootId = id ?? `code-example-${crypto.randomUUID()}`;

// Astro renders a ``` block as `<pre data-code="…" data-language="…"><code>…</code></pre>`:
// the Shiki transformer in `astro.config.ts` attaches the raw source as a prop, so
// there is nothing to rebuild. The slot fallback only serves calls without the
// transformer (e.g. `<Code>` used directly in an .astro file).
const slotHtml =
  (!isMultiFramework &&
    !dataCode &&
    Astro.slots.has('default') &&
    (await Astro.slots.render('default'))) ||
  '';

const langFromClass = slotHtml.match(/<code[^>]*class="[^"]*language-([\w-]+)/)?.[1];
const language = dataLanguage ?? langFromClass ?? 'text';

const codeFromSlot = slotHtml
  .replace(/^[\s\S]*?<code[^>]*>/, '')
  .replace(/<\/code>[\s\S]*$/, '')
  .replace(/<[^>]*>/g, '')
  .replace(/&(?:#x([0-9a-fA-F]+)|#(\d+)|([a-zA-Z]+));/g, (match, hex, dec, name) => {
    if (hex) return String.fromCodePoint(parseInt(hex, 16));
    if (dec) return String.fromCodePoint(parseInt(dec, 10));
    return { amp: '&', lt: '<', gt: '>', quot: '"', apos: "'", nbsp: ' ' }[name] ?? match;
  })
  .replace(/\n$/, '');

// Source code: the `data-code` prop first, otherwise the rebuilt source.
const code = dataCode ?? codeFromSlot;
---
{isMultiFramework ? (
  <div
    id={rootId}
    class={codeCardClass}
    data-pagefind-ignore
    data-code-frameworks={frameworks.join(' ')}
    data-code-previews={previews.join(' ')}
    data-code-layout={split ? 'split' : undefined}
    data-code-ssr
  >
    <CodePreview
      client:load
      mode="multiframework"
      rootId={rootId}
      frameworks={frameworks}
      previews={previews}
      sources={codes ?? {}}
      layout={layout}
    />
    <div class:list={[codeBodyClass, split && codeSplitBodyClass]}>
      {split ? frameworks.map((framework) => (
        <>
          {/* Code first: on the left when the card is wide, on top when it is narrow. */}
          <section
            id={`${rootId}-${framework}-code`}
            role="tabpanel"
            aria-labelledby={`${rootId}-tab-${framework}`}
            data-example-panel
            data-framework={framework}
            data-view="code"
            hidden={framework !== initialFramework}
            class={codePanelClass}
          >
            <Code
              code={codes?.[framework] ?? ''}
              lang={frameworkLanguages[framework]}
              theme="css-variables"
            />
          </section>
          {previews.includes(framework) && (
            <DemoSurface
              as="section"
              variant="inset"
              height={previewHeight}
              fill
              id={`${rootId}-${framework}-preview`}
              role="tabpanel"
              aria-labelledby={`${rootId}-tab-${framework}`}
              data-example-panel
              data-framework={framework}
              data-view="preview"
              hidden={framework !== initialFramework}
              frameClass={codeSplitPreviewClass}
              class={`${codePreviewClass} ${previewHeight === undefined ? 'min-h-32' : 'overflow-hidden'} ${center ? `items-center justify-center ${codeSplitPreviewTopClass}` : 'items-start justify-start'}`}
            >
              <slot name={framework} />
            </DemoSurface>
          )}
        </>
      )) : frameworks.map((framework) => (
        <>
          {previews.includes(framework) && (
            <DemoSurface
              as="section"
              variant="inset"
              height={previewHeight}
              id={`${rootId}-${framework}-preview`}
              role="tabpanel"
              aria-labelledby={`${rootId}-tab-${framework}`}
              data-example-panel
              data-framework={framework}
              data-view="preview"
              hidden={framework !== initialFramework}
              class={`${codePreviewClass} ${previewHeight === undefined ? 'min-h-32' : 'overflow-hidden'} ${center ? 'items-center justify-center' : 'items-start justify-start'}`}
            >
              <slot name={framework} />
            </DemoSurface>
          )}
          <section
            id={`${rootId}-${framework}-code`}
            role="tabpanel"
            aria-labelledby={`${rootId}-tab-${framework}`}
            data-example-panel
            data-framework={framework}
            data-view="code"
            hidden={framework !== initialFramework || previews.includes(framework)}
            class={codePanelClass}
          >
            <Code
              code={codes?.[framework] ?? ''}
              lang={frameworkLanguages[framework]}
              theme="css-variables"
            />
          </section>
        </>
      ))}
    </div>
  </div>
) : code != null && code !== '' ? (
  <div class={codeCardClass} data-pagefind-ignore>
    <CodePreview client:load code={code} language={language} />
    <div class={codeBodyClass}>
      <section class={codePanelClass}>
        <Code
          code={code}
          lang={language ?? 'text'}
          theme="css-variables"
        />
      </section>
    </div>
  </div>
) : (
  <pre data-pagefind-ignore {...htmlProps}><slot /></pre>
)}
<style is:global>
  pre {
    text-wrap: auto;
  }

  .card-code [hidden] {
    display: none !important;
  }

  .card-code .astro-code {
    --astro-code-background: transparent;
    --astro-code-foreground: #24292f;
    --astro-code-token-constant: #0550ae;
    --astro-code-token-string: #0a3069;
    --astro-code-token-comment: #6e7781;
    --astro-code-token-keyword: #cf222e;
    --astro-code-token-parameter: #953800;
    --astro-code-token-function: #8250df;
    --astro-code-token-string-expression: #0a3069;
    --astro-code-token-punctuation: #24292f;
    --astro-code-token-link: #0969da;
    margin: 0;
    background: transparent !important;
  }

  .dark .card-code .astro-code {
    --astro-code-foreground: #e1e4e8;
    --astro-code-token-constant: #79b8ff;
    --astro-code-token-string: #9ecbff;
    --astro-code-token-comment: #6a737d;
    --astro-code-token-keyword: #f97583;
    --astro-code-token-parameter: #ffab70;
    --astro-code-token-function: #b392f0;
    --astro-code-token-string-expression: #9ecbff;
    --astro-code-token-punctuation: #e1e4e8;
    --astro-code-token-link: #79b8ff;
  }

</style>
