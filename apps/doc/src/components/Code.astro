---
import { Code } from 'astro:components';
import { CodePreview } from '@/components/CodePreview';
import type { ExampleFramework } from '@/stores/exampleFrameworkStore';

type Props = {
  codes?: Partial<Record<ExampleFramework, string>>;
  id?: string;
  'data-code'?: string;
  'data-language'?: string;
  /** Centers the preview area; set false for layouts meant to hug an edge (e.g. a sidebar rail). */
  center?: boolean;
  [key: string]: unknown;
};

const {
  codes,
  id,
  'data-code': dataCode,
  'data-language': dataLanguage,
  center = true,
  ...htmlProps
} = Astro.props as Props;

const frameworkLanguages: Record<ExampleFramework, 'tsx' | 'ts'> = {
  react: 'tsx',
  angular: 'ts',
};
const frameworkOrder: ExampleFramework[] = ['react', 'angular'];
const frameworks = frameworkOrder.filter(
  (framework) =>
    Astro.slots.has(framework) &&
    typeof codes?.[framework] === 'string' &&
    codes[framework].trim() !== '',
);
const isMultiFramework = frameworks.length > 0;
const rootId = id ?? `code-example-${crypto.randomUUID()}`;

// Les blocs de code fenced sont rendus par Astro/MDX en `<pre><code class="language-XXX">code</code></pre>`,
// sans que `data-code`/`data-language` ne soient injectés en props (le transformer Shiki `pre()`
// n'est pas appelé dans ce projet, et expressive-code ne transmet pas le code au composant mappé
// via `components={{ pre: Code }}`). On reconstruit donc la langue et le code source à partir du slot.
const slotHtml =
  (!isMultiFramework &&
    Astro.slots.has('default') &&
    (await Astro.slots.render('default'))) ||
  '';

// Langue : priorité à la prop, sinon extraite de la classe `language-XXX` du <code>.
const langFromClass = slotHtml.match(/<code[^>]*class="[^"]*language-([\w-]+)/)?.[1];
const language = dataLanguage ?? langFromClass ?? 'text';

// Décodage en UNE passe : `&amp;#x3C;` doit redonner `&#x3C;`, pas `<`.
const namedEntities: Record<string, string> = {
  amp: '&',
  lt: '<',
  gt: '>',
  quot: '"',
  apos: "'",
  nbsp: ' ',
};
const decodeEntities = (value: string) =>
  value.replace(
    /&(?:#x([0-9a-fA-F]+)|#(\d+)|([a-zA-Z]+));/g,
    (match, hex, dec, name) => {
      if (hex) return String.fromCodePoint(parseInt(hex, 16));
      if (dec) return String.fromCodePoint(parseInt(dec, 10));
      return namedEntities[name] ?? match;
    },
  );
const stripTags = (value: string) => value.replace(/<[^>]*>/g, '');
// Les balises sont retirées AVANT le décodage : le `<` d'un JSX arrive encodé
// (`&#x3C;`) dans le slot, le décoder d'abord le rendrait indissociable d'une
// vraie balise et `stripTags` l'avalerait.
const toSource = (value: string) => decodeEntities(stripTags(value));

// expressive-code ne rend pas `<code>texte</code>` mais son propre markup, où
// chaque ligne source est un `<div class="ec-line">` de spans colorés. Pris tel
// quel, ce markup s'afficherait littéralement à la place du code : on reconstruit
// donc la source à partir du texte de ces lignes.
const ecLines = slotHtml
  .split(/<div class="[^"]*\bec-line\b[^"]*"[^>]*>/)
  .slice(1);

const codeFromSlot = ecLines.length
  ? ecLines
      // Le découpage laisse les retours à la ligne inter-éléments en fin de
      // morceau ; l'indentation (espaces) doit en revanche être préservée.
      .map((line) => toSource(line).replace(/^\n+|\n+$/g, ''))
      .join('\n')
  : toSource(
      slotHtml
        .replace(/^[\s\S]*?<code[^>]*>/, '')
        .replace(/<\/code>[\s\S]*$/, ''),
    ).replace(/\n$/, '');

// Code source : priorité à la prop `data-code`, sinon la source reconstruite.
const code = dataCode ?? codeFromSlot;
---
{isMultiFramework ? (
  <div
    id={rootId}
    class="not-prose card-code mt-4 overflow-hidden rounded-2xl bg-surface-container-low"
  >
    <CodePreview
      client:load
      mode="multiframework"
      rootId={rootId}
      frameworks={frameworks}
      sources={codes ?? {}}
    />
    <div class="min-h-32 bg-surface-bright">
      {frameworks.includes('react') && (
        <>
          <section
            data-example-panel
            data-framework="react"
            data-view="preview"
            class={`flex min-h-32 p-8 ${center ? 'items-center justify-center' : 'items-start justify-start'}`}
          >
            <slot name="react" />
          </section>
          <section
            data-example-panel
            data-framework="react"
            data-view="code"
            hidden
            class="code-source overflow-auto p-4"
          >
            <Code
              code={codes?.react ?? ''}
              lang={frameworkLanguages.react}
              theme="css-variables"
            />
          </section>
        </>
      )}
      {frameworks.includes('angular') && (
        <>
          <section
            data-example-panel
            data-framework="angular"
            data-view="preview"
            hidden={frameworks[0] !== 'angular'}
            class={`flex min-h-32 p-8 ${center ? 'items-center justify-center' : 'items-start justify-start'}`}
          >
            <slot name="angular" />
          </section>
          <section
            data-example-panel
            data-framework="angular"
            data-view="code"
            hidden
            class="code-source overflow-auto p-4"
          >
            <Code
              code={codes?.angular ?? ''}
              lang={frameworkLanguages.angular}
              theme="css-variables"
            />
          </section>
        </>
      )}
    </div>
  </div>
) : code != null && code !== '' ? (
  <CodePreview client:load code={code} language={language}>
    <Code
      code={code}
      lang={language ?? 'text'}
      theme="css-variables"
    />
  </CodePreview>
) : (
  <pre {...htmlProps}><slot /></pre>
)}
<style is:global>
  pre {
    text-wrap: auto;
  }

  /* Un bloc ``` est d'abord rendu par expressive-code ; `components={{ pre: Code }}`
     n'en remplace que le <pre>, si bien que notre carte se retrouve emboîtée dans
     le <figure class="frame"> d'EC (double cadre + en-tête, et un second bouton
     copier). On efface la boîte d'EC pour ne garder que la carte, à l'identique
     des exemples multi-framework qui, eux, n'ont jamais de wrapper EC.
     Le `:has()` garde intacts les blocs EC natifs (homepage, `del=`/`mark=`). */
  .expressive-code:has(.card-code),
  .expressive-code:has(.card-code) > figure.frame {
    display: contents;
  }

  .expressive-code:has(.card-code) figcaption.header,
  .expressive-code:has(.card-code) .copy {
    display: none;
  }

  .card-code [hidden] {
    display: none !important;
  }

  .card-code .astro-code {
    --astro-code-background: transparent;
    --astro-code-foreground: #24292f;
    --astro-code-token-constant: #0550ae;
    --astro-code-token-string: #0a3069;
    --astro-code-token-comment: #6e7781;
    --astro-code-token-keyword: #cf222e;
    --astro-code-token-parameter: #953800;
    --astro-code-token-function: #8250df;
    --astro-code-token-string-expression: #0a3069;
    --astro-code-token-punctuation: #24292f;
    --astro-code-token-link: #0969da;
    margin: 0;
    background: transparent !important;
  }

  .dark .card-code .astro-code {
    --astro-code-foreground: #e1e4e8;
    --astro-code-token-constant: #79b8ff;
    --astro-code-token-string: #9ecbff;
    --astro-code-token-comment: #6a737d;
    --astro-code-token-keyword: #f97583;
    --astro-code-token-parameter: #ffab70;
    --astro-code-token-function: #b392f0;
    --astro-code-token-string-expression: #9ecbff;
    --astro-code-token-punctuation: #e1e4e8;
    --astro-code-token-link: #79b8ff;
  }

</style>
