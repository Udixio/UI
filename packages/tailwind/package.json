{
  "name": "@udixio/tailwind",
  "version": "5.0.1-next.5",
  "type": "module",
  "main": "./dist/node.js",
  "module": "./dist/node.js",
  "types": "./dist/node.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": {
        "browser": "./src/index.browser.ts",
        "node": "./src/index.node.ts",
        "default": "./src/index.browser.ts"
      },
      "types": "./dist/index.node.d.ts",
      "browser": {
        "import": "./dist/browser.js",
        "require": "./dist/browser.cjs",
        "default": "./dist/browser.js"
      },
      "node": {
        "import": "./dist/node.js",
        "require": "./dist/node.cjs",
        "default": "./dist/node.js"
      },
      "import": "./dist/node.js",
      "require": "./dist/node.cjs",
      "default": "./dist/node.js"
    },
    "./vite": {
      "development": {
        "browser": "./src/vite/index.browser.ts",
        "node": "./src/vite/index.node.ts",
        "default": "./src/vite/index.browser.ts"
      },
      "types": "./dist/vite/index.node.d.ts",
      "browser": {
        "import": "./dist/vite.browser.js",
        "require": "./dist/vite.browser.cjs",
        "default": "./dist/vite.browser.js"
      },
      "node": {
        "import": "./dist/vite.node.js",
        "require": "./dist/vite.node.cjs",
        "default": "./dist/vite.node.js"
      },
      "import": "./dist/vite.node.js",
      "require": "./dist/vite.node.cjs",
      "default": "./dist/vite.node.js"
    }
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "text-case": "^1.2.9",
    "tailwindcss": "^4.1.12",
    "pathe": "^2.0.3",
    "@udixio/theme": "5.0.1-next.5",
    "tslib": "^2.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Udixio/UI.git"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.node.d.ts",
        "browser": {
          "import": "./dist/browser.js",
          "require": "./dist/browser.cjs",
          "default": "./dist/browser.js"
        },
        "node": {
          "import": "./dist/node.js",
          "require": "./dist/node.cjs",
          "default": "./dist/node.js"
        },
        "import": "./dist/node.js",
        "require": "./dist/node.cjs",
        "default": "./dist/node.js"
      },
      "./vite": {
        "types": "./dist/vite/index.node.d.ts",
        "browser": {
          "import": "./dist/vite.browser.js",
          "require": "./dist/vite.browser.cjs",
          "default": "./dist/vite.browser.js"
        },
        "node": {
          "import": "./dist/vite.node.js",
          "require": "./dist/vite.node.cjs",
          "default": "./dist/vite.node.js"
        },
        "import": "./dist/vite.node.js",
        "require": "./dist/vite.node.cjs",
        "default": "./dist/vite.node.js"
      }
    }
  },
  "devDependencies": {
    "@tailwindcss/node": "^4.1.12"
  }
}
