    --color-on-tertiary-container: var(--udx-on-tertiary-container-dark-on, var(--udx-light-on-tertiary-container));
    --udx-tertiary-fixed-dark-on: var(--udx-on-dark) var(--udx-dark-tertiary-fixed);
    --color-tertiary-fixed: var(--udx-tertiary-fixed-dark-on, var(--udx-light-tertiary-fixed));
    --udx-tertiary-fixed-dim-dark-on: var(--udx-on-dark) var(--udx-dark-tertiary-fixed-dim);
    --color-tertiary-fixed-dim: var(--udx-tertiary-fixed-dim-dark-on, var(--udx-light-tertiary-fixed-dim));
    --udx-on-tertiary-fixed-dark-on: var(--udx-on-dark) var(--udx-dark-on-tertiary-fixed);
    --color-on-tertiary-fixed: var(--udx-on-tertiary-fixed-dark-on, var(--udx-light-on-tertiary-fixed));
    --udx-on-tertiary-fixed-variant-dark-on: var(--udx-on-dark) var(--udx-dark-on-tertiary-fixed-variant);
    --color-on-tertiary-fixed-variant: var(--udx-on-tertiary-fixed-variant-dark-on, var(--udx-light-on-tertiary-fixed-variant));
    --udx-error-dark-on: var(--udx-on-dark) var(--udx-dark-error);
    --color-error: var(--udx-error-dark-on, var(--udx-light-error));
    --udx-error-dim-dark-on: var(--udx-on-dark) var(--udx-dark-error-dim);
    --color-error-dim: var(--udx-error-dim-dark-on, var(--udx-light-error-dim));
    --udx-on-error-dark-on: var(--udx-on-dark) var(--udx-dark-on-error);
    --color-on-error: var(--udx-on-error-dark-on, var(--udx-light-on-error));
    --udx-error-container-dark-on: var(--udx-on-dark) var(--udx-dark-error-container);
    --color-error-container: var(--udx-error-container-dark-on, var(--udx-light-error-container));
    --udx-on-error-container-dark-on: var(--udx-on-dark) var(--udx-dark-on-error-container);
    --color-on-error-container: var(--udx-on-error-container-dark-on, var(--udx-light-on-error-container));
    --udx-surface-variant-dark-on: var(--udx-on-dark) var(--udx-dark-surface-variant);
    --color-surface-variant: var(--udx-surface-variant-dark-on, var(--udx-light-surface-variant));
    --udx-surface-tint-dark-on: var(--udx-on-dark) var(--udx-dark-surface-tint);
    --color-surface-tint: var(--udx-surface-tint-dark-on, var(--udx-light-surface-tint));
    --udx-background-dark-on: var(--udx-on-dark) var(--udx-dark-background);
    --color-background: var(--udx-background-dark-on, var(--udx-light-background));
    --udx-on-background-dark-on: var(--udx-on-dark) var(--udx-dark-on-background);
    --color-on-background: var(--udx-on-background-dark-on, var(--udx-light-on-background));
  }
}
@layer base {
  @keyframes enter {
    from {
      opacity: var(--anim-enter-opacity, 1);
      transform: translate3d(var(--anim-enter-translate-x, 0), var(--anim-enter-translate-y, 0), 0) scale3d(var(--anim-enter-scale, 1), var(--anim-enter-scale, 1), var(--anim-enter-scale, 1)) rotate(var(--anim-enter-rotate, 0));
    }
  }
  @keyframes exit {
    to {
      opacity: var(--anim-exit-opacity, 1);
      transform: translate3d(var(--anim-exit-translate-x, 0), var(--anim-exit-translate-y, 0), 0) scale3d(var(--anim-exit-scale, 1), var(--anim-exit-scale, 1), var(--anim-exit-scale, 1)) rotate(var(--anim-exit-rotate, 0));
    }
  }
  [data-anim-in-run] {
    --anim-in-state: running;
  }
  [data-anim-in-paused] {
    --anim-in-state: paused;
  }
  [data-anim-out-run] {
    --anim-out-state: running;
  }
  [data-anim-out-paused] {
    --anim-out-state: paused;
  }
  @keyframes anim-fade {
    from {
      opacity: var(--anim-opacity , 0);
    }
  }
  @keyframes anim-scale {
    from {
      scale: var(--anim-scale-x , var(--anim-scale , .95)) var(--anim-scale-y , var(--anim-scale , .95));
    }
  }
  @keyframes anim-slide {
    from {
      translate: calc(var(--anim-distance , 2rem) * var(--anim-dx )) calc(var(--anim-distance , 2rem) * var(--anim-dy ));;
    }
    to {
      translate: var(--tw-translate-x, 0) var(--tw-translate-y, 0);
    }
  }
  [class*="anim-"] {
    animation-name: var(--anim-name-fade, noop), var(--anim-name-scale, noop), var(--anim-name-slide, noop);
    will-change: var(--anim-dependencies-fade, noop), var(--anim-dependencies-scale, noop), var(--anim-dependencies-slide, noop);
    animation-play-state: var(--anim-play-state-fade, running), var(--anim-play-state-scale, running), var(--anim-play-state-slide, running);
  }
  [class*="anim-"][class*="-scroll"] {
    animation-timeline: var(--anim-timeline-fade, auto), var(--anim-timeline-scale, auto), var(--anim-timeline-slide, auto);
    animation-range: var(--anim-range-fade, normal), var(--anim-range-scale, normal), var(--anim-range-slide, normal);
  }
}
@property --tw-duration {
  syntax: "*";
  inherits: false;
}
@layer properties {
  @supports ((-webkit-hyphens: none) and (not (margin-trim: inline))) or ((-moz-orient: inline) and (not (color:rgb(from red r g b)))) {
    *, ::before, ::after, ::backdrop {
      --tw-duration: initial;
    }
  }
}
"
`;
