@layer utilities {
  .state-layer {
    &:hover {
      @media (hover: hover) {
        background-color: var(--state-color);
        @supports (color: color-mix(in lab, red, red)) {
          background-color: color-mix(in oklab, var(--state-color) 8%, transparent);
        }
      }
    }
    &:active {
      background-color: var(--state-color);
      @supports (color: color-mix(in lab, red, red)) {
        background-color: color-mix(in oklab, var(--state-color) 10%, transparent);
      }
    }
    &:focus-visible {
      background-color: var(--state-color);
      @supports (color: color-mix(in lab, red, red)) {
        background-color: color-mix(in oklab, var(--state-color) 10%, transparent);
      }
    }
    transition-property: color, background-color, border-color, outline-color, text-decoration-color, fill, stroke, --tw-gradient-from, --tw-gradient-via, --tw-gradient-to;
    transition-timing-function: var(--tw-ease, var(--default-transition-timing-function));
    transition-duration: var(--tw-duration, var(--default-transition-duration));
    --tw-duration: 150ms;
    transition-duration: 150ms;
    &:disabled {
      color: var(--color-on-surface);
      @supports (color: color-mix(in lab, red, red)) {
        color: color-mix(in oklab, var(--color-on-surface) 38%, transparent);
      }
    }
    &:disabled {
      background-color: var(--color-on-surface);
      @supports (color: color-mix(in lab, red, red)) {
        background-color: color-mix(in oklab, var(--color-on-surface) 10%, transparent);
      }
    }
  }
  .bg-primary {
    background-color: var(--color-primary);
  }
  .text-body-medium {
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.25rem;
    letter-spacing: 0.015625rem;
    font-family: "Roboto", "sans-serif";
    @media (min-width: 64rem) {
      font-size: 0.984375rem;
      line-height: 1.40625rem;
    }
  }
  .text-display-large {
    font-size: 3.5625rem;
    font-weight: 400;
    line-height: 4rem;
    letter-spacing: -0.015625rem;
    font-family: "Roboto", "sans-serif";
    @media (min-width: 64rem) {
      font-size: 4.0078125rem;
      line-height: 4.5rem;
    }
  }
  .text-on-surface {
    color: var(--color-on-surface);
  }
  .shadow-1 {
    box-shadow: 0px 1px 3px 1px rgba(0, 0, 0, 0.15), 0px 1px 2px 0px rgba(0, 0, 0, 0.30);
  }
  .state-primary {
    --state-color: var(--color-primary);
  }
  @media (hover: hover) {
    .hover\\:shadow-2:hover {
      box-shadow: 0px 2px 6px 2px rgba(0, 0, 0, 0.15), 0px 1px 2px 0px rgba(0, 0, 0, 0.30);
    }
  }
  @media (width >= 64rem) {
    .lg\\:text-display-large {
      font-size: 3.5625rem;
      font-weight: 400;
      line-height: 4rem;
      letter-spacing: -0.015625rem;
      font-family: "Roboto", "sans-serif";
    }
    @media (min-width: 64rem) {
