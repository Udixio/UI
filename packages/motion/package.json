        "require": "./dist/policy.cjs",
        "default": "./dist/policy.js"
      },
      "./presets": {
        "types": "./dist/presets.d.ts",
        "import": "./dist/presets.js",
        "require": "./dist/presets.cjs",
        "default": "./dist/presets.js"
      },
      "./layout": {
        "types": "./dist/layout.d.ts",
        "import": "./dist/layout.js",
        "require": "./dist/layout.cjs",
        "default": "./dist/layout.js"
      },
      "./value": {
        "types": "./dist/value-entry.d.ts",
        "import": "./dist/value.js",
        "require": "./dist/value.cjs",
        "default": "./dist/value.js"
      },
      "./sequence": {
        "types": "./dist/sequence-entry.d.ts",
        "import": "./dist/sequence.js",
        "require": "./dist/sequence.cjs",
        "default": "./dist/sequence.js"
      },
      "./gesture": {
        "types": "./dist/gesture-entry.d.ts",
        "import": "./dist/gesture.js",
        "require": "./dist/gesture.cjs",
        "default": "./dist/gesture.js"
      },
      "./text": {
        "types": "./dist/text-entry.d.ts",
        "import": "./dist/text.js",
        "require": "./dist/text.cjs",
        "default": "./dist/text.js"
      },
      "./svg": {
        "types": "./dist/svg-entry.d.ts",
        "import": "./dist/svg.js",
        "require": "./dist/svg.cjs",
        "default": "./dist/svg.js"
      },
      "./astro": {
        "types": "./dist/astro.d.ts",
        "import": "./dist/astro.js",
        "require": "./dist/astro.cjs",
        "default": "./dist/astro.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Udixio/UI.git"
  },
  "type": "module",
  "files": [
    "dist",
    "motion-manifest.json",
    "src/**/*.ts",
    "!src/**/*.spec.ts",
    "!src/**/*.test.ts",
    "public/*.css"
  ],
  "scripts": {
    "size": "node --test scripts/package-exports.test.mjs && size-limit",
    "bench": "node bench/run.mjs"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./motion.css": {
      "development": "./public/motion.css",
      "default": "./dist/motion.css"
    },
    "./motion-manifest.json": "./motion-manifest.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "development": "./src/manifest.ts",
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "require": "./dist/manifest.cjs",
      "default": "./dist/manifest.js"
    },
    "./providers/css": {
      "development": "./src/providers/css.ts",
      "types": "./dist/providers/css.d.ts",
      "import": "./dist/providers/css.js",
      "require": "./dist/providers/css.cjs",
      "default": "./dist/providers/css.js"
    },
    "./providers/waapi": {
      "development": "./src/providers/waapi.ts",
      "types": "./dist/providers/waapi.d.ts",
      "import": "./dist/providers/waapi.js",
      "require": "./dist/providers/waapi.cjs",
      "default": "./dist/providers/waapi.js"
    },
    "./providers/animejs": {
      "development": "./src/providers/animejs.ts",
      "types": "./dist/providers/animejs.d.ts",
      "import": "./dist/providers/animejs.js",
      "require": "./dist/providers/animejs.cjs",
      "default": "./dist/providers/animejs.js"
    },
    "./testing": {
      "development": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.cjs",
      "default": "./dist/testing/index.js"
    },
    "./policy": {
      "development": "./src/policy.ts",
      "types": "./dist/policy.d.ts",
      "import": "./dist/policy.js",
      "require": "./dist/policy.cjs",
      "default": "./dist/policy.js"
    },
    "./presets": {
      "development": "./src/presets.ts",
      "types": "./dist/presets.d.ts",
      "import": "./dist/presets.js",
      "require": "./dist/presets.cjs",
      "default": "./dist/presets.js"
    },
    "./layout": {
      "development": "./src/layout.ts",
      "types": "./dist/layout.d.ts",
      "import": "./dist/layout.js",
      "require": "./dist/layout.cjs",
      "default": "./dist/layout.js"
    },
    "./value": {
      "development": "./src/value-entry.ts",
      "types": "./dist/value-entry.d.ts",
      "import": "./dist/value.js",
      "require": "./dist/value.cjs",
      "default": "./dist/value.js"
    },
    "./sequence": {
      "development": "./src/sequence-entry.ts",
      "types": "./dist/sequence-entry.d.ts",
      "import": "./dist/sequence.js",
      "require": "./dist/sequence.cjs",
      "default": "./dist/sequence.js"
    },
    "./gesture": {
      "development": "./src/gesture-entry.ts",
      "types": "./dist/gesture-entry.d.ts",
      "import": "./dist/gesture.js",
      "require": "./dist/gesture.cjs",
      "default": "./dist/gesture.js"
    },
    "./text": {
      "development": "./src/text-entry.ts",
      "types": "./dist/text-entry.d.ts",
      "import": "./dist/text.js",
      "require": "./dist/text.cjs",
      "default": "./dist/text.js"
    },
    "./svg": {
      "development": "./src/svg-entry.ts",
      "types": "./dist/svg-entry.d.ts",
      "import": "./dist/svg.js",
      "require": "./dist/svg.cjs",
      "default": "./dist/svg.js"
    },
    "./astro": {
      "development": "./src/astro.ts",
      "types": "./dist/astro.d.ts",
      "import": "./dist/astro.js",
      "require": "./dist/astro.cjs",
      "default": "./dist/astro.js"
    }
  },
  "dependencies": {
    "animejs": "^4.5.0"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.1.6",
    "@vitest/browser-playwright": "4.1.11",
    "motion": "^12.23.0",
    "playwright": "^1.64.0"
  },
  "nx": {
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "inputs": [
          "default",
          "^default",
          {
            "env": "MOTION_BROWSERS"
          }
        ],
        "options": {
          "cwd": "packages/motion",
          "command": "tsc --noEmit --project tsconfig.spec.json && node scripts/generate-curves.mjs --check && node scripts/generate-motion-manifest.mjs --check && node scripts/generate-springs.mjs --check && vitest run && node --test scripts/motion-policy-css.test.mjs scripts/route-css.test.mjs scripts/spring-css.test.mjs scripts/curve-generation.test.mjs"
        }
      }
    }
  }
}
