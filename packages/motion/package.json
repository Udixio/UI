{
  "name": "@udixio/motion",
  "version": "0.0.0",
  "publishConfig": {
    "provenance": true,
    "access": "public",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs",
        "default": "./dist/index.js"
      },
      "./providers/waapi": { "types": "./dist/providers/waapi.d.ts", "import": "./dist/providers/waapi.js", "require": "./dist/providers/waapi.cjs", "default": "./dist/providers/waapi.js" },
      "./providers/animejs": { "types": "./dist/providers/animejs.d.ts", "import": "./dist/providers/animejs.js", "require": "./dist/providers/animejs.cjs", "default": "./dist/providers/animejs.js" }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Udixio/UI.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./providers/waapi": { "development": "./src/providers/waapi.ts", "types": "./dist/providers/waapi.d.ts", "import": "./dist/providers/waapi.js", "require": "./dist/providers/waapi.cjs", "default": "./dist/providers/waapi.js" },
    "./providers/animejs": { "development": "./src/providers/animejs.ts", "types": "./dist/providers/animejs.d.ts", "import": "./dist/providers/animejs.js", "require": "./dist/providers/animejs.cjs", "default": "./dist/providers/animejs.js" }
  },
  "dependencies": {
    "animejs": "^4.5.0"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "4.1.11"
  },
  "nx": {
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/motion",
          "command": "vitest run"
        }
      }
    }
  }
}
