{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "declarationMap": true,
    "lib": ["es2022", "dom"],
    "types": [],
    "customConditions": []
  },
  "exclude": [
    "src/**/*.spec.ts",
    "src/test-setup.ts",
    "jest.config.ts",
    "src/**/*.test.ts",
    "jest.config.cts"
  ],
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../theme/tsconfig.lib.json"
    },
    {
      "path": "../tailwind/tsconfig.lib.json"
    },
    {
      "path": "../icons/icons-rounded-400/tsconfig.lib.json"
    },
    {
      "path": "../core/tsconfig.lib.json"
    }
  ]
}
