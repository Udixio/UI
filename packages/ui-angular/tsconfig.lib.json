{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "lib": ["es2022", "dom"],
    "types": []
  },
  "exclude": [
    "src/**/*.spec.ts",
    "src/test-setup.ts",
    "jest.config.ts",
    "src/**/*.test.ts",
    "jest.config.cts"
  ],
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../core/tsconfig.lib.json"
    }
  ]
}
