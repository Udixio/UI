{
  "name": "@udixio/theme",
  "version": "5.0.1-next.10",
  "type": "module",
  "main": "./dist/node.js",
  "module": "./dist/node.js",
  "types": "./dist/index.node.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": {
        "browser": "./src/index.browser.ts",
        "node": "./src/index.node.ts",
        "default": "./src/index.browser.ts"
      },
      "types": "./dist/index.node.d.ts",
      "browser": {
        "import": "./dist/browser.js",
        "require": "./dist/browser.cjs"
      },
      "node": {
        "import": "./dist/node.js",
        "require": "./dist/node.cjs",
        "default": "./dist/node.js"
      },
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./vite": {
      "development": {
        "node": "./src/vite.ts",
        "default": "./src/vite.ts"
      },
      "types": "./dist/vite.d.ts",
      "node": {
        "import": "./dist/vite.js",
        "require": "./dist/vite.cjs",
        "default": "./dist/vite.js"
      },
      "import": "./dist/vite.js",
      "require": "./dist/vite.cjs",
      "default": "./dist/vite.js"
    },
    "./rollup": {
      "development": {
        "node": "./src/rollup.ts",
        "default": "./src/rollup.ts"
      },
      "types": "./dist/rollup.d.ts",
      "node": {
        "import": "./dist/rollup.js",
        "require": "./dist/rollup.cjs",
        "default": "./dist/rollup.js"
      },
      "import": "./dist/rollup.js",
      "require": "./dist/rollup.cjs",
      "default": "./dist/rollup.js"
    }
  },
  "bin": {
    "udixio-theme": "./dist/bin.js"
  },
  "dependencies": {
    "pathe": "^2.0.3",
    "jiti": "^2.5.1",
    "awilix": "^12.0.5",
    "@material/material-color-utilities": "^0.3.0",
    "replace-in-file": "^8.3.0",
    "tailwindcss": "^4.1.11",
    "chokidar": "^4.0.3",
    "mri": "^1.2.0",
    "commander": "^14.0.0",
    "chalk": "^5.6.0",
    "unplugin": "^2.3.8"
  },
  "devDependencies": {},
  "repository": {
    "type": "git",
    "url": "https://github.com/Udixio/UI.git"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.node.d.ts",
        "browser": {
          "import": "./dist/browser.js",
          "require": "./dist/browser.cjs"
        },
        "node": {
          "import": "./dist/node.js",
          "require": "./dist/node.cjs",
          "default": "./dist/node.js"
        },
        "import": "./dist/node.js",
        "require": "./dist/node.cjs"
      },
      "./vite": {
        "types": "./dist/vite.d.ts",
        "node": {
          "import": "./dist/vite.js",
          "require": "./dist/vite.cjs",
          "default": "./dist/vite.js"
        },
        "import": "./dist/vite.js",
        "require": "./dist/vite.cjs",
        "default": "./dist/vite.js"
      },
      "./rollup": {
        "types": "./dist/rollup.d.ts",
        "node": {
          "import": "./dist/rollup.js",
          "require": "./dist/rollup.cjs",
          "default": "./dist/rollup.js"
        },
        "import": "./dist/rollup.js",
        "require": "./dist/rollup.cjs",
        "default": "./dist/rollup.js"
      }
    }
  }
}
