{
  "name": "@udixio/core",
  "version": "0.2.2-next.17",
  "publishConfig": {
    "provenance": true,
    "access": "public",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs",
        "default": "./dist/index.js"
      },
      "./dom": {
        "types": "./dist/dom.d.ts",
        "import": "./dist/dom.js",
        "require": "./dist/dom.cjs",
        "default": "./dist/dom.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Udixio/UI.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./dom": {
      "development": "./src/dom.ts",
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js",
      "require": "./dist/dom.cjs",
      "default": "./dist/dom.js"
    }
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.0.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1",
    "@udixio/motion": "0.0.0"
  },
  "peerDependencies": {
    "react": ">19.0.0"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "4.1.11",
    "playwright": "^1.64.0",
    "react": "^19.1.1"
  }
}
