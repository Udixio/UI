{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["development"],
    "paths": {
      // ng-packagr generates `@udixio/ui-angular`'s manifest at build time, so its
      // source package.json has no `exports` to resolve through the `development`
      // condition. Every other package must stay out of this map: vite-plugin-dts
      // rewrites `paths` aliases into relative source paths, emitting broken
      // specifiers like `../../../packages/core/src/index.ts` in the .d.ts files.
      "@udixio/ui-angular": ["./packages/ui-angular/src/index.ts"]
    }
  }
}
